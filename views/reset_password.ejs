<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter OTP & Reset Password • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 2.25rem 2rem;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.5rem;
        }

        .auth-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 4px 0;
        }

        .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.45;
        }

        .alert-banner {
            border-radius: var(--radius-sm);
            padding: 0.85rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 1.25rem;
            border: 1px solid transparent;
            line-height: 1.4;
        }

        .alert-error {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
        }

        .alert-success {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }

        .otp-input-field {
            font-family: 'JetBrains Mono', monospace, Courier;
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 10px;
            text-align: center;
            padding: 10px 14px;
            color: #1D4ED8;
            background: #EFF6FF;
            border: 2px solid #93C5FD;
            border-radius: 8px;
            width: 100%;
            box-sizing: border-box;
            outline: none;
            transition: all 130ms ease;
        }

        .otp-input-field:focus {
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
            background: #FFFFFF;
        }

        .password-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.4rem;
        }

        .btn-toggle-pw {
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xs);
            padding: 2px 8px;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            transition: var(--transition);
        }

        .btn-toggle-pw:hover {
            background: var(--surface-subtle);
            border-color: var(--border-hover);
            color: var(--text-main);
        }

        .auth-footer-links {
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            border-top: 1px solid #F1F5F9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.84rem;
        }

        .auth-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .auth-link:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }

        .resend-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.82rem;
            margin-top: 6px;
            color: var(--text-muted);
        }

        .btn-resend {
            background: none;
            border: none;
            color: var(--primary);
            font-weight: 600;
            cursor: pointer;
            padding: 0;
            font-size: 0.82rem;
            text-decoration: underline;
        }

        .btn-resend:disabled {
            color: #94A3B8;
            cursor: not-allowed;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <main class="auth-shell">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="auth-title">Verify & Reset</h1>
                    <p class="auth-subtitle">
                        <% if (typeof maskedEmail !== 'undefined' && maskedEmail) { %>
                            Enter the 6-digit OTP sent to <strong style="color: var(--text-main); font-family: 'JetBrains Mono', monospace;"><%= maskedEmail %></strong>
                        <% } else { %>
                            Enter the verification OTP and choose a new password
                        <% } %>
                    </p>
                </div>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-banner alert-error" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert-banner alert-success" role="status">
                    <%= message %>
                </div>
            <% } %>

            <form action="/reset-password" method="POST" id="resetPasswordForm">
                <input type="hidden" name="identifier" value="<%= typeof identifier !== 'undefined' && identifier ? identifier : '' %>">
                <input type="hidden" name="maskedEmail" value="<%= typeof maskedEmail !== 'undefined' && maskedEmail ? maskedEmail : '' %>">

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label for="otp" style="font-weight: 600; font-size: 0.86rem; color: var(--text-main); display: block; margin-bottom: 6px;">
                        One-Time Password (OTP) *
                    </label>
                    <input type="text"
                           id="otp"
                           name="otp"
                           class="otp-input-field"
                           placeholder="••••••"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           required
                           autofocus>
                    <div class="resend-bar">
                        <span>Valid for 10 minutes</span>
                        <button type="button" id="btnResendOtp" class="btn-resend" onclick="triggerResendOtp()">
                            Resend OTP
                        </button>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.15rem;">
                    <div class="password-label-row">
                        <label for="newPassword" style="font-weight: 600; font-size: 0.86rem; color: var(--text-main); margin-bottom: 0;">
                            New Password *
                        </label>
                        <button type="button" class="btn-toggle-pw" onclick="togglePw('newPassword', this)">Show</button>
                    </div>
                    <input type="password"
                           id="newPassword"
                           name="password"
                           class="form-control"
                           placeholder="Minimum 6 characters"
                           minlength="6"
                           required
                           autocomplete="new-password">
                </div>

                <div class="form-group" style="margin-bottom: 1.4rem;">
                    <div class="password-label-row">
                        <label for="confirmPassword" style="font-weight: 600; font-size: 0.86rem; color: var(--text-main); margin-bottom: 0;">
                            Confirm New Password *
                        </label>
                        <button type="button" class="btn-toggle-pw" onclick="togglePw('confirmPassword', this)">Show</button>
                    </div>
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Re-enter new password"
                           minlength="6"
                           required
                           autocomplete="new-password">
                </div>

                <button type="submit" id="btnResetSubmit" class="btn btn-primary btn-lg" style="width: 100%;">
                    Reset Password
                </button>
            </form>

            <form id="resendForm" action="/forgot-password" method="POST" style="display: none;">
                <input type="hidden" name="identifier" value="<%= typeof identifier !== 'undefined' && identifier ? identifier : '' %>">
                <input type="hidden" name="isResend" value="true">
            </form>

            <div class="auth-footer-links">
                <a href="/login" class="auth-link">
                    &larr; Back to Sign In
                </a>
                <a href="/forgot-password" class="auth-link">
                    Use different account
                </a>
            </div>
        </div>
    </main>

    <script>
        function togglePw(id, btn) {
            const input = document.getElementById(id);
            if (!input) return;
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.textContent = isHidden ? 'Hide' : 'Show';
        }

        const resetForm = document.getElementById('resetPasswordForm');
        const submitBtn = document.getElementById('btnResetSubmit');
        if (resetForm && submitBtn) {
            resetForm.addEventListener('submit', (e) => {
                const p1 = document.getElementById('newPassword').value;
                const p2 = document.getElementById('confirmPassword').value;
                if (p1 !== p2) {
                    e.preventDefault();
                    alert('Passwords do not match. Please verify both password fields.');
                    return;
                }
                if (resetForm.checkValidity()) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Updating Password...';
                }
            });
        }

        function triggerResendOtp() {
            const resendForm = document.getElementById('resendForm');
            const resendBtn = document.getElementById('btnResendOtp');
            if (resendForm && resendBtn) {
                resendBtn.disabled = true;
                resendBtn.textContent = 'Sending...';
                resendForm.submit();
            }
        }
    </script>
</body>

</html>
