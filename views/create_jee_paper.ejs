<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create JEE Mains Paper • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-container {
            max-width: 680px;
            margin: 0 auto;
            padding: 1.5rem 1rem 3rem 1rem;
        }

        .form-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.75rem 2rem;
            box-shadow: var(--shadow-sm);
        }

        .form-header {
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
        }

        .form-header h1 {
            font-size: 1.35rem;
            font-weight: 800;
            color: #1E3A8A;
            margin: 0 0 6px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-header p {
            color: var(--text-muted);
            margin: 0;
            font-size: 0.86rem;
            line-height: 1.45;
        }

        .preset-badge-box {
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            border-radius: var(--radius-md);
            padding: 12px 16px;
            margin-bottom: 1.5rem;
        }

        .preset-badge-box h4 {
            margin: 0 0 6px 0;
            font-size: 0.9rem;
            color: #1D4ED8;
            font-weight: 700;
        }

        .preset-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
            font-size: 0.78rem;
            color: #1E293B;
        }

        .preset-item {
            background: #FFFFFF;
            border: 1px solid #BFDBFE;
            padding: 8px 10px;
            border-radius: var(--radius-xs);
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--text-main);
        }

        .form-input {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-family: inherit;
            box-sizing: border-box;
            transition: var(--transition);
        }

        .form-input:focus {
            border-color: #2563EB;
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .btn-submit {
            background: #2563EB;
            color: #FFFFFF;
            border: 1px solid #2563EB;
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background: #1D4ED8;
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'jee' }) %>
    <div class="container form-container">
        <main>
            <div class="form-card">
                <div class="form-header">
                    <h1>
                        <span>⚛️ Create JEE Mains Exam Paper</span>
                    </h1>
                    <p>
                        Creates a standard JEE Mains paper with pre-configured 3 subjects, 300 Max Marks, and automated OMR question mapping.
                    </p>
                </div>

                <div class="preset-badge-box">
                    <h4>Pre-Configured JEE Mains Blueprint (Auto-Applied):</h4>
                    <div class="preset-grid">
                        <div class="preset-item">
                            <strong>⚛️ Physics</strong><br>
                            Q1–25 (100 M)
                        </div>
                        <div class="preset-item">
                            <strong>🧪 Chemistry</strong><br>
                            Q26–50 (100 M)
                        </div>
                        <div class="preset-item">
                            <strong>📐 Mathematics</strong><br>
                            Q51–75 (100 M)
                        </div>
                    </div>
                </div>

                <form action="/jee/new" method="POST">
                    <div class="form-group">
                        <label for="title" class="form-label">Paper Title *</label>
                        <input type="text" id="title" name="title" class="form-input" placeholder="e.g. JEE Mains 2026 - Mock Test 01" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="subject" class="form-label">Subject Category</label>
                        <input type="text" id="subject" name="subject" class="form-input" value="JEE Mains" readonly style="background:var(--surface-subtle); color:var(--text-muted);">
                    </div>

                    <div class="form-group">
                        <label for="category" class="form-label">Section / Batch / Folder</label>
                        <input type="text" id="category" name="category" class="form-input" placeholder="e.g. 12th JEE, Target 2026, 11th JEE" list="jeeCategorySuggestions" value="12th JEE">
                        <datalist id="jeeCategorySuggestions">
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>"></option>
                                <% }) %>
                            <% } %>
                            <option value="12th JEE"></option>
                            <option value="11th JEE"></option>
                            <option value="Target 2026"></option>
                            <option value="Droppers Batch"></option>
                        </datalist>
                        <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; display: block;">Papers are dynamically grouped and filtered by this section.</span>
                    </div>

                    <div style="display:flex; gap:10px; margin-top:1.5rem;">
                        <button type="submit" class="btn-submit">
                            Create &amp; Configure JEE Answer Key &rarr;
                        </button>
                    </div>

                    <div style="margin-top:12px; text-align:center;">
                        <a href="/jee" style="font-size:0.85rem; color:var(--text-muted); text-decoration:none;">
                            &larr; Cancel and return to JEE Section
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>
    <%- include('partials/sidebar_end') %>
</body>
</html>
