<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Assessment Paper • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .page-header-nav {
            max-width: 780px;
            margin: 0 auto 1.25rem auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .breadcrumb-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.875rem;
            color: var(--text-muted);
        }
        .breadcrumb-wrap a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .breadcrumb-wrap a:hover {
            text-decoration: underline;
        }
        .form-card {
            max-width: 780px;
            margin: 0 auto;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 2rem 2.25rem;
        }
        .form-card-header {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding-bottom: 1.35rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border-color);
        }
        .form-icon-box {
            width: 44px;
            height: 44px;
            background: var(--primary-light);
            border: 1px solid var(--primary-border);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            flex-shrink: 0;
        }
        .form-card-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0 0 4px 0;
        }
        .form-card-header p {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin: 0;
            line-height: 1.45;
        }
        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .form-row-3 {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1fr;
            gap: 16px;
        }
        .preset-group-label {
            display: block;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        .preset-badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .preset-tag {
            background: #FFFFFF;
            color: var(--text-body);
            border: 1px solid var(--border-hover);
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        .preset-tag:hover {
            border-color: var(--primary);
            background: var(--primary-light);
            color: var(--primary);
        }
        .preset-tag.active {
            background: var(--primary);
            color: #FFFFFF;
            border-color: var(--primary);
        }

        /* Section Builder Styles */
        .section-builder-box {
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 1.15rem 1.25rem;
            margin: 1.5rem 0;
        }
        .section-builder-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 12px;
        }
        .section-builder-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-status-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 9px;
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
        }
        .section-item-row {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            margin-bottom: 8px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 34px;
            gap: 10px;
            align-items: center;
        }
        .section-item-row:last-child {
            margin-bottom: 0;
        }
        .sec-field-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 4px;
            display: block;
        }
        .sec-input {
            width: 100%;
            padding: 6px 9px;
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-xs);
            font-size: 0.875rem;
            font-family: inherit;
            color: var(--text-main);
            background: #FFFFFF;
        }
        .sec-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-glow);
        }
        .sec-input-mono {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            text-align: center;
        }
        .btn-remove-sec {
            background: #FFFFFF;
            color: var(--text-muted);
            border: 1px solid var(--border-hover);
            width: 32px;
            height: 32px;
            border-radius: var(--radius-xs);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 18px;
            transition: var(--transition);
        }
        .btn-remove-sec:hover {
            background: var(--danger-light);
            color: var(--danger);
            border-color: var(--danger-border);
        }

        .preview-info-box {
            background: var(--primary-light);
            border: 1px solid var(--primary-border);
            border-radius: var(--radius-sm);
            padding: 12px 14px;
            margin: 1.25rem 0;
            font-size: 0.85rem;
            color: var(--text-body);
            display: flex;
            align-items: flex-start;
            gap: 10px;
            line-height: 1.45;
        }
        .preview-info-box strong {
            color: var(--text-main);
        }

        @media (max-width: 768px) {
            .form-row-2, .form-row-3 {
                grid-template-columns: 1fr;
                gap: 0;
            }
            .section-item-row {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }
            .sec-col-name {
                grid-column: span 2;
            }
            .sec-col-btn {
                grid-column: span 2;
                display: flex;
                justify-content: flex-end;
            }
            .btn-remove-sec {
                margin-top: 2px;
            }
            .form-card {
                padding: 1.35rem 1.15rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header-nav">
            <div class="breadcrumb-wrap">
                <a href="/">&larr; Dashboard</a>
                <span>/</span>
                <span style="font-weight: 600; color: var(--text-main);">Create Paper</span>
            </div>
            <a href="/" class="btn btn-secondary btn-sm">Cancel</a>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <div class="form-icon-box" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </div>
                <div>
                    <h2>Create Assessment Paper</h2>
                    <p>Configure the exam details, total questions, and section ranges to generate printable OMR sheets and answer keys.</p>
                </div>
            </div>

            <form action="/paper/new" method="POST" id="createPaperForm" onsubmit="prepareSectionsPayload()">
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="title">Paper Title <span aria-hidden="true">*</span></label>
                        <input
                            type="text"
                            id="title"
                            name="title"
                            class="form-control"
                            required
                            placeholder="e.g. Mathematics Term 1"
                            autofocus
                        >
                    </div>
                    <div class="form-group">
                        <label for="subject">Subject <span aria-hidden="true">*</span></label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            class="form-control"
                            required
                            placeholder="e.g. Mathematics"
                            value="Mathematics"
                        >
                    </div>
                </div>

                <div class="form-row-3">
                    <div class="form-group">
                        <label for="paper_id">Paper Code (Optional)</label>
                        <input
                            type="text"
                            id="paper_id"
                            name="paper_id"
                            class="form-control"
                            placeholder="e.g. MATH_101_2026"
                            autocorrect="off"
                            autocapitalize="none"
                            spellcheck="false"
                            style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 600;"
                        >
                    </div>
                    <div class="form-group">
                        <label for="numQuestions">Total Questions <span aria-hidden="true">*</span></label>
                        <input
                            type="number"
                            id="numQuestions"
                            name="numQuestions"
                            class="form-control"
                            required
                            min="1"
                            max="200"
                            value="180"
                            style="font-family: 'JetBrains Mono', monospace; font-weight: 600;"
                            onchange="onTotalQuestionsChanged()"
                        >
                    </div>
                    <div class="form-group">
                        <label for="max_marks">Max Marks</label>
                        <input
                            type="number"
                            id="max_marks"
                            name="max_marks"
                            class="form-control"
                            value="180"
                            style="font-family: 'JetBrains Mono', monospace; font-weight: 600;"
                        >
                    </div>
                </div>

                <div class="form-group">
                    <span class="preset-group-label">Question Count Presets</span>
                    <div class="preset-badge-group">
                        <button type="button" class="preset-tag" data-val="20">20 Qs (Quiz)</button>
                        <button type="button" class="preset-tag" data-val="50">50 Qs (Standard)</button>
                        <button type="button" class="preset-tag" data-val="100">100 Qs (Midterm)</button>
                        <button type="button" class="preset-tag active" data-val="180">180 Qs (NEET)</button>
                        <button type="button" class="preset-tag" data-val="200">200 Qs (Max)</button>
                    </div>
                </div>

                <div class="section-builder-box">
                    <div class="section-builder-header">
                        <div>
                            <div class="section-builder-title">
                                <span>Sections &amp; Question Ranges</span>
                                <span class="section-status-badge" id="sectionStatusBadge">4 Sections</span>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
                                Define sections by question range (From Q to To Q) and maximum marks.
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="resetToStandardSections()" title="Auto-divide total questions across balanced sections">
                                Auto Divide
                            </button>
                            <button type="button" class="btn btn-primary btn-sm" onclick="addSectionRow('', 1, 10, 40)" title="Add another section">
                                + Add Section
                            </button>
                        </div>
                    </div>

                    <div id="sectionRowsContainer"></div>
                    <input type="hidden" name="sections" id="sectionsInput" value="[]">
                </div>

                <div class="preview-info-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary); flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <div>
                        Standard 4-corner A4 OMR markers with options <strong>A, B, C, D</strong> will be automatically prepared. Questions are grouped section-wise in result reports.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 0.5rem;">
                    Generate Paper &amp; Configure Answer Key &rarr;
                </button>
            </form>
        </div>
    </div>

    <script>
        const numInput = document.getElementById('numQuestions');
        const maxMarksInput = document.getElementById('max_marks');
        const tags = document.querySelectorAll('.preset-tag');
        const sectionContainer = document.getElementById('sectionRowsContainer');
        const sectionsInput = document.getElementById('sectionsInput');
        const sectionStatusBadge = document.getElementById('sectionStatusBadge');

        tags.forEach(tag => {
            tag.addEventListener('click', () => {
                const val = parseInt(tag.getAttribute('data-val'), 10);
                numInput.value = val;
                maxMarksInput.value = val;
                tags.forEach(t => t.classList.remove('active'));
                tag.classList.add('active');
                resetToStandardSections();
            });
        });

        function onTotalQuestionsChanged() {
            const val = parseInt(numInput.value, 10) || 50;
            maxMarksInput.value = val;
            tags.forEach(tag => {
                if (parseInt(tag.getAttribute('data-val'), 10) === val) {
                    tag.classList.add('active');
                } else {
                    tag.classList.remove('active');
                }
            });
            resetToStandardSections();
        }

        function addSectionRow(name = '', fromQ = 1, toQ = 10, marks = null) {
            const row = document.createElement('div');
            row.className = 'section-item-row';
            const count = (toQ >= fromQ) ? (toQ - fromQ + 1) : 0;
            const secMarks = (marks !== null) ? marks : (count * 4);
            const escapedName = String(name).replace(/"/g, '&quot;');

            row.innerHTML = `
                <div class="sec-col-name">
                    <label class="sec-field-label">Section Name</label>
                    <input type="text" class="sec-input sec-name-input" value="${escapedName}" placeholder="e.g. Physics / Section A" oninput="updateSectionsJSON()">
                </div>
                <div>
                    <label class="sec-field-label">From Q #</label>
                    <input type="number" min="1" max="200" class="sec-input sec-input-mono sec-from-input" value="${fromQ}" oninput="onRangeChange(this)">
                </div>
                <div>
                    <label class="sec-field-label">To Q #</label>
                    <input type="number" min="1" max="200" class="sec-input sec-input-mono sec-to-input" value="${toQ}" oninput="onRangeChange(this)">
                </div>
                <div>
                    <label class="sec-field-label">Max Marks</label>
                    <input type="number" min="0" class="sec-input sec-input-mono sec-marks-input" value="${secMarks}" oninput="updateSectionsJSON()">
                </div>
                <div class="sec-col-btn">
                    <button type="button" class="btn-remove-sec" onclick="removeSectionRow(this)" title="Remove section" aria-label="Remove section">&times;</button>
                </div>
            `;

            sectionContainer.appendChild(row);
            updateSectionsJSON();
        }

        function removeSectionRow(btn) {
            const row = btn.closest('.section-item-row');
            if (row) row.remove();
            updateSectionsJSON();
        }

        function onRangeChange(input) {
            const row = input.closest('.section-item-row');
            if (row) {
                const fromQ = parseInt(row.querySelector('.sec-from-input').value, 10) || 1;
                const toQ = parseInt(row.querySelector('.sec-to-input').value, 10) || fromQ;
                const marksInput = row.querySelector('.sec-marks-input');
                if (marksInput) {
                    const count = (toQ >= fromQ) ? (toQ - fromQ + 1) : 0;
                    marksInput.value = count * 4;
                }
            }
            updateSectionsJSON();
        }

        function updateSectionsJSON() {
            const rows = sectionContainer.querySelectorAll('.section-item-row');
            const list = [];
            rows.forEach((r, idx) => {
                const name = r.querySelector('.sec-name-input').value.trim() || `Section ${idx + 1}`;
                const fromQ = parseInt(r.querySelector('.sec-from-input').value, 10) || 1;
                const toQ = parseInt(r.querySelector('.sec-to-input').value, 10) || fromQ;
                const marks = parseInt(r.querySelector('.sec-marks-input').value, 10) || ((toQ - fromQ + 1) * 4);
                list.push({
                    name: name,
                    from_question: fromQ,
                    to_question: toQ,
                    max_marks: marks
                });
            });

            sectionsInput.value = JSON.stringify(list);
            sectionStatusBadge.textContent = `${list.length} Section${list.length !== 1 ? 's' : ''}`;
        }

        function prepareSectionsPayload() {
            updateSectionsJSON();
        }

        function resetToStandardSections() {
            sectionContainer.innerHTML = '';
            const totalQ = parseInt(numInput.value, 10) || 180;

            if (totalQ === 180) {
                addSectionRow('Physics', 1, 45, 180);
                addSectionRow('Chemistry', 46, 90, 180);
                addSectionRow('Mathematics / Botany', 91, 135, 180);
                addSectionRow('General / Zoology', 136, 180, 180);
            } else if (totalQ <= 30) {
                addSectionRow('Section A (General)', 1, totalQ, totalQ * 4);
            } else if (totalQ <= 60) {
                const half = Math.ceil(totalQ / 2);
                addSectionRow('Section A', 1, half, half * 4);
                addSectionRow('Section B', half + 1, totalQ, (totalQ - half) * 4);
            } else {
                const qPerSec = Math.ceil(totalQ / 4);
                addSectionRow('Section 1 (Physics)', 1, qPerSec, qPerSec * 4);
                addSectionRow('Section 2 (Chemistry)', qPerSec + 1, qPerSec * 2, qPerSec * 4);
                addSectionRow('Section 3 (Mathematics)', (qPerSec * 2) + 1, qPerSec * 3, qPerSec * 4);
                addSectionRow('Section 4 (General)', (qPerSec * 3) + 1, totalQ, (totalQ - (qPerSec * 3)) * 4);
            }
        }

        resetToStandardSections();
    </script>
</body>
</html>
