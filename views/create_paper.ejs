<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Assessment Paper - Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        .page-header-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.25rem;
        }
        .breadcrumb-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        .breadcrumb-wrap a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: var(--transition);
        }
        .breadcrumb-wrap a:hover {
            color: var(--primary-hover);
            transform: translateX(-2px);
        }
        .form-card {
            max-width: 640px;
            margin: 0 auto;
            background: var(--surface);
            border-radius: var(--radius-xl);
            border: 1px solid rgba(226, 232, 240, 0.85);
            box-shadow: 0 20px 35px -10px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(15, 23, 42, 0.04);
            padding: 2.75rem 2.85rem;
            position: relative;
            overflow: hidden;
        }
        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--primary), #06B6D4);
        }
        .form-card-header {
            margin-bottom: 2rem;
            text-align: center;
        }
        .form-icon-circle {
            width: 60px;
            height: 60px;
            margin: 0 auto 1.25rem;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.1) 0%, rgba(6, 182, 212, 0.12) 100%);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);
            border: 1px solid rgba(79, 70, 229, 0.15);
        }
        .form-card-header h2 {
            font-size: 1.75rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            letter-spacing: -0.025em;
        }
        .form-card-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0;
            line-height: 1.5;
        }
        .preset-badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        .preset-tag {
            background: #F8FAFC;
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            user-select: none;
        }
        .preset-tag:hover {
            border-color: var(--primary);
            background: var(--primary-light);
            color: var(--primary);
            transform: translateY(-1px);
        }
        .preset-tag.active {
            background: linear-gradient(135deg, var(--primary) 0%, #4338CA 100%);
            color: #FFFFFF;
            border-color: var(--primary);
            box-shadow: 0 4px 12px var(--primary-glow);
        }
        .preview-info-box {
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.04) 0%, rgba(6, 182, 212, 0.04) 100%);
            border: 1px solid rgba(79, 70, 229, 0.15);
            border-left: 4px solid var(--primary);
            border-radius: var(--radius-md);
            padding: 14px 18px;
            margin: 1.75rem 0;
            font-size: 0.9rem;
            color: var(--text-body);
            display: flex;
            align-items: center;
            gap: 14px;
            line-height: 1.5;
        }
        .preview-info-box strong {
            color: var(--text-main);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header Nav -->
        <div class="page-header-nav">
            <div class="breadcrumb-wrap">
                <a href="/">← Dashboard</a>
                <span>/</span>
                <span style="font-weight: 700; color: var(--text-main);">Create Paper</span>
            </div>
            <a href="/" class="btn btn-secondary btn-sm">Cancel</a>
        </div>

        <!-- Create Paper Card -->
        <div class="form-card">
            <div class="form-card-header">
                <div class="form-icon-circle">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </div>
                <h2>Create Assessment Paper</h2>
                <p>Configure paper details and question count to generate standardized printable OMR answer sheets.</p>
            </div>

            <form action="/paper/new" method="POST" id="createPaperForm">
                <div class="form-group">
                    <label for="title">Paper / Exam Title</label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        class="form-control" 
                        required 
                        placeholder="e.g. Physics Midterm Examination 2026"
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="numQuestions">Total Questions (1 - 200)</label>
                    <input 
                        type="number" 
                        id="numQuestions" 
                        name="numQuestions" 
                        class="form-control" 
                        required 
                        min="1" 
                        max="200" 
                        value="50"
                        style="font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 700;"
                    >
                    
                    <div style="margin-top: 14px;">
                        <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Quick Presets:</span>
                        <div class="preset-badge-group">
                            <span class="preset-tag" data-val="20">20 Qs (Quiz)</span>
                            <span class="preset-tag active" data-val="50">50 Qs (Standard)</span>
                            <span class="preset-tag" data-val="100">100 Qs (Midterm)</span>
                            <span class="preset-tag" data-val="180">180 Qs (NEET)</span>
                            <span class="preset-tag" data-val="200">200 Qs (Max)</span>
                        </div>
                    </div>
                </div>

                <div class="preview-info-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary); flex-shrink: 0;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <div>
                        Standard 4-Corner OMR markers with options <strong>A, B, C, D</strong> will be automatically laid out for high-speed evaluation.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; font-size: 1.05rem; margin-top: 0.75rem;">
                    Generate Paper & Configure Keys →
                </button>
            </form>
        </div>
    </div>

    <script>
        // Preset selector functionality
        const numInput = document.getElementById('numQuestions');
        const tags = document.querySelectorAll('.preset-tag');

        tags.forEach(tag => {
            tag.addEventListener('click', () => {
                const val = tag.getAttribute('data-val');
                numInput.value = val;
                tags.forEach(t => t.classList.remove('active'));
                tag.classList.add('active');
            });
        });

        numInput.addEventListener('input', () => {
            tags.forEach(tag => {
                if (tag.getAttribute('data-val') === numInput.value) {
                    tag.classList.add('active');
                } else {
                    tag.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>
