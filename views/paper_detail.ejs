<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title><%= paper.title %> • Answer Key</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: var(--bg-page);
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .full-screen-container {
            width: 100%;
            max-width: 1360px;
            margin: 0 auto;
            padding: 12px 14px 104px 14px;
            box-sizing: border-box;
        }

        /* Slim Sticky Top Bar */
        .slim-top-bar {
            position: sticky;
            top: 10px;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 10px 16px;
            margin-bottom: 14px;
            box-shadow: var(--shadow-sm);
            gap: 12px;
            flex-wrap: wrap;
        }

        .topbar-actions-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .jee-tools-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #F8FAFC;
            border: 1px solid #CBD5E1;
            padding: 3px;
            border-radius: var(--radius-md);
            flex-wrap: wrap;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            background: #FFFFFF;
            color: var(--text-main);
            text-decoration: none;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 600;
            border: 1px solid var(--border-hover);
            transition: var(--transition);
            flex-shrink: 0;
        }

        .btn-back:hover {
            background: var(--surface-subtle);
            border-color: #94A3B8;
        }

        .page-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .subject-chip {
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.74rem;
            font-weight: 600;
        }

        .code-chip {
            background: var(--surface-subtle);
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.74rem;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
        }

        .header-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary-light);
            border: 1px solid var(--primary-border);
            color: var(--primary);
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            font-size: 0.8rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
        }

        /* Section Navigation */
        .section-quick-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
            align-items: center;
        }

        .section-quick-tab {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            padding: 5px 12px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            text-decoration: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .section-quick-tab:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
        }

        .section-divider-banner {
            grid-column: 1 / -1;
            background: #FFFFFF;
            color: var(--text-main);
            border-radius: var(--radius-md);
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0 2px 0;
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--primary);
            scroll-margin-top: 80px;
        }

        .omr-grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
            gap: 10px;
            width: 100%;
            box-sizing: border-box;
        }

        .omr-key-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 9px 12px;
            transition: border-color 150ms ease, background-color 150ms ease;
            user-select: none;
        }

        .omr-key-row:hover {
            border-color: var(--border-hover);
        }

        .omr-key-row.has-val {
            border-color: var(--primary-border);
            background: #F8FAFF;
        }

        .omr-q-badge {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .omr-q-num {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-body);
            min-width: 34px;
            font-variant-numeric: tabular-nums;
        }

        .omr-key-row.has-val .omr-q-num {
            color: var(--primary-active);
        }

        .omr-selected-val {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            background: var(--surface-subtle);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xs);
            font-weight: 700;
            font-size: 0.8rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .omr-key-row.has-val .omr-selected-val {
            background: var(--primary-light);
            color: var(--primary);
            border-color: var(--primary-border);
        }

        .omr-bubbles-wrap {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .omr-bubble {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 1.5px solid #CBD5E1;
            background: #FFFFFF;
            color: var(--text-body);
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, scale 120ms ease-out;
            padding: 0;
            touch-action: manipulation;
        }

        .omr-bubble:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
        }

        .omr-bubble.selected {
            background: var(--primary);
            border-color: var(--primary);
            color: #FFFFFF;
        }

        .omr-bubble.selected:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            color: #FFFFFF;
        }

        .omr-bubble:active {
            scale: 0.93;
        }

        /* Clean Light Floating Action Bar */
        .floating-action-bar {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FFFFFF;
            border: 1px solid var(--border-hover);
            padding: 8px 14px;
            border-radius: var(--radius-full);
            box-shadow: var(--shadow-xl);
            z-index: 100;
            width: auto;
            max-width: calc(100% - 24px);
        }

        .floating-counter {
            color: var(--text-muted);
            font-size: 0.82rem;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            padding: 0 8px;
            white-space: nowrap;
        }

        .floating-counter span {
            color: var(--primary);
            font-weight: 700;
        }

        .btn-floating-clear {
            background: #FFFFFF;
            border: 1px solid var(--danger-border);
            color: var(--danger);
            padding: 8px 14px;
            border-radius: var(--radius-full);
            font-size: 0.825rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition);
            white-space: nowrap;
            font-family: 'Inter', sans-serif;
        }

        .btn-floating-clear:hover {
            background: var(--danger-light);
            border-color: #FCA5A5;
        }

        .btn-floating-save {
            background: var(--primary);
            border: 1px solid var(--primary);
            color: #FFFFFF;
            padding: 9px 20px;
            border-radius: var(--radius-full);
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: var(--transition), scale 120ms ease-out;
            white-space: nowrap;
            font-family: 'Inter', sans-serif;
        }

        .btn-floating-save:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
        }

        .btn-floating-save:active {
            scale: 0.98;
        }

        /* Mobile Optimization */
        @media (max-width: 959px) {
            .slim-top-bar {
                position: static;
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }
            .topbar-actions-group {
                width: 100%;
                justify-content: flex-start;
            }
        }

        @media (max-width: 640px) {
            .full-screen-container {
                padding: 10px 10px 92px 10px;
            }

            .slim-top-bar {
                padding: 10px 12px;
                margin-bottom: 10px;
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .page-title {
                font-size: 0.95rem;
                max-width: 100%;
            }

            .topbar-actions-group {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .jee-tools-pill {
                width: 100%;
                display: flex;
                justify-content: space-between;
                gap: 4px;
            }

            .jee-tools-pill .btn {
                flex: 1;
                justify-content: center;
                padding: 6px 4px;
                font-size: 0.74rem;
            }

            .btn-back span {
                display: none;
            }

            .btn-back {
                padding: 6px 8px;
            }

            .omr-grid-container {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .omr-key-row {
                padding: 8px 10px;
            }

            .floating-action-bar {
                bottom: 12px;
                padding: 8px 10px;
                gap: 8px;
                width: calc(100% - 16px);
                justify-content: space-between;
            }

            .floating-counter {
                display: none;
            }

            .btn-floating-clear {
                padding: 9px 12px;
                font-size: 0.82rem;
                flex: 1;
                justify-content: center;
            }

            .btn-floating-save {
                padding: 9px 14px;
                font-size: 0.86rem;
                flex: 1.4;
                justify-content: center;
            }
        }

        @media (max-width: 360px) {
            .omr-bubble {
                width: 31px;
                height: 31px;
                font-size: 0.8rem;
            }
            .omr-bubbles-wrap { gap: 4px; }
            .omr-q-num { min-width: 28px; font-size: 0.85rem; }
        }

        @media (min-width: 641px) {
            .omr-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
                gap: 12px;
            }
        }

        @media (min-width: 960px) {
            .floating-action-bar {
                left: calc(50% + (var(--sidebar-width) / 2));
                max-width: calc(100% - var(--sidebar-width) - 32px);
            }
        }
    </style>
</head>
<body>
    <%- include('partials/sidebar_start', { activeNav: 'paper_key', paper: paper }) %>
    <%
        const totalQ = paper.total_questions || paper.numQuestions || 50;
        const encodedId = encodeURIComponent(paper._id);
        let keyCount = 0;
        if (Array.isArray(paper.answer_key) && paper.answer_key.length > 0) {
            paper.answer_key.forEach(k => { if(k) keyCount++; });
        } else if (paper.answerKey) {
            if (typeof paper.answerKey.get === 'function') {
                for(let i = 1; i <= totalQ; i++) {
                    if(paper.answerKey.get(String(i))) keyCount++;
                }
            } else {
                Object.keys(paper.answerKey).forEach(k => { if(paper.answerKey[k]) keyCount++; });
            }
        }
    %>

    <div class="full-screen-container">
        <header class="slim-top-bar">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: wrap;">
                <h1 class="page-title"><%= paper.title %></h1>
                <% if (paper.subject) { %>
                    <span class="subject-chip"><%= paper.subject %></span>
                <% } %>
                <% if (paper._id) { %>
                    <span class="code-chip"><%= paper._id %></span>
                <% } %>
            </div>
            <div class="topbar-actions-group">
                <div class="jee-tools-pill">
                    <a href="/paper/<%= encodedId %>/jee-answerkey" class="btn btn-secondary btn-sm" style="background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE; font-weight:700; padding:5px 10px; font-size:0.8rem; white-space:nowrap;" title="Configure JEE Mains Answer Key (Only Q1-20, Q26-45, Q51-70)">
                        ⚛️ JEE Key
                    </a>
                    <a href="/paper/<%= encodedId %>/jee-scan" class="btn btn-secondary btn-sm" style="background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE; font-weight:600; padding:5px 10px; font-size:0.8rem; white-space:nowrap;" title="Launch JEE Mains Camera Scanner">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        JEE Scan
                    </a>
                    <a href="/paper/<%= encodedId %>/jee-evaluator" class="btn btn-secondary btn-sm" style="background:#F0FDF4; color:#15803D; border-color:#BBF7D0; font-weight:600; padding:5px 10px; font-size:0.8rem; white-space:nowrap;" title="Upload and evaluate JEE Mains sheet directly">
                        📁 JEE Eval
                    </a>
                </div>
                <a href="/paper/<%= encodedId %>/results" class="btn btn-secondary btn-sm" title="View Paper Results & Checked OMR Copies" style="padding:6px 12px; font-size:0.82rem; white-space:nowrap;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    Results
                </a>
                <div class="header-pill">
                    <span id="headerCounter"><%= keyCount %>/<%= totalQ %></span>
                </div>
            </div>
        </header>

        <% if (paper.sections && paper.sections.length > 0) { %>
            <nav class="section-quick-tabs" aria-label="Jump to section">
                <span style="font-size: 0.76rem; font-weight: 600; color: var(--text-muted); margin-right: 2px;">Sections:</span>
                <% paper.sections.forEach(s => { %>
                    <a href="#sec_<%= s.from_question %>" class="section-quick-tab">
                        <span><%= s.name %></span>
                        <span style="font-family:'JetBrains Mono',monospace; font-size:0.72rem; color: var(--text-muted);">Q<%= s.from_question %>-Q<%= s.to_question %></span>
                    </a>
                <% }) %>
            </nav>
        <% } %>

        <form action="/paper/<%= encodedId %>/answerkey" method="POST" id="answerKeyForm">
            <div class="omr-grid-container" id="answerGrid">
                <% for(let i=1; i<=totalQ; i++) { %>
                    <%
                        const secHeader = (paper.sections && paper.sections.length > 0)
                            ? paper.sections.find(s => s.from_question === i)
                            : null;
                    %>
                    <% if (secHeader) { %>
                        <div class="section-divider-banner" id="sec_<%= secHeader.from_question %>">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <strong style="font-size:0.92rem; color: var(--text-main);"><%= secHeader.name %></strong>
                                <span style="color: var(--text-muted); font-size:0.78rem; font-family:'JetBrains Mono',monospace;">(Q<%= secHeader.from_question %> &ndash; Q<%= secHeader.to_question %>)</span>
                            </div>
                            <div style="font-size:0.78rem; font-family:'JetBrains Mono',monospace; font-weight: 600; color: var(--primary);">
                                <%= secHeader.max_marks || ((secHeader.to_question - secHeader.from_question + 1) * 4) %> Max Marks
                            </div>
                        </div>
                    <% } %>

                    <%
                        let currentVal = "";
                        if (Array.isArray(paper.answer_key) && paper.answer_key.length >= i) {
                            currentVal = paper.answer_key[i - 1] || "";
                        } else if (paper.answerKey) {
                            if (typeof paper.answerKey.get === 'function') {
                                currentVal = paper.answerKey.get(String(i)) || "";
                            } else {
                                currentVal = paper.answerKey[String(i)] || "";
                            }
                        }
                    %>
                    <div class="omr-key-row <%= currentVal ? 'has-val' : '' %>" id="row_q<%= i %>">
                        <div class="omr-q-badge">
                            <span class="omr-q-num">Q<%= i %></span>
                            <span class="omr-selected-val" id="badge_val_q<%= i %>"><%= currentVal || '-' %></span>
                        </div>
                        <div class="omr-bubbles-wrap" role="group" aria-label="Question <%= i %> options">
                            <% ['A','B','C','D'].forEach(opt => { %>
                                <button type="button"
                                        class="omr-bubble <%= currentVal === opt ? 'selected' : '' %>"
                                        id="btn_q<%= i %>_<%= opt %>"
                                        data-q="<%= i %>"
                                        data-opt="<%= opt %>"
                                        onclick="selectAnswer('<%= i %>', '<%= opt %>')"
                                        title="Select <%= opt %> for Question <%= i %>">
                                    <%= opt %>
                                </button>
                            <% }) %>
                        </div>
                        <input type="hidden" name="q<%= i %>" id="input_q<%= i %>" value="<%= currentVal %>">
                    </div>
                <% } %>
            </div>
        </form>

        <div class="floating-action-bar">
            <div class="floating-counter">
                <span id="floatingCounter"><%= keyCount %></span> / <%= totalQ %> Keyed
            </div>
            <button type="button" class="btn-floating-clear" onclick="confirmAndClearAll()" title="Clear all answers">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Clear All
            </button>
            <button type="button" class="btn-floating-save" onclick="confirmAndSaveKey()" title="Save answer key">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                Save Answer Key
            </button>
        </div>
    </div>

    <script>
        const totalQuestions = <%= totalQ %>;

        function selectAnswer(qNum, opt) {
            const input = document.getElementById('input_q' + qNum);
            const row = document.getElementById('row_q' + qNum);
            const badge = document.getElementById('badge_val_q' + qNum);
            if (!input) return;

            if (input.value === opt) {
                input.value = '';
                if (badge) badge.textContent = '-';
                if (row) row.classList.remove('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) btn.classList.remove('selected');
                });
            } else {
                input.value = opt;
                if (badge) badge.textContent = opt;
                if (row) row.classList.add('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) {
                        if (o === opt) btn.classList.add('selected');
                        else btn.classList.remove('selected');
                    }
                });
            }

            updateKeyProgress();
        }

        function updateKeyProgress() {
            let count = 0;
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            inputs.forEach(inp => {
                if (inp.value) count++;
            });
            const headerCounter = document.getElementById('headerCounter');
            const floatingCounter = document.getElementById('floatingCounter');
            if (headerCounter) headerCounter.textContent = count + '/' + totalQuestions;
            if (floatingCounter) floatingCounter.textContent = count;
        }

        function confirmAndClearAll() {
            if (confirm("Are you sure you want to clear all marked answers?")) {
                const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
                inputs.forEach(inp => { inp.value = ""; });
                const rows = document.querySelectorAll('.omr-key-row');
                rows.forEach(r => r.classList.remove('has-val'));
                const badges = document.querySelectorAll('.omr-selected-val');
                badges.forEach(b => b.textContent = '-');
                const bubbles = document.querySelectorAll('.omr-bubble');
                bubbles.forEach(b => b.classList.remove('selected'));
                updateKeyProgress();
            }
        }

        function confirmAndSaveKey() {
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            let filled = 0;
            inputs.forEach(inp => { if (inp.value) filled++; });

            const msg = filled === 0
                ? "No questions have been marked. Do you want to save an empty answer key?"
                : `Save answer key with ${filled} of ${totalQuestions} questions configured?`;

            if (confirm(msg)) {
                document.getElementById('answerKeyForm').submit();
            }
        }
    </script>
    <%- include('partials/sidebar_end') %>
</body>
</html>
