<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title><%= paper.title %> • Answer Key</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            background: var(--bg-gradient);
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .full-screen-container {
            width: 100%;
            max-width: 1360px;
            margin: 0 auto;
            padding: 12px 14px 110px 14px;
            box-sizing: border-box;
        }

        /* Slim Sticky Top Navigation */
        .slim-top-bar {
            position: sticky;
            top: 10px;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: var(--radius-lg);
            padding: 10px 16px;
            margin-bottom: 14px;
            box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.06);
            gap: 12px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 6px 12px;
            background: #F1F5F9;
            color: var(--text-main);
            text-decoration: none;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 700;
            border: 1px solid var(--border-color);
            transition: var(--transition);
            flex-shrink: 0;
        }

        .btn-back:hover {
            background: #E2E8F0;
            transform: translateX(-2px);
        }

        .page-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            letter-spacing: -0.02em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .header-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(79, 70, 229, 0.08);
            border: 1px solid rgba(79, 70, 229, 0.2);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
        }

        /* Full Space Answer Key Matrix Grid */
        .omr-grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
            gap: 12px;
            width: 100%;
            box-sizing: border-box;
        }

        .omr-key-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #FFFFFF;
            border: 1.5px solid #E2E8F0;
            border-radius: var(--radius-md);
            padding: 10px 14px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            user-select: none;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
        }

        .omr-key-row:hover {
            border-color: #CBD5E1;
            transform: translateY(-1.5px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

        .omr-key-row.has-val {
            border-color: rgba(79, 70, 229, 0.45);
            background: linear-gradient(90deg, #F5F3FF 0%, #FFFFFF 100%);
            box-shadow: 0 2px 8px rgba(79, 70, 229, 0.08);
        }

        .omr-q-badge {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .omr-q-num {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.95rem;
            color: #334155;
            min-width: 36px;
        }

        .omr-key-row.has-val .omr-q-num {
            color: var(--primary);
        }

        .omr-selected-val {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            background: #F1F5F9;
            color: #64748B;
            border-radius: 7px;
            font-weight: 800;
            font-size: 0.82rem;
            font-family: 'JetBrains Mono', monospace;
            transition: all 0.2s ease;
        }

        .omr-key-row.has-val .omr-selected-val {
            background: #EEF2FF;
            color: var(--primary);
            border: 1px solid rgba(79, 70, 229, 0.3);
        }

        .omr-bubbles-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .omr-bubble {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid #CBD5E1;
            background: #FFFFFF;
            color: #334155;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
            outline: none;
            padding: 0;
            position: relative;
            touch-action: manipulation;
        }

        .omr-bubble:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: scale(1.08);
            box-shadow: 0 2px 10px rgba(79, 70, 229, 0.25);
        }

        .omr-bubble.selected {
            background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%);
            border-color: #3730A3;
            color: #FFFFFF;
            transform: scale(1.06);
            box-shadow: 0 4px 14px rgba(79, 70, 229, 0.45);
        }

        .omr-bubble:active {
            transform: scale(0.92);
        }

        /* Floating Action Bar (FAB Dock) */
        .floating-action-bar {
            position: fixed;
            bottom: 22px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 10px 18px;
            border-radius: var(--radius-full);
            box-shadow: 0 16px 36px -6px rgba(15, 23, 42, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
            z-index: 100;
            width: auto;
            max-width: calc(100% - 24px);
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateX(-50%) translateY(20px); }
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        .floating-counter {
            color: #94A3B8;
            font-size: 0.82rem;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            padding: 0 6px;
            white-space: nowrap;
        }

        .floating-counter span {
            color: #38BDF8;
        }

        .btn-floating-clear {
            background: rgba(239, 68, 68, 0.16);
            border: 1px solid rgba(239, 68, 68, 0.45);
            color: #FCA5A5;
            padding: 9px 16px;
            border-radius: var(--radius-full);
            font-size: 0.84rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            white-space: nowrap;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .btn-floating-clear:hover {
            background: rgba(239, 68, 68, 0.35);
            color: #FFFFFF;
            border-color: #EF4444;
            transform: translateY(-1px);
        }

        .btn-floating-save {
            background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
            padding: 10px 22px;
            border-radius: var(--radius-full);
            font-size: 0.92rem;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 6px 20px -2px rgba(79, 70, 229, 0.5);
            transition: all 0.2s ease;
            white-space: nowrap;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .btn-floating-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -2px rgba(6, 182, 212, 0.6);
        }

        /* Mobile Phone Optimization: Use ENTIRE Space */
        @media (max-width: 640px) {
            .full-screen-container {
                padding: 8px 6px 95px 6px;
            }

            .slim-top-bar {
                top: 6px;
                padding: 8px 10px;
                margin-bottom: 10px;
                border-radius: 12px;
            }

            .page-title {
                font-size: 0.95rem;
                max-width: 140px;
            }

            .btn-back span {
                display: none;
            }

            .btn-back {
                padding: 6px 8px;
            }

            .header-pill {
                padding: 3px 8px;
                font-size: 0.75rem;
            }

            .omr-grid-container {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .omr-key-row {
                padding: 8px 10px;
                border-radius: 10px;
            }

            .omr-bubble {
                width: 36px;
                height: 36px;
                font-size: 0.88rem;
            }

            .omr-bubbles-wrap {
                gap: 6px;
            }

            .floating-action-bar {
                bottom: 12px;
                padding: 8px 12px;
                gap: 8px;
                width: calc(100% - 16px);
                justify-content: space-between;
                box-sizing: border-box;
            }

            .floating-counter {
                display: none;
            }

            .btn-floating-clear {
                padding: 10px 12px;
                font-size: 0.8rem;
                flex: 1;
                justify-content: center;
            }

            .btn-floating-save {
                padding: 10px 16px;
                font-size: 0.88rem;
                flex: 1.4;
                justify-content: center;
            }
        }

        @media (max-width: 360px) {
            .omr-bubble {
                width: 32px;
                height: 32px;
                font-size: 0.8rem;
            }
            .omr-bubbles-wrap {
                gap: 4px;
            }
            .omr-q-num {
                min-width: 28px;
                font-size: 0.85rem;
            }
        }

        /* Large Screen Optimizations */
        @media (min-width: 1200px) {
            .omr-grid-container {
                grid-template-columns: repeat(4, 1fr);
                gap: 14px;
            }
        }

        @media (min-width: 1440px) {
            .omr-grid-container {
                grid-template-columns: repeat(5, 1fr);
                gap: 14px;
            }
        }
    </style>
</head>
<body>
    <% 
        let keyCount = 0;
        if (paper.answerKey) {
            if (typeof paper.answerKey.get === 'function') {
                for(let i = 1; i <= paper.numQuestions; i++) {
                    if(paper.answerKey.get(String(i))) keyCount++;
                }
            } else {
                Object.keys(paper.answerKey).forEach(k => { if(paper.answerKey[k]) keyCount++; });
            }
        }
    %>

    <div class="full-screen-container">
        <!-- Slim Sticky Top Bar -->
        <header class="slim-top-bar">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                <a href="/" class="btn-back" title="Back to Dashboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Dashboard</span>
                </a>
                <h1 class="page-title"><%= paper.title %></h1>
            </div>
            <div class="header-pill">
                <span id="headerCounter"><%= keyCount %>/<%= paper.numQuestions %></span>
            </div>
        </header>

        <!-- Form wrapping the Answer Key Matrix -->
        <form action="/paper/<%= paper._id %>/answerkey" method="POST" id="answerKeyForm">
            <div class="omr-grid-container" id="answerGrid">
                <% for(let i=1; i<=paper.numQuestions; i++) { %>
                    <% 
                        let currentVal = "";
                        if (paper.answerKey) {
                            if (typeof paper.answerKey.get === 'function') {
                                currentVal = paper.answerKey.get(String(i)) || "";
                            } else {
                                currentVal = paper.answerKey[String(i)] || "";
                            }
                        }
                    %>
                    <div class="omr-key-row <%= currentVal ? 'has-val' : '' %>" id="row_q<%= i %>">
                        <div class="omr-q-badge">
                            <span class="omr-q-num">Q<%= i %></span>
                            <span class="omr-selected-val" id="badge_val_q<%= i %>"><%= currentVal || '-' %></span>
                        </div>
                        <div class="omr-bubbles-wrap" role="group" aria-label="Question <%= i %> options">
                            <% ['A','B','C','D'].forEach(opt => { %>
                                <button type="button" 
                                        class="omr-bubble <%= currentVal === opt ? 'selected' : '' %>" 
                                        id="btn_q<%= i %>_<%= opt %>"
                                        data-q="<%= i %>" 
                                        data-opt="<%= opt %>"
                                        onclick="selectAnswer('<%= i %>', '<%= opt %>')"
                                        title="Select <%= opt %> for Question <%= i %>">
                                    <%= opt %>
                                </button>
                            <% }) %>
                        </div>
                        <input type="hidden" name="q<%= i %>" id="input_q<%= i %>" value="<%= currentVal %>">
                    </div>
                <% } %>
            </div>
        </form>

        <!-- Floating Action Dock (Clear All with confirmation & Save Key with confirmation) -->
        <div class="floating-action-bar">
            <div class="floating-counter">
                <span id="floatingCounter"><%= keyCount %></span> / <%= paper.numQuestions %> Keyed
            </div>
            <button type="button" class="btn-floating-clear" onclick="confirmAndClearAll()" title="Clear all answers with confirmation">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                Clear All
            </button>
            <button type="button" class="btn-floating-save" onclick="confirmAndSaveKey()" title="Save answer key with confirmation">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save Answer Key
            </button>
        </div>
    </div>

    <script>
        const totalQuestions = <%= paper.numQuestions %>;

        function selectAnswer(qNum, opt) {
            const input = document.getElementById('input_q' + qNum);
            const row = document.getElementById('row_q' + qNum);
            const badge = document.getElementById('badge_val_q' + qNum);
            if (!input) return;

            if (input.value === opt) {
                input.value = '';
                if (badge) badge.textContent = '-';
                if (row) row.classList.remove('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) btn.classList.remove('selected');
                });
            } else {
                input.value = opt;
                if (badge) badge.textContent = opt;
                if (row) row.classList.add('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) {
                        if (o === opt) btn.classList.add('selected');
                        else btn.classList.remove('selected');
                    }
                });
            }

            updateKeyProgress();
        }

        function updateKeyProgress() {
            let count = 0;
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            inputs.forEach(inp => {
                if (inp.value) count++;
            });
            const headerCounter = document.getElementById('headerCounter');
            const floatingCounter = document.getElementById('floatingCounter');
            if (headerCounter) headerCounter.textContent = count + '/' + totalQuestions;
            if (floatingCounter) floatingCounter.textContent = count;
        }

        function confirmAndClearAll() {
            if (confirm("Are you sure you want to clear all marked answers?")) {
                const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
                inputs.forEach(inp => {
                    inp.value = "";
                });
                const rows = document.querySelectorAll('.omr-key-row');
                rows.forEach(r => r.classList.remove('has-val'));
                const badges = document.querySelectorAll('.omr-selected-val');
                badges.forEach(b => b.textContent = '-');
                const bubbles = document.querySelectorAll('.omr-bubble');
                bubbles.forEach(b => b.classList.remove('selected'));
                updateKeyProgress();
            }
        }

        function confirmAndSaveKey() {
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            let filled = 0;
            inputs.forEach(inp => { if (inp.value) filled++; });

            const msg = filled === 0
                ? "No questions have been marked. Do you want to save an empty answer key?"
                : `Save answer key with ${filled} of ${totalQuestions} questions configured?`;

            if (confirm(msg)) {
                document.getElementById('answerKeyForm').submit();
            }
        }
    </script>
</body>
</html>