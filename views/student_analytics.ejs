<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Performance Analytics & Marks Charts • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .analytics-container {
            margin: 0 auto;
            padding: 1.5rem 1.25rem 4rem 1.25rem;
        }

        /* Top Header & Breadcrumbs */
        .analytics-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 1.25rem;
        }

        .btn-back-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #FFFFFF;
            border: 1.5px solid var(--border-color);
            color: #334155;
            padding: 7px 15px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 130ms ease;
            box-shadow: var(--shadow-xs);
        }

        .btn-back-dashboard:hover {
            background: #EFF6FF;
            border-color: #93C5FD;
            color: #1D4ED8;
            transform: translateY(-1px);
        }

        /* Profile & Summary Strip */
        .analytics-profile-banner {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-xs);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .analytics-student-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .analytics-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            color: #FFFFFF;
            font-size: 1.35rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
            flex-shrink: 0;
        }

        .analytics-name-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .analytics-student-name {
            font-size: 1.35rem;
            font-weight: 800;
            color: #0F172A;
            margin: 0;
            letter-spacing: -0.02em;
        }

        .roll-pill {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 999px;
            background: #EFF6FF;
            color: #1E40AF;
            border: 1px solid #BFDBFE;
            font-size: 0.78rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .role-pill {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            background: #F1F5F9;
            color: #475569;
            border: 1px solid #E2E8F0;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* Folder Filter Tabs */
        .analytics-folder-section {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-xs);
        }

        .folder-tabs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.85rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .folder-tabs-title {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 800;
            color: #0F172A;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .folder-pills-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
            -webkit-overflow-scrolling: touch;
        }

        .folder-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            border-radius: 999px;
            background: #F8FAFC;
            color: #475569;
            border: 1.5px solid #E2E8F0;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            font-family: inherit;
            transition: all 130ms ease;
        }

        .folder-pill-btn:hover {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            transform: translateY(-1px);
        }

        .folder-pill-btn.active {
            background: #2563EB;
            color: #FFFFFF;
            border-color: #2563EB;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.28);
        }

        .folder-pill-count {
            display: inline-flex;
            align-items: center;
            padding: 1px 7px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.08);
            font-size: 0.72rem;
            font-weight: 700;
        }

        .folder-pill-btn.active .folder-pill-count {
            background: rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
        }

        /* Dedicated Chart Card */
        .chart-main-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.75rem;
            box-shadow: var(--shadow-xs);
        }

        .cmc-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            padding-bottom: 1rem;
            border-bottom: 1px solid #F1F5F9;
        }

        .cmc-title-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .cmc-icon-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #EFF6FF;
            color: #2563EB;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #DBEAFE;
            flex-shrink: 0;
        }

        .cmc-title {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.01em;
        }

        .cmc-folder-badge {
            display: inline-flex;
            align-items: center;
            background: #EFF6FF;
            color: #1E40AF;
            border: 1px solid #BFDBFE;
            padding: 2px 9px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .cmc-subtitle {
            margin: 2px 0 0 0;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .cmc-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .cmc-mode-group {
            display: inline-flex;
            background: #F1F5F9;
            padding: 3px;
            border-radius: 10px;
            border: 1px solid #E2E8F0;
        }

        .cmc-mode-btn {
            border: none;
            background: transparent;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #64748B;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
            transition: all 130ms ease;
            white-space: nowrap;
        }

        .cmc-mode-btn.active {
            background: #FFFFFF;
            color: #2563EB;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
            font-weight: 700;
        }

        /* Stats Strip */
        .cmc-stats-strip {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0.85rem 1.15rem;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            margin: 1.15rem 0 0.85rem 0;
            flex-wrap: wrap;
        }

        .cmc-mini-stat {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 95px;
            flex: 1;
        }

        .cms-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .cms-value {
            font-size: 1.05rem;
            font-weight: 800;
            color: #0F172A;
            font-variant-numeric: tabular-nums;
        }

        /* Subject Filter Chips */
        .cmc-subject-chips-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin: 0.85rem 0 0.65rem 0;
            padding: 4px 0;
        }

        .cmc-chips-label {
            font-size: 0.76rem;
            font-weight: 700;
            color: #475569;
        }

        .cmc-chips-container {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }

        .cmc-subject-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 11px;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 600;
            border: 1.5px solid;
            cursor: pointer;
            user-select: none;
            transition: all 130ms ease;
            font-family: inherit;
        }

        .cmc-subject-chip:hover {
            transform: translateY(-1px);
        }

        .cmc-subject-chip.inactive {
            opacity: 0.35;
            background: #F1F5F9 !important;
            border-color: #CBD5E1 !important;
            color: #64748B !important;
            text-decoration: line-through;
        }

        /* Canvas Wrapper */
        .cmc-canvas-wrapper {
            position: relative;
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            min-height: 270px;
            background: #FFFFFF;
            border-radius: 10px;
            padding: 8px 0;
        }

        .cmc-chart-svg-container {
            width: 100%;
        }

        .cmc-tooltip {
            position: absolute;
            z-index: 50;
            background: #0F172A;
            color: #FFFFFF;
            padding: 9px 13px;
            border-radius: 8px;
            font-size: 0.78rem;
            pointer-events: none;
            box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.12);
            min-width: 190px;
            max-width: 300px;
            line-height: 1.45;
            transition: opacity 0.12s ease;
        }

        .cmc-empty-state {
            padding: 3rem 1rem;
            text-align: center;
            color: #64748B;
            font-size: 0.92rem;
        }

        .cmc-point-target {
            cursor: pointer;
        }

        .cmc-point-target:hover circle.marker-dot {
            r: 7.5px;
            stroke-width: 3.5px;
        }

        /* Performance Breakdown Table Section */
        .breakdown-table-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow-xs);
        }

        .btc-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 1rem;
        }

        .btc-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 800;
            color: #0F172A;
        }

        .table-responsive-box {
            overflow-x: auto;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
        }

        .table-analytics {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.84rem;
            text-align: left;
            font-variant-numeric: tabular-nums;
        }

        .table-analytics thead th {
            background: #F8FAFC;
            padding: 10px 12px;
            font-weight: 700;
            color: #475569;
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--border-color);
        }

        .table-analytics tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid #F1F5F9;
            vertical-align: middle;
        }

        .table-analytics tbody tr:hover {
            background: #F8FAFC;
        }

        .table-analytics tbody tr:last-child td {
            border-bottom: none;
        }

        .pill-acc-high {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            background: #F0FDF4;
            color: #15803D;
            border: 1px solid #BBF7D0;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .pill-acc-mid {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            background: #FFFBEB;
            color: #B45309;
            border: 1px solid #FDE68A;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .pill-acc-low {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            background: #FEF2F2;
            color: #B91C1C;
            border: 1px solid #FECACA;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .rank-medal-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 8px;
            border-radius: 999px;
            background: #FFFBEB;
            color: #B45309;
            border: 1px solid #FDE68A;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .btn-view-omr-sm {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
            padding: 5px 11px;
            border-radius: var(--radius-xs);
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 120ms ease;
            font-family: inherit;
        }

        .btn-view-omr-sm:hover {
            background: #DBEAFE;
            color: #1E40AF;
        }

        /* OMR Inspection Dialog */
        #studentOmrModal {
            border: none;
            border-radius: var(--radius-lg);
            padding: 0;
            width: min(94vw, 1150px);
            max-height: 92vh;
            background: #FFFFFF;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        #studentOmrModal::backdrop {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
        }

        .filter-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.74rem;
            font-weight: 600;
            background: #F1F5F9;
            border: 1px solid #CBD5E1;
            color: #475569;
            cursor: pointer;
            transition: all 120ms ease;
            font-family: inherit;
        }

        .filter-pill.active {
            background: #2563EB;
            color: #FFFFFF;
            border-color: #2563EB;
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'student_analytics' }) %>

        <% 
            const totalExams = (results && Array.isArray(results)) ? results.length : 0;
            let sumAccuracy = 0;
            let bestScore = 0;
            let bestTotal = 0;
            let bestRank = Infinity;
            let bestRankTotal = 0;
            if (totalExams > 0) {
                results.forEach(item => {
                    sumAccuracy += (Number(item.percentage) || 0);
                    const sumSec = item.allSectionsSummary || {};
                    const obMarks = sumSec.obtainedMarks !== undefined ? sumSec.obtainedMarks : ((item.aggregateMarks !== undefined) ? item.aggregateMarks : (item.score * 4));
                    const totMarks = sumSec.totalMarks !== undefined ? sumSec.totalMarks : (item.maxMarks || ((item.totalQuestions || 50) * 4));
                    if (obMarks > bestScore) {
                        bestScore = obMarks;
                        bestTotal = totMarks;
                    }
                    if (item.rank && Number(item.rank) > 0) {
                        if (Number(item.rank) < bestRank) {
                            bestRank = Number(item.rank);
                            bestRankTotal = item.totalCandidates || 0;
                        }
                    }
                });
            }
            const avgAccuracy = totalExams > 0 ? (sumAccuracy / totalExams).toFixed(0) : 0;
        %>

        <div class="analytics-container">
            <!-- Top Bar with Back Button -->
            <div class="analytics-top-bar">
                <a href="/student" class="btn-back-dashboard">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    <span>Back to My Tests</span>
                </a>
                <div style="font-size: 0.82rem; color: var(--text-muted); font-weight: 500;">
                    Student Portal &bull; Performance Visualizer
                </div>
            </div>

            <!-- Profile Summary Ribbon -->
            <header class="analytics-profile-banner">
                <div class="analytics-student-info">
                    <div class="analytics-avatar" aria-hidden="true">
                        <%= (currentUser.fullName || currentUser.username || 'S')[0].toUpperCase() %>
                    </div>
                    <div>
                        <div class="analytics-name-row">
                            <h1 class="analytics-student-name">
                                <%= currentUser.fullName || currentUser.username %>
                            </h1>
                            <% if (targetRoll) { %>
                                <span class="roll-pill">Roll: <%= targetRoll %></span>
                            <% } %>
                            <span class="role-pill">
                                <%= (currentUser.role || 'student').toUpperCase() %>
                            </span>
                        </div>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 3px;">
                            Academic Performance & Marks Trajectory Analytics
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Total Evaluated</span>
                        <span style="font-size: 1.15rem; font-weight: 800; color: #0F172A;"><%= totalExams %> Tests</span>
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Overall Accuracy</span>
                        <span style="font-size: 1.15rem; font-weight: 800; color: #059669;"><%= avgAccuracy %>%</span>
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Top Marks</span>
                        <span style="font-size: 1.15rem; font-weight: 800; color: #2563EB;"><%= bestScore %> <small style="font-size: 0.78rem; color: #94A3B8;">/ <%= bestTotal || 300 %></small></span>
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Best Rank</span>
                        <span style="font-size: 1.15rem; font-weight: 800; color: #D97706;"><%= bestRank !== Infinity ? '#' + bestRank : '--' %></span>
                    </div>
                </div>
            </header>

            <!-- Folder Filter Ribbon (Only folders where student took tests) -->
            <section class="analytics-folder-section">
                <div class="folder-tabs-header">
                    <h2 class="folder-tabs-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        Filter by Folder / Batch:
                    </h2>
                    <span style="font-size: 0.78rem; color: var(--text-muted);">
                        Only showing folders where you have completed tests
                    </span>
                </div>

                <div class="folder-pills-bar">
                    <!-- All Tests Pill -->
                    <button type="button" class="folder-pill-btn <%= (!activeFolder || activeFolder === 'all') ? 'active' : '' %>" onclick="selectAnalyticsFolder('all')" data-folder="all">
                        <span>All Evaluated Tests</span>
                        <span class="folder-pill-count"><%= totalExams %></span>
                    </button>

                    <!-- User-scoped Folders -->
                    <% if (typeof folders !== 'undefined' && folders.length > 0) { %>
                        <% folders.forEach(f => { %>
                            <button type="button" class="folder-pill-btn <%= (activeFolder && activeFolder.toLowerCase() === f.name.toLowerCase()) ? 'active' : '' %>" onclick="selectAnalyticsFolder('<%= f.name.replace(/'/g, "\\'") %>')" data-folder="<%= f.name.toLowerCase() %>">
                                <span><%= f.name %></span>
                                <span class="folder-pill-count"><%= f.count || 0 %></span>
                            </button>
                        <% }) %>
                    <% } %>
                </div>
            </section>

            <!-- Dedicated Performance Chart Card -->
            <section class="chart-main-card">
                <div class="cmc-header">
                    <div class="cmc-title-group">
                        <div class="cmc-icon-avatar">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <h2 class="cmc-title">Performance & Marks Trends</h2>
                                <span class="cmc-folder-tag" id="cmcFolderBadge"><%= (!activeFolder || activeFolder === 'all') ? 'All Tests' : activeFolder %></span>
                            </div>
                            <p class="cmc-subtitle">Marks trajectory and accuracy progression over time</p>
                        </div>
                    </div>

                    <div class="cmc-controls">
                        <!-- Mode Selector -->
                        <div class="cmc-mode-group" role="tablist" aria-label="Chart Mode">
                            <button type="button" class="cmc-mode-btn active" id="btnCmcOverall" onclick="switchAnalyticsMode('overall')" role="tab" aria-selected="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                                </svg>
                                Overall Marks
                            </button>
                            <button type="button" class="cmc-mode-btn" id="btnCmcSubject" onclick="switchAnalyticsMode('subject')" role="tab" aria-selected="false">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                Subject / Section-wise
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Stats Ribbon for this Folder -->
                <div class="cmc-stats-strip" id="cmcStatsStrip">
                    <div class="cmc-mini-stat">
                        <span class="cms-label">Tests Plotted</span>
                        <span class="cms-value" id="cmcStatTestsCount">0</span>
                    </div>
                    <div class="cmc-mini-stat">
                        <span class="cms-label">Folder Average</span>
                        <span class="cms-value" id="cmcStatAvgScore">--</span>
                    </div>
                    <div class="cmc-mini-stat">
                        <span class="cms-label">Highest Score</span>
                        <span class="cms-value" id="cmcStatHighScore" style="color: #059669;">--</span>
                    </div>
                    <div class="cmc-mini-stat">
                        <span class="cms-label">Best Rank</span>
                        <span class="cms-value" id="cmcStatBestRank" style="color: #D97706;">--</span>
                    </div>
                    <div class="cmc-mini-stat">
                        <span class="cms-label">Recent Trend</span>
                        <span class="cms-value" id="cmcStatTrend">--</span>
                    </div>
                </div>

                <!-- Subject Filter Chips (Shown in Subject mode) -->
                <div class="cmc-subject-chips-bar" id="cmcSubjectChipsBar" style="display: none;">
                    <span class="cmc-chips-label">Toggle Subjects:</span>
                    <div class="cmc-chips-container" id="cmcSubjectChipsList"></div>
                </div>

                <!-- SVG Canvas Container -->
                <div class="cmc-canvas-wrapper" id="cmcCanvasWrapper">
                    <div id="cmcChartSvgContainer" class="cmc-chart-svg-container"></div>
                    <div id="cmcChartTooltip" class="cmc-tooltip" style="display: none;"></div>
                </div>

                <!-- Empty State -->
                <div id="cmcEmptyState" class="cmc-empty-state" style="display: none;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    <p style="margin: 8px 0 0 0; font-weight: 500;">No evaluated tests in this folder to display performance curves.</p>
                </div>
            </section>

            <!-- Test-by-Test Performance Breakdown Table -->
            <section class="breakdown-table-card">
                <div class="btc-header">
                    <h3 class="btc-title">Tests in this Selection</h3>
                    <span style="font-size: 0.78rem; color: var(--text-muted);" id="btcCountLabel">0 Tests</span>
                </div>

                <div class="table-responsive-box">
                    <table class="table-analytics">
                        <thead>
                            <tr>
                                <th>Test Title & Subject</th>
                                <th>Folder / Batch</th>
                                <th>Exam Date</th>
                                <th>Score & Accuracy</th>
                                <th>Rank</th>
                                <th>Section Breakdown</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="analyticsTableBody">
                            <!-- Injected dynamically by client JS -->
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- Student Evaluated OMR & Question Breakdown Dialog -->
        <dialog id="studentOmrModal">
            <div style="display: flex; flex-direction: column; max-height: 92vh;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); background: #F8FAFC;">
                    <div>
                        <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #0F172A;" id="modalPaperTitle">Evaluated OMR Sheet</h3>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 3px;" id="modalPaperSubtitle"></div>
                    </div>
                    <button type="button" onclick="closeStudentOmrModal()" style="background: none; border: none; font-size: 1.5rem; color: #64748B; cursor: pointer; line-height: 1; padding: 4px;">&times;</button>
                </div>

                <div style="padding: 1.25rem 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 16px;">
                    <!-- Scanned Image Area -->
                    <div id="modalImageContainer" style="display: none; background: #0F172A; border-radius: var(--radius-md); padding: 8px; text-align: center;">
                        <img id="modalScannedImg" src="" alt="Evaluated OMR Scan" style="max-width: 100%; max-height: 480px; object-fit: contain; border-radius: 4px;">
                    </div>

                    <!-- Question-by-Question Breakdown -->
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                            <h4 style="margin: 0; font-size: 0.94rem; font-weight: 700; color: #0F172A;">Detailed Answer Breakdown</h4>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" class="filter-pill active" data-filter="all" onclick="filterModalBreakdown('all')">All (<span id="filterCountAll">0</span>)</button>
                                <button type="button" class="filter-pill" data-filter="correct" onclick="filterModalBreakdown('correct')">Correct (<span id="filterCountCorrect">0</span>)</button>
                                <button type="button" class="filter-pill" data-filter="wrong" onclick="filterModalBreakdown('wrong')">Wrong (<span id="filterCountWrong">0</span>)</button>
                                <button type="button" class="filter-pill" data-filter="blank" onclick="filterModalBreakdown('blank')">Blank (<span id="filterCountBlank">0</span>)</button>
                            </div>
                        </div>

                        <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #FFFFFF;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 0.825rem; text-align: center; font-variant-numeric: tabular-nums;">
                                <thead>
                                    <tr style="background: #F1F5F9; border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 1; color: var(--text-muted); font-size: 0.72rem; text-transform: uppercase;">
                                        <th style="padding: 8px;">Q#</th>
                                        <th style="padding: 8px;">Subject</th>
                                        <th style="padding: 8px;">Marked</th>
                                        <th style="padding: 8px;">Official Key</th>
                                        <th style="padding: 8px;">Marks</th>
                                        <th style="padding: 8px;">Verdict</th>
                                    </tr>
                                </thead>
                                <tbody id="modalBreakdownBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </dialog>

        <script>
            const studentSubmissions = <%- JSON.stringify(results || []).replace(/</g, '\\u003c') %>;
            const paperTopperStats = <%- JSON.stringify(typeof paperTopperStats !== 'undefined' ? paperTopperStats : {}).replace(/</g, '\\u003c') %>;
            const submissionsById = {};
            studentSubmissions.forEach(s => {
                if (s && s._id) submissionsById[String(s._id)] = s;
            });

            let activeFolder = '<%- (typeof activeFolder !== "undefined" && activeFolder) ? activeFolder.replace(/'/g, "\\'") : "all" %>';
            let currentMode = 'overall'; // 'overall' or 'subject'
            const activeSubjectFilters = new Set();

            function selectAnalyticsFolder(folderName, updateHistory = true) {
                activeFolder = folderName || 'all';

                // Update active pill styling
                document.querySelectorAll('.folder-pill-btn').forEach(btn => {
                    const btnF = btn.getAttribute('data-folder');
                    btn.classList.toggle('active', btnF === activeFolder.toLowerCase());
                });

                const badge = document.getElementById('cmcFolderBadge');
                if (badge) {
                    badge.textContent = (activeFolder === 'all') ? 'All Tests' : activeFolder;
                }

                if (updateHistory) {
                    const url = new URL(window.location.href);
                    if (activeFolder === 'all') {
                        url.searchParams.delete('folder');
                    } else {
                        url.searchParams.set('folder', activeFolder);
                    }
                    window.history.pushState({ folder: activeFolder }, '', url.toString());
                }

                renderAnalyticsPage();
            }

            function switchAnalyticsMode(mode) {
                if (currentMode === mode) return;
                currentMode = mode;
                const btnOverall = document.getElementById('btnCmcOverall');
                const btnSubject = document.getElementById('btnCmcSubject');
                if (btnOverall) {
                    btnOverall.classList.toggle('active', mode === 'overall');
                    btnOverall.setAttribute('aria-selected', mode === 'overall');
                }
                if (btnSubject) {
                    btnSubject.classList.toggle('active', mode === 'subject');
                    btnSubject.setAttribute('aria-selected', mode === 'subject');
                }

                const chipsBar = document.getElementById('cmcSubjectChipsBar');
                if (chipsBar) chipsBar.style.display = (mode === 'subject') ? 'flex' : 'none';

                renderAnalyticsPage();
            }

            function toggleSubjectFilter(secName) {
                if (activeSubjectFilters.has(secName)) {
                    activeSubjectFilters.delete(secName);
                } else {
                    activeSubjectFilters.add(secName);
                }
                renderAnalyticsPage();
            }

            function getSubjectColor(subjName, index = 0) {
                const s = (subjName || '').toLowerCase().trim();
                if (s.includes('physic')) return { stroke: '#2563EB', fill: '#EFF6FF' };
                if (s.includes('chem')) return { stroke: '#059669', fill: '#ECFDF5' };
                if (s.includes('math')) return { stroke: '#7C3AED', fill: '#F5F3FF' };
                if (s.includes('bio') || s.includes('botan') || s.includes('zool')) return { stroke: '#D97706', fill: '#FFFBEB' };
                if (s.includes('apt') || s.includes('reason') || s.includes('logic')) return { stroke: '#0891B2', fill: '#ECFEFF' };
                if (s.includes('eng') || s.includes('lang')) return { stroke: '#DC2626', fill: '#FEF2F2' };

                const palette = [
                    { stroke: '#2563EB', fill: '#EFF6FF' },
                    { stroke: '#059669', fill: '#ECFDF5' },
                    { stroke: '#7C3AED', fill: '#F5F3FF' },
                    { stroke: '#D97706', fill: '#FFFBEB' },
                    { stroke: '#E11D48', fill: '#FFF1F2' },
                    { stroke: '#0284C7', fill: '#F0F9FF' },
                    { stroke: '#4F46E5', fill: '#EEF2FF' },
                    { stroke: '#16A34A', fill: '#F0FDF4' }
                ];
                return palette[index % palette.length];
            }

            function renderAnalyticsPage() {
                // Filter submissions by folder
                const filtered = (studentSubmissions || []).filter(s => {
                    if (!activeFolder || activeFolder === 'all') return true;
                    const cat = (s.paperCategory || 'General').trim().toLowerCase();
                    return cat === activeFolder.trim().toLowerCase();
                });

                // Chronological sort: earliest to latest
                const sorted = filtered.slice().sort((a, b) => {
                    const timeA = new Date(a.submitted_at || a.scannedAt || 0).getTime();
                    const timeB = new Date(b.submitted_at || b.scannedAt || 0).getTime();
                    return timeA - timeB;
                });

                const emptyBox = document.getElementById('cmcEmptyState');
                const statsStrip = document.getElementById('cmcStatsStrip');
                const canvasWrap = document.getElementById('cmcCanvasWrapper');
                const chipsBar = document.getElementById('cmcSubjectChipsBar');

                if (sorted.length === 0) {
                    if (emptyBox) emptyBox.style.display = 'block';
                    if (statsStrip) statsStrip.style.display = 'none';
                    if (canvasWrap) canvasWrap.style.display = 'none';
                    if (chipsBar) chipsBar.style.display = 'none';
                    renderTable([]);
                    return;
                }

                if (emptyBox) emptyBox.style.display = 'none';
                if (statsStrip) statsStrip.style.display = 'flex';
                if (canvasWrap) canvasWrap.style.display = 'block';

                // Compute Stats
                let sumPct = 0;
                let highestOb = -Infinity;
                let highestMax = 100;
                let highestPct = 0;
                let bestRank = Infinity;
                let bestRankTotal = 0;
                const pcts = [];

                sorted.forEach(s => {
                    const sumSec = s.allSectionsSummary || {};
                    const ob = (sumSec.obtainedMarks !== undefined) ? Number(sumSec.obtainedMarks) : ((s.aggregateMarks !== undefined) ? Number(s.aggregateMarks) : (Number(s.score || 0) * 4));
                    const mx = (sumSec.totalMarks !== undefined) ? Number(sumSec.totalMarks) : (Number(s.maxMarks) || ((Number(s.totalQuestions) || 50) * 4) || 100);
                    const pct = (s.percentage !== undefined) ? Number(s.percentage) : (mx > 0 ? Number(((ob / mx) * 100).toFixed(1)) : 0);
                    pcts.push(pct);
                    sumPct += pct;
                    if (ob > highestOb) {
                        highestOb = ob;
                        highestMax = mx;
                        highestPct = pct;
                    }
                    if (s.rank && Number(s.rank) > 0 && Number(s.rank) < bestRank) {
                        bestRank = Number(s.rank);
                        bestRankTotal = Number(s.totalCandidates) || 0;
                    }
                });

                const avgPct = (sumPct / sorted.length).toFixed(1);
                document.getElementById('cmcStatTestsCount').textContent = `${sorted.length} ${sorted.length === 1 ? 'Test' : 'Tests'}`;
                document.getElementById('cmcStatAvgScore').textContent = `${avgPct}% Avg`;
                document.getElementById('cmcStatHighScore').textContent = `${highestOb} / ${highestMax} (${highestPct}%)`;
                document.getElementById('cmcStatBestRank').textContent = bestRank !== Infinity ? `#${bestRank}${bestRankTotal ? ' / ' + bestRankTotal : ''}` : '--';

                const trendEl = document.getElementById('cmcStatTrend');
                if (sorted.length >= 2) {
                    const diff = Number((pcts[pcts.length - 1] - pcts[pcts.length - 2]).toFixed(1));
                    if (diff > 0) trendEl.innerHTML = `<span style="color: #059669;">+${diff}% ↑</span>`;
                    else if (diff < 0) trendEl.innerHTML = `<span style="color: #DC2626;">${diff}% ↓</span>`;
                    else trendEl.innerHTML = `<span style="color: #64748B;">0.0% →</span>`;
                } else {
                    trendEl.innerHTML = `<span style="color: #64748B; font-size: 0.82rem; font-weight: 600;">Initial Test</span>`;
                }

                // Render Chart SVG
                renderChartSvg(sorted);

                // Render Performance Table
                renderTable(sorted.slice().reverse()); // Show most recent on top in table
            }

            function renderChartSvg(sorted) {
                const container = document.getElementById('cmcChartSvgContainer');
                if (!container) return;

                const svgWidth = Math.max(760, sorted.length * 90);
                const svgHeight = 280;
                const padLeft = 55, padRight = 35, padTop = 32, padBottom = 48;
                const plotW = svgWidth - padLeft - padRight;
                const plotH = svgHeight - padTop - padBottom;

                if (currentMode === 'overall') {
                    const points = sorted.map((s, idx) => {
                        const sumSec = s.allSectionsSummary || {};
                        const ob = (sumSec.obtainedMarks !== undefined) ? Number(sumSec.obtainedMarks) : ((s.aggregateMarks !== undefined) ? Number(s.aggregateMarks) : (Number(s.score || 0) * 4));
                        const mx = (sumSec.totalMarks !== undefined) ? Number(sumSec.totalMarks) : (Number(s.maxMarks) || ((Number(s.totalQuestions) || 50) * 4) || 100);
                        const pct = (s.percentage !== undefined) ? Number(s.percentage) : (mx > 0 ? Number(((ob / mx) * 100).toFixed(1)) : 0);
                        const clamped = Math.max(0, Math.min(100, pct));
                        const x = sorted.length === 1 ? (padLeft + plotW / 2) : (padLeft + (idx / (sorted.length - 1)) * plotW);
                        const y = padTop + (1 - clamped / 100) * plotH;
                        return { x, y, pct, ob, mx, item: s, idx };
                    });

                    let svg = `<svg viewBox="0 0 ${svgWidth} ${svgHeight}" width="100%" height="${svgHeight}" style="overflow: visible; display: block;" xmlns="http://www.w3.org/2000/svg">`;
                    svg += `<defs>
                        <linearGradient id="cmcGradBlue" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#2563EB" stop-opacity="0.22"/>
                            <stop offset="100%" stop-color="#2563EB" stop-opacity="0.01"/>
                        </linearGradient>
                    </defs>`;

                    // Grid lines
                    [0, 25, 50, 75, 100].forEach(tick => {
                        const gy = padTop + (1 - tick / 100) * plotH;
                        svg += `<line x1="${padLeft}" y1="${gy}" x2="${svgWidth - padRight}" y2="${gy}" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="${tick === 0 ? 'none' : '3 3'}"/>`;
                        svg += `<text x="${padLeft - 8}" y="${gy + 4}" font-size="10.5" font-weight="600" fill="#94A3B8" text-anchor="end" font-family="inherit">${tick}%</text>`;
                    });

                    // Area & Line
                    if (points.length > 1) {
                        const bottomY = padTop + plotH;
                        let pathD = `M ${points[0].x} ${points[0].y}`;
                        let areaD = `M ${points[0].x} ${bottomY} L ${points[0].x} ${points[0].y}`;
                        for (let i = 1; i < points.length; i++) {
                            pathD += ` L ${points[i].x} ${points[i].y}`;
                            areaD += ` L ${points[i].x} ${points[i].y}`;
                        }
                        areaD += ` L ${points[points.length - 1].x} ${bottomY} Z`;

                        svg += `<path d="${areaD}" fill="url(#cmcGradBlue)" />`;
                        svg += `<path d="${pathD}" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />`;
                    } else if (points.length === 1) {
                        svg += `<line x1="${padLeft}" y1="${points[0].y}" x2="${svgWidth - padRight}" y2="${points[0].y}" stroke="#93C5FD" stroke-width="1.5" stroke-dasharray="4 4"/>`;
                    }

                    // X-axis labels
                    points.forEach(p => {
                        const d = new Date(p.item.submitted_at || p.item.scannedAt || Date.now());
                        const dateStr = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                        let shortTitle = p.item.paperTitle || `Test ${p.idx + 1}`;
                        if (shortTitle.length > 14) shortTitle = shortTitle.slice(0, 13) + '…';

                        svg += `<text x="${p.x}" y="${padTop + plotH + 18}" font-size="10.5" font-weight="700" fill="#334155" text-anchor="middle" font-family="inherit">${shortTitle}</text>`;
                        svg += `<text x="${p.x}" y="${padTop + plotH + 32}" font-size="9.5" font-weight="500" fill="#94A3B8" text-anchor="middle" font-family="inherit">${dateStr}</text>`;
                    });

                    // Dots & hover targets
                    points.forEach(p => {
                        const labelY = Math.max(padTop - 8, p.y - 12);
                        svg += `<g class="cmc-point-target" onclick="openStudentOmrModal('${p.item._id}')" onmouseenter="showCmcOverallTooltip(event, ${p.idx})" onmouseleave="hideCmcTooltip()">
                            <circle class="marker-dot" cx="${p.x}" cy="${p.y}" r="5.5" fill="#FFFFFF" stroke="#2563EB" stroke-width="3"/>
                            <rect x="${p.x - 18}" y="${labelY - 11}" width="36" height="15" rx="4" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="0.8"/>
                            <text x="${p.x}" y="${labelY}" font-size="9" font-weight="700" fill="#1E40AF" text-anchor="middle" font-family="inherit">${p.pct}%</text>
                            <circle cx="${p.x}" cy="${p.y}" r="18" fill="transparent"/>
                        </g>`;
                    });

                    svg += `</svg>`;
                    container.innerHTML = svg;

                } else {
                    // SUBJECT / SECTION-WISE MODE
                    const chipsBar = document.getElementById('cmcSubjectChipsBar');
                    if (chipsBar) chipsBar.style.display = 'flex';

                    const sectionNamesSet = new Set();
                    sorted.forEach(s => {
                        if (Array.isArray(s.sectionWise) && s.sectionWise.length > 0) {
                            s.sectionWise.forEach(sec => {
                                if (sec.sectionName) sectionNamesSet.add(sec.sectionName.trim());
                            });
                        } else if (s.paperSubject) {
                            sectionNamesSet.add(s.paperSubject.trim());
                        }
                    });

                    const sectionsList = Array.from(sectionNamesSet);

                    // Build chips
                    const chipsList = document.getElementById('cmcSubjectChipsList');
                    if (chipsList) {
                        chipsList.innerHTML = '';
                        sectionsList.forEach((secName, sIdx) => {
                            const color = getSubjectColor(secName, sIdx);
                            let sSum = 0, sCount = 0;
                            sorted.forEach(item => {
                                const sec = (item.sectionWise || []).find(x => (x.sectionName || '').trim().toLowerCase() === secName.toLowerCase());
                                if (sec) {
                                    const m = Number(sec.marks || 0);
                                    const mx = Number(sec.maxMarks || 100);
                                    sSum += mx > 0 ? (m / mx) * 100 : 0;
                                    sCount++;
                                }
                            });
                            const sAvg = sCount > 0 ? (sSum / sCount).toFixed(0) : '0';
                            const isHidden = activeSubjectFilters.has(secName);

                            const chipBtn = document.createElement('button');
                            chipBtn.type = 'button';
                            chipBtn.className = `cmc-subject-chip ${isHidden ? 'inactive' : ''}`;
                            chipBtn.style.borderColor = color.stroke;
                            chipBtn.style.color = color.stroke;
                            chipBtn.style.background = isHidden ? '#F1F5F9' : color.fill;
                            chipBtn.innerHTML = `<span style="width: 8px; height: 8px; border-radius: 50%; background: ${color.stroke}; display: inline-block;"></span> <span>${secName} (${sAvg}%)</span>`;
                            chipBtn.onclick = () => toggleSubjectFilter(secName);
                            chipsList.appendChild(chipBtn);
                        });
                    }

                    // Render Multi-line SVG
                    let svg = `<svg viewBox="0 0 ${svgWidth} ${svgHeight}" width="100%" height="${svgHeight}" style="overflow: visible; display: block;" xmlns="http://www.w3.org/2000/svg">`;

                    // Grid lines
                    [0, 25, 50, 75, 100].forEach(tick => {
                        const gy = padTop + (1 - tick / 100) * plotH;
                        svg += `<line x1="${padLeft}" y1="${gy}" x2="${svgWidth - padRight}" y2="${gy}" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="${tick === 0 ? 'none' : '3 3'}"/>`;
                        svg += `<text x="${padLeft - 8}" y="${gy + 4}" font-size="10.5" font-weight="600" fill="#94A3B8" text-anchor="end" font-family="inherit">${tick}%</text>`;
                    });

                    // X-axis labels
                    sorted.forEach((item, idx) => {
                        const x = sorted.length === 1 ? (padLeft + plotW / 2) : (padLeft + (idx / (sorted.length - 1)) * plotW);
                        const d = new Date(item.submitted_at || item.scannedAt || Date.now());
                        const dateStr = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                        let shortTitle = item.paperTitle || `Test ${idx + 1}`;
                        if (shortTitle.length > 14) shortTitle = shortTitle.slice(0, 13) + '…';

                        svg += `<text x="${x}" y="${padTop + plotH + 18}" font-size="10.5" font-weight="700" fill="#334155" text-anchor="middle" font-family="inherit">${shortTitle}</text>`;
                        svg += `<text x="${x}" y="${padTop + plotH + 32}" font-size="9.5" font-weight="500" fill="#94A3B8" text-anchor="middle" font-family="inherit">${dateStr}</text>`;
                    });

                    // Subject lines & dots
                    sectionsList.forEach((secName, sIdx) => {
                        if (activeSubjectFilters.has(secName)) return;
                        const color = getSubjectColor(secName, sIdx);
                        const secPoints = [];

                        sorted.forEach((item, idx) => {
                            const x = sorted.length === 1 ? (padLeft + plotW / 2) : (padLeft + (idx / (sorted.length - 1)) * plotW);
                            const sec = (item.sectionWise || []).find(x => (x.sectionName || '').trim().toLowerCase() === secName.toLowerCase());
                            if (sec) {
                                const m = Number(sec.marks || 0);
                                const mx = Number(sec.maxMarks || 100);
                                const pct = mx > 0 ? (m / mx) * 100 : 0;
                                const clamped = Math.max(0, Math.min(100, pct));
                                const y = padTop + (1 - clamped / 100) * plotH;
                                secPoints.push({ x, y, m, mx, pct, item, sec, idx });
                            }
                        });

                        if (secPoints.length > 1) {
                            let pathD = `M ${secPoints[0].x} ${secPoints[0].y}`;
                            for (let i = 1; i < secPoints.length; i++) pathD += ` L ${secPoints[i].x} ${secPoints[i].y}`;
                            svg += `<path d="${pathD}" fill="none" stroke="${color.stroke}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>`;
                        }

                        secPoints.forEach(p => {
                            svg += `<g class="cmc-point-target" onclick="openStudentOmrModal('${p.item._id}')" onmouseenter="showCmcSubjectTooltip(event, ${p.idx}, '${secName.replace(/'/g, "\\'")}')" onmouseleave="hideCmcTooltip()">
                                <circle class="marker-dot" cx="${p.x}" cy="${p.y}" r="4.5" fill="#FFFFFF" stroke="${color.stroke}" stroke-width="2.5"/>
                                <circle cx="${p.x}" cy="${p.y}" r="15" fill="transparent"/>
                            </g>`;
                        });
                    });

                    svg += `</svg>`;
                    container.innerHTML = svg;
                }
            }

            function renderTable(tests) {
                const tbody = document.getElementById('analyticsTableBody');
                const label = document.getElementById('btcCountLabel');
                if (label) label.textContent = `${tests.length} ${tests.length === 1 ? 'Test' : 'Tests'}`;
                if (!tbody) return;

                if (tests.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #94A3B8; padding: 2rem;">No tests available for this selection.</td></tr>`;
                    return;
                }

                let html = '';
                tests.forEach(t => {
                    const sumSec = t.allSectionsSummary || {};
                    const ob = (sumSec.obtainedMarks !== undefined) ? Number(sumSec.obtainedMarks) : ((t.aggregateMarks !== undefined) ? Number(t.aggregateMarks) : (Number(t.score || 0) * 4));
                    const mx = (sumSec.totalMarks !== undefined) ? Number(sumSec.totalMarks) : (Number(t.maxMarks) || ((Number(t.totalQuestions) || 50) * 4) || 100);
                    const pct = (t.percentage !== undefined) ? Number(t.percentage) : (mx > 0 ? Number(((ob / mx) * 100).toFixed(1)) : 0);
                    const d = new Date(t.submitted_at || t.scannedAt || Date.now());
                    const dateFormatted = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

                    const pillClass = pct >= 60 ? 'pill-acc-high' : (pct >= 35 ? 'pill-acc-mid' : 'pill-acc-low');

                    let rankHtml = '<span style="color: #94A3B8;">--</span>';
                    if (t.rank) {
                        const icon = t.rank === 1 ? '🥇' : (t.rank === 2 ? '🥈' : (t.rank === 3 ? '🥉' : '🏅'));
                        rankHtml = `<span class="rank-medal-badge">${icon} #${t.rank}${t.totalCandidates ? ' / ' + t.totalCandidates : ''}</span>`;
                    }

                    let secPills = '';
                    if (Array.isArray(t.sectionWise) && t.sectionWise.length > 0) {
                        secPills = t.sectionWise.map(s => {
                            const c = getSubjectColor(s.sectionName);
                            return `<span style="display: inline-flex; align-items: center; gap: 3px; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; background: ${c.fill}; color: ${c.stroke}; border: 1px solid ${c.stroke}; font-weight: 600;">
                                ${s.sectionName}: ${s.marks}/${s.maxMarks}
                            </span>`;
                        }).join(' ');
                    } else {
                        secPills = `<span style="font-size: 0.75rem; color: #94A3B8;">${t.paperSubject || 'General'}</span>`;
                    }

                    html += `
                        <tr>
                            <td>
                                <div style="font-weight: 700; color: #0F172A;">${t.paperTitle || 'Evaluated Paper'}</div>
                                <div style="font-size: 0.75rem; color: #64748B;">${t.paperSubject || 'General'}</div>
                            </td>
                            <td><span style="font-weight: 600; color: #2563EB;">${t.paperCategory || 'General'}</span></td>
                            <td style="color: #475569;">${dateFormatted}</td>
                            <td>
                                <div style="font-weight: 800; color: #0F172A;">${ob} <span style="font-weight: 500; font-size: 0.78rem; color: #94A3B8;">/ ${mx}</span></div>
                                <span class="${pillClass}">${pct}% Accuracy</span>
                            </td>
                            <td>${rankHtml}</td>
                            <td><div style="display: flex; gap: 4px; flex-wrap: wrap;">${secPills}</div></td>
                            <td style="text-align: right;">
                                <button type="button" class="btn-view-omr-sm" onclick="openStudentOmrModal('${t._id}')">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <span>View OMR</span>
                                </button>
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
            }

            // Tooltips
            function showCmcOverallTooltip(e, testIdx) {
                const tooltip = document.getElementById('cmcChartTooltip');
                const wrapper = document.getElementById('cmcCanvasWrapper');
                if (!tooltip || !wrapper) return;

                const filtered = (studentSubmissions || []).filter(s => {
                    if (!activeFolder || activeFolder === 'all') return true;
                    return (s.paperCategory || 'General').trim().toLowerCase() === activeFolder.trim().toLowerCase();
                });
                const sorted = filtered.slice().sort((a, b) => new Date(a.submitted_at || a.scannedAt || 0) - new Date(b.submitted_at || b.scannedAt || 0));
                const item = sorted[testIdx];
                if (!item) return;

                const sumSec = item.allSectionsSummary || {};
                const ob = (sumSec.obtainedMarks !== undefined) ? Number(sumSec.obtainedMarks) : ((item.aggregateMarks !== undefined) ? Number(item.aggregateMarks) : (Number(item.score || 0) * 4));
                const mx = (sumSec.totalMarks !== undefined) ? Number(sumSec.totalMarks) : (Number(item.maxMarks) || ((Number(item.totalQuestions) || 50) * 4) || 100);
                const pct = (item.percentage !== undefined) ? Number(item.percentage) : (mx > 0 ? Number(((ob / mx) * 100).toFixed(1)) : 0);
                const pId = String(item.paper_id || item.paperId || '');
                const pStats = paperTopperStats[pId] || null;

                const d = new Date(item.submitted_at || item.scannedAt || Date.now());
                const dateFormatted = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

                tooltip.innerHTML = `
                    <div style="font-weight: 800; font-size: 0.85rem; margin-bottom: 2px; color: #FFFFFF;">${item.paperTitle}</div>
                    <div style="font-size: 0.72rem; color: #94A3B8; margin-bottom: 6px;">${dateFormatted} &bull; ${item.paperSubject || 'General'}</div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                        <span style="color: #CBD5E1;">Score:</span>
                        <span style="font-weight: 800; color: #60A5FA;">${ob} / ${mx} (${pct}%)</span>
                    </div>
                    ${item.rank ? `<div style="display: flex; justify-content: space-between; margin-top: 4px; padding-top: 4px; border-top: 1px solid rgba(255,255,255,0.12);"><span style="color: #94A3B8;">Candidate Rank:</span><span style="font-weight: 700; color: #FBBF24;">#${item.rank}${item.totalCandidates ? ' / ' + item.totalCandidates : ''}</span></div>` : ''}
                    ${pStats && pStats.highestOverall !== undefined ? `<div style="display: flex; justify-content: space-between; margin-top: 3px;"><span style="color: #94A3B8;">Paper Highest:</span><span style="font-weight: 600; color: #34D399;">${pStats.highestOverall} / ${mx}</span></div>` : ''}
                    <div style="margin-top: 6px; font-size: 0.7rem; color: #94A3B8; text-align: center; font-style: italic;">Click point to inspect evaluated OMR sheet</div>
                `;

                positionCmcTooltip(e, tooltip, wrapper);
            }

            function showCmcSubjectTooltip(e, testIdx, activeSecName) {
                const tooltip = document.getElementById('cmcChartTooltip');
                const wrapper = document.getElementById('cmcCanvasWrapper');
                if (!tooltip || !wrapper) return;

                const filtered = (studentSubmissions || []).filter(s => {
                    if (!activeFolder || activeFolder === 'all') return true;
                    return (s.paperCategory || 'General').trim().toLowerCase() === activeFolder.trim().toLowerCase();
                });
                const sorted = filtered.slice().sort((a, b) => new Date(a.submitted_at || a.scannedAt || 0) - new Date(b.submitted_at || b.scannedAt || 0));
                const item = sorted[testIdx];
                if (!item) return;

                const d = new Date(item.submitted_at || item.scannedAt || Date.now());
                const dateFormatted = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

                let sectionsRows = '';
                (item.sectionWise || []).forEach(sec => {
                    const sName = sec.sectionName || 'Section';
                    const isCurrent = sName.toLowerCase() === (activeSecName || '').toLowerCase();
                    const m = Number(sec.marks || 0);
                    const mx = Number(sec.maxMarks || 100);
                    const p = mx > 0 ? ((m / mx) * 100).toFixed(0) : 0;
                    const color = getSubjectColor(sName);

                    sectionsRows += `
                        <div style="display: flex; justify-content: space-between; margin-top: 3px; padding: 2px 4px; border-radius: 4px; ${isCurrent ? 'background: rgba(255,255,255,0.12);' : ''}">
                            <span style="display: flex; align-items: center; gap: 5px; color: ${isCurrent ? '#FFFFFF' : '#CBD5E1'}; font-weight: ${isCurrent ? '700' : '500'};">
                                <span style="width: 7px; height: 7px; border-radius: 50%; background: ${color.stroke};"></span>
                                ${sName}
                            </span>
                            <span style="font-weight: 700; color: ${color.stroke};">${m} / ${mx} <small>(${p}%)</small></span>
                        </div>
                    `;
                });

                tooltip.innerHTML = `
                    <div style="font-weight: 800; font-size: 0.85rem; margin-bottom: 2px; color: #FFFFFF;">${item.paperTitle}</div>
                    <div style="font-size: 0.72rem; color: #94A3B8; margin-bottom: 6px;">${dateFormatted} &bull; Section Breakdown</div>
                    ${sectionsRows}
                    <div style="margin-top: 6px; font-size: 0.7rem; color: #94A3B8; text-align: center; font-style: italic;">Click point to inspect evaluated OMR sheet</div>
                `;

                positionCmcTooltip(e, tooltip, wrapper);
            }

            function positionCmcTooltip(e, tooltip, wrapper) {
                const wrapRect = wrapper.getBoundingClientRect();
                const x = e.clientX - wrapRect.left + wrapper.scrollLeft;
                const y = e.clientY - wrapRect.top;

                tooltip.style.display = 'block';
                tooltip.style.opacity = '1';

                const tipWidth = tooltip.offsetWidth || 230;
                const tipHeight = tooltip.offsetHeight || 120;

                let posX = x + 12;
                if (posX + tipWidth > wrapper.scrollWidth - 10) posX = x - tipWidth - 12;
                let posY = y - tipHeight - 10;
                if (posY < 10) posY = y + 16;

                tooltip.style.left = Math.max(10, posX) + 'px';
                tooltip.style.top = Math.max(10, posY) + 'px';
            }

            function hideCmcTooltip() {
                const tooltip = document.getElementById('cmcChartTooltip');
                if (tooltip) {
                    tooltip.style.opacity = '0';
                    tooltip.style.display = 'none';
                }
            }

            // OMR Modal
            let currentModalBreakdown = [];
            let currentModalFilter = 'all';

            function openStudentOmrModal(subId) {
                const sub = submissionsById[String(subId)];
                if (!sub) return;

                document.getElementById('modalPaperTitle').textContent = sub.paperTitle || 'Evaluated Paper';
                document.getElementById('modalPaperSubtitle').textContent = `${sub.paperSubject || 'General'} &bull; Submitted: ${new Date(sub.submitted_at || sub.scannedAt || Date.now()).toLocaleDateString()}`;

                const imgContainer = document.getElementById('modalImageContainer');
                const imgEl = document.getElementById('modalScannedImg');
                const rawPath = sub.image_path || sub.imagePath || '';

                if (rawPath) {
                    const cleanPath = rawPath.replace(/\\/g, '/');
                    const publicIndex = cleanPath.indexOf('public/');
                    const imgSrc = (publicIndex !== -1) ? '/' + cleanPath.substring(publicIndex + 'public/'.length) : cleanPath;
                    imgEl.src = imgSrc;
                    imgContainer.style.display = 'block';
                } else {
                    imgContainer.style.display = 'none';
                }

                // Breakdown list
                const responses = Array.isArray(sub.responses) ? sub.responses : [];
                const keyLookup = sub.answerKeyLookup || {};
                const totalQ = sub.totalQuestions || Math.max(responses.length, Object.keys(keyLookup).length) || 50;
                const isJee = (sub.examType === 'jee' || sub.paperExamType === 'jee');

                currentModalBreakdown = [];
                for (let q = 1; q <= totalQ; q++) {
                    const marked = responses[q - 1] ? String(responses[q - 1]).trim().toUpperCase() : '';
                    const key = keyLookup[q] ? String(keyLookup[q]).trim().toUpperCase() : '';
                    let subjectName = 'General';
                    if (isJee) {
                        if (q <= 25) subjectName = 'Physics';
                        else if (q <= 50) subjectName = 'Chemistry';
                        else if (q <= 75) subjectName = 'Mathematics';
                    }

                    const isBlank = (!marked || marked === '-' || marked === 'BLANK');
                    const isBonus = (key === 'BONUS' || key === '*' || key === 'ALL' || key.includes('BONUS'));
                    const isCorrect = isBonus || (!isBlank && key && (key === marked || key.split(/[,/;\s]+/).includes(marked)));
                    const isWrong = !isBlank && !isBonus && !isCorrect;

                    let verdict = 'wrong';
                    let marks = isJee ? '-1' : '0';
                    if (isBonus) { verdict = 'bonus'; marks = isJee ? '+4' : '+1'; }
                    else if (isCorrect) { verdict = 'correct'; marks = isJee ? '+4' : '+1'; }
                    else if (isBlank) { verdict = 'blank'; marks = '0'; }

                    currentModalBreakdown.push({ qNum: q, subject: subjectName, marked: isBlank ? '—' : marked, key: key || '—', marks, verdict });
                }

                filterModalBreakdown('all');
                document.getElementById('studentOmrModal').showModal();
            }

            function closeStudentOmrModal() {
                document.getElementById('studentOmrModal').close();
            }

            function filterModalBreakdown(filterType) {
                currentModalFilter = filterType;
                document.querySelectorAll('.filter-pill').forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-filter') === filterType);
                });

                let cCount = 0, wCount = 0, bCount = 0;
                currentModalBreakdown.forEach(item => {
                    if (item.verdict === 'correct' || item.verdict === 'bonus') cCount++;
                    else if (item.verdict === 'wrong') wCount++;
                    else if (item.verdict === 'blank') bCount++;
                });

                document.getElementById('filterCountAll').textContent = currentModalBreakdown.length;
                document.getElementById('filterCountCorrect').textContent = cCount;
                document.getElementById('filterCountWrong').textContent = wCount;
                document.getElementById('filterCountBlank').textContent = bCount;

                const tbody = document.getElementById('modalBreakdownBody');
                tbody.innerHTML = '';

                currentModalBreakdown.forEach(item => {
                    if (filterType === 'correct' && item.verdict !== 'correct' && item.verdict !== 'bonus') return;
                    if (filterType === 'wrong' && item.verdict !== 'wrong') return;
                    if (filterType === 'blank' && item.verdict !== 'blank') return;

                    const tr = document.createElement('tr');
                    tr.style.borderBottom = '1px solid #F1F5F9';
                    let vColor = '#DC2626';
                    let vText = 'Wrong';
                    if (item.verdict === 'correct') { vColor = '#16A34A'; vText = 'Correct'; }
                    else if (item.verdict === 'bonus') { vColor = '#7C3AED'; vText = 'Bonus'; }
                    else if (item.verdict === 'blank') { vColor = '#64748B'; vText = 'Unattempted'; }

                    tr.innerHTML = `
                        <td style="padding: 7px 8px; font-weight: 700;">${item.qNum}</td>
                        <td style="padding: 7px 8px; color: #475569;">${item.subject}</td>
                        <td style="padding: 7px 8px; font-weight: 700; color: #0F172A;">${item.marked}</td>
                        <td style="padding: 7px 8px; color: #2563EB; font-weight: 700;">${item.key}</td>
                        <td style="padding: 7px 8px; font-weight: 700;">${item.marks}</td>
                        <td style="padding: 7px 8px;"><span style="color: ${vColor}; font-weight: 700; font-size: 0.74rem;">${vText}</span></td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            window.addEventListener('resize', () => {
                renderAnalyticsPage();
            });

            // Initial render
            renderAnalyticsPage();
        </script>
</body>

</html>
