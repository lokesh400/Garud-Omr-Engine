<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 2.25rem 2rem;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.5rem;
        }

        .auth-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 4px 0;
        }

        .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.45;
        }

        .alert-banner {
            border-radius: var(--radius-sm);
            padding: 0.85rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 1.25rem;
            border: 1px solid transparent;
            line-height: 1.4;
        }

        .alert-error {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
        }

        .alert-success {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }

        .auth-footer-links {
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            border-top: 1px solid #F1F5F9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.84rem;
        }

        .auth-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .auth-link:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }

        .notice-box {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 0.82rem;
            color: #64748B;
            margin-bottom: 1.25rem;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }
    </style>
</head>

<body>
    <main class="auth-shell">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="auth-title">Forgot Password</h1>
                    <p class="auth-subtitle">Verify your student roll number or username to receive a reset OTP</p>
                </div>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-banner alert-error" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert-banner alert-success" role="status">
                    <%= message %>
                </div>
            <% } %>

            <div class="notice-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>An OTP will be delivered to the email address registered on your account via Brevo Mail.</span>
            </div>

            <form action="/forgot-password" method="POST" id="forgotForm">
                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label for="identifier" style="font-weight: 600; font-size: 0.86rem; color: var(--text-main); display: block; margin-bottom: 6px;">
                        Student Roll Number or Username
                    </label>
                    <input type="text"
                           id="identifier"
                           name="identifier"
                           class="form-control"
                           value="<%= typeof identifier !== 'undefined' && identifier ? identifier : '' %>"
                           placeholder="e.g. 01234567 or username"
                           autocomplete="username"
                           autocorrect="off"
                           autocapitalize="none"
                           spellcheck="false"
                           required
                           autofocus>
                </div>

                <button type="submit" id="btnSendOtp" class="btn btn-primary btn-lg" style="width: 100%;">
                    Send Verification OTP
                </button>
            </form>

            <div class="auth-footer-links">
                <a href="/login" class="auth-link">
                    &larr; Back to Sign In
                </a>
                <span style="color: var(--text-muted); font-size: 0.78rem;">Garud OMR Portal</span>
            </div>
        </div>
    </main>

    <script>
        const forgotForm = document.getElementById('forgotForm');
        const sendBtn = document.getElementById('btnSendOtp');
        if (forgotForm && sendBtn) {
            forgotForm.addEventListener('submit', () => {
                if (forgotForm.checkValidity()) {
                    sendBtn.disabled = true;
                    sendBtn.textContent = 'Sending OTP...';
                }
            });
        }
    </script>
</body>

</html>
