<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEE Mains Evaluation • <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .eval-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .eval-header-split {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.15rem 1.5rem;
            box-shadow: var(--shadow-xs);
        }
        .eval-layout {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.5rem;
            align-items: start;
        }
        @media (max-width: 1180px) {
            .eval-layout { grid-template-columns: 1fr; }
        }
        .canvas-card {
            background: #FFFFFF;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-xs);
            border: 1px solid var(--border-color);
            position: relative;
        }
        .canvas-toolbar {
            background: var(--surface-subtle);
            border-bottom: 1px solid var(--border-color);
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 0.85rem;
        }
        .canvas-toolbar-btn {
            background: #FFFFFF;
            color: var(--text-main);
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-xs);
            padding: 5px 12px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Inter', sans-serif;
        }
        .canvas-toolbar-btn:hover {
            background: var(--surface-subtle);
            border-color: var(--primary);
            color: var(--primary);
        }
        .canvas-wrapper {
            position: relative;
            background: var(--surface-subtle);
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #canvasOutput {
            width: 100%;
            height: auto;
            display: block;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            background: #FFFFFF;
        }
        .level-badge {
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .score-hero {
            background: var(--primary-light);
            color: var(--text-main);
            border: 1px solid var(--primary-border);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            text-align: center;
            margin-bottom: 1.25rem;
        }
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 1.25rem;
        }
        @media (max-width: 640px) {
            .stat-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        .stat-box {
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.8rem 0.5rem;
            text-align: center;
        }
        .stat-box .num {
            font-size: 1.45rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            line-height: 1.1;
        }
        .stat-box .lbl {
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            margin-top: 4px;
            letter-spacing: 0.04em;
        }
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
            font-variant-numeric: tabular-nums;
        }
        .breakdown-table th, .breakdown-table td {
            padding: 9px 12px;
            border-bottom: 1px solid #F1F5F9;
            text-align: center;
        }
        .breakdown-table th {
            background: var(--surface-subtle);
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .breakdown-table tr:hover td {
            background: var(--surface-subtle);
        }
        .badge {
            display: inline-block;
            padding: 2px 9px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge-correct {
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
        }
        .badge-wrong {
            background: var(--danger-light);
            color: var(--danger);
            border: 1px solid var(--danger-border);
        }
        .badge-blank {
            background: var(--surface-subtle);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }
        .badge-marked {
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
        }
        .badge-multiple {
            background: var(--danger-light);
            color: var(--danger-hover);
            border: 1px solid var(--danger-border);
        }
        .roll-number-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }
        .roll-label-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.75rem;
        }
        .roll-title {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .roll-status-pill {
            margin-left: auto;
            font-size: 0.74rem;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: var(--radius-full);
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
            font-family: 'JetBrains Mono', monospace;
        }
        .roll-boxes-display {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
        .roll-digit-box {
            width: 35px;
            height: 43px;
            background: var(--surface-subtle);
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-muted);
        }
        .roll-digit-box.filled {
            border-color: var(--primary-border);
            background: var(--primary-light);
            color: var(--primary-active);
        }
        .roll-digit-box.unknown {
            color: var(--text-subtle);
            border-style: dashed;
        }
        .jee-nvq-btn {
            border: 1px solid var(--border-hover);
            background: #FFFFFF;
            color: var(--text-main);
            border-radius: var(--radius-xs);
            padding: 4px 0;
            font-size: 0.74rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            transition: all 0.12s ease;
        }
        .jee-nvq-btn:hover {
            filter: brightness(0.95);
        }
        .jee-nvq-btn.btn-c.active {
            background: #10B981 !important;
            color: #FFFFFF !important;
            border-color: #059669 !important;
        }
        .jee-nvq-btn.btn-w.active {
            background: #EF4444 !important;
            color: #FFFFFF !important;
            border-color: #DC2626 !important;
        }
        .jee-nvq-btn.btn-b.active {
            background: #64748B !important;
            color: #FFFFFF !important;
            border-color: #475569 !important;
        }
    </style>
</head>
<body>
    <%- include('partials/sidebar_start', { activeMenu: 'papers' }) %>
    <div class="content-wrapper">
        <div class="eval-container">
            <div class="eval-header-split">
                <div>
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                        <h2 style="font-size: 1.35rem; margin: 0; font-weight: 800;">JEE Mains Sheet Evaluation</h2>
                        <span class="badge" style="background:#EFF6FF; color:#1D4ED8; border:1px solid #BFDBFE;">JEE Mains Format</span>
                    </div>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.85rem;">
                        <%= paper.title %> &middot; Checking: <strong>Q1-20 (Physics)</strong> &bull; <strong>Q41-60 (Chemistry)</strong> &bull; <strong>Q81-100 (Math)</strong> + Numerical
                    </p>
                </div>
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                    <span id="evalStatus" class="status-pill">Analyzing sheet...</span>
                    <a href="/paper/<%= encodeURIComponent(paper._id) %>/jee-answerkey" class="btn btn-secondary btn-sm" title="Edit JEE Answer Key (Q1-20, Q41-60, Q81-100)">JEE Answer Key</a>
                    <a href="/paper/<%= encodeURIComponent(paper._id) %>/results" class="btn btn-primary btn-sm">View Results</a>
                </div>
            </div>

            <div class="eval-layout">
                <!-- Left: Sheet Preview Canvas -->
                <div>
                    <div class="canvas-card">
                        <div class="canvas-toolbar">
                            <span class="level-badge">Auto-Leveled &amp; Cropped (A4)</span>
                            <div style="display:flex; gap:8px;">
                                <input type="file" id="sheetFileInput" accept="image/*" style="display:none;" onchange="handleFileSelect(event)">
                                <button type="button" class="canvas-toolbar-btn" onclick="document.getElementById('sheetFileInput').click()" title="Select an OMR sheet image from device">📁 Choose Image</button>
                                <button type="button" class="canvas-toolbar-btn" id="toggleViewBtn" onclick="toggleRawView()">View Raw Upload</button>
                            </div>
                        </div>
                        <div class="canvas-wrapper">
                            <canvas id="canvasOutput"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Right: Results & Numerical Panel -->
                <div>
                    <!-- Roll Number Card -->
                    <div class="roll-number-card">
                        <div class="roll-label-row">
                            <span class="roll-title">Student Roll Number</span>
                            <span class="roll-status-pill" id="rollStatusPill">Detecting...</span>
                        </div>
                        <div class="roll-boxes-display" id="rollBoxesDisplay">
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                        </div>
                    </div>

                    <!-- Score Hero: 300 Max Marks -->
                    <div class="score-hero">
                        <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600;">
                            JEE Mains Total Score (300 Max)
                        </div>
                        <div class="score-val" id="scoreValue"
                            style="font-size: 3rem; font-weight: 700; margin: 0.2rem 0; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; color: var(--primary);">
                            0 / 300
                        </div>
                        <div id="scorePercentage" style="font-size: 1rem; font-weight: 600; color: var(--text-body);">0% Marks (0/300)</div>
                    </div>

                    <!-- 3 Subject Mini Cards -->
                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; margin-bottom:1.25rem;">
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">⚛️ Physics</div>
                            <div id="phyTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="phyMcqMarks">0</span> &bull; NVQ: <span id="phyNvqMarks">0</span></div>
                        </div>
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">🧪 Chemistry</div>
                            <div id="chemTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="chemMcqMarks">0</span> &bull; NVQ: <span id="chemNvqMarks">0</span></div>
                        </div>
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">📐 Mathematics</div>
                            <div id="mathTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="mathMcqMarks">0</span> &bull; NVQ: <span id="mathNvqMarks">0</span></div>
                        </div>
                    </div>

                    <!-- Section B: Numerical Value Questions (NVQ) Panel -->
                    <div class="card" style="padding: 1.15rem; margin-bottom: 1.25rem; border: 1px solid var(--border-color); background: #FFFFFF;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:6px;">
                            <div>
                                <h4 style="margin:0; font-size:0.95rem; font-weight:700; color:var(--text-main);">Section B: Numerical Value Questions</h4>
                                <span style="font-size:0.75rem; color:var(--text-muted);">Single-tap (+4 Correct, -1 Wrong, 0 Blank)</span>
                            </div>
                            <span style="font-size:0.72rem; font-weight:600; padding:2px 8px; border-radius:var(--radius-full); background:#EFF6FF; color:#1D4ED8;">15 Qs &bull; Max 60 M</span>
                        </div>

                        <!-- Physics NVQ (Q21-25) -->
                        <div style="margin-bottom:10px; padding:8px 10px; background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm);">
                            <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.78rem; font-weight:700;">
                                <span>⚛️ Physics Numerical (Q21–Q25)</span>
                                <span id="phyNvqSummary" style="font-family:'JetBrains Mono',monospace; color:var(--primary);">+0 Marks</span>
                            </div>
                            <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:6px;">
                                <% for(let i=1; i<=5; i++) { %>
                                    <div style="border:1px solid var(--border-color); border-radius:var(--radius-xs); padding:5px 3px; text-align:center; background:#FFFFFF;">
                                        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); margin-bottom:3px;">Q<%= 20 + i %></div>
                                        <div style="display:flex; flex-direction:column; gap:2px;" id="nvq_phy_<%= i %>">
                                            <button type="button" class="jee-nvq-btn btn-c" onclick="setNvq('phy', <%= i-1 %>, 4, this)">+4</button>
                                            <button type="button" class="jee-nvq-btn btn-w" onclick="setNvq('phy', <%= i-1 %>, -1, this)">-1</button>
                                            <button type="button" class="jee-nvq-btn btn-b active" onclick="setNvq('phy', <%= i-1 %>, 0, this)">0</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Chemistry NVQ (Q46-50) -->
                        <div style="margin-bottom:10px; padding:8px 10px; background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm);">
                            <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.78rem; font-weight:700;">
                                <span>🧪 Chemistry Numerical (Q46–Q50)</span>
                                <span id="chemNvqSummary" style="font-family:'JetBrains Mono',monospace; color:var(--primary);">+0 Marks</span>
                            </div>
                            <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:6px;">
                                <% for(let i=1; i<=5; i++) { %>
                                    <div style="border:1px solid var(--border-color); border-radius:var(--radius-xs); padding:5px 3px; text-align:center; background:#FFFFFF;">
                                        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); margin-bottom:3px;">Q<%= 45 + i %></div>
                                        <div style="display:flex; flex-direction:column; gap:2px;" id="nvq_chem_<%= i %>">
                                            <button type="button" class="jee-nvq-btn btn-c" onclick="setNvq('chem', <%= i-1 %>, 4, this)">+4</button>
                                            <button type="button" class="jee-nvq-btn btn-w" onclick="setNvq('chem', <%= i-1 %>, -1, this)">-1</button>
                                            <button type="button" class="jee-nvq-btn btn-b active" onclick="setNvq('chem', <%= i-1 %>, 0, this)">0</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Mathematics NVQ (Q71-75) -->
                        <div style="padding:8px 10px; background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm);">
                            <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.78rem; font-weight:700;">
                                <span>📐 Mathematics Numerical (Q71–Q75)</span>
                                <span id="mathNvqSummary" style="font-family:'JetBrains Mono',monospace; color:var(--primary);">+0 Marks</span>
                            </div>
                            <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:6px;">
                                <% for(let i=1; i<=5; i++) { %>
                                    <div style="border:1px solid var(--border-color); border-radius:var(--radius-xs); padding:5px 3px; text-align:center; background:#FFFFFF;">
                                        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); margin-bottom:3px;">Q<%= 70 + i %></div>
                                        <div style="display:flex; flex-direction:column; gap:2px;" id="nvq_math_<%= i %>">
                                            <button type="button" class="jee-nvq-btn btn-c" onclick="setNvq('math', <%= i-1 %>, 4, this)">+4</button>
                                            <button type="button" class="jee-nvq-btn btn-w" onclick="setNvq('math', <%= i-1 %>, -1, this)">-1</button>
                                            <button type="button" class="jee-nvq-btn btn-b active" onclick="setNvq('math', <%= i-1 %>, 0, this)">0</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- 60 Scanned MCQs Stat Grid & Breakdown Table -->
                    <div class="card" style="padding: 1.25rem;">
                        <h4 style="margin: 0 0 0.6rem 0; font-size: 0.95rem; font-weight: 700;">Section A: 60 Scanned MCQs Overview</h4>
                        <div class="stat-grid">
                            <div class="stat-box">
                                <div class="num" id="statCorrect" style="color: var(--success);">0</div>
                                <div class="lbl">Correct (+4)</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statWrong" style="color: var(--danger);">0</div>
                                <div class="lbl">Wrong (-1)</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statMultiple" style="color: var(--danger-hover);">0</div>
                                <div class="lbl">Multiple (-1)</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statAttempted" style="color: var(--primary);">0</div>
                                <div class="lbl">Attempted</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statBlank" style="color: var(--text-muted);">0</div>
                                <div class="lbl">Blank (0)</div>
                            </div>
                        </div>

                        <div style="display:flex; justify-content:space-between; align-items:center; margin: 1rem 0 0.5rem 0;">
                            <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700;">Bubble Breakdown (Q1-20, Q41-60, Q81-100)</h4>
                            <span style="font-size:0.75rem; color:var(--text-muted);">60 Questions Evaluated</span>
                        </div>
                        <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                            <table class="breakdown-table">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>#</th>
                                        <th>Marked</th>
                                        <th>Key</th>
                                        <th>Verdict</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hidden source image -->
        <img id="uploadedImage" src="<%= imagePath || '' %>" style="position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;" alt="Sheet">

        <script>
            const answerKey = <%- answerKey || '{}' %>;
            const totalPaperQuestions = <%= paper.numQuestions || 50 %>;
            const img = document.getElementById('uploadedImage');
            const canvas = document.getElementById('canvasOutput');
            const ctx = canvas.getContext('2d');
            const evalStatus = document.getElementById('evalStatus');
            const toggleViewBtn = document.getElementById('toggleViewBtn');

            // JEE MAINS SPECIFIC: Only check Q1-20 (Physics), Q41-60 (Chemistry), Q81-100 (Math)
            const JEE_QUESTIONS = [];
            for (let q = 1; q <= 20; q++) JEE_QUESTIONS.push({ q, subject: 'Physics', subKey: 'phy' });
            for (let q = 41; q <= 60; q++) JEE_QUESTIONS.push({ q, subject: 'Chemistry', subKey: 'chem' });
            for (let q = 81; q <= 100; q++) JEE_QUESTIONS.push({ q, subject: 'Mathematics', subKey: 'math' });

            const numericalScores = {
                phy: [0, 0, 0, 0, 0],
                chem: [0, 0, 0, 0, 0],
                math: [0, 0, 0, 0, 0]
            };

            let mcqScores = {
                phy: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                chem: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                math: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 }
            };

            let rawCanvas = document.createElement('canvas');
            let rawCtx = rawCanvas.getContext('2d');
            let leveledCanvas = document.createElement('canvas');
            let leveledCtx = leveledCanvas.getContext('2d');
            let showingRaw = false;

            const TARGET_W = 1000;
            const TARGET_H = 1461;

            const U_START = 0.061846;
            const V_START = 0.256331;
            const U_BUBBLE_STEP = 0.028042;
            const V_ROW_STEP = 0.018233;
            const U_COL_STEP = 0.201332;
            const QUESTIONS_PER_COL = 40;
            const OPTIONS = ['A', 'B', 'C', 'D'];

            const U_ROLL_START = 0.619879;
            const V_ROLL_START = 0.058644;
            const U_ROLL_COL_STEP = 0.026640;
            const V_ROLL_ROW_STEP = 0.018233;

            function setNvq(subKey, index, marks, btn) {
                numericalScores[subKey][index] = marks;
                const parent = btn.parentElement;
                parent.querySelectorAll('.jee-nvq-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                updateJeeTotals();
                saveJeeEvaluation();
            }

            function updateJeeTotals() {
                const sumArr = (arr) => arr.reduce((acc, v) => acc + v, 0);
                const phyNvq = sumArr(numericalScores.phy);
                const chemNvq = sumArr(numericalScores.chem);
                const mathNvq = sumArr(numericalScores.math);

                const phyMcqMarks = (mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple;
                const chemMcqMarks = (mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple;
                const mathMcqMarks = (mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple;

                const phyTotal = phyMcqMarks + phyNvq;
                const chemTotal = chemMcqMarks + chemNvq;
                const mathTotal = mathMcqMarks + mathNvq;
                const grandTotal = phyTotal + chemTotal + mathTotal;

                const elPhyMcq = document.getElementById('phyMcqMarks');
                if (elPhyMcq) elPhyMcq.textContent = (phyMcqMarks >= 0 ? '+' : '') + phyMcqMarks;
                const elPhyNvq = document.getElementById('phyNvqMarks');
                if (elPhyNvq) elPhyNvq.textContent = (phyNvq >= 0 ? '+' : '') + phyNvq;
                const elPhyTotal = document.getElementById('phyTotalMarks');
                if (elPhyTotal) elPhyTotal.textContent = phyTotal + '/100';

                const elChemMcq = document.getElementById('chemMcqMarks');
                if (elChemMcq) elChemMcq.textContent = (chemMcqMarks >= 0 ? '+' : '') + chemMcqMarks;
                const elChemNvq = document.getElementById('chemNvqMarks');
                if (elChemNvq) elChemNvq.textContent = (chemNvq >= 0 ? '+' : '') + chemNvq;
                const elChemTotal = document.getElementById('chemTotalMarks');
                if (elChemTotal) elChemTotal.textContent = chemTotal + '/100';

                const elMathMcq = document.getElementById('mathMcqMarks');
                if (elMathMcq) elMathMcq.textContent = (mathMcqMarks >= 0 ? '+' : '') + mathMcqMarks;
                const elMathNvq = document.getElementById('mathNvqMarks');
                if (elMathNvq) elMathNvq.textContent = (mathNvq >= 0 ? '+' : '') + mathNvq;
                const elMathTotal = document.getElementById('mathTotalMarks');
                if (elMathTotal) elMathTotal.textContent = mathTotal + '/100';

                const elPhySum = document.getElementById('phyNvqSummary');
                if (elPhySum) elPhySum.textContent = (phyNvq >= 0 ? '+' : '') + phyNvq + ' Marks';
                const elChemSum = document.getElementById('chemNvqSummary');
                if (elChemSum) elChemSum.textContent = (chemNvq >= 0 ? '+' : '') + chemNvq + ' Marks';
                const elMathSum = document.getElementById('mathNvqSummary');
                if (elMathSum) elMathSum.textContent = (mathNvq >= 0 ? '+' : '') + mathNvq + ' Marks';

                const scoreValEl = document.getElementById('scoreValue');
                if (scoreValEl) scoreValEl.textContent = grandTotal + ' / 300';
                const pct = Math.max(0, Math.round((grandTotal / 300) * 100));
                const pctEl = document.getElementById('scorePercentage');
                if (pctEl) pctEl.textContent = pct + '% Marks (' + grandTotal + '/300)';
            }

            function handleFileSelect(evt) {
                const file = evt.target.files && evt.target.files[0];
                if (!file) return;
                evalStatus.textContent = 'Loading image...';
                const reader = new FileReader();
                reader.onload = function(e) {
                    _evalStarted = false;
                    img.src = e.target.result;
                    img.onload = function() {
                        initEvaluator();
                    };
                };
                reader.readAsDataURL(file);
            }

            let _evalStarted = false;
            function initEvaluator() {
                if (_evalStarted) return;
                if (!img.src || img.src === window.location.href || img.src.endsWith('/') || img.getAttribute('src') === '') {
                    evalStatus.textContent = 'Please choose an OMR sheet image to evaluate.';
                    return;
                }
                if (!img.complete || img.naturalWidth === 0) {
                    setTimeout(initEvaluator, 100);
                    return;
                }
                _evalStarted = true;

                const W = img.naturalWidth;
                const H = img.naturalHeight;
                rawCanvas.width = W;
                rawCanvas.height = H;
                rawCtx.drawImage(img, 0, 0);

                const corners = autoDetectCorners(rawCtx, W, H);
                warpAndEvaluate(corners, W, H);
            }

            function toggleRawView() {
                showingRaw = !showingRaw;
                if (showingRaw) {
                    canvas.width = rawCanvas.width;
                    canvas.height = rawCanvas.height;
                    ctx.drawImage(rawCanvas, 0, 0);
                    toggleViewBtn.textContent = 'View Leveled & Cropped';
                } else {
                    canvas.width = leveledCanvas.width;
                    canvas.height = leveledCanvas.height;
                    ctx.drawImage(leveledCanvas, 0, 0);
                    toggleViewBtn.textContent = 'View Raw Upload';
                }
            }

            function orderCorners(pts) {
                if (!pts || pts.length !== 4) return pts;
                let tl = pts[0], br = pts[0], tr = pts[0], bl = pts[0];
                let minSum = pts[0].x + pts[0].y, maxSum = minSum;
                let maxDiff = pts[0].x - pts[0].y, minDiff = maxDiff;

                for (let i = 1; i < pts.length; i++) {
                    const p = pts[i];
                    const sum = p.x + p.y;
                    const diff = p.x - p.y;
                    if (sum < minSum) { minSum = sum; tl = p; }
                    if (sum > maxSum) { maxSum = sum; br = p; }
                    if (diff > maxDiff) { maxDiff = diff; tr = p; }
                    if (diff < minDiff) { minDiff = diff; bl = p; }
                }

                const unique = new Set([tl, tr, br, bl]);
                if (unique.size === 4) {
                    return [tl, tr, br, bl];
                }

                const cx = (pts[0].x + pts[1].x + pts[2].x + pts[3].x) / 4;
                const cy = (pts[0].y + pts[1].y + pts[2].y + pts[3].y) / 4;
                const sorted = [...pts].map(p => ({
                    x: p.x,
                    y: p.y,
                    angle: Math.atan2(p.y - cy, p.x - cx)
                })).sort((a, b) => a.angle - b.angle);

                let minAngleDiff = Infinity;
                let tlIdx = 0;
                const targetAngle = -2.35619;
                sorted.forEach((p, idx) => {
                    let diff = Math.abs(p.angle - targetAngle);
                    if (diff > Math.PI) diff = 2 * Math.PI - diff;
                    if (diff < minAngleDiff) {
                        minAngleDiff = diff;
                        tlIdx = idx;
                    }
                });

                return [
                    sorted[tlIdx],
                    sorted[(tlIdx + 1) % 4],
                    sorted[(tlIdx + 2) % 4],
                    sorted[(tlIdx + 3) % 4]
                ].map(p => ({ x: p.x, y: p.y }));
            }

            function getPerspectiveTransform(src, dst) {
                const A = [], B = [];
                for (let i = 0; i < 4; i++) {
                    const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                    A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                    A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
                }
                const n = 8;
                for (let i = 0; i < n; i++) {
                    let maxRow = i;
                    for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                    [A[i], A[maxRow]] = [A[maxRow], A[i]];[B[i], B[maxRow]] = [B[maxRow], B[i]];
                    const pivot = A[i][i];
                    if (Math.abs(pivot) < 1e-10) return null;
                    for (let j = i; j < n; j++) A[i][j] /= pivot;
                    B[i] /= pivot;
                    for (let k = 0; k < n; k++) {
                        if (k !== i) {
                            const factor = A[k][i];
                            for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                            B[k] -= factor * B[i];
                        }
                    }
                }
                return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
            }

            let _omrBuf = { gray: null, visited: null, queue: null, hist: new Int32Array(256), cap: 0 };
            function _ensureBuffers(total) {
                if (_omrBuf.cap < total) {
                    _omrBuf.gray = new Uint8Array(total);
                    _omrBuf.visited = new Uint8Array(total);
                    _omrBuf.queue = new Int32Array(total);
                    _omrBuf.cap = total;
                }
            }

            function autoDetectCorners(ctx, sw, sh) {
                const total = sw * sh;
                _ensureBuffers(total);

                const imgData = ctx.getImageData(0, 0, sw, sh);
                const data = imgData.data;
                const gray = _omrBuf.gray;
                const hist = _omrBuf.hist;
                hist.fill(0);

                let pIdx = 0;
                for (let i = 0; i < data.length; i += 4) {
                    const g = (data[i] * 77 + data[i + 1] * 150 + data[i + 2] * 29) >> 8;
                    gray[pIdx++] = g;
                    hist[g]++;
                }

                let sum = 0;
                for (let i = 0; i < 256; i++) sum += i * hist[i];
                let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
                for (let i = 0; i < 256; i++) {
                    wB += hist[i];
                    if (wB === 0) continue;
                    const wF = total - wB;
                    if (wF === 0) break;
                    sumB += i * hist[i];
                    const diff = (sumB / wB) - ((sum - sumB) / wF);
                    const v = wB * wF * diff * diff;
                    if (v > maxVar) { maxVar = v; thresh = i + 1; }
                }
                thresh = Math.max(40, Math.min(thresh, 175));

                const visited = _omrBuf.visited;
                visited.fill(0, 0, total);
                const candidates = [];
                const queue = _omrBuf.queue;

                for (let py = 4; py < sh - 4; py += 2) {
                    for (let px = 4; px < sw - 4; px += 2) {
                        const startP = py * sw + px;
                        if (visited[startP] || gray[startP] >= thresh) continue;

                        let count = 0, sumX = 0, sumY = 0;
                        let minX = px, maxX = px, minY = py, maxY = py;
                        let qHead = 0, qTail = 0;
                        queue[qTail++] = startP;
                        visited[startP] = 1;

                        while (qHead < qTail) {
                            if (count > 2500) break;
                            const cur = queue[qHead++];
                            const cy = Math.floor(cur / sw);
                            const cx = cur % sw;
                            count++;
                            sumX += cx;
                            sumY += cy;
                            if (cx < minX) minX = cx;
                            if (cx > maxX) maxX = cx;
                            if (cy < minY) minY = cy;
                            if (cy > maxY) maxY = cy;

                            const neighbors = [cur - 1, cur + 1, cur - sw, cur + sw];
                            for (let k = 0; k < 4; k++) {
                                const nb = neighbors[k];
                                if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                    visited[nb] = 1;
                                    queue[qTail++] = nb;
                                }
                            }
                        }

                        const bw = maxX - minX + 1;
                        const bh = maxY - minY + 1;
                        const aspect = bw / bh;
                        const density = count / (bw * bh);

                        if (bw >= 5 && bh >= 5 && bw <= 55 && bh <= 55 && aspect >= 0.55 && aspect <= 1.80 && density >= 0.45 && count >= 14 && count <= 1400) {
                            const bx = sumX / count;
                            const by = sumY / count;
                            const blobR = Math.max(bw, bh) / 2;

                            const dirX = Math.sign((sw / 2) - bx);
                            const dirY = Math.sign((sh / 2) - by);
                            const rIn = Math.round(blobR * 1.3);
                            const rOut = Math.max(rIn + 3, Math.round(blobR * 2.5));
                            let darkPixels = 0, totalRing = 0;

                            for (let dy = -rOut; dy <= rOut; dy += 2) {
                                for (let dx = -rOut; dx <= rOut; dx += 2) {
                                    const d2 = dx * dx + dy * dy;
                                    if (d2 >= rIn * rIn && d2 <= rOut * rOut) {
                                        if ((dx * dirX + dy * dirY) >= -0.2 * blobR) {
                                            const gx = Math.round(bx + dx);
                                            const gy = Math.round(by + dy);
                                            if (gx >= 0 && gx < sw && gy >= 0 && gy < sh) {
                                                totalRing++;
                                                if (gray[gy * sw + gx] < thresh) darkPixels++;
                                            }
                                        }
                                    }
                                }
                            }

                            const ringDarkRatio = totalRing > 0 ? (darkPixels / totalRing) : 0;
                            if (ringDarkRatio > 0.22) continue;

                            let whiteInwardCount = 0;
                            const testDists = [Math.round(blobR * 1.3), Math.round(blobR * 1.9), Math.round(blobR * 2.5)];
                            for (let d of testDists) {
                                const ix = Math.round(bx + dirX * d);
                                const iy = Math.round(by + dirY * d);
                                if (ix >= 0 && ix < sw && iy >= 0 && iy < sh) {
                                    if (gray[iy * sw + ix] >= (thresh - 15)) whiteInwardCount++;
                                }
                            }

                            if (whiteInwardCount < 2) continue;

                            const distFromCenter = Math.hypot(bx - sw / 2, by - sh / 2);
                            const score = (density * 3.0) + (distFromCenter / (sw * 0.5) * 2.0) - (ringDarkRatio * 8.0);

                            candidates.push({ x: bx, y: by, bw, bh, count, score, density, distFromCenter });
                        }
                    }
                }

                if (candidates.length < 4) {
                    return [
                        { x: sw * 0.08, y: sh * 0.05 },
                        { x: sw * 0.92, y: sh * 0.05 },
                        { x: sw * 0.92, y: sh * 0.95 },
                        { x: sw * 0.08, y: sh * 0.95 }
                    ];
                }

                candidates.sort((a, b) => b.score - a.score);
                const topCandidates = candidates.slice(0, 10);
                const n = topCandidates.length;

                let bestQuad = null;

                function evaluateQuadCandidate(ordered) {
                    const [pTL, pTR, pBR, pBL] = ordered;

                    const pts = [pTL, pTR, pBR, pBL];
                    for (let i = 0; i < 4; i++) {
                        const a = pts[i];
                        const b = pts[(i + 1) % 4];
                        const c = pts[(i + 2) % 4];
                        const cross = (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
                        if (cross <= 0) return null;
                    }

                    const wTop = Math.hypot(pTR.x - pTL.x, pTR.y - pTL.y);
                    const wBot = Math.hypot(pBR.x - pBL.x, pBR.y - pBL.y);
                    const hLeft = Math.hypot(pBL.x - pTL.x, pBL.y - pTL.y);
                    const hRight = Math.hypot(pBR.x - pTR.x, pBR.y - pTR.y);

                    const wRatio = Math.min(wTop, wBot) / Math.max(wTop, wBot);
                    const hRatio = Math.min(hLeft, hRight) / Math.max(hLeft, hRight);
                    if (wRatio < 0.50 || hRatio < 0.50) return null;

                    const avgW = (wTop + wBot) / 2;
                    const avgH = (hLeft + hRight) / 2;
                    const aspect = avgH / avgW;
                    if (aspect < 1.00 || aspect > 2.10) return null;

                    const d1 = Math.hypot(pBR.x - pTL.x, pBR.y - pTL.y);
                    const d2 = Math.hypot(pBL.x - pTR.x, pBL.y - pTR.y);
                    if (Math.min(d1, d2) / Math.max(d1, d2) < 0.55) return null;

                    const quadArea = 0.5 * Math.abs(
                        (pTL.x * pTR.y - pTL.y * pTR.x) +
                        (pTR.x * pBR.y - pTR.y * pBR.x) +
                        (pBR.x * pBL.y - pBR.y * pBL.x) +
                        (pBL.x * pTL.y - pBL.y * pTL.x)
                    );
                    if (quadArea < sw * sh * 0.08) return null;

                    const counts = [pTL.count, pTR.count, pBR.count, pBL.count];
                    const minC = Math.min(...counts);
                    const maxC = Math.max(...counts);
                    if (minC / maxC < 0.12) return null;

                    const aspectDev = Math.abs(aspect - 1.461);
                    const score = quadArea * (1.0 - aspectDev * 0.4) * wRatio * hRatio;

                    return { ordered, score };
                }

                for (let i = 0; i < n; i++) {
                    for (let j = i + 1; j < n; j++) {
                        for (let k = j + 1; k < n; k++) {
                            for (let l = k + 1; l < n; l++) {
                                const quad4 = [topCandidates[i], topCandidates[j], topCandidates[k], topCandidates[l]];
                                const ordered = orderCorners(quad4);
                                if (!ordered) continue;
                                const res = evaluateQuadCandidate(ordered);
                                if (res && (!bestQuad || res.score > bestQuad.score)) {
                                    bestQuad = res;
                                }
                            }
                        }
                    }
                }

                if (!bestQuad) {
                    return [
                        { x: sw * 0.08, y: sh * 0.05 },
                        { x: sw * 0.92, y: sh * 0.05 },
                        { x: sw * 0.92, y: sh * 0.95 },
                        { x: sw * 0.08, y: sh * 0.95 }
                    ];
                }
                return bestQuad.ordered;
            }

            function warpAndEvaluate(corners, W, H) {
                const orderedCorners = orderCorners(corners);
                leveledCanvas.width = TARGET_W;
                leveledCanvas.height = TARGET_H;

                const dstRectCorners = [
                    { x: 0, y: 0 },
                    { x: TARGET_W, y: 0 },
                    { x: TARGET_W, y: TARGET_H },
                    { x: 0, y: TARGET_H }
                ];

                const srcImgData = rawCtx.getImageData(0, 0, W, H);
                const srcData = srcImgData.data;
                const src32 = new Uint32Array(srcImgData.data.buffer);

                function refineCornerSubpixel(pt) {
                    const searchR = Math.max(12, Math.min(24, Math.round(Math.min(W, H) * 0.018)));
                    const minX = Math.max(0, Math.round(pt.x - searchR));
                    const maxX = Math.min(W - 1, Math.round(pt.x + searchR));
                    const minY = Math.max(0, Math.round(pt.y - searchR));
                    const maxY = Math.min(H - 1, Math.round(pt.y + searchR));

                    let minLum = 255, seedX = Math.round(pt.x), seedY = Math.round(pt.y);
                    for (let y = minY; y <= maxY; y++) {
                        const rowIdx = y * W;
                        for (let x = minX; x <= maxX; x++) {
                            const idx = (rowIdx + x) * 4;
                            const lum = (srcData[idx] * 77 + srcData[idx + 1] * 150 + srcData[idx + 2] * 29) >> 8;
                            if (lum < minLum) {
                                minLum = lum;
                                seedX = x;
                                seedY = y;
                            }
                        }
                    }

                    if (minLum > 140) return pt;

                    const markerThresh = minLum + 45;
                    const maxR = Math.max(18, searchR * 1.6);
                    const maxR2 = maxR * maxR;
                    const winDim = Math.round(maxR * 2) + 3;
                    const visited = new Uint8Array(winDim * winDim);
                    const ox = seedX - Math.round(maxR) - 1;
                    const oy = seedY - Math.round(maxR) - 1;

                    const qX = new Int32Array(4096);
                    const qY = new Int32Array(4096);
                    let qHead = 0, qTail = 0;

                    const startLx = seedX - ox;
                    const startLy = seedY - oy;
                    visited[startLy * winDim + startLx] = 1;
                    qX[qTail] = seedX;
                    qY[qTail] = seedY;
                    qTail++;

                    let sumX = 0, sumY = 0, count = 0;

                    while (qHead < qTail && count < 3500) {
                        const cx = qX[qHead];
                        const cy = qY[qHead];
                        qHead++;

                        sumX += cx;
                        sumY += cy;
                        count++;

                        const neighbors = [
                            [cx - 1, cy], [cx + 1, cy], [cx, cy - 1], [cx, cy + 1]
                        ];
                        for (let k = 0; k < 4; k++) {
                            const nx = neighbors[k][0];
                            const ny = neighbors[k][1];
                            if (nx < 0 || nx >= W || ny < 0 || ny >= H) continue;

                            const dx = nx - seedX;
                            const dy = ny - seedY;
                            if (dx * dx + dy * dy > maxR2) continue;

                            const lx = nx - ox;
                            const ly = ny - oy;
                            if (lx < 0 || lx >= winDim || ly < 0 || ly >= winDim) continue;
                            const vIdx = ly * winDim + lx;
                            if (visited[vIdx]) continue;
                            visited[vIdx] = 1;

                            const pIdx = (ny * W + nx) * 4;
                            const lum = (srcData[pIdx] * 77 + srcData[pIdx + 1] * 150 + srcData[pIdx + 2] * 29) >> 8;
                            if (lum < markerThresh) {
                                if (qTail < 4090) {
                                    qX[qTail] = nx;
                                    qY[qTail] = ny;
                                    qTail++;
                                }
                            }
                        }
                    }

                    if (count >= 16) {
                        return { x: sumX / count, y: sumY / count };
                    }
                    return pt;
                }

                const refinedCorners = orderedCorners.map(p => refineCornerSubpixel(p));
                const H_mat = getPerspectiveTransform(dstRectCorners, refinedCorners);

                const dstImgData = leveledCtx.createImageData(TARGET_W, TARGET_H);
                const dst32 = new Uint32Array(dstImgData.data.buffer);

                const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
                const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
                const h6 = H_mat[6], h7 = H_mat[7];

                let dstIdx = 0;
                for (let y = 0; y < TARGET_H; y++) {
                    const wx = h1 * y + h2;
                    const wy = h4 * y + h5;
                    const wz = h7 * y + 1;
                    for (let x = 0; x < TARGET_W; x++) {
                        const z = 1 / (h6 * x + wz);
                        const sx = Math.round((h0 * x + wx) * z);
                        const sy = Math.round((h3 * x + wy) * z);
                        if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                            dst32[dstIdx] = src32[sy * W + sx];
                        } else {
                            dst32[dstIdx] = 0xFFFFFFFF;
                        }
                        dstIdx++;
                    }
                }

                leveledCtx.putImageData(dstImgData, 0, 0);

                try {
                    window.cleanLeveledImageData = leveledCanvas.toDataURL('image/jpeg', 0.78);
                } catch (e) {
                    window.cleanLeveledImageData = leveledCanvas.toDataURL();
                }

                evaluateJeeSheet(leveledCtx, TARGET_W, TARGET_H, 0, 0, TARGET_W, TARGET_H);

                canvas.width = TARGET_W;
                canvas.height = TARGET_H;
                ctx.drawImage(leveledCanvas, 0, 0);

                evalStatus.textContent = 'Evaluation Complete';
                evalStatus.className = 'status-pill ready';
            }

            let lastRollNumber = '';
            let lastBreakdown = [];

            function evaluateJeeSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
                const imgData = ctx.getImageData(0, 0, W, H);
                const data = imgData.data;

                function getGray(x, y) {
                    if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                    const idx = (y * W + x) * 4;
                    return (data[idx] * 77 + data[idx + 1] * 150 + data[idx + 2] * 29) >> 8;
                }

                function sampleDisk(cx, cy, r) {
                    let sum = 0, count = 0;
                    const r2 = r * r;
                    const ir = Math.ceil(r);
                    for (let dy = -ir; dy <= ir; dy++) {
                        for (let dx = -ir; dx <= ir; dx++) {
                            if (dx * dx + dy * dy <= r2) {
                                sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                                count++;
                            }
                        }
                    }
                    return count > 0 ? (sum / count) : 255;
                }

                function sampleBubbleFeatures(nominalX, nominalY, paperVal) {
                    const offsets = [
                        [0, 0], [-1.0, 0], [1.0, 0], [0, -1.0], [0, 1.0]
                    ];
                    let bestStat = null;

                    for (let k = 0; k < offsets.length; k++) {
                        const cx = nominalX + offsets[k][0];
                        const cy = nominalY + offsets[k][1];
                        let midSum = 0, midCount = 0, darkMidCount = 0;
                        let fullSum = 0, fullCount = 0;

                        for (let dy = -6; dy <= 6; dy++) {
                            for (let dx = -6; dx <= 6; dx++) {
                                const d2 = dx * dx + dy * dy;
                                const d = Math.sqrt(d2);
                                if (d > 5.8) continue;

                                const g = getGray(Math.round(cx + dx), Math.round(cy + dy));
                                fullSum += g;
                                fullCount++;

                                if (d >= 2.5 && d <= 5.8) {
                                    midSum += g;
                                    midCount++;
                                    if (g < (paperVal - 22)) darkMidCount++;
                                }
                            }
                        }

                        if (midCount === 0 || fullCount === 0) continue;

                        const midMean = midSum / midCount;
                        const fullMean = fullSum / fullCount;
                        const midDarkness = Math.max(0, paperVal - midMean);
                        const fullDarkness = Math.max(0, paperVal - fullMean);
                        const midDarkRatio = darkMidCount / midCount;
                        const fillScore = midDarkness * 0.70 + fullDarkness * 0.30;

                        if (!bestStat || fillScore > bestStat.fillScore) {
                            bestStat = { midDarkness, fullDarkness, midDarkRatio, fillScore };
                        }
                    }

                    return bestStat || { midDarkness: 0, fullDarkness: 0, midDarkRatio: 0, fillScore: 0 };
                }

                // 1. DETECT 8-DIGIT ROLL NUMBER
                const rollRadius = 8.5;
                let detectedRollNumber = '';
                let rollDigitsArray = [];

                for (let c = 0; c < 8; c++) {
                    const colX = markerL + (U_ROLL_START + c * U_ROLL_COL_STEP) * markerW;
                    const paperVal = sampleDisk(colX, markerT + (V_ROLL_START - 0.015) * markerH, 4.0);

                    let digitScores = [];
                    for (let d = 0; d <= 9; d++) {
                        const rowY = markerT + (V_ROLL_START + d * V_ROLL_ROW_STEP) * markerH;
                        const sample = sampleBubbleFeatures(colX, rowY, paperVal);
                        digitScores.push({ digit: d, ...sample, x: colX, y: rowY });
                    }

                    const sortedAsc = [...digitScores].sort((a, b) => a.fillScore - b.fillScore);
                    const colBase = (sortedAsc[0].fillScore + sortedAsc[1].fillScore) / 2;

                    const filledDigits = digitScores.filter(d => {
                        const contrast = d.fillScore - colBase;
                        return (d.midDarkness >= 26 && contrast >= 14) ||
                               (d.fillScore >= 42 && contrast >= 16);
                    });

                    if (filledDigits.length === 1) {
                        const chosen = filledDigits[0];
                        detectedRollNumber += chosen.digit;
                        rollDigitsArray.push(chosen.digit);

                        ctx.beginPath();
                        ctx.arc(chosen.x, chosen.y, rollRadius, 0, 2 * Math.PI);
                        ctx.lineWidth = 2.5;
                        ctx.strokeStyle = '#2563EB';
                        ctx.fillStyle = 'rgba(37, 99, 235, 0.40)';
                        ctx.fill();
                        ctx.stroke();
                    } else if (filledDigits.length > 1) {
                        const best = [...filledDigits].sort((a, b) => b.fillScore - a.fillScore)[0];
                        detectedRollNumber += best.digit;
                        rollDigitsArray.push(best.digit);

                        ctx.beginPath();
                        ctx.arc(best.x, best.y, rollRadius, 0, 2 * Math.PI);
                        ctx.lineWidth = 2.5;
                        ctx.strokeStyle = '#F59E0B';
                        ctx.fillStyle = 'rgba(245, 158, 11, 0.40)';
                        ctx.fill();
                        ctx.stroke();
                    } else {
                        detectedRollNumber += '-';
                        rollDigitsArray.push(null);
                    }
                }

                lastRollNumber = detectedRollNumber;

                const rollBoxes = document.getElementById('rollBoxesDisplay');
                if (rollBoxes) {
                    rollBoxes.innerHTML = '';
                    for (let i = 0; i < 8; i++) {
                        const box = document.createElement('div');
                        const val = rollDigitsArray[i];
                        if (val !== null && val !== undefined) {
                            box.className = 'roll-digit-box filled';
                            box.textContent = val;
                        } else {
                            box.className = 'roll-digit-box unknown';
                            box.textContent = '-';
                        }
                        rollBoxes.appendChild(box);
                    }
                }

                const pill = document.getElementById('rollStatusPill');
                const cleanRoll = detectedRollNumber.replace(/-/g, '');
                if (pill) {
                    if (cleanRoll.length === 8) {
                        pill.textContent = 'Detected (' + cleanRoll + ')';
                        pill.style.background = '#F0FDF4';
                        pill.style.color = '#15803D';
                        pill.style.borderColor = '#BBF7D0';
                    } else if (cleanRoll.length > 0) {
                        pill.textContent = 'Partial (' + cleanRoll + ')';
                        pill.style.background = '#FEF3C7';
                        pill.style.color = '#D97706';
                        pill.style.borderColor = '#FDE68A';
                    } else {
                        pill.textContent = 'Not Found';
                        pill.style.background = '#FEF2F2';
                        pill.style.color = '#B91C1C';
                        pill.style.borderColor = '#FECACA';
                    }
                }

                // 2. DETECT JEE MAINS MCQS (STRICTLY Q1-20, Q41-60, Q81-100 ONLY)
                const bubbleRadius = 9.0;
                let correctCount = 0;
                let wrongCount = 0;
                let multipleCount = 0;
                let attemptedCount = 0;
                let blankCount = 0;
                let rowsHtml = '';
                const questionBreakdown = [];

                mcqScores = {
                    phy: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                    chem: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                    math: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 }
                };

                for (let idx = 0; idx < JEE_QUESTIONS.length; idx++) {
                    const item = JEE_QUESTIONS[idx];
                    const q = item.q;
                    const subject = item.subject;
                    const subKey = item.subKey;

                    const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                    const row = (q - 1) % QUESTIONS_PER_COL;

                    const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                    const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                    const optD_X = colX + 3 * U_BUBBLE_STEP * markerW;
                    const gutterSampleX = Math.min(W - 14, optD_X + 16);
                    const paperVal1 = sampleDisk(gutterSampleX, rowY, 3.5);
                    const paperVal2 = sampleDisk(Math.max(14, colX - 16), rowY, 3.5);
                    const paperVal = Math.max(paperVal1, paperVal2);

                    let bubbleStats = [];
                    for (let b = 0; b < 4; b++) {
                        const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;
                        const sample = sampleBubbleFeatures(bubbleX, rowY, paperVal);
                        bubbleStats.push({ opt: OPTIONS[b], ...sample, x: bubbleX, y: rowY });
                    }

                    const sortedAsc = [...bubbleStats].sort((a, b) => a.fillScore - b.fillScore);
                    const rowBase = (sortedAsc[0].fillScore + sortedAsc[1].fillScore) / 2;

                    function isOptionFilled(s) {
                        const contrast = s.fillScore - rowBase;
                        if (s.midDarkness >= 36 && contrast >= 16) return true;
                        if (s.midDarkness >= 26 && contrast >= 14 && s.midDarkRatio >= 0.28) return true;
                        if (s.fillScore >= 48 && contrast >= 16) return true;
                        if (s.midDarkness >= 55 && s.midDarkRatio >= 0.50 && s.fullDarkness >= 45) return true;
                        return false;
                    }

                    const filledCandidates = bubbleStats.filter(b => isOptionFilled(b));
                    let filledBubbles = [];

                    if (filledCandidates.length === 0) {
                        filledBubbles = [];
                    } else if (filledCandidates.length === 1) {
                        filledBubbles = filledCandidates;
                    } else {
                        const sortedCandidates = [...filledCandidates].sort((a, b) => b.fillScore - a.fillScore);
                        const top1 = sortedCandidates[0];
                        const top2 = sortedCandidates[1];

                        if (top1.fillScore - top2.fillScore >= 35 && top1.fillScore >= 55) {
                            filledBubbles = [top1];
                        } else {
                            filledBubbles = filledCandidates;
                        }
                    }

                    const isMultiple = filledBubbles.length > 1;
                    const detectedAnswer = filledBubbles.map(b => b.opt).join(', ');
                    const correctAns = answerKey[q.toString()] || '';

                    let verdict = 'unmarked';

                    if (isMultiple) {
                        attemptedCount++;
                        wrongCount++;
                        multipleCount++;
                        verdict = 'multiple';
                        mcqScores[subKey].multiple++;
                    } else if (filledBubbles.length === 1) {
                        const singleAns = filledBubbles[0].opt;
                        attemptedCount++;
                        if (correctAns && singleAns === correctAns) {
                            correctCount++;
                            verdict = 'correct';
                            mcqScores[subKey].correct++;
                        } else if (correctAns) {
                            wrongCount++;
                            verdict = 'wrong';
                            mcqScores[subKey].wrong++;
                        } else {
                            verdict = 'marked';
                            mcqScores[subKey].correct++;
                        }
                    } else {
                        blankCount++;
                        mcqScores[subKey].blank++;
                    }

                    questionBreakdown.push({
                        q: q,
                        subject: subject,
                        subKey: subKey,
                        marked: detectedAnswer || '',
                        correctKey: correctAns || '',
                        verdict: verdict
                    });

                    // Draw Overlay Rings strictly on these checked questions
                    for (let b = 0; b < 4; b++) {
                        const opt = OPTIONS[b];
                        const stat = bubbleStats[b];
                        const isThisBubbleFilled = filledBubbles.some(f => f.opt === opt);

                        ctx.beginPath();
                        ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                        ctx.lineWidth = Math.max(2, Math.round(W * 0.002));

                        if (isMultiple && isThisBubbleFilled) {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                            ctx.fill();
                            ctx.stroke();

                            ctx.strokeStyle = '#FFFFFF';
                            ctx.lineWidth = 2;
                            const sz = Math.round(bubbleRadius * 0.5);
                            ctx.beginPath();
                            ctx.moveTo(stat.x - sz, stat.y - sz);
                            ctx.lineTo(stat.x + sz, stat.y + sz);
                            ctx.moveTo(stat.x + sz, stat.y - sz);
                            ctx.lineTo(stat.x - sz, stat.y + sz);
                            ctx.stroke();
                        } else if (isThisBubbleFilled) {
                            if (verdict === 'correct') {
                                ctx.strokeStyle = '#10B981';
                                ctx.fillStyle = 'rgba(16, 185, 129, 0.55)';
                            } else if (verdict === 'wrong') {
                                ctx.strokeStyle = '#EF4444';
                                ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                            } else {
                                ctx.strokeStyle = '#06B6D4';
                                ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                            }
                            ctx.fill();
                            ctx.stroke();
                        } else if (correctAns && opt === correctAns && verdict === 'wrong') {
                            ctx.strokeStyle = '#10B981';
                            ctx.setLineDash([3, 3]);
                            ctx.stroke();
                            ctx.setLineDash([]);
                        } else {
                            ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                            ctx.stroke();
                        }
                    }

                    let badgeClass = 'badge-blank';
                    let verdictText = 'Blank';
                    let markedCellHtml = '<span style="color:#94A3B8;">-</span>';

                    if (verdict === 'multiple') {
                        badgeClass = 'badge-multiple';
                        verdictText = 'Multiple';
                        markedCellHtml = '<strong style="color: #DC2626; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                    } else if (verdict === 'correct') {
                        badgeClass = 'badge-correct';
                        verdictText = 'Correct (+4)';
                        markedCellHtml = '<strong style="color: #15803D; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                    } else if (verdict === 'wrong') {
                        badgeClass = 'badge-wrong';
                        verdictText = 'Wrong (-1)';
                        markedCellHtml = '<strong style="color: #DC2626; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                    } else if (verdict === 'marked') {
                        badgeClass = 'badge-marked';
                        verdictText = 'Marked';
                        markedCellHtml = '<strong style="color: var(--primary); font-size:0.95rem;">' + detectedAnswer + '</strong>';
                    }

                    const subIcon = subKey === 'phy' ? '⚛️ Phy' : (subKey === 'chem' ? '🧪 Chem' : '📐 Math');

                    rowsHtml += '<tr>' +
                        '<td style="font-size:0.75rem; font-weight:700; color:var(--text-muted);">' + subIcon + '</td>' +
                        '<td style="font-weight:700; font-family:\'JetBrains Mono\',monospace;">Q' + q + '</td>' +
                        '<td>' + markedCellHtml + '</td>' +
                        '<td style="font-family:\'JetBrains Mono\',monospace; font-weight:700; color:var(--text-muted);">' + (correctAns || '-') + '</td>' +
                        '<td><span class="badge ' + badgeClass + '">' + verdictText + '</span></td>' +
                        '</tr>';
                }

                lastBreakdown = questionBreakdown;
                document.getElementById('tableBody').innerHTML = rowsHtml;
                document.getElementById('statCorrect').textContent = correctCount;
                document.getElementById('statWrong').textContent = wrongCount;
                document.getElementById('statMultiple').textContent = multipleCount;
                document.getElementById('statAttempted').textContent = attemptedCount;
                document.getElementById('statBlank').textContent = blankCount;

                updateJeeTotals();
                saveJeeEvaluation();
            }

            let _saveTimeout = null;
            function saveJeeEvaluation() {
                if (_saveTimeout) clearTimeout(_saveTimeout);
                _saveTimeout = setTimeout(() => {
                    const statusPill = document.getElementById('evalStatus');
                    let rollNo = (lastRollNumber || '').replace(/-/g, '');
                    if (!rollNo || rollNo.length === 0) {
                        rollNo = 'STUDENT-' + Date.now().toString().slice(-4);
                    }

                    const sumArr = (arr) => arr.reduce((acc, v) => acc + v, 0);
                    const phyTotal = ((mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple) + sumArr(numericalScores.phy);
                    const chemTotal = ((mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple) + sumArr(numericalScores.chem);
                    const mathTotal = ((mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple) + sumArr(numericalScores.math);
                    const grandTotal = phyTotal + chemTotal + mathTotal;

                    const imageData = window.cleanLeveledImageData || (typeof leveledCanvas !== 'undefined' ? leveledCanvas.toDataURL('image/jpeg', 0.78) : null);
                    if (!imageData) return;

                    if (statusPill) statusPill.textContent = 'Saving evaluation...';

                    fetch('/api/paper/<%= encodeURIComponent(paper._id) %>/jee-save-result', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            rollNumber: rollNo,
                            score: grandTotal,
                            totalQuestions: 75,
                            maxMarks: 300,
                            numericalScores: numericalScores,
                            mcqSubjectScores: {
                                phy: { score: (mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple, correct: mcqScores.phy.correct, wrong: mcqScores.phy.wrong + mcqScores.phy.multiple, blank: mcqScores.phy.blank },
                                chem: { score: (mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple, correct: mcqScores.chem.correct, wrong: mcqScores.chem.wrong + mcqScores.chem.multiple, blank: mcqScores.chem.blank },
                                math: { score: (mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple, correct: mcqScores.math.correct, wrong: mcqScores.math.wrong + mcqScores.math.multiple, blank: mcqScores.math.blank }
                            },
                            breakdown: lastBreakdown,
                            imageData: imageData
                        })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (statusPill && data.success) {
                            statusPill.innerHTML = 'Saved to Cloudinary &middot; <a href="/paper/<%= encodeURIComponent(paper._id) %>/results" style="color:inherit; font-weight:700; text-decoration:underline;">View Results</a>';
                            statusPill.className = 'status-pill ready';
                        }
                    })
                    .catch(e => {
                        console.warn('Save error:', e);
                        if (statusPill) statusPill.textContent = 'Evaluation Complete';
                    });
                }, 500);
            }

            window.addEventListener('DOMContentLoaded', initEvaluator);
        </script>
    <%- include('partials/sidebar_end') %>
</body>
</html>
