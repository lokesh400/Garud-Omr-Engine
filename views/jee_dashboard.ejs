<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEE Mains Portal • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .jee-container {
            max-width: 1320px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 3rem 1.5rem;
        }

        /* Sleek Top Header Bar */
        .jee-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .jee-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .jee-page-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -0.01em;
        }

        .count-pill {
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.75rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        .jee-header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .jee-search-box {
            position: relative;
            min-width: 240px;
        }

        .jee-search-box input {
            width: 100%;
            padding: 7px 10px 7px 32px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-family: inherit;
            color: var(--text-main);
            background: #FFFFFF;
            transition: var(--transition);
        }

        .jee-search-box input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .jee-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        /* Dynamic Category / Section Filter Bar */
        .category-filter-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 1.25rem;
            padding: 4px 0;
        }

        .cat-filter-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-right: 4px;
        }

        .cat-pill {
            background: #FFFFFF;
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 140ms ease;
            user-select: none;
        }

        .cat-pill:hover {
            border-color: var(--border-hover);
            background: var(--surface-subtle);
        }

        .cat-pill.active {
            background: #1D4ED8;
            color: #FFFFFF;
            border-color: #1D4ED8;
            box-shadow: 0 2px 6px rgba(29, 78, 216, 0.25);
        }

        /* Compact Attractive Cards Grid */
        .jee-papers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 1.15rem;
        }

        .jee-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-top: 3.5px solid #2563EB;
            border-radius: var(--radius-md);
            padding: 1rem 1.15rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.85rem;
            box-shadow: var(--shadow-xs);
            transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
        }

        .jee-card:hover {
            border-color: #93C5FD;
            box-shadow: 0 6px 16px -3px rgba(15, 23, 42, 0.08);
            transform: translateY(-2px);
        }

        .jee-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 6px;
        }

        .jee-card-title {
            font-size: 0.98rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            line-height: 1.35;
        }

        .jee-status-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 7px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .status-ready {
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid #A7F3D0;
        }

        .status-pending {
            background: #FFFBEB;
            color: #92400E;
            border: 1px solid #FDE68A;
        }

        .status-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
        }

        .status-ready .status-dot { background: #10B981; }
        .status-pending .status-dot { background: #F59E0B; }

        .jee-meta-chips {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 4px;
        }

        .jee-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            padding: 2px 7px;
            border-radius: var(--radius-xs);
            font-size: 0.72rem;
            color: var(--text-body);
            font-weight: 600;
        }

        .jee-chip-cat {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            font-weight: 700;
        }

        .jee-chip-copies {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }

        .jee-card-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        /* Action Buttons Row: Side by Side */
        .jee-actions-row {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            padding-top: 0.75rem;
            border-top: 1px solid var(--border-color);
        }

        .btn-action-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 5px 9px;
            border-radius: var(--radius-sm);
            font-size: 0.78rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 130ms ease;
            white-space: nowrap;
            border: 1px solid transparent;
            font-family: inherit;
        }

        .btn-act-key {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
        }
        .btn-act-key:hover { background: #DBEAFE; }

        .btn-act-scan {
            background: #2563EB;
            color: #FFFFFF;
            border-color: #1D4ED8;
        }
        .btn-act-scan:hover { background: #1D4ED8; }

        .btn-act-eval {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }
        .btn-act-eval:hover { background: #DCFCE7; }

        .btn-act-results {
            background: #FFFFFF;
            color: var(--text-body);
            border-color: var(--border-hover);
        }
        .btn-act-results:hover { background: var(--surface-subtle); color: var(--text-main); }

        .btn-act-print {
            background: #F8FAFC;
            color: #475569;
            border-color: #E2E8F0;
        }
        .btn-act-print:hover { background: #F1F5F9; color: #1E293B; }

        .btn-act-delete {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
            margin-left: auto;
        }
        .btn-act-delete:hover { background: #FEE2E2; color: #991B1B; }

        @media (max-width: 680px) {
            .jee-container { padding: 1rem 0.85rem 2.5rem 0.85rem; }
            .jee-header-bar { flex-direction: column; align-items: stretch; gap: 10px; }
            .jee-header-right { flex-direction: column; align-items: stretch; }
            .jee-search-box { min-width: 100%; }
            .jee-papers-grid { grid-template-columns: 1fr; }
            .btn-act-delete { margin-left: 0; }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'jee' }) %>
    <div class="container">
        <main class="jee-container">
            <!-- Compact Header Bar -->
            <header class="jee-header-bar">
                <div class="jee-header-left">
                    <h1 class="jee-page-title">⚛️ JEE Mains Exams</h1>
                    <span class="count-pill" id="paperCountBadge"><%= papers ? papers.length : 0 %> Papers</span>
                </div>

                <div class="jee-header-right">
                    <div class="jee-search-box">
                        <span class="jee-search-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="search" id="jeeSearchInput" aria-label="Search JEE Papers" placeholder="Search JEE papers..." oninput="filterJeePapers()">
                    </div>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/jee/new" class="btn btn-primary btn-sm" id="btnCreateJeeTop" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            + New JEE Paper
                        </a>
                    <% } %>

                    <a href="/" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                        &larr; Standard Exams
                    </a>
                </div>
            </header>

            <!-- Dynamic Category / Section Filter Bar -->
            <nav class="category-filter-bar" aria-label="Filter by section or category">
                <span class="cat-filter-label">Section:</span>
                <button type="button" class="cat-pill active" data-cat="all" onclick="setCategoryFilter('all', this)">All</button>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                        <button type="button" class="cat-pill" data-cat="<%= cat.toLowerCase() %>" onclick="setCategoryFilter('<%= cat.toLowerCase() %>', this)"><%= cat %></button>
                    <% }) %>
                <% } %>
            </nav>

            <!-- Papers Grid -->
            <% if (papers && papers.length > 0) { %>
                <div class="jee-papers-grid" id="jeePapersGrid">
                    <% papers.forEach(paper => { %>
                        <% 
                            const hasKey = (Array.isArray(paper.answer_key) && paper.answer_key.some(k => k)) ||
                                           (paper.answerKey && (paper.answerKey.size > 0 || Object.keys(paper.answerKey).length > 0));
                            const encodedId = encodeURIComponent(paper._id);
                            const pIdStr = String(paper._id);
                            const count = (typeof subCounts !== 'undefined' && subCounts[pIdStr]) ? subCounts[pIdStr] : 0;
                            const paperCat = (paper.category || paper.batch || '12th JEE').trim();
                            const searchStr = `${paper.title || ''} ${pIdStr} ${paperCat}`.toLowerCase();
                        %>
                        <article class="jee-card jee-paper-item" id="card-<%= pIdStr %>" data-search="<%= searchStr %>" data-category="<%= paperCat.toLowerCase() %>">
                            <div>
                                <div class="jee-card-header">
                                    <h3 class="jee-card-title"><%= paper.title %></h3>
                                    <% if (hasKey) { %>
                                        <span class="jee-status-chip status-ready" title="Answer key configured">
                                            <span class="status-dot"></span> Ready
                                        </span>
                                    <% } else { %>
                                        <span class="jee-status-chip status-pending" title="Answer key not fully configured">
                                            <span class="status-dot"></span> Key Pending
                                        </span>
                                    <% } %>
                                </div>

                                <div class="jee-meta-chips">
                                    <span class="jee-chip jee-chip-cat">📁 <%= paperCat %></span>
                                    <span class="jee-chip">300M &bull; 75 Qs</span>
                                    <span class="jee-chip jee-chip-copies">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <%= count %> Evaluated
                                    </span>
                                </div>

                                <div class="jee-card-footer-info">
                                    <span>ID: <code style="font-family:'JetBrains Mono',monospace;"><%= pIdStr.slice(-8) %></code></span>
                                    <span><%= paper.createdAt ? new Date(paper.createdAt).toLocaleDateString() : 'NTA Pattern' %></span>
                                </div>
                            </div>

                            <!-- Buttons Side-by-Side in Horizontal Row -->
                            <div class="jee-actions-row">
                                <a href="/paper/<%= encodedId %>/jee-answerkey" class="btn-action-pill btn-act-key" title="Configure 3-Section JEE Answer Key">
                                    ⚛️ Key
                                </a>

                                <% if (currentUser && currentUser.role === 'admin') { %>
                                    <a href="/paper/<%= encodedId %>/jee-scan" class="btn-action-pill btn-act-scan" title="Launch Camera Scanner">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                            <circle cx="12" cy="13" r="4"></circle>
                                        </svg>
                                        Scan
                                    </a>

                                    <a href="/paper/<%= encodedId %>/jee-evaluator" class="btn-action-pill btn-act-eval" title="Upload and evaluate file">
                                        📁 Eval
                                    </a>
                                <% } %>

                                <a href="/paper/<%= encodedId %>/results" class="btn-action-pill btn-act-results" title="View Evaluated Copies & Results">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    Results
                                </a>

                                <a href="/paper/<%= encodedId %>/omr" target="_blank" rel="noopener" class="btn-action-pill btn-act-print" title="Print A4 OMR Sheet">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                        <rect x="6" y="14" width="12" height="8"></rect>
                                    </svg>
                                    OMR
                                </a>

                                <% if (currentUser && currentUser.role === 'admin') { %>
                                    <button type="button" class="btn-action-pill btn-act-delete" onclick="deleteJeePaper('<%= pIdStr %>', '<%= paper.title.replace(/'/g, "\\'") %>')" title="Delete this paper and all its student submissions and OMR images">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                        Delete
                                    </button>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state" style="background:#FFFFFF; border:1px solid var(--border-color); border-radius:var(--radius-lg); padding:3rem 1.5rem; text-align:center;">
                    <div class="empty-state-icon" aria-hidden="true" style="background:#EFF6FF; color:#2563EB; width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <circle cx="12" cy="12" r="9" stroke-dasharray="3 3"></circle>
                            <path d="M12 2v2m0 16v2M2 12h2m16 0h2"></path>
                        </svg>
                    </div>
                    <h3 style="margin: 0 0 0.5rem 0; font-size:1.15rem; font-weight:700;">No JEE Mains papers created yet</h3>
                    <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto 1.5rem; font-size: 0.9rem; line-height:1.5;">
                        Create a JEE Mains paper to evaluate Physics, Chemistry, and Mathematics with Section B numerical checking.
                    </p>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/jee/new" class="btn btn-primary" style="box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);">
                            + Create First JEE Paper
                        </a>
                    <% } %>
                </div>
            <% } %>
        </main>
    </div>

    <script>
        let activeCategory = 'all';

        function setCategoryFilter(cat, btn) {
            activeCategory = cat;
            document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            filterJeePapers();
        }

        function filterJeePapers() {
            const query = (document.getElementById('jeeSearchInput').value || '').toLowerCase().trim();
            const items = document.querySelectorAll('.jee-paper-item');
            let visibleCount = 0;

            items.forEach(item => {
                const searchStr = item.getAttribute('data-search') || '';
                const itemCat = item.getAttribute('data-category') || '';
                const matchesSearch = !query || searchStr.includes(query);
                const matchesCat = (activeCategory === 'all') || (itemCat === activeCategory);

                const show = matchesSearch && matchesCat;
                item.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            const badge = document.getElementById('paperCountBadge');
            if (badge) {
                badge.textContent = visibleCount + (visibleCount === 1 ? ' Paper' : ' Papers');
            }
        }

        async function deleteJeePaper(id, title) {
            // Triple confirmation before deleting paper
            const c1 = confirm(`[1/3 CONFIRMATION REQUIRED]\n\nAre you sure you want to permanently DELETE JEE Paper "${title}"?\n\nThis will remove the paper, all graded submissions, and all stored OMR scans.`);
            if (!c1) return;

            const c2 = confirm(`[2/3 WARNING: CATASTROPHIC DATA LOSS]\n\nAll student marks, rankings, and Cloudinary OMR image copies will be PERMANENTLY DESTROYED.\n\nAre you sure you want to proceed?`);
            if (!c2) return;

            const c3 = confirm(`[3/3 FINAL CONFIRMATION]\n\nFinal check: Type or confirm to permanently delete JEE Paper "${title}" and all its data immediately.`);
            if (!c3) return;

            try {
                const res = await fetch('/api/paper/' + encodeURIComponent(id), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById('card-' + id);
                    if (card) card.remove();
                    filterJeePapers();
                } else {
                    alert('Error: ' + (data.error || 'Failed to delete paper'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }
    </script>
    <%- include('partials/sidebar_end') %>
</body>

</html>
