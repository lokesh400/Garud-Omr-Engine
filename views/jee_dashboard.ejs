<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEE Mains Portal • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .jee-container {
            max-width: 1320px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 3rem 1.5rem;
        }

        /* Sleek Top Header Bar */
        .jee-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .jee-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .jee-page-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -0.01em;
        }

        .count-pill {
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.75rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        .jee-header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .jee-search-box {
            position: relative;
            min-width: 240px;
        }

        .jee-search-box input {
            width: 100%;
            padding: 7px 10px 7px 32px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-family: inherit;
            color: var(--text-main);
            background: #FFFFFF;
            transition: var(--transition);
        }

        .jee-search-box input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .jee-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        /* Folder Directory Layout & Cards */
        .directory-info-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .directory-heading {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 4px 0;
            letter-spacing: -0.01em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .directory-subheading {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin: 0;
        }

        .folders-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.15rem;
        }

        .folder-card-item {
            background: #FFFFFF;
            border: 1.5px solid #E2E8F0;
            border-radius: 16px;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
            transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            position: relative;
            user-select: none;
            text-decoration: none;
            color: inherit;
        }

        .folder-card-item:hover {
            border-color: #3B82F6;
            box-shadow: 0 12px 28px -4px rgba(37, 99, 235, 0.12), 0 4px 10px -2px rgba(37, 99, 235, 0.04);
            transform: translateY(-2.5px);
        }

        .folder-card-all {
            background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
            border-color: #CBD5E1;
        }

        .folder-card-all:hover {
            border-color: #2563EB;
        }

        .folder-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .folder-icon-avatar {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #EFF6FF;
            color: #2563EB;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.15);
        }

        .avatar-all {
            background: #F0FDF4;
            color: #16A34A;
            box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.15);
        }

        .folder-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .folder-count-badge.has-papers {
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
        }

        .folder-count-badge.empty {
            background: #F8FAFC;
            color: #64748B;
            border: 1px solid #E2E8F0;
        }

        .btn-card-del-folder {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #DC2626;
            border-radius: 8px;
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 130ms ease;
            padding: 0;
            flex-shrink: 0;
        }

        .btn-card-del-folder:hover {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #F87171;
            transform: scale(1.08);
        }

        .folder-card-body {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .folder-card-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            letter-spacing: -0.01em;
            line-height: 1.3;
        }

        .folder-card-desc {
            font-size: 0.82rem;
            color: #64748B;
            margin: 0;
            line-height: 1.4;
        }

        .folder-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 0.75rem;
            border-top: 1px solid #F1F5F9;
            font-size: 0.8rem;
            font-weight: 600;
            color: #2563EB;
        }

        .folder-card-footer span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .folder-card-arrow {
            transition: transform 140ms ease;
        }

        .folder-card-item:hover .folder-card-arrow {
            transform: translateX(3px);
        }

        /* Folder Navigation Bar (Inside Folder View) */
        .folder-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .folder-active-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-back-folders {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #F8FAFC;
            border: 1.5px solid #E2E8F0;
            color: #334155;
            padding: 6px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 130ms ease;
            text-decoration: none;
            font-family: inherit;
        }

        .btn-back-folders:hover {
            background: #EFF6FF;
            border-color: #93C5FD;
            color: #1D4ED8;
            transform: translateX(-2px);
        }

        .breadcrumb-sep {
            color: #94A3B8;
            font-size: 1rem;
            font-weight: 300;
        }

        /* Compact Attractive Cards Grid */
        .jee-papers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }

        .jee-card {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            padding: 1.15rem 1.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.95rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
            transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .jee-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3.5px;
            background: linear-gradient(90deg, #2563EB, #6366F1);
            border-radius: 14px 14px 0 0;
        }

        .jee-card:hover {
            border-color: #93C5FD;
            box-shadow: 0 10px 25px -4px rgba(37, 99, 235, 0.12), 0 4px 8px -2px rgba(37, 99, 235, 0.06);
            transform: translateY(-2px);
        }

        .jee-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 6px;
        }

        .jee-card-title {
            font-size: 1.02rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            line-height: 1.35;
            letter-spacing: -0.01em;
        }

        .jee-status-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .status-ready {
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid #A7F3D0;
        }

        .status-pending {
            background: #FFFBEB;
            color: #92400E;
            border: 1px solid #FDE68A;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .status-ready .status-dot { background: #10B981; }
        .status-pending .status-dot { background: #F59E0B; }

        .jee-meta-chips {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0;
        }

        .jee-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.74rem;
            color: #475569;
            font-weight: 600;
        }

        .jee-chip-cat {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            font-weight: 700;
        }

        .jee-chip-copies {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
            font-weight: 700;
        }

        .jee-card-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.74rem;
            color: #64748B;
            padding-top: 4px;
        }

        .jee-id-code {
            font-family: 'JetBrains Mono', monospace;
            background: #F1F5F9;
            color: #334155;
            padding: 1px 6px;
            border-radius: 4px;
            border: 1px solid #E2E8F0;
            font-size: 0.72rem;
        }

        /* Action Buttons Row: Side by Side */
        .jee-actions-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            padding-top: 0.85rem;
            border-top: 1px solid #F1F5F9;
        }

        .btn-action-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 130ms cubic-bezier(0.16, 1, 0.3, 1);
            white-space: nowrap;
            border: 1px solid transparent;
            font-family: inherit;
        }

        .btn-act-key {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
        }
        .btn-act-key:hover { background: #DBEAFE; color: #1E40AF; }

        .btn-act-scan {
            background: #2563EB;
            color: #FFFFFF;
            border-color: #1D4ED8;
        }
        .btn-act-scan:hover { background: #1D4ED8; }

        .btn-act-eval {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }
        .btn-act-eval:hover { background: #DCFCE7; color: #166534; border-color: #86EFAC; }

        .btn-act-results {
            background: #FFFFFF;
            color: #334155;
            border-color: #CBD5E1;
        }
        .btn-act-results:hover { background: #F8FAFC; color: #0F172A; border-color: #94A3B8; }

        .btn-act-print {
            background: #F8FAFC;
            color: #475569;
            border-color: #E2E8F0;
        }
        .btn-act-print:hover { background: #F1F5F9; color: #1E293B; border-color: #CBD5E1; }

        .btn-act-migrate {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }
        .btn-act-migrate:hover { background: #DCFCE7; color: #166534; border-color: #86EFAC; }

        .btn-act-delete {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
            margin-left: auto;
        }
        .btn-act-delete:hover { background: #FEE2E2; color: #991B1B; border-color: #FCA5A5; }

        @media (max-width: 680px) {
            .jee-container { padding: 1rem 0.85rem 2.5rem 0.85rem; }
            .jee-header-bar { flex-direction: column; align-items: stretch; gap: 10px; }
            .jee-header-right { flex-direction: column; align-items: stretch; }
            .jee-search-box { min-width: 100%; }
            .folders-grid { grid-template-columns: 1fr; }
            .folder-card-item { padding: 1.1rem; }
            .directory-info-strip { flex-direction: column; align-items: stretch; gap: 10px; }
            .folder-nav-bar { flex-direction: column; align-items: stretch; gap: 10px; }
            .jee-papers-grid { grid-template-columns: 1fr; }
            .btn-act-delete { margin-left: 0; }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'jee' }) %>
    <div class="container">
        <main class="jee-container">
            <!-- Compact Header Bar -->
            <header class="jee-header-bar">
                <div class="jee-header-left">
                    <h1 class="jee-page-title" id="topHeaderTitle">
                        <span id="topHeaderIcon" style="display: inline-flex; align-items: center; color: #2563EB;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3"></circle>
                                <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"></ellipse>
                                <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-30 12 12)"></ellipse>
                            </svg>
                        </span>
                        <span id="topHeaderTitleText"><%= activeFolder ? (activeFolder === 'all' ? 'All JEE Papers' : activeFolder) : 'JEE Folders & Batches' %></span>
                    </h1>
                    <span class="count-pill" id="topCountBadge"><%= activeFolder ? ((papers ? papers.length : 0) + ' Papers') : ((folders ? folders.length : 0) + ' Folders') %></span>
                </div>

                <div class="jee-header-right">
                    <div class="jee-search-box">
                        <span class="jee-search-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="search" id="dashboardSearchInput" aria-label="Search JEE Folders" placeholder="<%= activeFolder ? 'Search papers in this folder...' : 'Search JEE folders by name or batch...' %>" oninput="handleSearch()">
                    </div>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="openCreateFolderModal()" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            New Folder
                        </button>

                        <a href="/jee/new" class="btn btn-primary btn-sm" id="btnCreateJeeTop" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            New JEE Paper
                        </a>
                    <% } %>

                    <a href="/" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Standard Exams
                    </a>
                </div>
            </header>

            <!-- FOLDERS DIRECTORY VIEW (Front Page Default: ONLY shows folders in a modern mobile-friendly grid) -->
            <section id="foldersDirectorySection" style="<%= activeFolder ? 'display: none;' : '' %>">
                <div class="directory-info-strip">
                    <div>
                        <h2 class="directory-heading">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #2563EB;">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            JEE Mains Sections & Batches
                        </h2>
                        <p class="directory-subheading">Select a JEE folder below to view all papers inside, scan OMR sheets, and evaluate student marks.</p>
                    </div>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <button type="button" class="btn btn-primary btn-sm" onclick="openCreateFolderModal()" style="font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; padding: 6px 14px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            + New Folder
                        </button>
                    <% } %>
                </div>

                <div class="folders-grid" id="foldersGrid">
                    <!-- All JEE Papers Summary Card -->
                    <div class="folder-card-item folder-card-all" onclick="selectFolder('all')" data-folder-name="all jee papers" data-folder-desc="all jee mains assessment papers combined">
                        <div class="folder-card-top">
                            <div class="folder-icon-avatar avatar-all">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                    <polyline points="2 17 12 22 22 17"></polyline>
                                    <polyline points="2 12 12 17 22 12"></polyline>
                                </svg>
                            </div>
                            <span class="folder-count-badge <%= (papers && papers.length > 0) ? 'has-papers' : 'empty' %>">
                                <%= papers ? papers.length : 0 %> <%= (papers && papers.length === 1) ? 'Paper' : 'Papers' %>
                            </span>
                        </div>
                        <div class="folder-card-body">
                            <h3 class="folder-card-title">All JEE Papers</h3>
                            <p class="folder-card-desc">Combined overview of all JEE papers across all batches & series.</p>
                        </div>
                        <div class="folder-card-footer">
                            <span>Open All Papers</span>
                            <svg class="folder-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </div>

                    <% if (typeof folders !== 'undefined' && folders.length > 0) { %>
                        <% folders.forEach(f => { %>
                            <div class="folder-card-item" onclick="selectFolder('<%= f.name.replace(/'/g, "\\'") %>')" data-folder-id="<%= f._id %>" data-folder-name="<%= f.name.toLowerCase() %>" data-folder-desc="<%= (f.description || '').toLowerCase() %>">
                                <div class="folder-card-top">
                                    <div class="folder-icon-avatar">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span class="folder-count-badge <%= (f.count || 0) > 0 ? 'has-papers' : 'empty' %>">
                                            <%= f.count || 0 %> <%= (f.count === 1) ? 'Paper' : 'Papers' %>
                                        </span>
                                        <% if (currentUser && currentUser.role === 'admin') { %>
                                            <button type="button" class="btn-card-del-folder" onclick="event.stopPropagation(); deleteFolder('<%= f._id %>', '<%= f.name.replace(/'/g, "\\'") %>')" title="Delete this folder">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                </svg>
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="folder-card-body">
                                    <h3 class="folder-card-title"><%= f.name %></h3>
                                    <p class="folder-card-desc"><%= f.description || 'JEE Mains tests, Section B numericals & batch results' %></p>
                                </div>
                                <div class="folder-card-footer">
                                    <span>Open Folder</span>
                                    <svg class="folder-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="grid-column: 1 / -1; background: #FFFFFF; border: 1.5px dashed #CBD5E1; border-radius: 16px; padding: 2.25rem 1.5rem; text-align: center;">
                            <div style="width: 46px; height: 46px; border-radius: 12px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem auto;">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </div>
                            <h3 style="margin: 0 0 0.35rem 0; font-size: 1.05rem; font-weight: 700; color: #0F172A;">No Custom JEE Folders Created Yet</h3>
                            <p style="color: #64748B; font-size: 0.85rem; max-width: 440px; margin: 0 auto 1.25rem auto; line-height: 1.5;">
                                You haven't created any JEE batches or folders yet. Click the button below to create your first JEE Section / Batch / Folder.
                            </p>
                            <% if (currentUser && currentUser.role === 'admin') { %>
                                <button type="button" class="btn btn-primary btn-sm" onclick="openCreateFolderModal()" style="font-weight: 600; padding: 7px 16px; font-size: 0.85rem;">
                                    + Create Your First JEE Folder
                                </button>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <div id="noFoldersFoundState" style="display: none; background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem 1.5rem; text-align: center; margin-top: 1rem;">
                    <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">No JEE folders matching your search.</p>
                </div>
            </section>

            <!-- FOLDER PAPERS VIEW (Shown when a folder is selected) -->
            <section id="folderPapersSection" style="<%= activeFolder ? '' : 'display: none;' %>">
                <div class="folder-nav-bar">
                    <div class="folder-active-title-group">
                        <button type="button" class="btn-back-folders" onclick="exitFolderView()">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                            All JEE Folders
                        </button>
                        <span class="breadcrumb-sep">/</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="color: #2563EB; display: inline-flex; align-items: center;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <h2 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #0F172A;" id="activeFolderHeading">
                                <%= activeFolder || 'Folder' %>
                            </h2>
                            <span class="count-pill" id="activeFolderPaperBadge">0 Papers</span>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <% if (currentUser && currentUser.role === 'admin') { %>
                            <a href="/jee/new" id="btnCreatePaperInActiveFolder" class="btn btn-primary btn-sm" style="font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                + Create JEE Paper in this Folder
                            </a>
                            <button type="button" id="btnDeleteActiveFolder" class="btn btn-secondary btn-sm" onclick="deleteCurrentActiveFolder()" style="color: #DC2626; border-color: #FECACA; display: inline-flex; align-items: center; gap: 5px;" title="Delete this folder">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                Delete Folder
                            </button>
                        <% } %>
                    </div>
                </div>

            <!-- Papers Grid -->
            <% if (papers && papers.length > 0) { %>
                <div class="jee-papers-grid" id="jeePapersGrid">
                    <% papers.forEach(paper => { %>
                        <% 
                            const hasKey = (Array.isArray(paper.answer_key) && paper.answer_key.some(k => k)) ||
                                           (paper.answerKey && (paper.answerKey.size > 0 || Object.keys(paper.answerKey).length > 0));
                            const encodedId = encodeURIComponent(paper._id);
                            const pIdStr = String(paper._id);
                            const count = (typeof subCounts !== 'undefined' && subCounts[pIdStr]) ? subCounts[pIdStr] : 0;
                            const paperCat = (paper.category || paper.batch || '12th JEE').trim();
                            const searchStr = `${paper.title || ''} ${pIdStr} ${paperCat}`.toLowerCase();
                        %>
                        <article class="jee-card jee-paper-item" id="card-<%= pIdStr %>" data-search="<%= searchStr %>" data-category="<%= paperCat.toLowerCase() %>">
                            <div>
                                <div class="jee-card-header">
                                    <h3 class="jee-card-title"><%= paper.title %></h3>
                                    <% if (hasKey) { %>
                                        <span class="jee-status-chip status-ready" title="Answer key configured">
                                            <span class="status-dot"></span> Ready
                                        </span>
                                    <% } else { %>
                                        <span class="jee-status-chip status-pending" title="Answer key not fully configured">
                                            <span class="status-dot"></span> Key Pending
                                        </span>
                                    <% } %>
                                </div>

                                <div class="jee-meta-chips">
                                    <span class="jee-chip jee-chip-cat">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                        <%= paperCat %>
                                    </span>
                                    <span class="jee-chip">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                        </svg>
                                        300M &bull; 75 Qs
                                    </span>
                                    <span class="jee-chip jee-chip-copies">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <%= count %> Evaluated
                                    </span>
                                </div>

                                <div class="jee-card-footer-info">
                                    <span>ID: <code class="jee-id-code"><%= pIdStr.slice(-8) %></code></span>
                                    <span style="display: inline-flex; align-items: center; gap: 4px;">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <%= paper.createdAt ? new Date(paper.createdAt).toLocaleDateString() : 'NTA Pattern' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Buttons Side-by-Side in Horizontal Row -->
                            <div class="jee-actions-row">
                                <a href="/paper/<%= encodedId %>/jee-answerkey" class="btn-action-pill btn-act-key" title="Configure 3-Section JEE Answer Key">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="3"></circle>
                                        <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"></ellipse>
                                        <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-30 12 12)"></ellipse>
                                    </svg>
                                    Key
                                </a>

                                <% if (currentUser && currentUser.role === 'admin') { %>
                                    <a href="/paper/<%= encodedId %>/jee-scan" class="btn-action-pill btn-act-scan" title="Launch Camera Scanner">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                            <circle cx="12" cy="13" r="4"></circle>
                                        </svg>
                                        Scan
                                    </a>

                                    <a href="/paper/<%= encodedId %>/jee-evaluator" class="btn-action-pill btn-act-eval" title="Upload and evaluate file">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                            <polyline points="10 9 9 9 8 9"></polyline>
                                        </svg>
                                        Eval
                                    </a>
                                <% } %>

                                <a href="/paper/<%= encodedId %>/results" class="btn-action-pill btn-act-results" title="View Evaluated Copies & Results">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    Results
                                </a>

                                <% if (currentUser && currentUser.role === 'admin') { %>
                                    <a href="/paper/<%= encodedId %>/omr" target="_blank" rel="noopener" class="btn-action-pill btn-act-print" title="Print A4 OMR Sheet">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                            <rect x="6" y="14" width="12" height="8"></rect>
                                        </svg>
                                        OMR
                                    </a>

                                    <button type="button" class="btn-action-pill btn-act-migrate" onclick="openMigrateModal('<%= pIdStr %>', '<%= paper.title.replace(/'/g, "\\'") %>', '<%= paperCat.replace(/'/g, "\\'") %>')" title="Move / Migrate this paper to another Section / Batch / Folder">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                            <polyline points="12 11 12 17"></polyline>
                                            <polyline points="9 14 12 17 15 14"></polyline>
                                        </svg>
                                        Move
                                    </button>

                                    <button type="button" class="btn-action-pill btn-act-delete" onclick="deleteJeePaper('<%= pIdStr %>', '<%= paper.title.replace(/'/g, "\\'") %>')" title="Delete this paper and all its student submissions and OMR images">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                        Delete
                                    </button>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>

                <!-- Empty Folder State (shown when current active folder has 0 papers) -->
                <div id="emptyFolderBox" style="display: none; background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3.5rem 1.5rem; text-align: center; margin-top: 1rem;">
                    <div style="width: 52px; height: 52px; border-radius: 14px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem; font-weight: 700; color: #0F172A;" id="emptyFolderTitle">No JEE papers in this folder yet</h3>
                    <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto 1.5rem; font-size: 0.88rem; line-height: 1.5;" id="emptyFolderDesc">
                        Create your first JEE Mains assessment paper in this folder to start evaluating.
                    </p>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/jee/new" id="btnEmptyCreatePaper" class="btn btn-primary" style="box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);">
                            + Create JEE Paper in this Folder
                        </a>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <!-- Create Folder Modal Dialog -->
    <dialog id="createFolderModal" class="folder-modal-dialog" closedby="any" style="max-width: 420px; border-radius: 12px; border: 1px solid #CBD5E1; padding: 0; box-shadow: 0 12px 30px rgba(0,0,0,0.18); background: #FFFFFF;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-flex; align-items: center; color: #2563EB;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span>
                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1E293B;">Create JEE Section / Batch / Folder</h3>
            </div>
            <button type="button" onclick="document.getElementById('createFolderModal').close()" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748B;">&times;</button>
        </div>
        <form onsubmit="submitCreateFolder(event)" style="padding: 20px;">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Folder Name *</label>
                <input type="text" id="newFolderNameInput" class="form-control" placeholder="e.g. 12th JEE, Droppers, Target 2026" required style="width: 100%;">
            </div>
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Description (Optional)</label>
                <input type="text" id="newFolderDescInput" class="form-control" placeholder="e.g. Evening Advanced Batch" style="width: 100%;">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('createFolderModal').close()">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitCreateFolder">Create Folder</button>
            </div>
        </form>
    </dialog>

    <!-- Migrate Paper Modal Dialog -->
    <dialog id="migratePaperModal" class="folder-modal-dialog" closedby="any" style="max-width: 440px; border-radius: 12px; border: 1px solid #CBD5E1; padding: 0; box-shadow: 0 12px 30px rgba(0,0,0,0.18); background: #FFFFFF;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-flex; align-items: center; color: #059669;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        <polyline points="12 11 12 17"></polyline>
                        <polyline points="9 14 12 17 15 14"></polyline>
                    </svg>
                </span>
                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1E293B;">Migrate JEE Paper to Folder</h3>
            </div>
            <button type="button" onclick="document.getElementById('migratePaperModal').close()" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748B;">&times;</button>
        </div>
        <form onsubmit="submitMigratePaper(event)" style="padding: 20px;">
            <input type="hidden" id="migratePaperId">
            <div style="margin-bottom: 14px;">
                <span style="font-size: 0.78rem; color: #64748B; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">Selected Paper</span>
                <div id="migratePaperTitle" style="font-weight: 700; font-size: 0.95rem; color: #1E293B; margin-top: 2px;"></div>
                <div id="migrateCurrentFolder" style="font-size: 0.8rem; color: #64748B; margin-top: 2px;"></div>
            </div>
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Target Section / Batch / Folder *</label>
                <select id="migrateTargetSelect" class="form-control" style="width: 100%; font-weight: 600;" required>
                    <% if (typeof folders !== 'undefined' && folders.length > 0) { %>
                        <% folders.forEach(f => { %>
                            <option value="<%= f.name %>"><%= f.name %></option>
                        <% }) %>
                    <% } else if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('migratePaperModal').close()">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitMigrate" style="background: #059669; border-color: #059669;">Migrate Paper</button>
            </div>
        </form>
    </dialog>

    <script>
        let currentActiveFolder = <%- JSON.stringify(activeFolder ? activeFolder : null) %>;

        function selectFolder(folderName, updateHistory = true) {
            currentActiveFolder = folderName;
            const foldersSec = document.getElementById('foldersDirectorySection');
            const papersSec = document.getElementById('folderPapersSection');
            const heading = document.getElementById('activeFolderHeading');
            const searchInput = document.getElementById('dashboardSearchInput');
            const topTitleText = document.getElementById('topHeaderTitleText');
            const topHeaderIcon = document.getElementById('topHeaderIcon');
            const btnCreateInFolder = document.getElementById('btnCreatePaperInActiveFolder');
            const btnEmptyCreate = document.getElementById('btnEmptyCreatePaper');

            if (foldersSec) foldersSec.style.display = 'none';
            if (papersSec) papersSec.style.display = 'block';

            const displayName = (folderName === 'all') ? 'All JEE Papers' : folderName;
            if (heading) heading.textContent = displayName;
            if (topTitleText) topTitleText.textContent = displayName;

            if (topHeaderIcon) {
                topHeaderIcon.innerHTML = (folderName === 'all')
                    ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`
                    : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`;
            }

            const targetUrlParam = (folderName === 'all') ? '' : ('?category=' + encodeURIComponent(folderName));
            if (btnCreateInFolder) {
                btnCreateInFolder.href = '/jee/new' + targetUrlParam;
            }
            if (btnEmptyCreate) {
                btnEmptyCreate.href = '/jee/new' + targetUrlParam;
                btnEmptyCreate.textContent = (folderName === 'all') ? '+ Create First JEE Paper' : `+ Create JEE Paper in "${displayName}"`;
            }
            const emptyTitle = document.getElementById('emptyFolderTitle');
            if (emptyTitle) {
                emptyTitle.textContent = (folderName === 'all') ? 'No JEE assessment papers found' : `No JEE papers in "${displayName}" yet`;
            }

            if (searchInput) {
                searchInput.value = '';
                searchInput.placeholder = `Search papers in ${displayName}...`;
            }

            filterPapersInsideFolder('');

            if (updateHistory) {
                const newUrl = (folderName === 'all') ? '/jee?folder=all' : ('/jee?folder=' + encodeURIComponent(folderName));
                window.history.pushState({ folder: folderName }, '', newUrl);
            }
        }

        function exitFolderView(updateHistory = true) {
            currentActiveFolder = null;
            const foldersSec = document.getElementById('foldersDirectorySection');
            const papersSec = document.getElementById('folderPapersSection');
            const searchInput = document.getElementById('dashboardSearchInput');
            const topTitleText = document.getElementById('topHeaderTitleText');
            const topHeaderIcon = document.getElementById('topHeaderIcon');
            const topBadge = document.getElementById('topCountBadge');

            if (foldersSec) foldersSec.style.display = 'block';
            if (papersSec) papersSec.style.display = 'none';

            if (topTitleText) topTitleText.textContent = 'JEE Folders & Batches';
            if (topHeaderIcon) {
                topHeaderIcon.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"></ellipse><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-30 12 12)"></ellipse></svg>`;
            }

            const totalFolders = document.querySelectorAll('.folder-card-item').length;
            if (topBadge) topBadge.textContent = totalFolders + ' Folders';

            if (searchInput) {
                searchInput.value = '';
                searchInput.placeholder = 'Search JEE folders by name or batch...';
            }

            // Restore all folder cards
            document.querySelectorAll('.folder-card-item').forEach(c => c.style.display = '');
            const noFound = document.getElementById('noFoldersFoundState');
            if (noFound) noFound.style.display = 'none';

            if (updateHistory) {
                window.history.pushState({}, '', '/jee');
            }
        }

        function handleSearch() {
            const query = (document.getElementById('dashboardSearchInput').value || '').toLowerCase().trim();
            if (!currentActiveFolder) {
                // Filter folder cards in directory
                let visibleCount = 0;
                document.querySelectorAll('.folder-card-item').forEach(card => {
                    const name = card.getAttribute('data-folder-name') || '';
                    const desc = card.getAttribute('data-folder-desc') || '';
                    const match = !query || name.includes(query) || desc.includes(query);
                    card.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });

                const noFound = document.getElementById('noFoldersFoundState');
                if (noFound) noFound.style.display = (visibleCount === 0) ? 'block' : 'none';

                const badge = document.getElementById('topCountBadge');
                if (badge) badge.textContent = visibleCount + ' Folders';
            } else {
                // Filter papers inside active folder
                filterPapersInsideFolder(query);
            }
        }

        function filterPapersInsideFolder(query = '') {
            const q = (query || (document.getElementById('dashboardSearchInput') ? document.getElementById('dashboardSearchInput').value : '')).toLowerCase().trim();
            const items = document.querySelectorAll('.jee-paper-item');
            let visibleCount = 0;

            items.forEach(item => {
                const searchStr = item.getAttribute('data-search') || '';
                const itemCat = item.getAttribute('data-category') || '';
                const matchesSearch = !q || searchStr.includes(q);
                const matchesFolder = (currentActiveFolder === 'all') || (itemCat === (currentActiveFolder || '').toLowerCase());

                const show = matchesSearch && matchesFolder;
                item.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            const badge = document.getElementById('topCountBadge');
            if (badge) badge.textContent = visibleCount + (visibleCount === 1 ? ' Paper' : ' Papers');

            const activeFolderBadge = document.getElementById('activeFolderPaperBadge');
            if (activeFolderBadge) activeFolderBadge.textContent = visibleCount + (visibleCount === 1 ? ' Paper' : ' Papers');

            const emptyBox = document.getElementById('emptyFolderBox');
            const paperGrid = document.getElementById('jeePapersGrid');
            if (visibleCount === 0) {
                if (emptyBox) emptyBox.style.display = 'block';
                if (paperGrid) paperGrid.style.display = 'none';
            } else {
                if (emptyBox) emptyBox.style.display = 'none';
                if (paperGrid) paperGrid.style.display = 'grid';
            }
        }

        function openCreateFolderModal() {
            const m = document.getElementById('createFolderModal');
            if (m) {
                document.getElementById('newFolderNameInput').value = '';
                document.getElementById('newFolderDescInput').value = '';
                if (typeof m.showModal === 'function') m.showModal();
                else m.setAttribute('open', '');
            }
        }

        async function submitCreateFolder(e) {
            e.preventDefault();
            const name = document.getElementById('newFolderNameInput').value.trim();
            const desc = document.getElementById('newFolderDescInput').value.trim();
            if (!name) return;
            const btn = document.getElementById('btnSubmitCreateFolder');
            btn.disabled = true;
            btn.textContent = 'Creating...';
            try {
                const res = await fetch('/api/folders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, description: desc, examType: 'jee' })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to create folder');
                }
                document.getElementById('createFolderModal').close();
                alert(`Folder "${data.folder.name}" created successfully!`);
                window.location.href = '/jee?folder=' + encodeURIComponent(data.folder.name);
            } catch (err) {
                alert(err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Create Folder';
            }
        }

        async function deleteFolder(folderId, folderName) {
            const ok = confirm(`Are you sure you want to permanently delete folder "${folderName}"?`);
            if (!ok) return;
            try {
                const res = await fetch('/api/folders/' + encodeURIComponent(folderId), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    alert(`Folder "${folderName}" deleted successfully.`);
                    window.location.href = '/jee';
                } else {
                    alert(data.error || 'Failed to delete folder');
                }
            } catch (err) {
                alert(err.message);
            }
        }

        async function deleteCurrentActiveFolder() {
            if (!currentActiveFolder || currentActiveFolder === 'all') {
                alert('Cannot delete this view.');
                return;
            }
            const card = document.querySelector(`.folder-card-item[data-folder-name="${currentActiveFolder.toLowerCase()}"]`);
            const folderId = card ? card.getAttribute('data-folder-id') : currentActiveFolder;
            await deleteFolder(folderId, currentActiveFolder);
        }

        function openMigrateModal(pId, title, currentCat) {
            document.getElementById('migratePaperId').value = pId;
            document.getElementById('migratePaperTitle').textContent = title;
            document.getElementById('migrateCurrentFolder').textContent = 'Currently in: ' + currentCat;
            const sel = document.getElementById('migrateTargetSelect');
            if (sel) {
                for (let i = 0; i < sel.options.length; i++) {
                    if (sel.options[i].value.toLowerCase() === currentCat.toLowerCase()) {
                        sel.selectedIndex = i;
                        break;
                    }
                }
            }
            const m = document.getElementById('migratePaperModal');
            if (m) {
                if (typeof m.showModal === 'function') m.showModal();
                else m.setAttribute('open', '');
            }
        }

        async function submitMigratePaper(e) {
            e.preventDefault();
            const paperId = document.getElementById('migratePaperId').value;
            const targetFolder = document.getElementById('migrateTargetSelect').value;
            const btn = document.getElementById('btnSubmitMigrate');
            btn.disabled = true;
            btn.textContent = 'Migrating...';
            try {
                const res = await fetch(`/api/paper/${encodeURIComponent(paperId)}/migrate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ targetFolder })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to migrate paper');
                }
                const card = document.getElementById('card-' + paperId);
                if (card) {
                    card.setAttribute('data-category', targetFolder.toLowerCase());
                    const catBadge = card.querySelector('.jee-chip-cat');
                    if (catBadge) {
                        catBadge.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> ${targetFolder}`;
                    }
                }
                document.getElementById('migratePaperModal').close();
                alert(`Paper migrated to "${targetFolder}" successfully!`);
                window.location.reload();
            } catch (err) {
                alert(err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Migrate Paper';
            }
        }

        async function deleteJeePaper(id, title) {
            const c1 = confirm(`[1/3 CONFIRMATION REQUIRED]\n\nAre you sure you want to permanently DELETE JEE Paper "${title}"?\n\nThis will remove the paper, all graded submissions, and all stored OMR scans.`);
            if (!c1) return;

            const c2 = confirm(`[2/3 WARNING: CATASTROPHIC DATA LOSS]\n\nAll student marks, rankings, and Cloudinary OMR image copies will be PERMANENTLY DESTROYED.\n\nAre you sure you want to proceed?`);
            if (!c2) return;

            const c3 = confirm(`[3/3 FINAL CONFIRMATION]\n\nFinal check: Type or confirm to permanently delete JEE Paper "${title}" and all its data immediately.`);
            if (!c3) return;

            try {
                const res = await fetch('/api/paper/' + encodeURIComponent(id), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById('card-' + id);
                    if (card) card.remove();
                    filterPapersInsideFolder('');
                } else {
                    alert('Error: ' + (data.error || 'Failed to delete paper'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }

        // Handle browser Back / Forward buttons
        window.addEventListener('popstate', () => {
            const params = new URLSearchParams(window.location.search);
            const folder = params.get('folder') || params.get('category');
            if (folder) {
                selectFolder(folder, false);
            } else {
                exitFolderView(false);
            }
        });

        // Initialize view on page load
        window.addEventListener('DOMContentLoaded', () => {
            if (currentActiveFolder) {
                selectFolder(currentActiveFolder, false);
            } else {
                exitFolderView(false);
            }
        });
    </script>
    <%- include('partials/sidebar_end') %>
</body>

</html>
