                        style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Folder
                        Name *</label>
                    <input type="text" id="newFolderNameInput" class="form-control"
                        placeholder="e.g. 11th NEET, Target 2026, Foundation" required style="width: 100%;">
                </div>
                <div style="margin-bottom: 18px;">
                    <label
                        style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Description
                        (Optional)</label>
                    <input type="text" id="newFolderDescInput" class="form-control" placeholder="e.g. Morning Batch"
                        style="width: 100%;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-secondary btn-sm"
                        onclick="document.getElementById('createFolderModal').close()">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitCreateFolder">Create
                        Folder</button>
                </div>
            </form>
        </dialog>

        <!-- Migrate Paper Modal Dialog -->
        <dialog id="migratePaperModal" class="folder-modal-dialog" closedby="any"
            style="max-width: 440px; border-radius: 12px; border: 1px solid #CBD5E1; padding: 0; box-shadow: 0 12px 30px rgba(0,0,0,0.18); background: #FFFFFF;">
            <div
                style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-flex; align-items: center; color: #059669;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                            </path>
                            <polyline points="12 11 12 17"></polyline>
                            <polyline points="9 14 12 17 15 14"></polyline>
                        </svg>
                    </span>
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1E293B;">Migrate Paper to Folder
                    </h3>
                </div>
                <button type="button" onclick="document.getElementById('migratePaperModal').close()"
                    style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748B;">&times;</button>
            </div>
            <form onsubmit="submitMigratePaper(event)" style="padding: 20px;">
                <input type="hidden" id="migratePaperId">
                <div style="margin-bottom: 14px;">
                    <span
                        style="font-size: 0.78rem; color: #64748B; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">Selected
                        Paper</span>
                    <div id="migratePaperTitle"
                        style="font-weight: 700; font-size: 0.95rem; color: #1E293B; margin-top: 2px;"></div>
                    <div id="migrateCurrentFolder" style="font-size: 0.8rem; color: #64748B; margin-top: 2px;"></div>
                </div>
                <div style="margin-bottom: 18px;">
                    <label
                        style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Target
                        Section / Batch / Folder *</label>
                    <select id="migrateTargetSelect" class="form-control" style="width: 100%; font-weight: 600;"
                        required>
                        <% if (typeof folders !=='undefined' && folders.length> 0) { %>
                            <% folders.forEach(f=> { %>
                                <option value="<%= f.name %>">
                                    <%= f.name %>
                                </option>
                                <% }) %>
                                    <% } else if (typeof categories !=='undefined' && categories.length> 0) { %>
                                        <% categories.forEach(cat=> { %>
                                            <option value="<%= cat %>">
                                                <%= cat %>
                                            </option>
                                            <% }) %>
                                                <% } %>
                    </select>
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-secondary btn-sm"
                        onclick="document.getElementById('migratePaperModal').close()">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitMigrate"
                        style="background: #059669; border-color: #059669;">Migrate Paper</button>
                </div>
            </form>
        </dialog>

        <!-- Edit Folder Modal Dialog -->
        <dialog id="editFolderModal" class="folder-modal-dialog" closedby="any"
            style="max-width: 440px; border-radius: 12px; border: 1px solid #CBD5E1; padding: 0; box-shadow: 0 14px 34px rgba(0,0,0,0.18); background: #FFFFFF;">
            <div
                style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; border-radius: 12px 12px 0 0;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-flex; align-items: center; color: #2563EB;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </span>
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1E293B;">Edit Section / Batch / Folder</h3>
                </div>
                <button type="button" onclick="document.getElementById('editFolderModal').close()"
                    style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748B;">&times;</button>
            </div>
            <form onsubmit="submitEditFolder(event)" style="padding: 20px;">
                <input type="hidden" id="editFolderId">
                <div style="margin-bottom: 14px;">
                    <label
                        style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Folder
                        Name *</label>
                    <input type="text" id="editFolderNameInput" class="form-control" required style="width: 100%;">
                </div>
                <div style="margin-bottom: 18px;">
                    <label
                        style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 6px;">Description
                        (Optional)</label>
                    <input type="text" id="editFolderDescInput" class="form-control" placeholder="e.g. Morning Batch"
                        style="width: 100%;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-secondary btn-sm"
                        onclick="document.getElementById('editFolderModal').close()">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitEditFolder">Save Changes</button>
                </div>
            </form>
        </dialog>

        <!-- Edit Paper Modal Dialog with Section Builder -->
        <dialog id="editPaperModal" class="folder-modal-dialog" closedby="any"
            style="max-width: 680px; width: 95%; border-radius: 12px; border: 1px solid #CBD5E1; padding: 0; box-shadow: 0 16px 40px rgba(0,0,0,0.22); background: #FFFFFF;">
            <div
                style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; border-radius: 12px 12px 0 0;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-flex; align-items: center; color: #2563EB;">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </span>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #1E293B;">Edit Paper Details</h3>
                </div>
                <button type="button" onclick="document.getElementById('editPaperModal').close()"
                    style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #64748B; line-height: 1;">&times;</button>
            </div>
            <form onsubmit="submitEditPaper(event)" style="padding: 20px; max-height: calc(88vh - 80px); overflow-y: auto;">
                <input type="hidden" id="editPaperId">

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 14px;">
                    <div>
                        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Paper Title *</label>
                        <input type="text" id="editPaperTitle" class="form-control" placeholder="e.g. Full NEET Mock Test 01" required style="width: 100%;">
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Subject</label>
                        <input type="text" id="editPaperSubject" class="form-control" placeholder="e.g. Physics, Chemistry" style="width: 100%;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                    <div>
                        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Section / Batch / Folder *</label>
                        <select id="editPaperFolder" class="form-control" style="width: 100%; font-weight: 600;" required>
                            <% if (typeof folders !== 'undefined' && folders.length > 0) { %>
                                <% folders.forEach(f => { %>
                                    <option value="<%= f.name %>"><%= f.name %></option>
                                <% }) %>
                            <% } else if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>"><%= cat %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="General">General</option>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Total Questions *</label>
                        <input type="number" id="editPaperTotalQ" class="form-control" min="1" max="200" required style="width: 100%; font-family: 'JetBrains Mono', monospace; font-weight: 600;" oninput="onEditPaperTotalQChanged()">
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Max Marks</label>
                        <input type="number" id="editPaperMaxMarks" class="form-control" min="0" style="width: 100%; font-family: 'JetBrains Mono', monospace; font-weight: 600;" placeholder="Auto">
                    </div>
                </div>

                <!-- Section Configuration Box -->
                <div style="background: #F8FAFC; border: 1.5px solid #E2E8F0; border-radius: 10px; padding: 14px; margin-bottom: 18px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <strong style="font-size: 0.92rem; color: #1E293B;">Sections &amp; Question Ranges</strong>
                            <span id="editSecStatusBadge" style="background: #EFF6FF; color: #1D4ED8; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 12px; border: 1px solid #BFDBFE;">0 Sections</span>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="autoDivideEditSections()" style="padding: 4px 10px; font-size: 0.78rem;" title="Auto-divide across balanced sections">
                                Auto Divide
                            </button>
                            <button type="button" class="btn btn-primary btn-sm" onclick="addEditSectionRow('', 1, 10, 40)" style="padding: 4px 10px; font-size: 0.78rem;" title="Add another section">
                                + Add Section
                            </button>
                        </div>
                    </div>
                    <div id="editSecRowsContainer" style="max-height: 240px; overflow-y: auto;">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 8px; padding-top: 10px; border-top: 1px solid #E2E8F0;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('editPaperModal').close()">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="btnSubmitEditPaper" style="font-weight: 600;">Save Paper Details</button>
                </div>
            </form>
        </dialog>

        <script>
            let currentActiveFolder = <%- JSON.stringify(activeFolder ? activeFolder : null) %>;

            function selectFolder(folderName, updateHistory = true) {
                currentActiveFolder = folderName;
                const foldersSec = document.getElementById('foldersDirectorySection');
                const papersSec = document.getElementById('folderPapersSection');
                const heading = document.getElementById('activeFolderHeading');
                const folderIcon = document.getElementById('folderTitleIcon');
                const searchInput = document.getElementById('dashboardSearchInput');
                const btnCreateInFolder = document.getElementById('btnCreatePaperInActiveFolder');
                const btnDeleteActive = document.getElementById('btnDeleteActiveFolder');
                const btnEditActive = document.getElementById('btnEditActiveFolder');
                const btnEmptyCreate = document.getElementById('btnEmptyCreatePaper');

                if (foldersSec) foldersSec.style.display = 'none';
                if (papersSec) papersSec.style.display = 'block';

                const displayName = (folderName === 'all') ? 'All Assessment Papers' : folderName;
                if (heading) heading.textContent = displayName;

                if (folderIcon) {
                    folderIcon.innerHTML = (folderName === 'all')
                        ? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`
                        : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`;
                }

                if (btnDeleteActive) {
                    btnDeleteActive.style.display = (folderName === 'all') ? 'none' : 'inline-flex';
                }
                if (btnEditActive) {
                    btnEditActive.style.display = (folderName === 'all') ? 'none' : 'inline-flex';
                }

                const targetUrlParam = (folderName === 'all') ? '' : ('?category=' + encodeURIComponent(folderName));
                if (btnCreateInFolder) {
                    btnCreateInFolder.href = '/paper/new' + targetUrlParam;
                }
                if (btnEmptyCreate) {
                    btnEmptyCreate.href = '/paper/new' + targetUrlParam;
                    btnEmptyCreate.textContent = (folderName === 'all') ? '+ Create First Paper' : `+ Create Paper in "${displayName}"`;
                }
                const emptyTitle = document.getElementById('emptyFolderTitle');
                if (emptyTitle) {
                    emptyTitle.textContent = (folderName === 'all') ? 'No assessment papers found' : `No papers in "${displayName}" yet`;
                }

                if (searchInput) {
                    searchInput.value = '';
                    searchInput.placeholder = (folderName === 'all') ? 'Search all papers...' : `Search papers in ${displayName}...`;
                }

                filterPapersInsideFolder('');

                if (updateHistory) {
                    const newUrl = (folderName === 'all') ? '/?folder=all' : ('/?folder=' + encodeURIComponent(folderName));
                    window.history.pushState({ folder: folderName }, '', newUrl);
                }
            }

            function exitFolderView(updateHistory = true) {
                currentActiveFolder = null;
                const foldersSec = document.getElementById('foldersDirectorySection');
                const papersSec = document.getElementById('folderPapersSection');
                const searchInput = document.getElementById('dashboardSearchInput');

                if (foldersSec) foldersSec.style.display = 'block';
                if (papersSec) papersSec.style.display = 'none';

                if (searchInput) {
                    searchInput.value = '';
                }

                if (updateHistory) {
                    window.history.pushState({}, '', '/');
                }
            }

            function handleSearch() {
                const searchEl = document.getElementById('dashboardSearchInput');
                const query = (searchEl ? searchEl.value : '').toLowerCase().trim();
                if (currentActiveFolder) {
                    filterPapersInsideFolder(query);
                }
            }

            function filterPapersInsideFolder(query = '') {
                const q = (query || (document.getElementById('dashboardSearchInput') ? document.getElementById('dashboardSearchInput').value : '')).toLowerCase().trim();
                const items = document.querySelectorAll('.paper-item-card');
                let visibleCount = 0;

                items.forEach(item => {
                    const searchStr = item.getAttribute('data-search') || '';
                    const itemCat = item.getAttribute('data-category') || '';
                    const matchesSearch = !q || searchStr.includes(q);
                    const matchesFolder = (currentActiveFolder === 'all') || (itemCat === (currentActiveFolder || '').toLowerCase());

                    const show = matchesSearch && matchesFolder;
                    item.style.display = show ? '' : 'none';
                    if (show) visibleCount++;
                });

                const activeFolderBadge = document.getElementById('activeFolderPaperBadge');
                if (activeFolderBadge) activeFolderBadge.textContent = visibleCount + (visibleCount === 1 ? ' Paper' : ' Papers');

                const emptyBox = document.getElementById('emptyFolderBox');
                const paperGrid = document.getElementById('paperListGrid');
                if (visibleCount === 0) {
                    if (emptyBox) emptyBox.style.display = 'block';
                    if (paperGrid) paperGrid.style.display = 'none';
                } else {
                    if (emptyBox) emptyBox.style.display = 'none';
                    if (paperGrid) paperGrid.style.display = 'grid';
                }
            }

            function openCreateFolderModal() {
                const m = document.getElementById('createFolderModal');
                if (m) {
                    document.getElementById('newFolderNameInput').value = '';
                    document.getElementById('newFolderDescInput').value = '';
                    if (typeof m.showModal === 'function') m.showModal();
                    else m.setAttribute('open', '');
                }
            }

            async function submitCreateFolder(e) {
                e.preventDefault();
                const name = document.getElementById('newFolderNameInput').value.trim();
                const desc = document.getElementById('newFolderDescInput').value.trim();
                if (!name) return;
                const btn = document.getElementById('btnSubmitCreateFolder');
                btn.disabled = true;
                btn.textContent = 'Creating...';
                try {
                    const res = await fetch('/api/folders', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, description: desc, examType: 'standard' })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to create folder');
                    }
                    document.getElementById('createFolderModal').close();
                    alert(`Folder "${data.folder.name}" created successfully!`);
                    window.location.href = '/?folder=' + encodeURIComponent(data.folder.name);
                } catch (err) {
                    alert(err.message);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Create Folder';
                }
            }

            async function deleteFolder(folderId, folderName) {
                const ok = confirm(`Are you sure you want to permanently delete folder "${folderName}"?`);
                if (!ok) return;
                try {
                    const res = await fetch('/api/folders/' + encodeURIComponent(folderId), {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (data.success) {
                        alert(`Folder "${folderName}" deleted successfully.`);
                        window.location.href = '/';
                    } else {
                        alert(data.error || 'Failed to delete folder');
                    }
                } catch (err) {
                    alert(err.message);
                }
            }

            async function deleteCurrentActiveFolder() {
                if (!currentActiveFolder || currentActiveFolder === 'all') {
                    alert('Cannot delete this view.');
                    return;
                }
                const card = document.querySelector(`.folder-card-item[data-folder-name="${currentActiveFolder.toLowerCase()}"]`);
                const folderId = card ? card.getAttribute('data-folder-id') : currentActiveFolder;
                await deleteFolder(folderId, currentActiveFolder);
            }

            function openEditFolderModal(id, name, desc) {
                document.getElementById('editFolderId').value = id;
                document.getElementById('editFolderNameInput').value = name || '';
                document.getElementById('editFolderDescInput').value = desc || '';
                const m = document.getElementById('editFolderModal');
                if (m) {
                    if (typeof m.showModal === 'function') m.showModal();
                    else m.setAttribute('open', '');
                }
            }

            function editCurrentActiveFolder() {
                if (!currentActiveFolder || currentActiveFolder === 'all') {
                    alert('Cannot edit this view.');
                    return;
                }
                const card = document.querySelector(`.folder-card-item[data-folder-name="${currentActiveFolder.toLowerCase()}"]`);
                const folderId = card ? card.getAttribute('data-folder-id') : currentActiveFolder;
                const folderDesc = card ? (card.getAttribute('data-folder-desc') || '') : '';
                openEditFolderModal(folderId, currentActiveFolder, folderDesc);
            }

            async function submitEditFolder(e) {
                e.preventDefault();
                const folderId = document.getElementById('editFolderId').value;
                const name = document.getElementById('editFolderNameInput').value.trim();
                const desc = document.getElementById('editFolderDescInput').value.trim();
                if (!name) return;
                const btn = document.getElementById('btnSubmitEditFolder');
                btn.disabled = true;
                btn.textContent = 'Saving...';
                try {
                    const res = await fetch('/api/folders/' + encodeURIComponent(folderId), {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, description: desc })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to update folder');
                    }
                    document.getElementById('editFolderModal').close();
                    alert(`Folder updated to "${data.folder.name}" successfully!`);
                    window.location.href = '/?folder=' + encodeURIComponent(data.folder.name);
                } catch (err) {
                    alert(err.message);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Save Changes';
                }
            }

            function openMigrateModal(pId, title, currentCat) {
                document.getElementById('migratePaperId').value = pId;
                document.getElementById('migratePaperTitle').textContent = title;
                document.getElementById('migrateCurrentFolder').textContent = 'Currently in: ' + currentCat;
                const sel = document.getElementById('migrateTargetSelect');
                if (sel) {
                    for (let i = 0; i < sel.options.length; i++) {
                        if (sel.options[i].value.toLowerCase() === currentCat.toLowerCase()) {
                            sel.selectedIndex = i;
                            break;
                        }
                    }
                }
                const m = document.getElementById('migratePaperModal');
                if (m) {
                    if (typeof m.showModal === 'function') m.showModal();
                    else m.setAttribute('open', '');
                }
            }

            async function submitMigratePaper(e) {
                e.preventDefault();
                const paperId = document.getElementById('migratePaperId').value;
                const targetFolder = document.getElementById('migrateTargetSelect').value;
                const btn = document.getElementById('btnSubmitMigrate');
                btn.disabled = true;
                btn.textContent = 'Migrating...';
                try {
                    const res = await fetch(`/api/paper/${encodeURIComponent(paperId)}/migrate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ targetFolder })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to migrate paper');
                    }
                    const card = document.getElementById('card-' + paperId);
                    if (card) {
                        card.setAttribute('data-category', targetFolder.toLowerCase());
                        const catBadge = card.querySelector('.spec-chip-cat');
                        if (catBadge) {
                            catBadge.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> ${targetFolder}`;
                        }
                    }
                    document.getElementById('migratePaperModal').close();
                    alert(`Paper migrated to "${targetFolder}" successfully!`);
                    window.location.reload();
                } catch (err) {
                    alert(err.message);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Migrate Paper';
                }
            }

            async function deleteStandardPaper(id, title) {
                const c1 = confirm(`[1/3 CONFIRMATION REQUIRED]\n\nAre you sure you want to permanently DELETE paper "${title}"?\n\nThis will remove the paper, all graded submissions, and all stored OMR scans.`);
                if (!c1) return;

                const c2 = confirm(`[2/3 WARNING: CATASTROPHIC DATA LOSS]\n\nAll student marks, rankings, and Cloudinary OMR image copies will be PERMANENTLY DESTROYED.\n\nAre you sure you want to proceed?`);
                if (!c2) return;

                const c3 = confirm(`[3/3 FINAL CONFIRMATION]\n\nFinal check: Type or confirm to permanently delete paper "${title}" and all its data immediately.`);
                if (!c3) return;

                try {
                    const res = await fetch('/api/paper/' + encodeURIComponent(id), {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (data.success) {
                        const card = document.getElementById('card-' + id);
                        if (card) card.remove();
                        filterPapersInsideFolder('');
                    } else {
                        alert('Error: ' + (data.error || 'Failed to delete paper'));
                    }
                } catch (err) {
                    alert('Request failed: ' + err.message);
                }
            }

            // Section builder state for Edit Paper Modal
            function addEditSectionRow(name = '', fromQ = 1, toQ = 10, marks = null) {
                const container = document.getElementById('editSecRowsContainer');
                if (!container) return;
                const row = document.createElement('div');
                row.className = 'section-item-row';
                const count = (toQ >= fromQ) ? (toQ - fromQ + 1) : 0;
                const secMarks = (marks !== null && marks !== undefined) ? marks : (count * 4);
                const escapedName = String(name || '').replace(/"/g, '&quot;');

                row.innerHTML = `
                    <div class="sec-col-name">
                        <label class="sec-field-label">Section Name</label>
                        <input type="text" class="sec-input sec-name-input" value="${escapedName}" placeholder="e.g. Physics / Botany" oninput="updateEditSectionsJSON()">
                    </div>
                    <div>
                        <label class="sec-field-label">From Q #</label>
                        <input type="number" min="1" max="200" class="sec-input sec-input-mono sec-from-input" value="${fromQ}" oninput="onEditRangeChange(this)">
                    </div>
                    <div>
                        <label class="sec-field-label">To Q #</label>
                        <input type="number" min="1" max="200" class="sec-input sec-input-mono sec-to-input" value="${toQ}" oninput="onEditRangeChange(this)">
                    </div>
                    <div>
                        <label class="sec-field-label">Max Marks</label>
                        <input type="number" min="0" class="sec-input sec-input-mono sec-marks-input" value="${secMarks}" oninput="updateEditSectionsJSON()">
                    </div>
                    <div class="sec-col-btn">
                        <button type="button" class="btn-remove-sec" onclick="removeEditSectionRow(this)" title="Remove section">&times;</button>
                    </div>
                `;
                container.appendChild(row);
                updateEditSectionsJSON();
            }

            function removeEditSectionRow(btn) {
                const row = btn.closest('.section-item-row');
                if (row) row.remove();
                updateEditSectionsJSON();
            }

            function onEditRangeChange(input) {
                const row = input.closest('.section-item-row');
                if (row) {
                    const fromQ = parseInt(row.querySelector('.sec-from-input').value, 10) || 1;
                    const toQ = parseInt(row.querySelector('.sec-to-input').value, 10) || fromQ;
                    const marksInput = row.querySelector('.sec-marks-input');
                    if (marksInput) {
                        const count = (toQ >= fromQ) ? (toQ - fromQ + 1) : 0;
                        marksInput.value = count * 4;
                    }
                }
                updateEditSectionsJSON();
            }

            function updateEditSectionsJSON() {
                const container = document.getElementById('editSecRowsContainer');
                if (!container) return [];
                const rows = container.querySelectorAll('.section-item-row');
                const list = [];
                let totalSecMarks = 0;
                rows.forEach((r, idx) => {
                    const name = r.querySelector('.sec-name-input').value.trim() || `Section ${idx + 1}`;
                    const fromQ = parseInt(r.querySelector('.sec-from-input').value, 10) || 1;
                    const toQ = parseInt(r.querySelector('.sec-to-input').value, 10) || fromQ;
                    const count = (toQ >= fromQ) ? (toQ - fromQ + 1) : 0;
                    const marks = parseInt(r.querySelector('.sec-marks-input').value, 10);
                    const secMarks = (!isNaN(marks) && marks >= 0) ? marks : (count * 4);
                    totalSecMarks += secMarks;
                    list.push({
                        name: name,
                        from_question: fromQ,
                        to_question: toQ,
                        max_marks: secMarks
                    });
                });

                const badge = document.getElementById('editSecStatusBadge');
                if (badge) badge.textContent = `${list.length} Section${list.length !== 1 ? 's' : ''}`;

                const maxMarksInput = document.getElementById('editPaperMaxMarks');
                if (maxMarksInput && totalSecMarks > 0) {
                    maxMarksInput.value = totalSecMarks;
                }
                return list;
            }

            function autoDivideEditSections() {
                const container = document.getElementById('editSecRowsContainer');
                if (!container) return;
                container.innerHTML = '';
                const totalQ = parseInt(document.getElementById('editPaperTotalQ').value, 10) || 180;

                if (totalQ === 180) {
                    addEditSectionRow('Physics', 1, 45, 180);
                    addEditSectionRow('Chemistry', 46, 90, 180);
                    addEditSectionRow('Botany', 91, 135, 180);
                    addEditSectionRow('Zoology', 136, 180, 180);
                } else if (totalQ === 200) {
                    addEditSectionRow('Physics', 1, 50, 180);
                    addEditSectionRow('Chemistry', 51, 100, 180);
                    addEditSectionRow('Botany', 101, 150, 180);
                    addEditSectionRow('Zoology', 151, 200, 180);
                } else {
                    const numSec = (totalQ >= 40) ? 4 : 2;
                    const perSec = Math.floor(totalQ / numSec);
                    let start = 1;
                    const defNames = ['Physics', 'Chemistry', 'Botany', 'Zoology', 'Mathematics', 'Biology'];
                    for (let s = 1; s <= numSec; s++) {
                        const end = (s === numSec) ? totalQ : (start + perSec - 1);
                        const sName = defNames[s - 1] || `Section ${s}`;
                        addEditSectionRow(sName, start, end, (end - start + 1) * 4);
                        start = end + 1;
                    }
                }
            }

            function onEditPaperTotalQChanged() {
                const totalQ = parseInt(document.getElementById('editPaperTotalQ').value, 10) || 50;
                const maxInput = document.getElementById('editPaperMaxMarks');
                const container = document.getElementById('editSecRowsContainer');
                if (container && container.querySelectorAll('.section-item-row').length === 0) {
                    if (maxInput) maxInput.value = totalQ * 4;
                } else {
                    updateEditSectionsJSON();
                }
            }

            function openEditPaperModal(paperId) {
                const scriptEl = document.getElementById('paper-data-' + paperId);
                let paper = null;
                if (scriptEl) {
                    try {
                        paper = JSON.parse(scriptEl.textContent);
                    } catch (e) {
                        console.warn('Failed to parse paper data script:', e);
                    }
                }

                function populateModal(p) {
                    document.getElementById('editPaperId').value = p._id;
                    document.getElementById('editPaperTitle').value = p.title || '';
                    document.getElementById('editPaperSubject').value = p.subject || 'General';

                    const folderSelect = document.getElementById('editPaperFolder');
                    if (folderSelect) {
                        const cat = (p.category || p.batch || 'General').trim();
                        let found = false;
                        for (let i = 0; i < folderSelect.options.length; i++) {
                            if (folderSelect.options[i].value.toLowerCase() === cat.toLowerCase()) {
                                folderSelect.selectedIndex = i;
                                found = true;
                                break;
                            }
                        }
                        if (!found) {
                            const opt = new Option(cat, cat);
                            folderSelect.add(opt);
                            folderSelect.value = cat;
                        }
                    }

                    const totalQ = p.total_questions || p.numQuestions || 50;
                    document.getElementById('editPaperTotalQ').value = totalQ;
                    document.getElementById('editPaperMaxMarks').value = p.max_marks || (totalQ * 4);

                    const container = document.getElementById('editSecRowsContainer');
                    if (container) {
                        container.innerHTML = '';
                        if (Array.isArray(p.sections) && p.sections.length > 0) {
                            p.sections.forEach(sec => {
                                const fromQ = sec.from_question || sec.from || 1;
                                const toQ = sec.to_question || sec.to || fromQ;
                                addEditSectionRow(sec.name, fromQ, toQ, sec.max_marks);
                            });
                        } else {
                            autoDivideEditSections();
                        }
                    }

                    const m = document.getElementById('editPaperModal');
                    if (m) {
                        if (typeof m.showModal === 'function') m.showModal();
                        else m.setAttribute('open', '');
                    }
                }

                if (paper) {
                    populateModal(paper);
                } else {
                    fetch('/api/paper/' + encodeURIComponent(paperId))
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.success && data.paper) {
                                populateModal(data.paper);
                            } else {
                                alert('Could not load paper details: ' + (data && data.error ? data.error : 'Unknown error'));
                            }
                        })
                        .catch(err => alert('Error loading paper: ' + err.message));
                }
            }

            async function submitEditPaper(e) {
                e.preventDefault();
                const paperId = document.getElementById('editPaperId').value;
                const title = document.getElementById('editPaperTitle').value.trim();
                const subject = document.getElementById('editPaperSubject').value.trim();
                const category = document.getElementById('editPaperFolder').value;
                const totalQ = parseInt(document.getElementById('editPaperTotalQ').value, 10);
                const maxMarks = parseInt(document.getElementById('editPaperMaxMarks').value, 10);
                const sections = updateEditSectionsJSON();

                if (!title) {
                    alert('Please enter a paper title.');
                    return;
                }
                if (isNaN(totalQ) || totalQ < 1 || totalQ > 200) {
                    alert('Total questions must be between 1 and 200.');
                    return;
                }

                for (let i = 0; i < sections.length; i++) {
                    const s = sections[i];
                    if (s.to_question < s.from_question) {
                        alert(`In section "${s.name}", "To Q#" (${s.to_question}) cannot be smaller than "From Q#" (${s.from_question}).`);
                        return;
                    }
                    if (s.to_question > totalQ) {
                        alert(`In section "${s.name}", "To Q#" (${s.to_question}) exceeds total questions (${totalQ}).`);
                        return;
                    }
                }

                const btn = document.getElementById('btnSubmitEditPaper');
                btn.disabled = true;
                btn.textContent = 'Saving...';

                try {
                    const res = await fetch('/api/paper/' + encodeURIComponent(paperId), {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            title,
                            subject,
                            category,
                            total_questions: totalQ,
                            max_marks: maxMarks,
                            sections
                        })
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to update paper details');
                    }

                    document.getElementById('editPaperModal').close();
                    alert(`Paper "${data.paper.title}" details updated successfully!`);

                    const scriptEl = document.getElementById('paper-data-' + paperId);
                    if (scriptEl) {
                        scriptEl.textContent = JSON.stringify(data.paper);
                    }

                    window.location.reload();
                } catch (err) {
                    alert(err.message);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Save Paper Details';
                }
            }

            // Handle browser Back / Forward buttons
            window.addEventListener('popstate', () => {
                const params = new URLSearchParams(window.location.search);
                const folder = params.get('folder') || params.get('category');
                if (folder) {
                    selectFolder(folder, false);
                } else {
                    exitFolderView(false);
                }
            });

            // Initialize view on page load
            window.addEventListener('DOMContentLoaded', () => {
                if (currentActiveFolder) {
                    selectFolder(currentActiveFolder, false);
                } else {
                    exitFolderView(false);
                }
            });
        </script>
        <%- include('partials/sidebar_end') %>
</body>

</html>