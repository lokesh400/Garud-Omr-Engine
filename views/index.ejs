<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garud OMR • Intelligent Evaluation Suite</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-title {
            font-size: 1.45rem;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            letter-spacing: -0.02em;
        }

        .paper-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
            gap: 1.65rem;
        }

        .paper-card {
            background: var(--surface);
            border: 1px solid rgba(226, 232, 240, 0.85);
            border-radius: var(--radius-xl);
            padding: 1.65rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: all 0.26s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .paper-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), #06B6D4);
            opacity: 0.85;
            transition: opacity 0.25s ease, height 0.25s ease;
        }

        .paper-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 30px -8px rgba(79, 70, 229, 0.12), 0 8px 12px -4px rgba(15, 23, 42, 0.04);
            border-color: #CBD5E1;
        }

        .paper-card:hover::before {
            opacity: 1;
            height: 5px;
        }

        .paper-card-top {
            margin-bottom: 1.35rem;
        }

        .paper-card-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 0.55rem 0;
            line-height: 1.35;
            letter-spacing: -0.02em;
        }

        .paper-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 0.6rem;
        }

        .badge-count {
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(99, 102, 241, 0.12) 100%);
            color: var(--primary);
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 11px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid rgba(79, 70, 229, 0.16);
        }

        .badge-status {
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 11px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-ready {
            background: var(--success-light);
            color: #065F46;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-pending {
            background: #FEF3C7;
            color: #92400E;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .paper-tiles-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 1.35rem;
            padding-top: 1.25rem;
            border-top: 1px solid #F1F5F9;
        }

        .action-tile {
            display: flex;
            flex-direction: column;
            padding: 11px 13px;
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            text-decoration: none;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .action-tile:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px -2px rgba(15, 23, 42, 0.07);
        }

        .action-tile-key:hover {
            background: #EEF2FF;
            border-color: #A5B4FC;
        }

        .action-tile-scan {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(79, 70, 229, 0.09) 100%);
            border-color: rgba(6, 182, 212, 0.35);
        }

        .action-tile-scan:hover {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(79, 70, 229, 0.18) 100%);
            border-color: var(--accent-cyan);
            box-shadow: 0 6px 18px rgba(6, 182, 212, 0.25);
        }

        .action-tile-omr:hover {
            background: #ECFDF5;
            border-color: #86EFAC;
        }

        .action-tile-results:hover {
            background: #FAF5FF;
            border-color: #D8B4FE;
        }

        .tile-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 7px;
        }

        .tile-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease;
        }

        .action-tile:hover .tile-icon-box {
            transform: scale(1.08);
        }

        .icon-key {
            background: var(--primary-light);
            color: var(--primary);
        }

        .icon-scan {
            background: rgba(6, 182, 212, 0.2);
            color: #0891B2;
        }

        .icon-omr {
            background: var(--success-light);
            color: var(--success);
        }

        .icon-results {
            background: #F3E8FF;
            color: var(--secondary);
        }

        .tile-arrow {
            color: var(--text-subtle);
            font-size: 0.9rem;
            font-weight: 700;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .action-tile:hover .tile-arrow {
            transform: translateX(3px);
            color: var(--text-main);
        }

        .tile-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.25;
            margin-bottom: 2px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .tile-sub {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* Mobile & Tablet Responsiveness */
        @media (max-width: 640px) {
            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
                margin-bottom: 1.25rem;
            }
            .section-header .btn {
                width: 100%;
                justify-content: center;
            }
            .paper-list {
                grid-template-columns: 1fr;
                gap: 1.15rem;
            }
            .paper-card {
                padding: 1.25rem;
                border-radius: var(--radius-lg);
            }
            .paper-card-title {
                font-size: 1.15rem;
            }
            .paper-tiles-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }
            .action-tile {
                padding: 9px 10px;
            }
            .tile-icon-box {
                width: 30px;
                height: 30px;
            }
            .tile-title {
                font-size: 0.82rem;
            }
            .tile-sub {
                font-size: 0.68rem;
            }
        }

        @media (max-width: 360px) {
            .paper-tiles-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Large Laptop & Desktop */
        @media (min-width: 1200px) {
            .paper-list {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.85rem;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Top App Navigation Bar -->
        <header class="app-header">
            <div class="brand-logo-wrap">
                <div class="brand-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="9" y1="13" x2="15" y2="13"></line>
                        <line x1="9" y1="17" x2="13" y2="17"></line>
                        <circle cx="12" cy="12" r="1"></circle>
                    </svg>
                </div>
                <div>
                    <div class="brand-badge">Garud OMR Suite</div>
                    <h1 style="font-size: 1.45rem; margin: 0; font-weight: 800; letter-spacing: -0.02em;">Garud Engine</h1>
                </div>
            </div>
            <div>
                <a href="/paper/new" class="btn btn-primary">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create New Paper
                </a>
            </div>
        </header>

        <!-- Papers Section -->
        <main>
            <div class="section-header">
                <h2 class="section-title">
                    <span>Assessment Papers</span>
                    <span style="font-size: 0.88rem; color: var(--text-muted); font-weight: 600; background: #F1F5F9; padding: 2px 10px; border-radius: var(--radius-full);">
                        <%= papers ? papers.length : 0 %> Total
                    </span>
                </h2>
                <% if (papers && papers.length > 0) { %>
                    <a href="/paper/new" class="btn btn-secondary btn-sm">+ Add Paper</a>
                <% } %>
            </div>

            <% if (papers && papers.length > 0) { %>
                <div class="paper-list">
                    <% papers.forEach(paper => { %>
                        <% const hasKey = paper.answerKey && (paper.answerKey.size > 0 || Object.keys(paper.answerKey).length > 0); %>
                        <div class="paper-card">
                            <div class="paper-card-top">
                                <h3 class="paper-card-title"><%= paper.title %></h3>
                                <div class="paper-badges">
                                    <span class="badge-count">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <%= paper.numQuestions %> Questions
                                    </span>
                                    <% if (hasKey) { %>
                                        <span class="badge-status badge-ready">
                                            ✓ Key Configured
                                        </span>
                                    <% } else { %>
                                        <span class="badge-status badge-pending">
                                            ● Key Pending
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="paper-tiles-grid">
                                <!-- Tile 1: Answer Key -->
                                <a href="/paper/<%= paper._id %>" class="action-tile action-tile-key" title="Configure Question Answer Key">
                                    <div class="tile-top">
                                        <div class="tile-icon-box icon-key">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-2 2 1.5 1.5-3 3a5.5 5.5 0 1 0 7.78 7.78l3-3 1.5 1.5 2-2-1.5-1.5 1.5-1.5 2-2z"></path>
                                                <circle cx="7.5" cy="16.5" r="1.5"></circle>
                                            </svg>
                                        </div>
                                        <span class="tile-arrow">→</span>
                                    </div>
                                    <div class="tile-title">Answer Key</div>
                                    <div class="tile-sub"><%= hasKey ? '✓ Configured' : 'Configure Key' %></div>
                                </a>

                                <!-- Tile 2: Scan Paper (Live 4-Corner Camera) -->
                                <a href="/paper/<%= paper._id %>/scan" class="action-tile action-tile-scan" title="Launch Live 4-Corner AI Scanner">
                                    <div class="tile-top">
                                        <div class="tile-icon-box icon-scan">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                                <circle cx="12" cy="13" r="4"></circle>
                                            </svg>
                                        </div>
                                        <span class="tile-arrow">⚡</span>
                                    </div>
                                    <div class="tile-title" style="color: #0E7490;">Scan Paper</div>
                                    <div class="tile-sub">Live 4-Corner AI</div>
                                </a>

                                <!-- Tile 3: Generate OMR -->
                                <a href="/paper/<%= paper._id %>/omr" target="_blank" class="action-tile action-tile-omr" title="Generate & Print Blank A4 OMR Sheet">
                                    <div class="tile-top">
                                        <div class="tile-icon-box icon-omr">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                                <rect x="6" y="14" width="12" height="8"></rect>
                                            </svg>
                                        </div>
                                        <span class="tile-arrow">↗</span>
                                    </div>
                                    <div class="tile-title">Generate OMR</div>
                                    <div class="tile-sub">Printable A4 Sheet</div>
                                </a>

                                <!-- Tile 4: Results & Upload Evaluation -->
                                <a href="/paper/<%= paper._id %>" class="action-tile action-tile-results" title="View Evaluation Results & Upload Sheet Image">
                                    <div class="tile-top">
                                        <div class="tile-icon-box icon-results">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                                <line x1="6" y1="20" x2="6" y2="14"></line>
                                            </svg>
                                        </div>
                                        <span class="tile-arrow">→</span>
                                    </div>
                                    <div class="tile-title">Results</div>
                                    <div class="tile-sub">Upload & Report</div>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📝</div>
                    <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 800;">No Assessment Papers Yet</h3>
                    <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto 1.75rem; font-size: 0.95rem;">
                        Create your first paper to generate custom printable OMR answer sheets and begin automatic evaluation with sub-pixel precision.
                    </p>
                    <a href="/paper/new" class="btn btn-primary btn-lg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Create Your First Paper
                    </a>
                </div>
            <% } %>
        </main>
    </div>
</body>

</html>
