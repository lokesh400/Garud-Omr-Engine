<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garud OMR • Assessment Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .dashboard-container {
            max-width: 1320px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 3rem 1.5rem;
        }

        .section-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .header-bar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -0.01em;
        }

        .count-badge {
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.75rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        .header-bar-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            min-width: 240px;
        }

        .search-box input {
            width: 100%;
            padding: 7px 10px 7px 32px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-family: inherit;
            color: var(--text-main);
            background: #FFFFFF;
            transition: var(--transition);
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        /* Folder Directory Layout & Cards */
        .directory-info-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .directory-heading {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 4px 0;
            letter-spacing: -0.01em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .directory-subheading {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin: 0;
        }

        .folders-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.15rem;
        }

        .folder-card-item {
            background: #FFFFFF;
            border: 1.5px solid #E2E8F0;
            border-radius: 16px;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
            transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            position: relative;
            user-select: none;
            text-decoration: none;
            color: inherit;
        }

        .folder-card-item:hover {
            border-color: #3B82F6;
            box-shadow: 0 12px 28px -4px rgba(37, 99, 235, 0.12), 0 4px 10px -2px rgba(37, 99, 235, 0.04);
            transform: translateY(-2.5px);
        }

        .folder-card-all {
            background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
            border-color: #CBD5E1;
        }

        .folder-card-all:hover {
            border-color: #2563EB;
        }

        .folder-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .folder-icon-avatar {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #EFF6FF;
            color: #2563EB;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.15);
        }

        .avatar-all {
            background: #F0FDF4;
            color: #16A34A;
            box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.15);
        }

        .folder-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .folder-count-badge.has-papers {
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
        }

        .folder-count-badge.empty {
            background: #F8FAFC;
            color: #64748B;
            border: 1px solid #E2E8F0;
        }

        .btn-card-del-folder {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #DC2626;
            border-radius: 8px;
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 130ms ease;
            padding: 0;
            flex-shrink: 0;
        }

        .btn-card-del-folder:hover {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #F87171;
            transform: scale(1.08);
        }

        .btn-card-edit-folder {
            background: #F1F5F9;
            border: 1px solid #CBD5E1;
            color: #475569;
            border-radius: 8px;
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 130ms ease;
            padding: 0;
            flex-shrink: 0;
        }

        .btn-card-edit-folder:hover {
            background: #E2E8F0;
            color: #1E293B;
            border-color: #94A3B8;
            transform: scale(1.08);
        }

        .folder-card-body {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .folder-card-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            letter-spacing: -0.01em;
            line-height: 1.3;
        }

        .folder-card-desc {
            font-size: 0.82rem;
            color: #64748B;
            margin: 0;
            line-height: 1.4;
        }

        .folder-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 0.75rem;
            border-top: 1px solid #F1F5F9;
            font-size: 0.8rem;
            font-weight: 600;
            color: #2563EB;
        }

        .folder-card-footer span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .folder-card-arrow {
            transition: transform 140ms ease;
        }

        .folder-card-item:hover .folder-card-arrow {
            transform: translateX(3px);
        }

        /* Folder Navigation Bar (Inside Folder View) */
        .folder-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .folder-active-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-back-folders {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #F8FAFC;
            border: 1.5px solid #E2E8F0;
            color: #334155;
            padding: 6px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 130ms ease;
            text-decoration: none;
            font-family: inherit;
        }

        .btn-back-folders:hover {
            background: #EFF6FF;
            border-color: #93C5FD;
            color: #1D4ED8;
            transform: translateX(-2px);
        }

        .breadcrumb-sep {
            color: #94A3B8;
            font-size: 1rem;
            font-weight: 300;
        }

        /* Compact Attractive Cards Grid */
        .paper-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }

        .paper-card {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            padding: 1.15rem 1.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.95rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
            transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .paper-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3.5px;
            background: linear-gradient(90deg, #2563EB, #3B82F6);
            border-radius: 14px 14px 0 0;
        }

        .paper-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 25px -4px rgba(15, 23, 42, 0.08), 0 6px 12px -4px rgba(15, 23, 42, 0.04);
            transform: translateY(-2px);
        }

        .paper-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 6px;
        }

        .paper-card-title {
            font-size: 1.02rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            line-height: 1.35;
            letter-spacing: -0.01em;
        }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .status-ready {
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid #A7F3D0;
        }

        .status-pending {
            background: #FFFBEB;
            color: #92400E;
            border: 1px solid #FDE68A;
        }

        .status-dot-sm {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-ready .status-dot-sm {
            background: #10B981;
        }

        .status-pending .status-dot-sm {
            background: #F59E0B;
        }

        .paper-specs {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0;
        }

        .spec-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.74rem;
            color: #475569;
            font-weight: 600;
        }

        .spec-chip-cat {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            font-weight: 700;
        }

        .paper-card-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.74rem;
            color: #64748B;
            padding-top: 4px;
        }

        .paper-id-code {
            font-family: 'JetBrains Mono', monospace;
            background: #F1F5F9;
            color: #334155;
            padding: 1px 6px;
            border-radius: 4px;
            border: 1px solid #E2E8F0;
            font-size: 0.72rem;
        }

        /* Action Buttons Row: Side by Side */
        .paper-actions-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            padding-top: 0.85rem;
            border-top: 1px solid #F1F5F9;
        }

        .btn-action-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 130ms cubic-bezier(0.16, 1, 0.3, 1);
            white-space: nowrap;
            border: 1px solid transparent;
            font-family: inherit;
        }

        .btn-act-key {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
        }

        .btn-act-key:hover {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .btn-act-scan {
            background: var(--primary);
            color: #FFFFFF;
            border-color: var(--primary-hover);
        }

        .btn-act-scan:hover {
            background: var(--primary-hover);
        }

        .btn-act-results {
            background: #FFFFFF;
            color: #334155;
            border-color: #CBD5E1;
        }

        .btn-act-results:hover {
            background: #F8FAFC;
            color: #0F172A;
            border-color: #94A3B8;
        }

        .btn-act-print {
            background: #F8FAFC;
            color: #475569;
            border-color: #E2E8F0;
        }

        .btn-act-print:hover {
            background: #F1F5F9;
            color: #1E293B;
            border-color: #CBD5E1;
        }

        .btn-act-migrate {
            background: #F0FDF4;
            color: #15803D;
            border-color: #BBF7D0;
        }

        .btn-act-migrate:hover {
            background: #DCFCE7;
            color: #166534;
            border-color: #86EFAC;
        }

        .btn-act-delete {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
            margin-left: auto;
        }

        .btn-act-delete:hover {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #FCA5A5;
        }

        .btn-act-edit {
            background: #F8FAFC;
            color: #334155;
            border-color: #CBD5E1;
        }

        .btn-act-edit:hover {
            background: #F1F5F9;
            color: #0F172A;
            border-color: #94A3B8;
        }

        /* Section Builder inside Edit Paper Modal */
        .section-item-row {
            background: #FFFFFF;
            border: 1px solid #CBD5E1;
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 8px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 32px;
            gap: 8px;
            align-items: center;
        }
        .section-item-row:last-child {
            margin-bottom: 0;
        }
        .sec-field-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: #64748B;
            margin-bottom: 3px;
            display: block;
        }
        .sec-input {
            width: 100%;
            padding: 5px 8px;
            border: 1px solid #CBD5E1;
            border-radius: 6px;
            font-size: 0.85rem;
            font-family: inherit;
            color: #1E293B;
            background: #FFFFFF;
        }
        .sec-input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }
        .sec-input-mono {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            text-align: center;
        }
        .btn-remove-sec {
            background: #FEF2F2;
            color: #DC2626;
            border: 1px solid #FECACA;
            width: 30px;
            height: 30px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 16px;
            transition: all 120ms ease;
        }
        .btn-remove-sec:hover {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #F87171;
        }

        @media (max-width: 680px) {
            .dashboard-container {
                padding: 1rem 0.85rem 2.5rem 0.85rem;
            }

            .section-header-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .header-bar-right {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                min-width: 100%;
            }

            .folders-grid {
                grid-template-columns: 1fr;
            }

            .folder-card-item {
                padding: 1.1rem;
            }

            .directory-info-strip {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .folder-nav-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .paper-list {
                grid-template-columns: 1fr;
            }

            .btn-act-delete {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'dashboard' }) %>
        <div class="container">
            <main class="dashboard-container">
                <!-- FOLDERS DIRECTORY VIEW (Front Page Default: ONLY shows folders in a modern mobile-friendly grid) -->
                <section id="foldersDirectorySection" style="<%= activeFolder ? 'display: none;' : '' %>">
                    <div class="directory-info-strip">
                        <div>
                            <h2 class="directory-heading">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    style="color: #2563EB;">
                                    <path
                                        d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                                    </path>
                                </svg>
                                Sections, Batches & Folders
                            </h2>
                            <p class="directory-subheading">Select a folder or batch below to view all papers inside,
                                scan OMR sheets, and evaluate student marks.</p>
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <% if (currentUser && currentUser.role==='admin' ) { %>
                                <button type="button" class="btn btn-secondary btn-sm" onclick="openCreateFolderModal()"
                                    style="font-weight: 600; padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    New Folder
                                </button>

                                <a href="/paper/new" class="btn btn-primary btn-sm"
                                    style="font-weight: 600; padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    Create Paper
                                </a>
                                <% } %>

                                    <a href="/jee" class="btn btn-secondary btn-sm"
                                        style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="3"></circle>
                                            <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)">
                                            </ellipse>
                                            <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-30 12 12)">
                                            </ellipse>
                                        </svg>
                                        JEE Mains Section &rarr;
                                    </a>
                        </div>
                    </div>

                    <div class="folders-grid" id="foldersGrid">
                        <!-- All Assessment Papers Overview Card -->
                        <div class="folder-card-item folder-card-all" onclick="selectFolder('all')"
                            data-folder-name="all papers" data-folder-desc="all assessment papers combined">
                            <div class="folder-card-top">
                                <div class="folder-icon-avatar avatar-all">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                        <polyline points="2 17 12 22 22 17"></polyline>
                                        <polyline points="2 12 12 17 22 12"></polyline>
                                    </svg>
                                </div>
                                <span
                                    class="folder-count-badge <%= (papers && papers.length > 0) ? 'has-papers' : 'empty' %>">
                                    <%= papers ? papers.length : 0 %>
                                        <%= (papers && papers.length===1) ? 'Paper' : 'Papers' %>
                                </span>
                            </div>
                            <div class="folder-card-body">
                                <h3 class="folder-card-title">All Assessment Papers</h3>
                                <p class="folder-card-desc">Combined overview of all tests across all batches & folders.
                                </p>
                            </div>
                            <div class="folder-card-footer">
                                <span>Open All Papers</span>
                                <svg class="folder-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </div>
                        </div>

                        <% if (typeof folders !=='undefined' && folders.length> 0) { %>
                            <% folders.forEach(f=> { %>
                                <div class="folder-card-item" onclick="selectFolder('<%= f.name.replace(/'/g, "\\'") %>')" data-folder-id="<%= f._id %>" data-folder-name="<%= f.name.toLowerCase() %>" data-folder-desc="<%= (f.description || '' ).toLowerCase() %>">
                                                <div class="folder-card-top">
                                                    <div class="folder-icon-avatar">
