<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>V2</title>
    <link rel="stylesheet" href="/css/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        .hero-banner {
            background: linear-gradient(135deg, #1E1B4B 0%, #312E81 50%, #4338CA 100%);
            border-radius: var(--radius-lg);
            padding: 2.25rem 2.5rem;
            color: #FFFFFF;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(67, 56, 202, 0.25);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.35) 0%, transparent 70%);
            pointer-events: none;
        }

        .hero-content h2 {
            color: #FFFFFF;
            font-size: 1.85rem;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .hero-content p {
            color: #C7D2FE;
            font-size: 0.98rem;
            max-width: 580px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        .hero-stats {
            display: flex;
            gap: 1.25rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            padding: 1rem 1.5rem;
            border-radius: var(--radius-md);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .stat-item {
            text-align: center;
        }

        .stat-val {
            font-size: 1.6rem;
            font-weight: 800;
            color: #FFFFFF;
            font-family: 'Plus Jakarta Sans', sans-serif;
            line-height: 1;
        }

        .stat-lbl {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #A5B4FC;
            margin-top: 4px;
            font-weight: 600;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
        }

        .section-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }

        .paper-card {
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow-sm);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .paper-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            opacity: 0.85;
            transition: opacity 0.2s ease;
        }

        .paper-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: #CBD5E1;
        }

        .paper-card:hover::before {
            opacity: 1;
            height: 5px;
        }

        .paper-card-top {
            margin-bottom: 1.25rem;
        }

        .paper-card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .paper-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

        .badge-count {
            background: var(--primary-light);
            color: var(--primary);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-status {
            font-size: 0.8rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-ready {
            background: var(--success-light);
            color: #065F46;
        }

        .badge-pending {
            background: #FEF3C7;
            color: #92400E;
        }

        .paper-tiles-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 1.25rem;
            padding-top: 1.1rem;
            border-top: 1px solid #F1F5F9;
        }

        .action-tile {
            display: flex;
            flex-direction: column;
            padding: 10px 12px;
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            text-decoration: none;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

        .action-tile:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .action-tile-key:hover {
            background: #EEF2FF;
            border-color: #A5B4FC;
        }

        .action-tile-scan {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.06), rgba(79, 70, 229, 0.08));
            border-color: rgba(6, 182, 212, 0.35);
        }

        .action-tile-scan:hover {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.12), rgba(79, 70, 229, 0.16));
            border-color: var(--accent);
            box-shadow: 0 4px 14px rgba(6, 182, 212, 0.22);
        }

        .action-tile-omr:hover {
            background: #F0FDF4;
            border-color: #86EFAC;
        }

        .action-tile-results:hover {
            background: #FAF5FF;
            border-color: #D8B4FE;
        }

        .tile-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .tile-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-key {
            background: var(--primary-light);
            color: var(--primary);
        }

        .icon-scan {
            background: rgba(6, 182, 212, 0.18);
            color: #0891B2;
        }

        .icon-omr {
            background: var(--success-light);
            color: var(--success);
        }

        .icon-results {
            background: #F3E8FF;
            color: var(--secondary);
        }

        .tile-arrow {
            color: var(--text-subtle);
            font-size: 0.85rem;
            font-weight: 700;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .action-tile:hover .tile-arrow {
            transform: translateX(3px);
            color: var(--text-main);
        }

        .tile-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.2;
            margin-bottom: 2px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .tile-sub {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Top App Navigation Bar -->
        <header class="app-header">
            <div class="brand-logo-wrap">
                <div class="brand-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="9" y1="13" x2="15" y2="13"></line>
                        <line x1="9" y1="17" x2="13" y2="17"></line>
                        <circle cx="12" cy="12" r="1"></circle>
                    </svg>
                </div>
                <div>
                    <div class="brand-badge">OMR System v2.2</div>
                    <h1 style="font-size: 1.35rem; margin: 0; font-weight: 800;">OMRChecker Suite</h1>
                </div>
            </div>
            <div>
                <a href="/paper/new" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create New Paper
                </a>
            </div>
        </header>

        <!-- Hero Overview Banner -->
        <div class="hero-banner">
            <div class="hero-content">
                <h2>Automated Sheet Evaluation</h2>
                <p>Generate standardized printable sheets, configure question answer keys, and evaluate student
                    responses instantly via camera or image upload.</p>
            </div>
            <div class="hero-stats">
                <div class="stat-item">
                    <div class="stat-val">
                        <%= papers ? papers.length : 0 %>
                    </div>
                    <div class="stat-lbl">Active Papers</div>
                </div>
                <div style="width: 1px; background: rgba(255,255,255,0.2);"></div>
                <div class="stat-item">
                    <div class="stat-val">100%</div>
                    <div class="stat-lbl">Automated</div>
                </div>
            </div>
        </div>

        <!-- Papers Section -->
        <main>
            <div class="section-header">
                <h2 class="section-title">
                    <span>Your Assessment Papers</span>
                    <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
                        (<%= papers ? papers.length : 0 %> total)
                    </span>
                </h2>
                <% if (papers && papers.length> 0) { %>
                    <a href="/paper/new" class="btn btn-secondary btn-sm">+ Add Paper</a>
                    <% } %>
            </div>

            <% if (papers && papers.length> 0) { %>
                <div class="paper-list">
                    <% papers.forEach(paper=> { %>
                        <% const hasKey=paper.answerKey && (paper.answerKey.size> 0 ||
                            Object.keys(paper.answerKey).length > 0); %>
                            <div class="paper-card">
                                <div class="paper-card-top">
                                    <h3 class="paper-card-title">
                                        <%= paper.title %>
                                    </h3>
                                    <div class="paper-badges">
                                        <span class="badge-count">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            <%= paper.numQuestions %> Questions
                                        </span>
                                        <% if (hasKey) { %>
                                            <span class="badge-status badge-ready">
                                                ✓ Key Configured
                                            </span>
                                            <% } else { %>
                                                <span class="badge-status badge-pending">
                                                    ● Key Pending
                                                </span>
                                                <% } %>
                                    </div>
                                </div>

                                <div class="paper-tiles-grid">
                                    <!-- Tile 1: Answer Key -->
                                    <a href="/paper/<%= paper._id %>" class="action-tile action-tile-key" title="Configure Question Answer Key">
                                        <div class="tile-top">
                                            <div class="tile-icon-box icon-key">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-2 2 1.5 1.5-3 3a5.5 5.5 0 1 0 7.78 7.78l3-3 1.5 1.5 2-2-1.5-1.5 1.5-1.5 2-2z"></path>
                                                    <circle cx="7.5" cy="16.5" r="1.5"></circle>
                                                </svg>
                                            </div>
                                            <span class="tile-arrow">→</span>
                                        </div>
                                        <div class="tile-title">Answer Key</div>
                                        <div class="tile-sub"><%= hasKey ? '✓ Configured' : 'Configure Key' %></div>
                                    </a>

                                    <!-- Tile 2: Scan Paper (Live 4-Corner Camera) -->
                                    <a href="/paper/<%= paper._id %>/scan" class="action-tile action-tile-scan" title="Launch Live 4-Corner AI Scanner">
                                        <div class="tile-top">
                                            <div class="tile-icon-box icon-scan">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                                    <circle cx="12" cy="13" r="4"></circle>
                                                </svg>
                                            </div>
                                            <span class="tile-arrow">⚡</span>
                                        </div>
                                        <div class="tile-title" style="color: #0E7490;">Scan Paper</div>
                                        <div class="tile-sub">Live 4-Corner AI</div>
                                    </a>

                                    <!-- Tile 3: Generate OMR -->
                                    <a href="/paper/<%= paper._id %>/omr" target="_blank" class="action-tile action-tile-omr" title="Generate & Print Blank A4 OMR Sheet">
                                        <div class="tile-top">
                                            <div class="tile-icon-box icon-omr">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                                    <rect x="6" y="14" width="12" height="8"></rect>
                                                </svg>
                                            </div>
                                            <span class="tile-arrow">↗</span>
                                        </div>
                                        <div class="tile-title">Generate OMR</div>
                                        <div class="tile-sub">Printable A4 Sheet</div>
                                    </a>

                                    <!-- Tile 4: Results & Upload Evaluation -->
                                    <a href="/paper/<%= paper._id %>" class="action-tile action-tile-results" title="View Evaluation Results & Upload Sheet Image">
                                        <div class="tile-top">
                                            <div class="tile-icon-box icon-results">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                                </svg>
                                            </div>
                                            <span class="tile-arrow">→</span>
                                        </div>
                                        <div class="tile-title">Results</div>
                                        <div class="tile-sub">Upload & Report</div>
                                    </a>
                                </div>
                            </div>
                            <% }) %>
                </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">📝</div>
                        <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem;">No Papers Created Yet</h3>
                        <p style="color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem;">
                            Create your first paper to generate custom printable OMR answer sheets and begin automatic
                            evaluation.
                        </p>
                        <a href="/paper/new" class="btn btn-primary btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Create Your First Paper
                        </a>
                    </div>
                    <% } %>
        </main>
    </div>
</body>

</html>