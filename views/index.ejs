                                    > 0));
                                    const totalQ = paper.total_questions || paper.numQuestions || 50;
                                    const encodedId = encodeURIComponent(paper._id);
                                    const pIdStr = String(paper._id);
                                    const paperCat = (paper.category || paper.batch || 'General').trim();
                                    const searchStr = `${paper.title || ''} ${paper.subject || ''} ${pIdStr}
