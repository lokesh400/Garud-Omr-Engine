                                                    Move
                                                </button>

                                                <button type="button" class="btn-action-pill btn-act-delete"
                                                    onclick="deleteStandardPaper('<%= pIdStr %>', '<%= paper.title.replace(/'/g, "\\'") %>')" title="Delete this paper and all its student submissions and OMR images">
