<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garud OMR • Assessment Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .dashboard-container {
            max-width: 1320px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 3rem 1.5rem;
        }

        .section-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0.85rem 1.25rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .header-bar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -0.01em;
        }

        .count-badge {
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.75rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        .header-bar-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            min-width: 240px;
        }

        .search-box input {
            width: 100%;
            padding: 7px 10px 7px 32px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-family: inherit;
            color: var(--text-main);
            background: #FFFFFF;
            transition: var(--transition);
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        /* Dynamic Category / Section Filter Bar */
        .category-filter-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 1.25rem;
            padding: 4px 0;
        }

        .cat-filter-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-right: 4px;
        }

        .cat-pill {
            background: #FFFFFF;
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 140ms ease;
            user-select: none;
        }

        .cat-pill:hover {
            border-color: var(--border-hover);
            background: var(--surface-subtle);
        }

        .cat-pill.active {
            background: var(--primary);
            color: #FFFFFF;
            border-color: var(--primary);
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
        }

        /* Compact Attractive Cards Grid */
        .paper-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 1.15rem;
        }

        .paper-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-top: 3.5px solid var(--primary);
            border-radius: var(--radius-md);
            padding: 1rem 1.15rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.85rem;
            box-shadow: var(--shadow-xs);
            transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
        }

        .paper-card:hover {
            border-color: var(--border-hover);
            box-shadow: 0 6px 16px -3px rgba(15, 23, 42, 0.08);
            transform: translateY(-2px);
        }

        .paper-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 6px;
        }

        .paper-card-title {
            font-size: 0.98rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            line-height: 1.35;
        }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 7px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .status-ready {
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid #A7F3D0;
        }

        .status-pending {
            background: #FFFBEB;
            color: #92400E;
            border: 1px solid #FDE68A;
        }

        .status-dot-sm {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

        .paper-specs {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 4px;
        }

        .spec-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            padding: 2px 7px;
            border-radius: var(--radius-xs);
            font-size: 0.72rem;
            color: var(--text-body);
            font-weight: 600;
        }

        .spec-chip-cat {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
            font-weight: 700;
        }

        .paper-card-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        /* Action Buttons Row: Side by Side */
        .paper-actions-row {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            padding-top: 0.75rem;
            border-top: 1px solid var(--border-color);
        }

        .btn-action-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 5px 9px;
            border-radius: var(--radius-sm);
            font-size: 0.78rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 130ms ease;
            white-space: nowrap;
            border: 1px solid transparent;
            font-family: inherit;
        }

        .btn-act-key {
            background: #EFF6FF;
            color: #1D4ED8;
            border-color: #BFDBFE;
        }
        .btn-act-key:hover { background: #DBEAFE; }

        .btn-act-scan {
            background: var(--primary);
            color: #FFFFFF;
            border-color: var(--primary-hover);
        }
        .btn-act-scan:hover { background: var(--primary-hover); }

        .btn-act-results {
            background: #FFFFFF;
            color: var(--text-body);
            border-color: var(--border-hover);
        }
        .btn-act-results:hover { background: var(--surface-subtle); color: var(--text-main); }

        .btn-act-print {
            background: #F8FAFC;
            color: #475569;
            border-color: #E2E8F0;
        }
        .btn-act-print:hover { background: #F1F5F9; color: #1E293B; }

        .btn-act-delete {
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FECACA;
            margin-left: auto;
        }
        .btn-act-delete:hover { background: #FEE2E2; color: #991B1B; }

        @media (max-width: 680px) {
            .dashboard-container { padding: 1rem 0.85rem 2.5rem 0.85rem; }
            .section-header-bar { flex-direction: column; align-items: stretch; gap: 10px; }
            .header-bar-right { flex-direction: column; align-items: stretch; }
            .search-box { min-width: 100%; }
            .paper-list { grid-template-columns: 1fr; }
            .btn-act-delete { margin-left: 0; }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'dashboard' }) %>
    <div class="container">
        <main class="dashboard-container">
            <!-- Header Bar -->
            <header class="section-header-bar">
                <div class="header-bar-left">
                    <h1 class="section-title">Assessment Papers</h1>
                    <span class="count-badge" id="paperCountBadge"><%= papers ? papers.length : 0 %> Total</span>
                </div>

                <div class="header-bar-right">
                    <div class="search-box">
                        <span class="search-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="search" id="paperSearchInput" aria-label="Search papers" placeholder="Search by title, subject, or ID..." oninput="filterPapers()">
                    </div>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/paper/new" class="btn btn-primary btn-sm" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            + Create Paper
                        </a>
                    <% } %>

                    <a href="/jee" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                        ⚛️ JEE Mains Section &rarr;
                    </a>
                </div>
            </header>

            <!-- Dynamic Category / Section Filter Bar -->
            <nav class="category-filter-bar" aria-label="Filter by section or category">
                <span class="cat-filter-label">Section:</span>
                <button type="button" class="cat-pill active" data-cat="all" onclick="setCategoryFilter('all', this)">All</button>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                        <button type="button" class="cat-pill" data-cat="<%= cat.toLowerCase() %>" onclick="setCategoryFilter('<%= cat.toLowerCase() %>', this)"><%= cat %></button>
                    <% }) %>
                <% } %>
            </nav>

            <% if (papers && papers.length > 0) { %>
                <div class="paper-list" id="paperListGrid">
                    <% papers.forEach(paper => { %>
                        <% 
                            const hasKey = (Array.isArray(paper.answer_key) && paper.answer_key.some(k => k)) ||
                                           (paper.answerKey && (paper.answerKey.size > 0 || Object.keys(paper.answerKey).length > 0));
                            const totalQ = paper.total_questions || paper.numQuestions || 50;
                            const encodedId = encodeURIComponent(paper._id);
                            const pIdStr = String(paper._id);
                            const paperCat = (paper.category || paper.batch || 'General').trim();
                            const searchStr = `${paper.title || ''} ${paper.subject || ''} ${pIdStr} ${paperCat}`.toLowerCase();
                        %>
                        <article class="paper-card paper-item-card" id="card-<%= pIdStr %>" data-search="<%= searchStr %>" data-category="<%= paperCat.toLowerCase() %>">
                            <div>
                                <div class="paper-card-header">
                                    <h3 class="paper-card-title"><%= paper.title %></h3>
                                    <% if (hasKey) { %>
                                        <span class="status-chip status-ready" title="Answer key configured">
                                            <span class="status-dot-sm"></span> Key Ready
                                        </span>
                                    <% } else { %>
                                        <span class="status-chip status-pending" title="Answer key not configured">
                                            <span class="status-dot-sm"></span> Key Pending
                                        </span>
                                    <% } %>
                                </div>

                                <div class="paper-specs">
                                    <span class="spec-chip spec-chip-cat">📁 <%= paperCat %></span>
                                    <span class="spec-chip"><%= totalQ %> Questions</span>
                                    <% if (paper.sections && paper.sections.length > 0) { %>
                                        <span class="spec-chip"><%= paper.sections.length %> Sections</span>
                                    <% } %>
                                    <% if (paper.max_marks) { %>
                                        <span class="spec-chip"><%= paper.max_marks %> Max Marks</span>
                                    <% } %>
                                </div>

                                <div class="paper-card-footer-info">
                                    <span>Subject: <strong><%= paper.subject || 'General' %></strong></span>
                                    <span>ID: <code style="font-family:'JetBrains Mono',monospace;"><%= pIdStr.slice(-8) %></code></span>
                                </div>
                            </div>

                            <!-- Buttons Side-by-Side in Horizontal Row -->
                            <div class="paper-actions-row">
                                <a href="/paper/<%= encodedId %>" class="btn-action-pill btn-act-key" title="View or edit answer key">
                                    Answer Key
                                </a>

                                <a href="/paper/<%= encodedId %>/results" class="btn-action-pill btn-act-results" title="View Results and Checked OMR Copies">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    Results
                                </a>

                                <a href="/paper/<%= encodedId %>/omr" target="_blank" class="btn-action-pill btn-act-print" title="Open Printable A4 OMR Sheet">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                        <rect x="6" y="14" width="12" height="8"></rect>
                                    </svg>
                                    Print
                                </a>

                                <% if (currentUser && currentUser.role === 'admin') { %>
                                    <a href="/paper/<%= encodedId %>/scan" class="btn-action-pill btn-act-scan" title="Scan OMR Sheet with Camera">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                            <circle cx="12" cy="13" r="4"></circle>
                                        </svg>
                                        Scan
                                    </a>

                                    <button type="button" class="btn-action-pill btn-act-delete" onclick="deleteStandardPaper('<%= pIdStr %>', '<%= paper.title.replace(/'/g, "\\'") %>')" title="Delete this paper and all its student submissions and OMR images">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                        Delete
                                    </button>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state" style="background:#FFFFFF; border:1px solid var(--border-color); border-radius:var(--radius-lg); padding:3rem 1.5rem; text-align:center;">
                    <div class="empty-state-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                            <line x1="8" y1="8" x2="16" y2="8"></line>
                        </svg>
                    </div>
                    <h3 style="margin: 0 0 0.5rem 0; font-size:1.15rem; font-weight:700;">No papers created yet</h3>
                    <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto 1.5rem; font-size: 0.9rem; line-height:1.5;">
                        Create your first assessment paper to generate printable OMR answer sheets and start evaluating.
                    </p>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/paper/new" class="btn btn-primary">
                            + Create First Paper
                        </a>
                    <% } %>
                </div>
            <% } %>
        </main>
    </div>

    <script>
        let activeCategory = 'all';

        function setCategoryFilter(cat, btn) {
            activeCategory = cat;
            document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            filterPapers();
        }

        function filterPapers() {
            const query = (document.getElementById('paperSearchInput').value || '').toLowerCase().trim();
            const items = document.querySelectorAll('.paper-item-card');
            let visibleCount = 0;

            items.forEach(item => {
                const searchStr = item.getAttribute('data-search') || '';
                const itemCat = item.getAttribute('data-category') || '';
                const matchesSearch = !query || searchStr.includes(query);
                const matchesCat = (activeCategory === 'all') || (itemCat === activeCategory);

                const show = matchesSearch && matchesCat;
                item.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            const badge = document.getElementById('paperCountBadge');
            if (badge) {
                badge.textContent = visibleCount + ' Total';
            }
        }

        async function deleteStandardPaper(id, title) {
            // Triple confirmation before deleting paper
            const c1 = confirm(`[1/3 CONFIRMATION REQUIRED]\n\nAre you sure you want to permanently DELETE paper "${title}"?\n\nThis will remove the paper, all graded submissions, and all stored OMR scans.`);
            if (!c1) return;

            const c2 = confirm(`[2/3 WARNING: CATASTROPHIC DATA LOSS]\n\nAll student marks, rankings, and Cloudinary OMR image copies will be PERMANENTLY DESTROYED.\n\nAre you sure you want to proceed?`);
            if (!c2) return;

            const c3 = confirm(`[3/3 FINAL CONFIRMATION]\n\nFinal check: Type or confirm to permanently delete paper "${title}" and all its data immediately.`);
            if (!c3) return;

            try {
                const res = await fetch('/api/paper/' + encodeURIComponent(id), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById('card-' + id);
                    if (card) card.remove();
                    filterPapers();
                } else {
                    alert('Error: ' + (data.error || 'Failed to delete paper'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }
    </script>
    <%- include('partials/sidebar_end') %>
</body>

</html>
