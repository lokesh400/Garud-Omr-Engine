<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garud OMR • Assessment Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .brand-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            line-height: 1.2;
        }

        .brand-subtitle {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 2px 0 0 0;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }

        .count-badge {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-muted);
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            padding: 2px 10px;
            border-radius: var(--radius-full);
        }

        .paper-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 1.25rem;
        }

        .paper-card {
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.35rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.25rem;
            box-shadow: var(--shadow-xs);
            transition: border-color 150ms ease, box-shadow 150ms ease;
        }

        .paper-card:hover {
            border-color: var(--border-hover);
            box-shadow: var(--shadow-md);
        }

        .paper-card-top-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 0.5rem;
        }

        .paper-card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            line-height: 1.35;
        }

        .paper-meta-line {
            font-size: 0.8125rem;
            color: var(--text-muted);
            margin-bottom: 0.85rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .paper-id-code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-body);
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            padding: 1px 6px;
            border-radius: 4px;
        }

        .paper-specs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .spec-chip {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-body);
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            padding: 3px 9px;
            border-radius: var(--radius-xs);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .status-chip {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            flex-shrink: 0;
        }

        .status-ready {
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
        }

        .status-pending {
            background: var(--warning-light);
            color: var(--warning-hover);
            border: 1px solid var(--warning-border);
        }

        .status-dot-sm {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .paper-actions-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            padding-top: 1rem;
            border-top: 1px solid #F1F5F9;
        }

        .paper-actions-grid .btn {
            width: 100%;
            justify-content: center;
            padding: 0.55rem 0.75rem;
            font-size: 0.825rem;
        }

        @media (max-width: 640px) {
            .paper-list {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .paper-card {
                padding: 1.15rem;
            }
        }

        @media (max-width: 360px) {
            .paper-actions-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (min-width: 1320px) {
            .paper-list {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .header-actions-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        @media (max-width: 640px) {
            .header-actions-group {
                width: 100%;
            }

            .header-actions-group .btn-primary-full {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'dashboard' }) %>
        <div class="container">

            <main>
                <div class="section-header">
                    <h2 class="section-title">
                        <span>Assessment Papers</span>
                        <span class="count-badge">
                            <%= papers ? papers.length : 0 %> Total
                        </span>
                    </h2>
                </div>

                <% if (papers && papers.length> 0) { %>
                    <div class="paper-list">
                        <% papers.forEach(paper=> { %>
                            <% const hasKey=(Array.isArray(paper.answer_key) && paper.answer_key.some(k=> k)) ||
                                (paper.answerKey && (paper.answerKey.size > 0 || Object.keys(paper.answerKey).length >
                                0));
                                const totalQ = paper.total_questions || paper.numQuestions || 50;
                                const encodedId = encodeURIComponent(paper._id);
                                %>
                                <article class="paper-card">
                                    <div>
                                        <div class="paper-card-top-row">
                                            <h3 class="paper-card-title">
                                                <%= paper.title %>
                                            </h3>
                                            <% if (hasKey) { %>
                                                <span class="status-chip status-ready">
                                                    <span class="status-dot-sm"></span>
                                                    Key Ready
                                                </span>
                                                <% } else { %>
                                                    <span class="status-chip status-pending">
                                                        <span class="status-dot-sm"></span>
                                                        Key Pending
                                                    </span>
                                                    <% } %>
                                        </div>

                                        <div class="paper-meta-line">
                                            <% if (paper.subject) { %>
                                                <span>
                                                    <%= paper.subject %>
                                                </span>
                                                <% } %>
                                                    <% if (paper.subject && paper._id) { %>
                                                        <span>&middot;</span>
                                                        <% } %>
                                                            <% if (paper._id) { %>
                                                                <span class="paper-id-code">
                                                                    <%= paper._id %>
                                                                </span>
                                                                <% } %>
                                        </div>

                                        <div class="paper-specs">
                                            <span class="spec-chip">
                                                <%= totalQ %> Questions
                                            </span>
                                            <% if (paper.sections && paper.sections.length> 0) { %>
                                                <span class="spec-chip">
                                                    <%= paper.sections.length %> Sections
                                                </span>
                                                <% } %>
                                                    <% if (paper.max_marks) { %>
                                                        <span class="spec-chip">
                                                            <%= paper.max_marks %> Max Marks
                                                        </span>
                                                        <% } %>
                                        </div>
                                    </div>

                                    <div class="paper-actions-grid">
                                        <a href="/paper/<%= encodedId %>" class="btn btn-secondary"
                                            title="Configure Question Answer Key">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round" aria-hidden="true">
                                                <path
                                                    d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4">
                                                </path>
                                            </svg>
                                            Answer Key
                                        </a>

                                        <a href="/paper/<%= encodedId %>/omr" target="_blank" class="btn btn-secondary"
                                            title="Open Printable A4 OMR Sheet">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                <path
                                                    d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2">
                                                </path>
                                                <rect x="6" y="14" width="12" height="8"></rect>
                                            </svg>
                                            Print OMR
                                        </a>

                                        <a href="/paper/<%= encodedId %>/results" class="btn btn-secondary"
                                            title="View Results and Checked OMR Copies">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round" aria-hidden="true">
                                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                                <line x1="6" y1="20" x2="6" y2="14"></line>
                                            </svg>
                                            Results
                                        </a>

                                        <a href="/paper/<%= encodedId %>/scan" class="btn btn-primary"
                                            title="Scan OMR Sheet with Camera">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round" aria-hidden="true">
                                                <path
                                                    d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z">
                                                </path>
                                                <circle cx="12" cy="13" r="4"></circle>
                                            </svg>
                                            Scan Paper
                                        </a>
                                    </div>
                                </article>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-state-icon" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </div>
                            <h3 style="margin-bottom: 0.4rem;">No assessment papers yet</h3>
                            <p
                                style="color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem; font-size: 0.92rem;">
                                Create your first exam paper to generate printable A4 OMR sheets, configure the answer
                                key, and evaluate student responses.
                            </p>
                            <a href="/paper/new" class="btn btn-primary btn-lg">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                                    aria-hidden="true">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Create Your First Paper
                            </a>
                        </div>
                        <% } %>
            </main>
        </div>
        <%- include('partials/sidebar_end') %>
</body>

</html>