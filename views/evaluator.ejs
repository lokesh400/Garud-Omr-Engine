<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Leveled Evaluation - <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        .eval-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .eval-header-split {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .eval-layout {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .eval-layout { grid-template-columns: 1fr; }
        }
        .canvas-card {
            background: #090D16;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.5);
            border: 1px solid #1E293B;
            position: relative;
        }
        .canvas-toolbar {
            background: #111827;
            border-bottom: 1px solid #1E293B;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            color: white;
            font-size: 0.88rem;
        }
        .canvas-toolbar-btn {
            background: #1E293B;
            color: #FFFFFF;
            border: 1px solid #334155;
            border-radius: var(--radius-sm);
            padding: 6px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .canvas-toolbar-btn:hover {
            background: #334155;
            border-color: #06B6D4;
        }
        .canvas-wrapper {
            position: relative;
            background: #090D16;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #canvasOutput {
            width: 100%;
            height: auto;
            display: block;
            border-radius: var(--radius-sm);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            background: #FFFFFF;
        }
        .level-badge {
            background: rgba(16, 185, 129, 0.9);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
        }
        .score-hero {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            text-align: center;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-glow);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .stat-box {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.85rem;
            text-align: center;
        }
        .stat-box .num { font-size: 1.5rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
        .stat-box .lbl { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-top: 2px; }
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        .breakdown-table th, .breakdown-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }
        .breakdown-table th { background: #F8FAFC; font-weight: 700; color: var(--text-muted); }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-correct { background: var(--success-light); color: #065F46; }
        .badge-wrong { background: var(--danger-light); color: #991B1B; }
        .badge-blank { background: #F1F5F9; color: #64748B; }
        .badge-multiple {
            background: #FEE2E2;
            color: #991B1B;
            border: 1px solid #FCA5A5;
        }
        /* Roll Number Card */
        .roll-number-card {
            background: #0F172A;
            border: 1px solid #1E293B;
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
        }
        .roll-label-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.75rem;
        }
        .roll-title {
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: #94A3B8;
            text-transform: uppercase;
        }
        .roll-status-pill {
            margin-left: auto;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: var(--radius-full);
            background: rgba(16, 185, 129, 0.2);
            color: #34D399;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-family: 'JetBrains Mono', monospace;
        }
        .roll-boxes-display {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
        .roll-digit-box {
            width: 36px;
            height: 44px;
            background: #1E293B;
            border: 1.5px solid #334155;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #38BDF8;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
            transition: all 0.2s ease;
        }
        .roll-digit-box.filled {
            border-color: #38BDF8;
            background: #0c2238;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.35), inset 0 2px 4px rgba(0,0,0,0.3);
        }
        .roll-digit-box.unknown {
            color: #64748B;
            border-style: dashed;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            background: #DEF7EC;
            color: #03543F;
        }
    </style>
</head>
<body>
    <div class="container eval-container">
        <!-- Header -->
        <div class="eval-header-split">
            <div>
                <h1 style="font-size: 1.5rem; margin: 0 0 4px 0;">AI Leveled Evaluation</h1>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                    <%= paper.title %> &bull; <%= paper.numQuestions %> Questions
                </p>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <span id="evalStatus" class="status-pill">Analyzing & Leveling...</span>
                <a href="/paper/<%= paper._id %>" class="btn btn-secondary btn-sm">&larr; Back to Paper</a>
            </div>
        </div>

        <div class="eval-layout">
            <!-- Left: Leveled & Cropped Sheet -->
            <div>
                <div class="canvas-card">
                    <div class="canvas-toolbar">
                        <span class="level-badge">âœ“ Auto-Leveled & Cropped (A4)</span>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="canvas-toolbar-btn" id="toggleViewBtn" onclick="toggleRawView()">ðŸ–¼ View Raw Upload</button>
                        </div>
                    </div>
                    <div class="canvas-wrapper">
                        <canvas id="canvasOutput"></canvas>
                    </div>
                </div>
            </div>

            <!-- Right: Scorecard & Breakdown -->
            <div>
                <!-- Student Roll Number Card -->
                    <div class="roll-number-card">
                        <div class="roll-label-row">
                            <span style="font-size: 1.1rem;">🎓</span>
                            <span class="roll-title">Student Roll Number</span>
                            <span class="roll-status-pill" id="rollStatusPill">Detecting...</span>
                        </div>
                        <div class="roll-boxes-display" id="rollBoxesDisplay">
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                        </div>
                    </div>

                    <div class="score-hero">
                    <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Score Achieved</div>
                    <div class="score-val" id="scoreValue" style="font-size: 3.25rem; font-weight: 800; margin: 0.25rem 0; font-family: 'Plus Jakarta Sans', sans-serif;">0 / 0</div>
                    <div id="scorePercentage" style="font-size: 1.15rem; font-weight: 600;">0% Accuracy</div>
                </div>

                <div class="card" style="padding: 1.25rem;">
                    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(75px, 1fr)); gap: 8px;">
                        <div class="stat-box">
                            <div class="num" id="statCorrect" style="color: #10B981;">0</div>
                            <div class="lbl">Correct</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                            <div class="lbl">Wrong</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statMultiple" style="color: #DC2626;">0</div>
                            <div class="lbl">Multiple</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                            <div class="lbl">Attempted</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                            <div class="lbl">Blank</div>
                        </div>
                    </div>
                        <div class="stat-box">
                            <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                            <div class="lbl">Wrong</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                            <div class="lbl">Attempted</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                            <div class="lbl">Unmarked</div>
                        </div>
                    </div>

                    <h4 style="margin: 1.25rem 0 0.5rem 0; font-size: 0.95rem;">Question Breakdown</h4>
                    <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                        <table class="breakdown-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Marked</th>
                                    <th>Key</th>
                                    <th>Verdict</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden source image -->
    <img id="uploadedImage" src="<%= imagePath %>" style="position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;" alt="Sheet">

    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;
        const img = document.getElementById('uploadedImage');
        const canvas = document.getElementById('canvasOutput');
        const ctx = canvas.getContext('2d');
        const evalStatus = document.getElementById('evalStatus');
        const toggleViewBtn = document.getElementById('toggleViewBtn');

        let rawCanvas = document.createElement('canvas');
        let rawCtx = rawCanvas.getContext('2d');
        let leveledCanvas = document.createElement('canvas');
        let leveledCtx = leveledCanvas.getContext('2d');
        let showingRaw = false;

        const TARGET_W = 1000;
        const TARGET_H = 1414; // A4 1:1.414

        const U_START = 141.0 / 2235.0;
        const V_START = 835.5 / 3261.0;
        const U_BUBBLE_STEP = 62.5 / 2235.0;
        const V_ROW_STEP = 59.4615 / 3261.0;
        const U_COL_STEP = 447.5 / 2235.0;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        function initEvaluator() {
            if (!img.complete || img.naturalWidth === 0) {
                setTimeout(initEvaluator, 100);
                return;
            }

            const W = img.naturalWidth;
            const H = img.naturalHeight;
            rawCanvas.width = W;
            rawCanvas.height = H;
            rawCtx.drawImage(img, 0, 0);

            // Auto-detect 4 corner square markers
            const corners = autoDetectCorners(rawCtx, W, H);

            // Warp & level into the flat upright A4 canvas
            warpAndEvaluate(corners, W, H);
        }

        function toggleRawView() {
            showingRaw = !showingRaw;
            if (showingRaw) {
                canvas.width = rawCanvas.width;
                canvas.height = rawCanvas.height;
                ctx.drawImage(rawCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ“ View Leveled & Cropped';
            } else {
                canvas.width = leveledCanvas.width;
                canvas.height = leveledCanvas.height;
                ctx.drawImage(leveledCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ–¼ View Raw Upload';
            }
        }

        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]]; [B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        function autoDetectCorners(ctx, W, H) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;
            const diag = Math.hypot(W, H);

            function findSquareMarker(x1, y1, x2, y2, cx, cy) {
                const pw = Math.round(x2 - x1);
                const ph = Math.round(y2 - y1);
                const gray = new Uint8Array(pw * ph);
                const hist = new Int32Array(256);
                let idx = 0;

                for (let y = y1; y < y2; y++) {
                    for (let x = x1; x < x2; x++) {
                        const pIdx = (y * W + x) * 4;
                        const g = (data[pIdx] * 77 + data[pIdx+1] * 150 + data[pIdx+2] * 29) >> 8;
                        gray[idx++] = g;
                        hist[g]++;
                    }
                }

                const total = pw * ph;
                let sum = 0;
                for (let i = 0; i < 256; i++) sum += i * hist[i];
                let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
                for (let i = 0; i < 256; i++) {
                    wB += hist[i];
                    if (wB === 0) continue;
                    const wF = total - wB;
                    if (wF === 0) break;
                    sumB += i * hist[i];
                    const v = wB * wF * (sumB/wB - (sum - sumB)/wF) * (sumB/wB - (sum - sumB)/wF);
                    if (v > maxVar) { maxVar = v; thresh = i + 1; }
                }

                thresh = Math.max(35, Math.min(thresh, 185));

                const visited = new Uint8Array(pw * ph);
                const candidates = [];
                const minSide = Math.min(W, H);
                const minArea = (minSide * 0.007) * (minSide * 0.007);
                const maxArea = (minSide * 0.08) * (minSide * 0.08);

                for (let py = 1; py < ph - 1; py += 2) {
                    for (let px = 1; px < pw - 1; px += 2) {
                        const p = py * pw + px;
                        if (visited[p] || gray[p] >= thresh) continue;

                        let count = 0, sumX = 0, sumY = 0;
                        let minX = px, maxX = px, minY = py, maxY = py;
                        const queue = [p];
                        visited[p] = 1;
                        let qHead = 0;

                        while (qHead < queue.length) {
                            const cur = queue[qHead++];
                            const cy_p = Math.floor(cur / pw);
                            const cx_p = cur % pw;
                            count++;
                            sumX += cx_p;
                            sumY += cy_p;
                            if (cx_p < minX) minX = cx_p;
                            if (cx_p > maxX) maxX = cx_p;
                            if (cy_p < minY) minY = cy_p;
                            if (cy_p > maxY) maxY = cy_p;

                            for (let nb of [cur - 1, cur + 1, cur - pw, cur + pw]) {
                                if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                    visited[nb] = 1;
                                    queue.push(nb);
                                }
                            }
                        }

                        const bw = maxX - minX + 1;
                        const bh = maxY - minY + 1;
                        const aspect = bw / bh;
                        const density = count / (bw * bh);

                        if (aspect > 0.60 && aspect < 1.60 && density > 0.55 && count >= minArea && count <= maxArea) {
                            const bx = Math.round(x1 + sumX / count);
                            const by = Math.round(y1 + sumY / count);

                            // Isolation check
                            const rIn = Math.round(Math.max(bw, bh) * 0.75);
                            const rOut = Math.round(Math.max(bw, bh) * 1.55);
                            let darkRing = 0, totalRing = 0;

                            for (let rdy = -rOut; rdy <= rOut; rdy += 3) {
                                for (let rdx = -rOut; rdx <= rOut; rdx += 3) {
                                    const d2 = rdx * rdx + rdy * rdy;
                                    if (d2 >= rIn * rIn && d2 <= rOut * rOut) {
                                        const gx = bx + rdx;
                                        const gy = by + rdy;
                                        if (gx >= 0 && gx < W && gy >= 0 && gy < H) {
                                            totalRing++;
                                            const gIdx = (gy * W + gx) * 4;
                                            const pixGray = (data[gIdx] * 77 + data[gIdx + 1] * 150 + data[gIdx + 2] * 29) >> 8;
                                            if (pixGray < thresh) darkRing++;
                                        }
                                    }
                                }
                            }

                            const ringDarkRatio = totalRing > 0 ? (darkRing / totalRing) : 0;
                            const distToCorner = Math.hypot(bx - cx, by - cy);
                            const normDist = distToCorner / diag;

                            if (ringDarkRatio <= 0.08) {
                                const score = (density * 2.0) - (normDist * 2.5) - (ringDarkRatio * 4.0);
                                candidates.push({ x: bx, y: by, score: score });
                            }
                        }
                    }
                }

                if (candidates.length === 0) return null;
                candidates.sort((a, b) => b.score - a.score);
                return { x: candidates[0].x, y: candidates[0].y };
            }

            const boxW = Math.round(W * 0.22);
            const boxH = Math.round(H * 0.22);

            const tl = findSquareMarker(0, 0, boxW, boxH, 0, 0) || { x: Math.round(W * 0.056), y: Math.round(H * 0.038) };
            const tr = findSquareMarker(W - boxW, 0, W, boxH, W, 0) || { x: Math.round(W * 0.944), y: Math.round(H * 0.038) };
            const br = findSquareMarker(W - boxW, H - boxH, W, H, W, H) || { x: Math.round(W * 0.944), y: Math.round(H * 0.962) };
            const bl = findSquareMarker(0, H - boxH, boxW, H, 0, H) || { x: Math.round(W * 0.056), y: Math.round(H * 0.962) };

            return [tl, tr, br, bl];
        }

        function warpAndEvaluate(corners, W, H) {
            leveledCanvas.width = TARGET_W;
            leveledCanvas.height = TARGET_H;

            const m_L = TARGET_W * 0.056;
            const m_R = TARGET_W * 0.944;
            const m_T = TARGET_H * 0.038;
            const m_B = TARGET_H * 0.962;

            const dstRectCorners = [
                { x: m_L, y: m_T },
                { x: m_R, y: m_T },
                { x: m_R, y: m_B },
                { x: m_L, y: m_B }
            ];

            const H_mat = getPerspectiveTransform(dstRectCorners, corners);
            const srcImgData = rawCtx.getImageData(0, 0, W, H);
            const src32 = new Uint32Array(srcImgData.data.buffer);

            const dstImgData = leveledCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF;
                    }
                    dstIdx++;
                }
            }

            leveledCtx.putImageData(dstImgData, 0, 0);

            // Grade bubbles on the leveled cropped sheet
            evaluateLeveledSheet(leveledCtx, TARGET_W, TARGET_H, m_L, m_T, m_R - m_L, m_B - m_T);

            // Draw leveled sheet to main canvas
            canvas.width = TARGET_W;
            canvas.height = TARGET_H;
            ctx.drawImage(leveledCanvas, 0, 0);

            evalStatus.textContent = 'âœ“ Leveled & Graded (100% Locked)';
            evalStatus.style.background = '#DEF7EC';
            evalStatus.style.color = '#03543F';
        }

        // Evaluate bubbles and roll number on the flat, leveled A4 sheet
        // High-Precision Core-Based Bubble & Roll Number Evaluator
        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (y * W + x) * 4;
                return (data[idx] * 77 + data[idx+1] * 150 + data[idx+2] * 29) >> 8;
            }

            function sampleCircle(cx, cy, r) {
                let sum = 0, count = 0;
                for (let dy = -r; dy <= r; dy++) {
                    for (let dx = -r; dx <= r; dx++) {
                        if (dx*dx + dy*dy <= r*r) {
                            sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            // 1. DETECT 8-DIGIT ROLL NUMBER FROM ROLL NUMBER GRID
            const U_ROLL_START = 1386.5 / 2235.0;
            const V_ROLL_START = 191.0 / 3261.0;
            const U_ROLL_COL_STEP = 59.5 / 2235.0;
            const V_ROLL_ROW_STEP = 59.5 / 3261.0;
            const rollRadius = Math.max(6, Math.round(Math.min(W, H) * 0.0065));
            const rollCoreRadius = Math.max(3, Math.round(rollRadius * 0.55));

            let detectedRollNumber = '';
            let rollDigitsArray = [];
            let detectedDigitsCount = 0;

            for (let c = 0; c < 8; c++) {
                const colX = markerL + (U_ROLL_START + c * U_ROLL_COL_STEP) * markerW;
                const paperVal = sampleCircle(colX - 12, markerT + V_ROLL_START * markerH, 4);

                let colStats = [];
                for (let d = 0; d < 10; d++) {
                    const rowY = markerT + (V_ROLL_START + d * V_ROLL_ROW_STEP) * markerH;

                    let bestX = colX, bestY = rowY, minVal = 999;
                    for (let dy of [-2, 0, 2]) {
                        for (let dx of [-2, 0, 2]) {
                            const val = sampleCircle(colX + dx, rowY + dy, Math.round(rollRadius * 0.5));
                            if (val < minVal) {
                                minVal = val;
                                bestX = colX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    const coreMean = sampleCircle(bestX, bestY, rollCoreRadius);
                    const coreDarkness = paperVal - coreMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -rollRadius; dy <= rollRadius; dy++) {
                        for (let dx = -rollRadius; dx <= rollRadius; dx++) {
                            if (dx*dx + dy*dy <= rollRadius*rollRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 30)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    colStats.push({
                        digit: d,
                        coreDarkness: coreDarkness,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                colStats.sort((a, b) => b.coreDarkness - a.coreDarkness);
                const top1 = colStats[0];
                const top2 = colStats[1];

                let isColFilled = false;
                if ((top1.coreDarkness >= 75) || (top1.coreDarkness >= 40 && top1.darkRatio >= 0.35)) {
                    if (top1.coreDarkness - top2.coreDarkness >= 15 || top1.darkRatio >= 0.45) {
                        isColFilled = true;
                    }
                }

                const detectedDigit = isColFilled ? top1.digit.toString() : '-';
                if (isColFilled) detectedDigitsCount++;
                detectedRollNumber += detectedDigit;
                rollDigitsArray.push({
                    digit: detectedDigit,
                    isFilled: isColFilled,
                    chosen: isColFilled ? top1 : null
                });

                // Draw roll number grid overlays on canvas
                for (let d = 0; d < 10; d++) {
                    const stat = colStats.find(s => s.digit === d);
                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, rollRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(2, Math.round(W * 0.0018));

                    if (isColFilled && d === top1.digit) {
                        ctx.strokeStyle = '#06B6D4';
                        ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        ctx.fill();
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                    }
                    ctx.stroke();
                }
            }

            // Update Roll Number UI Display
            const rollBoxesEl = document.getElementById('rollBoxesDisplay');
            if (rollBoxesEl) {
                let rollBoxesHtml = '';
                for (let c = 0; c < 8; c++) {
                    const item = rollDigitsArray[c];
                    if (item.isFilled) {
                        rollBoxesHtml += `<div class="roll-digit-box filled">${item.digit}</div>`;
                    } else {
                        rollBoxesHtml += `<div class="roll-digit-box unknown">-</div>`;
                    }
                }
                rollBoxesEl.innerHTML = rollBoxesHtml;
            }
            const rollStatusPill = document.getElementById('rollStatusPill');
            if (rollStatusPill) {
                if (detectedDigitsCount === 8) {
                    rollStatusPill.textContent = '✓ 8/8 DIGITS DETECTED';
                    rollStatusPill.style.background = 'rgba(16, 185, 129, 0.2)';
                    rollStatusPill.style.color = '#34D399';
                    rollStatusPill.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                } else if (detectedDigitsCount > 0) {
                    rollStatusPill.textContent = `${detectedDigitsCount}/8 DIGITS DETECTED`;
                    rollStatusPill.style.background = 'rgba(245, 158, 11, 0.2)';
                    rollStatusPill.style.color = '#FBBF24';
                    rollStatusPill.style.borderColor = 'rgba(245, 158, 11, 0.4)';
                } else {
                    rollStatusPill.textContent = 'NO ROLL NO DETECTED';
                    rollStatusPill.style.background = 'rgba(100, 116, 139, 0.2)';
                    rollStatusPill.style.color = '#94A3B8';
                    rollStatusPill.style.borderColor = 'rgba(100, 116, 139, 0.3)';
                }
            }

            // 2. DETECT QUESTIONS & MULTIPLE MARKINGS (ACCURATE CORE-FILL DISCRIMINATION)
            const bubbleRadius = Math.max(7, Math.round(Math.min(W, H) * 0.007));
            const bubbleCoreRadius = Math.max(3, Math.round(bubbleRadius * 0.55));
            let score = 0;
            let correctCount = 0;
            let wrongCount = 0;
            let multipleCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let evaluatedKeyCount = 0;
            let rowsHtml = '';

            function isBubbleGenuinelyFilled(b) {
                // Must have solid ink in inner core (avoiding outer printed border)
                if (b.coreDarkness >= 85) return true;
                if (b.coreDarkness >= 45 && b.darkRatio >= 0.35) return true;
                return false;
            }

            for (let q = 1; q <= totalPaperQuestions; q++) {
                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                // Exact pixel coordinates on the leveled sheet
                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                // Sample local paper baseline
                const paperVal = sampleCircle(colX - 18, rowY, 6);

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;

                    let bestX = bubbleX, bestY = rowY, minVal = 999;
                    for (let dy of [-2, 0, 2]) {
                        for (let dx of [-2, 0, 2]) {
                            const val = sampleCircle(bubbleX + dx, rowY + dy, Math.round(bubbleRadius * 0.5));
                            if (val < minVal) {
                                minVal = val;
                                bestX = bubbleX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    // Inner core brightness
                    const coreMean = sampleCircle(bestX, bestY, bubbleCoreRadius);
                    const coreDarkness = paperVal - coreMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -bubbleRadius; dy <= bubbleRadius; dy++) {
                        for (let dx = -bubbleRadius; dx <= bubbleRadius; dx++) {
                            if (dx*dx + dy*dy <= bubbleRadius*bubbleRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 30)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    bubbleStats.push({
                        opt: OPTIONS[b],
                        coreDarkness: coreDarkness,
                        coreMean: coreMean,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                const sorted = [...bubbleStats].sort((a, b) => b.coreDarkness - a.coreDarkness);

                // Identify all genuinely filled bubbles
                const filledBubbles = sorted.filter(b => isBubbleGenuinelyFilled(b));

                const isMultiple = filledBubbles.length > 1;
                const detectedAnswer = filledBubbles.map(b => b.opt).join(', ');
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';
                if (correctAns) evaluatedKeyCount++;

                if (isMultiple) {
                    // Multiple bubbles filled: mark as INCORRECT
                    attemptedCount++;
                    wrongCount++;
                    multipleCount++;
                    verdict = 'multiple';
                } else if (filledBubbles.length === 1) {
                    const singleAns = filledBubbles[0].opt;
                    attemptedCount++;
                    if (correctAns && singleAns === correctAns) {
                        score++;
                        correctCount++;
                        verdict = 'correct';
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                    } else {
                        verdict = 'marked';
                    }
                } else {
                    blankCount++;
                }

                // Draw Overlay Rings on the Leveled Cropped Sheet
                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];
                    const isThisBubbleFilled = filledBubbles.some(f => f.opt === opt);

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(3, Math.round(W * 0.002));

                    if (isMultiple && isThisBubbleFilled) {
                        // Highlight ALL multiple markings in prominent RED!
                        ctx.strokeStyle = '#EF4444';
                        ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        ctx.fill();
                        ctx.stroke();

                        // Draw white 'X' over the multiple marked bubble
                        ctx.strokeStyle = '#FFFFFF';
                        ctx.lineWidth = 2;
                        const sz = Math.round(bubbleRadius * 0.5);
                        ctx.beginPath();
                        ctx.moveTo(stat.x - sz, stat.y - sz);
                        ctx.lineTo(stat.x + sz, stat.y + sz);
                        ctx.moveTo(stat.x + sz, stat.y - sz);
                        ctx.lineTo(stat.x - sz, stat.y + sz);
                        ctx.stroke();
                    } else if (!isMultiple && isThisBubbleFilled) {
                        if (correctAns && opt === correctAns) {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.45)';
                        } else if (correctAns) {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.45)';
                        } else {
                            ctx.strokeStyle = '#3B82F6';
                            ctx.fillStyle = 'rgba(59, 130, 246, 0.35)';
                        }
                        ctx.fill();
                        ctx.stroke();
                    } else if (opt === correctAns && !isThisBubbleFilled) {
                        ctx.strokeStyle = '#F59E0B';
                        ctx.fillStyle = 'rgba(245, 158, 11, 0.35)';
                        ctx.fill();
                        ctx.stroke();
                    } else {
                        ctx.strokeStyle = 'rgba(59, 130, 246, 0.2)';
                        ctx.stroke();
                    }
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Unmarked';
                let markedCellHtml = '<span style="color:#9CA3AF;">-</span>';

                if (verdict === 'multiple') {
                    badgeClass = 'badge-multiple';
                    verdictText = '❌ Multiple (Invalid)';
                    markedCellHtml = `<strong style="color: #EF4444; font-size:1rem;">${detectedAnswer}</strong> <span style="font-size:0.75rem; color:#DC2626; font-weight:700;">(Multi)</span>`;
                } else if (verdict === 'correct') {
                    badgeClass = 'badge-correct';
                    verdictText = '✓ Correct';
                    markedCellHtml = `<strong style="color: #10B981; font-size:1rem;">${detectedAnswer}</strong>`;
                } else if (verdict === 'wrong') {
                    badgeClass = 'badge-wrong';
                    verdictText = '✗ Wrong';
                    markedCellHtml = `<strong style="color: #EF4444; font-size:1rem;">${detectedAnswer}</strong>`;
                } else if (verdict === 'marked') {
                    badgeClass = 'badge-correct';
                    verdictText = 'Marked';
                    markedCellHtml = `<strong style="font-size:1rem;">${detectedAnswer}</strong>`;
                }

                rowsHtml += `<tr>
                    <td><strong>${q}</strong></td>
                    <td>${markedCellHtml}</td>
                    <td>${correctAns ? '<strong style="color:var(--primary);">' + correctAns + '</strong>' : '<span style="color:#9CA3AF;">-</span>'}</td>
                    <td><span class="badge ${badgeClass}">${verdictText}</span></td>
                </tr>`;
            }

            // Safe UI Scoreboard Updates
            const safeSetText = (id, text) => {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            const totalGraded = evaluatedKeyCount > 0 ? evaluatedKeyCount : totalPaperQuestions;
            safeSetText('scoreValue', `${score} / ${totalGraded}`);
            const pct = totalGraded > 0 ? Math.round((score / totalGraded) * 100) : 0;
            safeSetText('scorePercentage', `${pct}% Accuracy`);

            safeSetText('statCorrect', correctCount);
            safeSetText('statWrong', wrongCount);
            safeSetText('statMultiple', multipleCount);
            safeSetText('statAttempted', attemptedCount);
            safeSetText('statBlank', blankCount);

            const tbl = document.getElementById('tableBody');
            if (tbl) tbl.innerHTML = rowsHtml;
        }

        if (img.complete) {
            initEvaluator();
        } else {
            img.onload = initEvaluator;
        }
    </script>
</body>
</html>