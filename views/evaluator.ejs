<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Leveled Evaluation - <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        .eval-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .eval-header-split {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .eval-layout {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .eval-layout { grid-template-columns: 1fr; }
        }
        .canvas-card {
            background: #090D16;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.5);
            border: 1px solid #1E293B;
            position: relative;
        }
        .canvas-toolbar {
            background: #111827;
            border-bottom: 1px solid #1E293B;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            color: white;
            font-size: 0.88rem;
        }
        .canvas-toolbar-btn {
            background: #1E293B;
            color: #FFFFFF;
            border: 1px solid #334155;
            border-radius: var(--radius-sm);
            padding: 6px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .canvas-toolbar-btn:hover {
            background: #334155;
            border-color: #06B6D4;
        }
        .canvas-wrapper {
            position: relative;
            background: #090D16;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #canvasOutput {
            width: 100%;
            height: auto;
            display: block;
            border-radius: var(--radius-sm);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            background: #FFFFFF;
        }
        .level-badge {
            background: rgba(16, 185, 129, 0.9);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
        }
        .score-hero {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            text-align: center;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-glow);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .stat-box {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.85rem;
            text-align: center;
        }
        .stat-box .num { font-size: 1.5rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
        .stat-box .lbl { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-top: 2px; }
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        .breakdown-table th, .breakdown-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }
        .breakdown-table th { background: #F8FAFC; font-weight: 700; color: var(--text-muted); }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-correct { background: var(--success-light); color: #065F46; }
        .badge-wrong { background: var(--danger-light); color: #991B1B; }
        .badge-blank { background: #F1F5F9; color: #64748B; }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            background: #DEF7EC;
            color: #03543F;
        }
    </style>
</head>
<body>
    <div class="container eval-container">
        <!-- Header -->
        <div class="eval-header-split">
            <div>
                <h1 style="font-size: 1.5rem; margin: 0 0 4px 0;">AI Leveled Evaluation</h1>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                    <%= paper.title %> &bull; <%= paper.numQuestions %> Questions
                </p>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <span id="evalStatus" class="status-pill">Analyzing & Leveling...</span>
                <a href="/paper/<%= paper._id %>" class="btn btn-secondary btn-sm">&larr; Back to Paper</a>
            </div>
        </div>

        <div class="eval-layout">
            <!-- Left: Leveled & Cropped Sheet -->
            <div>
                <div class="canvas-card">
                    <div class="canvas-toolbar">
                        <span class="level-badge">âœ“ Auto-Leveled & Cropped (A4)</span>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="canvas-toolbar-btn" id="toggleViewBtn" onclick="toggleRawView()">ðŸ–¼ View Raw Upload</button>
                        </div>
                    </div>
                    <div class="canvas-wrapper">
                        <canvas id="canvasOutput"></canvas>
                    </div>
                </div>
            </div>

            <!-- Right: Scorecard & Breakdown -->
            <div>
                <div class="score-hero">
                    <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Score Achieved</div>
                    <div class="score-val" id="scoreValue" style="font-size: 3.25rem; font-weight: 800; margin: 0.25rem 0; font-family: 'Plus Jakarta Sans', sans-serif;">0 / 0</div>
                    <div id="scorePercentage" style="font-size: 1.15rem; font-weight: 600;">0% Accuracy</div>
                </div>

                <div class="card" style="padding: 1.25rem;">
                    <div class="stat-grid">
                        <div class="stat-box">
                            <div class="num" id="statCorrect" style="color: #10B981;">0</div>
                            <div class="lbl">Correct</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                            <div class="lbl">Wrong</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                            <div class="lbl">Attempted</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                            <div class="lbl">Unmarked</div>
                        </div>
                    </div>

                    <h4 style="margin: 1.25rem 0 0.5rem 0; font-size: 0.95rem;">Question Breakdown</h4>
                    <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                        <table class="breakdown-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Marked</th>
                                    <th>Key</th>
                                    <th>Verdict</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden source image -->
    <img id="uploadedImage" src="<%= imagePath %>" style="position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;" alt="Sheet">

    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;
        const img = document.getElementById('uploadedImage');
        const canvas = document.getElementById('canvasOutput');
        const ctx = canvas.getContext('2d');
        const evalStatus = document.getElementById('evalStatus');
        const toggleViewBtn = document.getElementById('toggleViewBtn');

        let rawCanvas = document.createElement('canvas');
        let rawCtx = rawCanvas.getContext('2d');
        let leveledCanvas = document.createElement('canvas');
        let leveledCtx = leveledCanvas.getContext('2d');
        let showingRaw = false;

        const TARGET_W = 1000;
        const TARGET_H = 1414; // A4 1:1.414

        const U_START = 141.0 / 2235.0;
        const V_START = 835.5 / 3261.0;
        const U_BUBBLE_STEP = 62.5 / 2235.0;
        const V_ROW_STEP = 59.4615 / 3261.0;
        const U_COL_STEP = 447.5 / 2235.0;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        function initEvaluator() {
            if (!img.complete || img.naturalWidth === 0) {
                setTimeout(initEvaluator, 100);
                return;
            }

            const W = img.naturalWidth;
            const H = img.naturalHeight;
            rawCanvas.width = W;
            rawCanvas.height = H;
            rawCtx.drawImage(img, 0, 0);

            // Auto-detect 4 corner square markers
            const corners = autoDetectCorners(rawCtx, W, H);

            // Warp & level into the flat upright A4 canvas
            warpAndEvaluate(corners, W, H);
        }

        function toggleRawView() {
            showingRaw = !showingRaw;
            if (showingRaw) {
                canvas.width = rawCanvas.width;
                canvas.height = rawCanvas.height;
                ctx.drawImage(rawCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ“ View Leveled & Cropped';
            } else {
                canvas.width = leveledCanvas.width;
                canvas.height = leveledCanvas.height;
                ctx.drawImage(leveledCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ–¼ View Raw Upload';
            }
        }

        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]]; [B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        function autoDetectCorners(ctx, W, H) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function findSquareMarker(x1, y1, x2, y2) {
                const pw = Math.round(x2 - x1);
                const ph = Math.round(y2 - y1);
                const gray = new Uint8Array(pw * ph);
                const hist = new Int32Array(256);
                let idx = 0;

                for (let y = y1; y < y2; y++) {
                    for (let x = x1; x < x2; x++) {
                        const pIdx = (y * W + x) * 4;
                        const g = (data[pIdx] * 77 + data[pIdx+1] * 150 + data[pIdx+2] * 29) >> 8;
                        gray[idx++] = g;
                        hist[g]++;
                    }
                }

                const total = pw * ph;
                let sum = 0;
                for (let i = 0; i < 256; i++) sum += i * hist[i];
                let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
                for (let i = 0; i < 256; i++) {
                    wB += hist[i];
                    if (wB === 0) continue;
                    const wF = total - wB;
                    if (wF === 0) break;
                    sumB += i * hist[i];
                    const v = wB * wF * (sumB/wB - (sum - sumB)/wF) * (sumB/wB - (sum - sumB)/wF);
                    if (v > maxVar) { maxVar = v; thresh = i; }
                }

                const visited = new Uint8Array(pw * ph);
                let best = null;
                let bestScore = -1;
                const minSide = Math.min(W, H);
                const minArea = (minSide * 0.007) * (minSide * 0.007);
                const maxArea = (minSide * 0.08) * (minSide * 0.08);

                for (let py = 1; py < ph - 1; py += 2) {
                    for (let px = 1; px < pw - 1; px += 2) {
                        const p = py * pw + px;
                        if (visited[p] || gray[p] >= thresh) continue;

                        let count = 0, sumX = 0, sumY = 0;
                        let minX = px, maxX = px, minY = py, maxY = py;
                        const queue = [p];
                        visited[p] = 1;
                        let qHead = 0;

                        while (qHead < queue.length) {
                            const cur = queue[qHead++];
                            const cy = Math.floor(cur / pw);
                            const cx = cur % pw;
                            count++;
                            sumX += cx;
                            sumY += cy;
                            if (cx < minX) minX = cx;
                            if (cx > maxX) maxX = cx;
                            if (cy < minY) minY = cy;
                            if (cy > maxY) maxY = cy;

                            for (let nb of [cur - 1, cur + 1, cur - pw, cur + pw]) {
                                if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                    visited[nb] = 1;
                                    queue.push(nb);
                                }
                            }
                        }

                        const bw = maxX - minX + 1;
                        const bh = maxY - minY + 1;
                        const aspect = bw / bh;
                        const density = count / (bw * bh);

                        if (aspect > 0.65 && aspect < 1.45 && density > 0.60 && count >= minArea && count <= maxArea) {
                            const score = density * count;
                            if (score > bestScore) {
                                bestScore = score;
                                best = { x: Math.round(x1 + sumX / count), y: Math.round(y1 + sumY / count) };
                            }
                        }
                    }
                }
                return best;
            }

            const boxW = Math.round(W * 0.22);
            const boxH = Math.round(H * 0.22);

            const tl = findSquareMarker(0, 0, boxW, boxH) || { x: Math.round(W * 0.056), y: Math.round(H * 0.038) };
            const tr = findSquareMarker(W - boxW, 0, W, boxH) || { x: Math.round(W * 0.944), y: Math.round(H * 0.038) };
            const br = findSquareMarker(W - boxW, H - boxH, W, H) || { x: Math.round(W * 0.944), y: Math.round(H * 0.962) };
            const bl = findSquareMarker(0, H - boxH, boxW, H) || { x: Math.round(W * 0.056), y: Math.round(H * 0.962) };

            return [tl, tr, br, bl];
        }

        function warpAndEvaluate(corners, W, H) {
            leveledCanvas.width = TARGET_W;
            leveledCanvas.height = TARGET_H;

            const m_L = TARGET_W * 0.056;
            const m_R = TARGET_W * 0.944;
            const m_T = TARGET_H * 0.038;
            const m_B = TARGET_H * 0.962;

            const dstRectCorners = [
                { x: m_L, y: m_T },
                { x: m_R, y: m_T },
                { x: m_R, y: m_B },
                { x: m_L, y: m_B }
            ];

            const H_mat = getPerspectiveTransform(dstRectCorners, corners);
            const srcImgData = rawCtx.getImageData(0, 0, W, H);
            const src32 = new Uint32Array(srcImgData.data.buffer);

            const dstImgData = leveledCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF;
                    }
                    dstIdx++;
                }
            }

            leveledCtx.putImageData(dstImgData, 0, 0);

            // Grade bubbles on the leveled cropped sheet
            evaluateLeveledSheet(leveledCtx, TARGET_W, TARGET_H, m_L, m_T, m_R - m_L, m_B - m_T);

            // Draw leveled sheet to main canvas
            canvas.width = TARGET_W;
            canvas.height = TARGET_H;
            ctx.drawImage(leveledCanvas, 0, 0);

            evalStatus.textContent = 'âœ“ Leveled & Graded (100% Locked)';
            evalStatus.style.background = '#DEF7EC';
            evalStatus.style.color = '#03543F';
        }

        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (y * W + x) * 4;
                return (data[idx] * 77 + data[idx+1] * 150 + data[idx+2] * 29) >> 8;
            }

            function sampleCircle(cx, cy, r) {
                let sum = 0, count = 0;
                for (let dy = -r; dy <= r; dy++) {
                    for (let dx = -r; dx <= r; dx++) {
                        if (dx*dx + dy*dy <= r*r) {
                            sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            const bubbleRadius = Math.max(7, Math.round(Math.min(W, H) * 0.007));
            let score = 0;
            let correctCount = 0;
            let wrongCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let evaluatedKeyCount = 0;
            let rowsHtml = '';

            for (let q = 1; q <= totalPaperQuestions; q++) {
                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                const paperVal = sampleCircle(colX - 18, rowY, 6);

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;

                    let bestX = bubbleX, bestY = rowY, minVal = 999;
                    for (let dy of [-4, 0, 4]) {
                        for (let dx of [-4, 0, 4]) {
                            const val = sampleCircle(bubbleX + dx, rowY + dy, Math.round(bubbleRadius * 0.6));
                            if (val < minVal) {
                                minVal = val;
                                bestX = bubbleX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    const bubbleMean = sampleCircle(bestX, bestY, bubbleRadius);
                    const darkness = paperVal - bubbleMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -bubbleRadius; dy <= bubbleRadius; dy++) {
                        for (let dx = -bubbleRadius; dx <= bubbleRadius; dx++) {
                            if (dx*dx + dy*dy <= bubbleRadius*bubbleRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 25)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    bubbleStats.push({
                        opt: OPTIONS[b],
                        darkness: darkness,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                const sorted = [...bubbleStats].sort((a, b) => b.darkness - a.darkness);
                const top1 = sorted[0];
                const top2 = sorted[1];

                let isFilled = false;
                if (top1.darkness >= 16) {
                    if (top1.darkness - top2.darkness >= 9 || top1.darkRatio > 0.32 || top1.darkness > top2.darkness * 1.35) {
                        isFilled = true;
                    }
                }

                const detectedAnswer = isFilled ? top1.opt : '';
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';
                if (correctAns) evaluatedKeyCount++;

                if (detectedAnswer) {
                    attemptedCount++;
                    if (correctAns && detectedAnswer === correctAns) {
                        score++;
                        correctCount++;
                        verdict = 'correct';
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                    }
                } else {
                    blankCount++;
                }

                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(3, Math.round(W * 0.002));

                    if (opt === detectedAnswer) {
                        if (correctAns && detectedAnswer === correctAns) {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.45)';
                        } else if (correctAns) {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.45)';
                        } else {
                            ctx.strokeStyle = '#3B82F6';
                            ctx.fillStyle = 'rgba(59, 130, 246, 0.35)';
                        }
                        ctx.fill();
                    } else if (opt === correctAns && detectedAnswer !== correctAns) {
                        ctx.strokeStyle = '#F59E0B';
                        ctx.fillStyle = 'rgba(245, 158, 11, 0.35)';
                        ctx.fill();
                    } else {
                        ctx.strokeStyle = 'rgba(59, 130, 246, 0.2)';
                    }
                    ctx.stroke();
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Unmarked';
                if (verdict === 'correct') { badgeClass = 'badge-correct'; verdictText = 'âœ“ Correct'; }
                else if (verdict === 'wrong') { badgeClass = 'badge-wrong'; verdictText = 'âœ— Wrong'; }
                else if (detectedAnswer) { badgeClass = 'badge-correct'; verdictText = 'Marked'; }

                rowsHtml += `<tr>
                    <td><strong>${q}</strong></td>
                    <td>${detectedAnswer ? '<span style="font-weight:700; font-size:1rem;">' + detectedAnswer + '</span>' : '<span style="color:#9CA3AF;">-</span>'}</td>
                    <td>${correctAns ? '<strong style="color:var(--primary);">' + correctAns + '</strong>' : '<span style="color:#9CA3AF;">-</span>'}</td>
                    <td><span class="badge ${badgeClass}">${verdictText}</span></td>
                </tr>`;
            }

            const totalGraded = evaluatedKeyCount > 0 ? evaluatedKeyCount : totalPaperQuestions;
            document.getElementById('scoreValue').textContent = `${score} / ${totalGraded}`;
            const pct = totalGraded > 0 ? Math.round((score / totalGraded) * 100) : 0;
            document.getElementById('scorePercentage').textContent = `${pct}% Accuracy`;

            document.getElementById('statCorrect').textContent = correctCount;
            document.getElementById('statWrong').textContent = wrongCount;
            document.getElementById('statAttempted').textContent = attemptedCount;
            document.getElementById('statBlank').textContent = blankCount;
            document.getElementById('tableBody').innerHTML = rowsHtml;
        }

        if (img.complete) {
            initEvaluator();
        } else {
            img.onload = initEvaluator;
        }
    </script>
</body>
</html>