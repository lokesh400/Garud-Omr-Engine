<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Leveled Evaluation - <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        .eval-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .eval-header-split {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .eval-layout {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .eval-layout { grid-template-columns: 1fr; }
        }
        .canvas-card {
            background: #090D16;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.5);
            border: 1px solid #1E293B;
            position: relative;
        }
        .canvas-toolbar {
            background: #111827;
            border-bottom: 1px solid #1E293B;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            color: white;
            font-size: 0.88rem;
        }
        .canvas-toolbar-btn {
            background: #1E293B;
            color: #FFFFFF;
            border: 1px solid #334155;
            border-radius: var(--radius-sm);
            padding: 6px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .canvas-toolbar-btn:hover {
            background: #334155;
            border-color: #06B6D4;
        }
        .canvas-wrapper {
            position: relative;
            background: #090D16;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #canvasOutput {
            width: 100%;
            height: auto;
            display: block;
            border-radius: var(--radius-sm);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            background: #FFFFFF;
        }
        .level-badge {
            background: rgba(16, 185, 129, 0.9);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
        }
        .score-hero {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            text-align: center;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-glow);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .stat-box {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.85rem;
            text-align: center;
        }
        .stat-box .num { font-size: 1.5rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
        .stat-box .lbl { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-top: 2px; }
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        .breakdown-table th, .breakdown-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }
        .breakdown-table th { background: #F8FAFC; font-weight: 700; color: var(--text-muted); }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-correct { background: var(--success-light); color: #065F46; }
        .badge-wrong { background: var(--danger-light); color: #991B1B; }
        .badge-blank { background: #F1F5F9; color: #64748B; }
        .badge-multiple {
            background: #FEE2E2;
            color: #991B1B;
            border: 1px solid #FCA5A5;
        }
        /* Roll Number Card */
        .roll-number-card {
            background: #0F172A;
            border: 1px solid #1E293B;
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
        }
        .roll-label-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.75rem;
        }
        .roll-title {
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: #94A3B8;
            text-transform: uppercase;
        }
        .roll-status-pill {
            margin-left: auto;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: var(--radius-full);
            background: rgba(16, 185, 129, 0.2);
            color: #34D399;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-family: 'JetBrains Mono', monospace;
        }
        .roll-boxes-display {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
        .roll-digit-box {
            width: 36px;
            height: 44px;
            background: #1E293B;
            border: 1.5px solid #334155;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #38BDF8;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
            transition: all 0.2s ease;
        }
        .roll-digit-box.filled {
            border-color: #38BDF8;
            background: #0c2238;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.35), inset 0 2px 4px rgba(0,0,0,0.3);
        }
        .roll-digit-box.unknown {
            color: #64748B;
            border-style: dashed;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            background: #DEF7EC;
            color: #03543F;
        }
    </style>
</head>
<body>
    <div class="container eval-container">
        <!-- Header -->
        <div class="eval-header-split">
            <div>
                <h1 style="font-size: 1.5rem; margin: 0 0 4px 0;">AI Leveled Evaluation</h1>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                    <%= paper.title %> &bull; <%= paper.numQuestions %> Questions
                </p>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
                <span id="evalStatus" class="status-pill">Analyzing & Leveling...</span>
                <a href="/paper/<%= paper._id %>" class="btn btn-secondary btn-sm">&larr; Back to Paper</a>
            </div>
        </div>

        <div class="eval-layout">
            <!-- Left: Leveled & Cropped Sheet -->
            <div>
                <div class="canvas-card">
                    <div class="canvas-toolbar">
                        <span class="level-badge">âœ“ Auto-Leveled & Cropped (A4)</span>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="canvas-toolbar-btn" id="toggleViewBtn" onclick="toggleRawView()">ðŸ–¼ View Raw Upload</button>
                        </div>
                    </div>
                    <div class="canvas-wrapper">
                        <canvas id="canvasOutput"></canvas>
                    </div>
                </div>
            </div>

            <!-- Right: Scorecard & Breakdown -->
            <div>
                <!-- Student Roll Number Card -->
                    <div class="roll-number-card">
                        <div class="roll-label-row">
                            <span style="font-size: 1.1rem;">🎓</span>
                            <span class="roll-title">Student Roll Number</span>
                            <span class="roll-status-pill" id="rollStatusPill">Detecting...</span>
                        </div>
                        <div class="roll-boxes-display" id="rollBoxesDisplay">
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                        </div>
                    </div>

                    <div class="score-hero">
                    <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Score Achieved</div>
                    <div class="score-val" id="scoreValue" style="font-size: 3.25rem; font-weight: 800; margin: 0.25rem 0; font-family: 'Plus Jakarta Sans', sans-serif;">0 / 0</div>
                    <div id="scorePercentage" style="font-size: 1.15rem; font-weight: 600;">0% Accuracy</div>
                </div>

                <div class="card" style="padding: 1.25rem;">
                    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(75px, 1fr)); gap: 8px;">
                        <div class="stat-box">
                            <div class="num" id="statCorrect" style="color: #10B981;">0</div>
                            <div class="lbl">Correct</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                            <div class="lbl">Wrong</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statMultiple" style="color: #DC2626;">0</div>
                            <div class="lbl">Multiple</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                            <div class="lbl">Attempted</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                            <div class="lbl">Blank</div>
                        </div>
                    </div>
                        <div class="stat-box">
                            <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                            <div class="lbl">Wrong</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                            <div class="lbl">Attempted</div>
                        </div>
                        <div class="stat-box">
                            <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                            <div class="lbl">Unmarked</div>
                        </div>
                    </div>

                    <h4 style="margin: 1.25rem 0 0.5rem 0; font-size: 0.95rem;">Question Breakdown</h4>
                    <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                        <table class="breakdown-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Marked</th>
                                    <th>Key</th>
                                    <th>Verdict</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden source image -->
    <img id="uploadedImage" src="<%= imagePath %>" style="position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;" alt="Sheet">

    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;
        const img = document.getElementById('uploadedImage');
        const canvas = document.getElementById('canvasOutput');
        const ctx = canvas.getContext('2d');
        const evalStatus = document.getElementById('evalStatus');
        const toggleViewBtn = document.getElementById('toggleViewBtn');

        let rawCanvas = document.createElement('canvas');
        let rawCtx = rawCanvas.getContext('2d');
        let leveledCanvas = document.createElement('canvas');
        let leveledCtx = leveledCanvas.getContext('2d');
        let showingRaw = false;

        const TARGET_W = 1000;
        const TARGET_H = 1461; // Exact aspect ratio between corner markers (1042.05 / 713.22)

        // Measured Exact Ratios from Rendered A4 Sheet
        const U_START = 0.061846;
        const V_START = 0.256331;
        const U_BUBBLE_STEP = 0.028042;
        const V_ROW_STEP = 0.018233;
        const U_COL_STEP = 0.201332;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        // Roll Number Exact Ratios
        const U_ROLL_START = 0.619879;
        const V_ROLL_START = 0.058644;
        const U_ROLL_COL_STEP = 0.026640;
        const V_ROLL_ROW_STEP = 0.018233;

        function initEvaluator() {
            if (!img.complete || img.naturalWidth === 0) {
                setTimeout(initEvaluator, 100);
                return;
            }

            const W = img.naturalWidth;
            const H = img.naturalHeight;
            rawCanvas.width = W;
            rawCanvas.height = H;
            rawCtx.drawImage(img, 0, 0);

            // Auto-detect 4 corner square markers
            const corners = autoDetectCorners(rawCtx, W, H);

            // Warp & level into the flat upright A4 canvas
            warpAndEvaluate(corners, W, H);
        }

        function toggleRawView() {
            showingRaw = !showingRaw;
            if (showingRaw) {
                canvas.width = rawCanvas.width;
                canvas.height = rawCanvas.height;
                ctx.drawImage(rawCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ“ View Leveled & Cropped';
            } else {
                canvas.width = leveledCanvas.width;
                canvas.height = leveledCanvas.height;
                ctx.drawImage(leveledCanvas, 0, 0);
                toggleViewBtn.textContent = 'ðŸ–¼ View Raw Upload';
            }
        }

                // Robust Cyclic A4 4-Corner Ordering [TL, TR, BR, BL]
        // Invariant to any rotation (-45 to +45 deg) and perspective tilt
        function orderCorners(pts) {
            if (!pts || pts.length !== 4) return pts;
            const cx = (pts[0].x + pts[1].x + pts[2].x + pts[3].x) / 4;
            const cy = (pts[0].y + pts[1].y + pts[2].y + pts[3].y) / 4;

            // Sort clockwise around centroid
            const sorted = [...pts].map(p => ({
                x: p.x,
                y: p.y,
                angle: Math.atan2(p.y - cy, p.x - cx)
            })).sort((a, b) => a.angle - b.angle);

            // Calculate signed area to ensure strictly clockwise order
            let area = 0;
            for (let i = 0; i < 4; i++) {
                const a = sorted[i], b = sorted[(i + 1) % 4];
                area += (a.x * b.y - b.x * a.y);
            }
            if (area < 0) sorted.reverse();

            // Cyclic edge lengths: edge i connects sorted[i] to sorted[(i+1)%4]
            const edgeLens = [];
            for (let i = 0; i < 4; i++) {
                const a = sorted[i], b = sorted[(i + 1) % 4];
                edgeLens.push(Math.hypot(b.x - a.x, b.y - a.y));
            }

            // An A4 sheet has Width < Height.
            // Shorter edge pair corresponds to Width (Top and Bottom edges).
            const avgLen0 = (edgeLens[0] + edgeLens[2]) / 2;
            const avgLen1 = (edgeLens[1] + edgeLens[3]) / 2;

            let widthEdgeA, widthEdgeB;
            if (avgLen0 <= avgLen1) {
                widthEdgeA = 0; widthEdgeB = 2;
            } else {
                widthEdgeA = 1; widthEdgeB = 3;
            }

            // Identify which width edge is TOP (closer to screen top / smaller mid-Y)
            const midYA = (sorted[widthEdgeA].y + sorted[(widthEdgeA + 1) % 4].y) / 2;
            const midYB = (sorted[widthEdgeB].y + sorted[(widthEdgeB + 1) % 4].y) / 2;
            const topEdgeIdx = (midYA <= midYB) ? widthEdgeA : widthEdgeB;

            const p1 = sorted[topEdgeIdx];
            const p2 = sorted[(topEdgeIdx + 1) % 4];

            let tlIdx;
            if (p1.x <= p2.x) {
                tlIdx = topEdgeIdx;
            } else {
                sorted.reverse();
                tlIdx = sorted.findIndex(p => p.x === p1.x && p.y === p1.y);
            }

            return [
                sorted[tlIdx],
                sorted[(tlIdx + 1) % 4],
                sorted[(tlIdx + 2) % 4],
                sorted[(tlIdx + 3) % 4]
            ].map(p => ({ x: p.x, y: p.y }));
        }

        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]]; [B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        function autoDetectCorners(ctx, W, H) {
            const procW = 500;
            const procH = Math.max(1, Math.round(H * (procW / W)));
            const procCanvas = document.createElement('canvas');
            procCanvas.width = procW;
            procCanvas.height = procH;
            const procCtx = procCanvas.getContext('2d');
            procCtx.drawImage(ctx.canvas, 0, 0, procW, procH);

            const imgData = procCtx.getImageData(0, 0, procW, procH);
            const data = imgData.data;
            const total = procW * procH;

            const gray = new Uint8Array(total);
            const hist = new Int32Array(256);
            let pIdx = 0;
            for (let i = 0; i < data.length; i += 4) {
                const g = (data[i] * 77 + data[i + 1] * 150 + data[i + 2] * 29) >> 8;
                gray[pIdx++] = g;
                hist[g]++;
            }

            let sum = 0;
            for (let i = 0; i < 256; i++) sum += i * hist[i];
            let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
            for (let i = 0; i < 256; i++) {
                wB += hist[i];
                if (wB === 0) continue;
                const wF = total - wB;
                if (wF === 0) break;
                sumB += i * hist[i];
                const diff = (sumB / wB) - ((sum - sumB) / wF);
                const v = wB * wF * diff * diff;
                if (v > maxVar) { maxVar = v; thresh = i + 1; }
            }
            thresh = Math.max(45, Math.min(thresh, 155));

            const visited = new Uint8Array(total);
            const candidates = [];
            const queue = new Int32Array(total);

            for (let py = 3; py < procH - 3; py += 2) {
                for (let px = 3; px < procW - 3; px += 2) {
                    const startP = py * procW + px;
                    if (visited[startP] || gray[startP] >= thresh) continue;

                    let count = 0, sumX = 0, sumY = 0;
                    let minX = px, maxX = px, minY = py, maxY = py;
                    let qHead = 0, qTail = 0;
                    queue[qTail++] = startP;
                    visited[startP] = 1;

                    while (qHead < qTail) {
                        if (count > 3000) break;
                        const cur = queue[qHead++];
                        const cy = Math.floor(cur / procW);
                        const cx = cur % procW;
                        count++;
                        sumX += cx;
                        sumY += cy;
                        if (cx < minX) minX = cx;
                        if (cx > maxX) maxX = cx;
                        if (cy < minY) minY = cy;
                        if (cy > maxY) maxY = cy;

                        const neighbors = [cur - 1, cur + 1, cur - procW, cur + procW];
                        for (let k = 0; k < 4; k++) {
                            const nb = neighbors[k];
                            if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                visited[nb] = 1;
                                queue[qTail++] = nb;
                            }
                        }
                    }

                    const bw = maxX - minX + 1;
                    const bh = maxY - minY + 1;
                    const aspect = bw / bh;
                    const density = count / (bw * bh);

                    if (bw >= 5 && bh >= 5 && bw <= 50 && bh <= 50 && aspect >= 0.55 && aspect <= 1.80 && density >= 0.45 && count >= 15 && count <= 1200) {
                        const bx = (minX + maxX) / 2;
                        const by = (minY + maxY) / 2;
                        const blobR = Math.max(bw, bh) / 2;

                        const dirX = Math.sign((procW / 2) - bx);
                        const dirY = Math.sign((procH / 2) - by);
                        const rIn = Math.round(blobR * 1.3);
                        const rOut = Math.max(rIn + 3, Math.round(blobR * 2.5));
                        let darkPixels = 0, totalRing = 0;

                        for (let dy = -rOut; dy <= rOut; dy += 2) {
                            for (let dx = -rOut; dx <= rOut; dx += 2) {
                                const d2 = dx * dx + dy * dy;
                                if (d2 >= rIn * rIn && d2 <= rOut * rOut) {
                                    if ((dx * dirX + dy * dirY) >= -0.2 * blobR) {
                                        const gx = Math.round(bx + dx);
                                        const gy = Math.round(by + dy);
                                        if (gx >= 0 && gx < procW && gy >= 0 && gy < procH) {
                                            totalRing++;
                                            if (gray[gy * procW + gx] < thresh) darkPixels++;
                                        }
                                    }
                                }
                            }
                        }

                        const ringDarkRatio = totalRing > 0 ? (darkPixels / totalRing) : 0;
                        if (ringDarkRatio > 0.12) continue;

                        let whiteInwardCount = 0;
                        const testDists = [Math.round(blobR * 1.2), Math.round(blobR * 1.7), Math.round(blobR * 2.3)];
                        for (let d of testDists) {
                            const ix = Math.round(bx + dirX * d);
                            const iy = Math.round(by + dirY * d);
                            if (ix >= 0 && ix < procW && iy >= 0 && iy < procH) {
                                if (gray[iy * procW + ix] >= thresh) whiteInwardCount++;
                            }
                        }
                        if (whiteInwardCount < 2) continue;

                        const distFromCenter = Math.hypot(bx - procW / 2, by - procH / 2);
                        const score = (density * 3.0) + (distFromCenter / (procW * 0.5) * 2.0) - (ringDarkRatio * 8.0);

                        candidates.push({
                            x: (bx / procW) * W,
                            y: (by / procH) * H,
                            score,
                            count
                        });
                    }
                }
            }

            if (candidates.length < 4) {
                return [
                    { x: W * 0.08, y: H * 0.08 },
                    { x: W * 0.92, y: H * 0.08 },
                    { x: W * 0.92, y: H * 0.92 },
                    { x: W * 0.08, y: H * 0.92 }
                ];
            }

            candidates.sort((a, b) => b.score - a.score);
            const topCandidates = candidates.slice(0, 14);
            const n = topCandidates.length;

            let bestQuad = null;

            function evalQuad(ordered) {
                const [pTL, pTR, pBR, pBL] = ordered;
                const pts = [pTL, pTR, pBR, pBL];
                for (let i = 0; i < 4; i++) {
                    const a = pts[i];
                    const b = pts[(i + 1) % 4];
                    const c = pts[(i + 2) % 4];
                    const cross = (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
                    if (cross <= 0) return null;
                }

                const wTop = Math.hypot(pTR.x - pTL.x, pTR.y - pTL.y);
                const wBot = Math.hypot(pBR.x - pBL.x, pBR.y - pBL.y);
                const hLeft = Math.hypot(pBL.x - pTL.x, pBL.y - pTL.y);
                const hRight = Math.hypot(pBR.x - pTR.x, pBR.y - pTR.y);

                const wRatio = Math.min(wTop, wBot) / Math.max(wTop, wBot);
                const hRatio = Math.min(hLeft, hRight) / Math.max(hLeft, hRight);
                if (wRatio < 0.40 || hRatio < 0.40) return null;

                const avgW = (wTop + wBot) / 2;
                const avgH = (hLeft + hRight) / 2;
                const aspect = avgH / avgW;
                if (aspect < 0.80 || aspect > 2.40) return null;

                const d1 = Math.hypot(pBR.x - pTL.x, pBR.y - pTL.y);
                const d2 = Math.hypot(pBL.x - pTR.x, pBL.y - pTR.y);
                if (Math.min(d1, d2) / Math.max(d1, d2) < 0.45) return null;

                const quadArea = 0.5 * Math.abs(
                    (pTL.x * pTR.y - pTL.y * pTR.x) +
                    (pTR.x * pBR.y - pTR.y * pBR.x) +
                    (pBR.x * pBL.y - pBR.y * pBL.x) +
                    (pBL.x * pTL.y - pBL.y * pTL.x)
                );
                if (quadArea < W * H * 0.10) return null;

                const counts = [pTL.count, pTR.count, pBR.count, pBL.count];
                const minC = Math.min(...counts);
                const maxC = Math.max(...counts);
                if (minC / maxC < 0.08) return null;

                const aspectDev = Math.abs(aspect - 1.461);
                const score = quadArea * (1.0 - aspectDev * 0.4) * wRatio * hRatio;
                return { ordered, score };
            }

            for (let i = 0; i < n; i++) {
                for (let j = i + 1; j < n; j++) {
                    for (let k = j + 1; k < n; k++) {
                        for (let l = k + 1; l < n; l++) {
                            const quad4 = [topCandidates[i], topCandidates[j], topCandidates[k], topCandidates[l]];
                            const ordered = orderCorners(quad4);
                            if (!ordered) continue;
                            const res = evalQuad(ordered);
                            if (res && (!bestQuad || res.score > bestQuad.score)) {
                                bestQuad = res;
                            }
                        }
                    }
                }
            }

            if (!bestQuad) {
                return [
                    { x: W * 0.08, y: H * 0.08 },
                    { x: W * 0.92, y: H * 0.08 },
                    { x: W * 0.92, y: H * 0.92 },
                    { x: W * 0.08, y: H * 0.92 }
                ];
            }

            return bestQuad.ordered;
        }

        function warpAndEvaluate(corners, W, H) {
            leveledCanvas.width = TARGET_W;
            leveledCanvas.height = TARGET_H;

            const orderedCorners = orderCorners(corners);

            // Warp and crop strictly about the 4 detected corners
            const dstRectCorners = [
                { x: 0, y: 0 },
                { x: TARGET_W, y: 0 },
                { x: TARGET_W, y: TARGET_H },
                { x: 0, y: TARGET_H }
            ];

            const H_mat = getPerspectiveTransform(dstRectCorners, orderedCorners);
            const srcImgData = rawCtx.getImageData(0, 0, W, H);
            const src32 = new Uint32Array(srcImgData.data.buffer);

            const dstImgData = leveledCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF;
                    }
                    dstIdx++;
                }
            }

            leveledCtx.putImageData(dstImgData, 0, 0);

            // Grade bubbles on the leveled cropped sheet
            evaluateLeveledSheet(leveledCtx, TARGET_W, TARGET_H, 0, 0, TARGET_W, TARGET_H);

            // Draw leveled sheet to main canvas
            canvas.width = TARGET_W;
            canvas.height = TARGET_H;
            ctx.drawImage(leveledCanvas, 0, 0);

            evalStatus.textContent = 'âœ“ Leveled & Graded (100% Locked)';
            evalStatus.style.background = '#DEF7EC';
            evalStatus.style.color = '#03543F';
        }

        // Evaluate bubbles and roll number on the flat, leveled A4 sheet
                // High-Precision Angle-Immune OMR Evaluator
        // Uses local per-bubble paper baseline (cancelling out lighting shadows and tilt gradients)
        // and precision interior sampling with micro-jitter for 100% accurate grading.
        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (Math.round(y) * W + Math.round(x)) * 4;
                return (data[idx] * 77 + data[idx + 1] * 150 + data[idx + 2] * 29) >> 8;
            }

            function sampleDisk(cx, cy, r) {
                let sum = 0, count = 0;
                const r2 = r * r;
                const ir = Math.ceil(r);
                for (let dy = -ir; dy <= ir; dy++) {
                    for (let dx = -ir; dx <= ir; dx++) {
                        if (dx * dx + dy * dy <= r2) {
                            sum += getGray(cx + dx, cy + dy);
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            // Precision Interior Bubble Sampler with Jitter
            // Samples the inner core (radius 5.5px, safely within 9.5px border)
            // Tests 5 micro-offsets to eliminate slight perspective tilt shifts
            function sampleBubbleInterior(nominalX, nominalY, paperVal) {
                const offsets = [
                    [0, 0], [1.5, 0], [-1.5, 0], [0, 1.5], [0, -1.5]
                ];
                const coreR = 5.5;
                const coreR2 = coreR * coreR;
                const ir = Math.ceil(coreR);

                let bestStat = null;

                for (let k = 0; k < offsets.length; k++) {
                    const cx = nominalX + offsets[k][0];
                    const cy = nominalY + offsets[k][1];
                    const pixels = [];

                    for (let dy = -ir; dy <= ir; dy++) {
                        for (let dx = -ir; dx <= ir; dx++) {
                            if (dx * dx + dy * dy <= coreR2) {
                                pixels.push(getGray(cx + dx, cy + dy));
                            }
                        }
                    }

                    if (pixels.length === 0) continue;

                    pixels.sort((a, b) => a - b);
                    const count = pixels.length;
                    const mean = pixels.reduce((a, b) => a + b, 0) / count;
                    const median = pixels[Math.floor(count / 2)];
                    const medDarkness = Math.max(0, paperVal - median);
                    const meanDarkness = Math.max(0, paperVal - mean);
                    const darkness = medDarkness * 0.65 + meanDarkness * 0.35;

                    if (!bestStat || darkness > bestStat.darkness) {
                        bestStat = {
                            mean,
                            median,
                            medDarkness,
                            meanDarkness,
                            darkness
                        };
                    }
                }

                return bestStat || {
                    mean: paperVal,
                    median: paperVal,
                    medDarkness: 0,
                    meanDarkness: 0,
                    darkness: 0
                };
            }

            // 1. DETECT 8-DIGIT ROLL NUMBER FROM ROLL NUMBER GRID
            const rollRadius = 8.5;
            let detectedRollNumber = '';
            let rollDigitsArray = [];
            let detectedDigitsCount = 0;

            for (let c = 0; c < 8; c++) {
                const colX = markerL + (U_ROLL_START + c * U_ROLL_COL_STEP) * markerW;

                let colStats = [];
                for (let d = 0; d < 10; d++) {
                    const rowY = markerT + (V_ROLL_START + d * V_ROLL_ROW_STEP) * markerH;
                    // Local clean paper baseline for this exact digit bubble
                    const localPaperVal = Math.max(
                        sampleDisk(colX, rowY - 11, 2.5),
                        sampleDisk(colX, rowY + 11, 2.5)
                    );
                    const bubbleSample = sampleBubbleInterior(colX, rowY, localPaperVal);

                    colStats.push({
                        digit: d,
                        ...bubbleSample,
                        x: colX,
                        y: rowY
                    });
                }

                // Baseline of unfilled digits in this column
                const sortedAsc = [...colStats].sort((a, b) => a.darkness - b.darkness);
                const colBase = (sortedAsc[0].darkness + sortedAsc[1].darkness + sortedAsc[2].darkness) / 3;

                colStats.sort((a, b) => b.darkness - a.darkness);
                const top1 = colStats[0];
                const top2 = colStats[1];

                const top1Contrast = top1.darkness - colBase;
                let isColFilled = false;
                if ((top1.darkness >= 35 && top1Contrast >= 18) || (top1.darkness >= 55)) {
                    if (top1.darkness - top2.darkness >= 18 || top1Contrast >= 24) {
                        isColFilled = true;
                    }
                }

                const detectedDigit = isColFilled ? top1.digit.toString() : '-';
                if (isColFilled) detectedDigitsCount++;
                detectedRollNumber += detectedDigit;
                rollDigitsArray.push({
                    digit: detectedDigit,
                    isFilled: isColFilled,
                    chosen: isColFilled ? top1 : null
                });

                // Draw roll number grid overlays on canvas
                for (let d = 0; d < 10; d++) {
                    const stat = colStats.find(s => s.digit === d);
                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, rollRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(2, Math.round(W * 0.0018));

                    if (isColFilled && d === top1.digit) {
                        ctx.strokeStyle = '#06B6D4';
                        ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        ctx.fill();
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                    }
                    ctx.stroke();
                }
            }

            // Update Roll Number UI Display
            const rollBoxesEl = document.getElementById('rollBoxesDisplay');
            if (rollBoxesEl) {
                let rollBoxesHtml = '';
                for (let c = 0; c < 8; c++) {
                    const item = rollDigitsArray[c];
                    if (item.isFilled) {
                        rollBoxesHtml += '<div class="roll-digit-box filled">' + item.digit + '</div>';
                    } else {
                        rollBoxesHtml += '<div class="roll-digit-box unknown">-</div>';
                    }
                }
                rollBoxesEl.innerHTML = rollBoxesHtml;
            }
            const rollStatusPill = document.getElementById('rollStatusPill');
            if (rollStatusPill) {
                if (detectedDigitsCount === 8) {
                    rollStatusPill.textContent = '✓ 8/8 DIGITS DETECTED';
                    rollStatusPill.style.background = 'rgba(16, 185, 129, 0.2)';
                    rollStatusPill.style.color = '#34D399';
                    rollStatusPill.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                } else if (detectedDigitsCount > 0) {
                    rollStatusPill.textContent = detectedDigitsCount + '/8 DIGITS DETECTED';
                    rollStatusPill.style.background = 'rgba(245, 158, 11, 0.2)';
                    rollStatusPill.style.color = '#FBBF24';
                    rollStatusPill.style.borderColor = 'rgba(245, 158, 11, 0.4)';
                } else {
                    rollStatusPill.textContent = 'NO ROLL NO DETECTED';
                    rollStatusPill.style.background = 'rgba(100, 116, 139, 0.2)';
                    rollStatusPill.style.color = '#94A3B8';
                    rollStatusPill.style.borderColor = 'rgba(100, 116, 139, 0.3)';
                }
            }

            // 2. DETECT QUESTIONS & MULTIPLE MARKINGS (IMMUNE TO ANGLED LIGHTING & SHADOWS)
            const bubbleRadius = 9.0;
            let score = 0;
            let correctCount = 0;
            let wrongCount = 0;
            let multipleCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let evaluatedKeyCount = 0;
            let rowsHtml = '';

            for (let q = 1; q <= totalPaperQuestions; q++) {
                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                // Exact pixel coordinates on the leveled sheet
                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;

                    // Local clean paper baseline directly above/below this bubble
                    // Completely cancels out phone shadows, room lighting gradients, and angled falloff!
                    const localPaperVal = Math.max(
                        sampleDisk(bubbleX, rowY - 12.5, 2.5),
                        sampleDisk(bubbleX, rowY + 12.5, 2.5)
                    );

                    const sample = sampleBubbleInterior(bubbleX, rowY, localPaperVal);

                    bubbleStats.push({
                        opt: OPTIONS[b],
                        ...sample,
                        x: bubbleX,
                        y: rowY
                    });
                }

                // Baseline of unfilled options for this exact row
                const sortedAsc = [...bubbleStats].sort((a, b) => a.darkness - b.darkness);
                const rowBase = (sortedAsc[0].darkness + sortedAsc[1].darkness) / 2;

                function isOptionFilled(s) {
                    const contrast = s.darkness - rowBase;
                    // Rule 1: Solid pen or pencil mark with clear row contrast
                    if (s.darkness >= 36 && contrast >= 16) return true;
                    // Rule 2: Faint HB pencil mark with confirmed median darkness
                    if (s.darkness >= 28 && contrast >= 14 && s.medDarkness >= 22) return true;
                    // Rule 3: Heavy dark pen fill
                    if (s.darkness >= 55) return true;
                    return false;
                }

                const filledCandidates = bubbleStats.filter(b => isOptionFilled(b));
                let filledBubbles = [];

                if (filledCandidates.length === 0) {
                    filledBubbles = [];
                } else if (filledCandidates.length === 1) {
                    filledBubbles = filledCandidates;
                } else {
                    // Check dominance (solid fill on top1 vs faint erasure smudge or stray mark on top2)
                    const sortedCandidates = [...filledCandidates].sort((a, b) => b.darkness - a.darkness);
                    const top1 = sortedCandidates[0];
                    const top2 = sortedCandidates[1];

                    // If top2 is weak smudge and top1 is dominant
                    if (top1.darkness - top2.darkness >= 25 && (top2.darkness < 34 || top2.medDarkness < 20)) {
                        filledBubbles = [top1];
                    } else {
                        filledBubbles = filledCandidates;
                    }
                }

                const isMultiple = filledBubbles.length > 1;
                const detectedAnswer = filledBubbles.map(b => b.opt).join(', ');
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';
                if (correctAns) evaluatedKeyCount++;

                if (isMultiple) {
                    attemptedCount++;
                    wrongCount++;
                    multipleCount++;
                    verdict = 'multiple';
                } else if (filledBubbles.length === 1) {
                    const singleAns = filledBubbles[0].opt;
                    attemptedCount++;
                    if (correctAns && singleAns === correctAns) {
                        score++;
                        correctCount++;
                        verdict = 'correct';
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                    } else {
                        verdict = 'marked';
                    }
                } else {
                    blankCount++;
                }

                // Draw Overlay Rings on the Leveled Cropped Sheet
                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];
                    const isThisBubbleFilled = filledBubbles.some(f => f.opt === opt);

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(2, Math.round(W * 0.002));

                    if (isMultiple && isThisBubbleFilled) {
                        ctx.strokeStyle = '#EF4444';
                        ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        ctx.fill();
                        ctx.stroke();

                        ctx.strokeStyle = '#FFFFFF';
                        ctx.lineWidth = 2;
                        const sz = Math.round(bubbleRadius * 0.5);
                        ctx.beginPath();
                        ctx.moveTo(stat.x - sz, stat.y - sz);
                        ctx.lineTo(stat.x + sz, stat.y + sz);
                        ctx.moveTo(stat.x + sz, stat.y - sz);
                        ctx.lineTo(stat.x - sz, stat.y + sz);
                        ctx.stroke();
                    } else if (isThisBubbleFilled) {
                        if (verdict === 'correct') {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.55)';
                        } else if (verdict === 'wrong') {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        } else {
                            ctx.strokeStyle = '#06B6D4';
                            ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        }
                        ctx.fill();
                        ctx.stroke();
                    } else if (correctAns && opt === correctAns && verdict === 'wrong') {
                        ctx.strokeStyle = '#10B981';
                        ctx.setLineDash([3, 3]);
                        ctx.stroke();
                        ctx.setLineDash([]);
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                        ctx.stroke();
                    }
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Blank';
                let markedCellHtml = '<span style="color:#9CA3AF;">-</span>';

                if (verdict === 'multiple') {
                    badgeClass = 'badge-multiple';
                    verdictText = '❌ Multiple (Invalid)';
                    markedCellHtml = '<strong style="color: #EF4444; font-size:1rem;">' + detectedAnswer + '</strong> <span style="font-size:0.75rem; color:#DC2626; font-weight:700;">(Multi)</span>';
                } else if (verdict === 'correct') {
                    badgeClass = 'badge-correct';
                    verdictText = '✓ Correct';
                    markedCellHtml = '<strong style="color: #10B981; font-size:1rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'wrong') {
                    badgeClass = 'badge-wrong';
                    verdictText = '✗ Wrong';
                    markedCellHtml = '<strong style="color: #EF4444; font-size:1rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'marked') {
                    badgeClass = 'badge-marked';
                    verdictText = 'Recorded';
                    markedCellHtml = '<strong style="color: #06B6D4; font-size:1rem;">' + detectedAnswer + '</strong>';
                }

                rowsHtml += '<tr>' +
                    '<td style="font-weight:700; color:#CBD5E1;">Q' + q + '</td>' +
                    '<td>' + markedCellHtml + '</td>' +
                    '<td>' + (correctAns ? '<span style="font-weight:700; color:#38BDF8;">' + correctAns + '</span>' : '<span style="color:#64748B;">None</span>') + '</td>' +
                    '<td><span class="badge ' + badgeClass + '">' + verdictText + '</span></td>' +
                '</tr>';
            }

            // Safe UI Scoreboard Updates
            const safeSetText = (id, text) => {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            const totalGraded = evaluatedKeyCount > 0 ? evaluatedKeyCount : totalPaperQuestions;
            safeSetText('scoreValue', `${score} / ${totalGraded}`);
            const pct = totalGraded > 0 ? Math.round((score / totalGraded) * 100) : 0;
            safeSetText('scorePercentage', `${pct}% Accuracy`);

            safeSetText('statCorrect', correctCount);
            safeSetText('statWrong', wrongCount);
            safeSetText('statMultiple', multipleCount);
            safeSetText('statAttempted', attemptedCount);
            safeSetText('statBlank', blankCount);

            const tbl = document.getElementById('tableBody');
            if (tbl) tbl.innerHTML = rowsHtml;
        }

        </script>
</body>
</html>