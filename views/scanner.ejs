<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI CyberScan - <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --cyber-cyan: #06B6D4;
            --cyber-emerald: #10B981;
            --cyber-glow: rgba(6, 182, 212, 0.4);
            --cyber-emerald-glow: rgba(16, 185, 129, 0.4);
            --dark-card: #0F172A;
        }
        .scanner-container {
            max-width: 1100px;
            margin: 0 auto;
        }
        .scanner-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }
        .viewfinder-card {
            background: #090D16;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            border: 1px solid #1E293B;
            position: relative;
        }
        .video-wrapper {
            position: relative;
            width: 100%;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 520px;
            user-select: none;
            touch-action: none;
            cursor: pointer;
        }
        #videoInput {
            display: none;
        }
        #canvasPreview {
            width: 100%;
            height: auto;
            display: block;
        }
        /* High-Tech HUD Overlays */
        .hud-top-bar {
            position: absolute;
            top: 14px;
            left: 14px;
            right: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            pointer-events: none;
            z-index: 25;
        }
        .hud-chip {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(10px);
            color: #FFFFFF;
            padding: 8px 16px;
            border-radius: var(--radius-full);
            font-size: 0.85rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid rgba(6, 182, 212, 0.3);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            letter-spacing: 0.5px;
        }
        .hud-chip.locked {
            border-color: var(--cyber-emerald);
            color: #6EE7B7;
            box-shadow: 0 0 20px var(--cyber-emerald-glow);
        }
        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #F59E0B;
            box-shadow: 0 0 10px #F59E0B;
            transition: all 0.2s ease;
        }
        .status-dot.active {
            background: var(--cyber-emerald);
            box-shadow: 0 0 12px var(--cyber-emerald);
            animation: pulse-dot 1.2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.7; }
        }
        .hud-tilt-badge {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(10px);
            color: #94A3B8;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-family: 'JetBrains Mono', monospace;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .hud-tilt-badge.level {
            color: #34D399;
            border-color: rgba(52, 211, 153, 0.4);
        }
        /* Scanning Laser Beam */
        .scan-laser {
            position: absolute;
            left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent 0%, var(--cyber-cyan) 50%, transparent 100%);
            box-shadow: 0 0 15px var(--cyber-cyan), 0 0 30px var(--cyber-cyan);
            pointer-events: none;
            z-index: 20;
            display: none;
            animation: laser-sweep 2s ease-in-out infinite alternate;
        }
        @keyframes laser-sweep {
            0% { top: 10%; opacity: 0.3; }
            50% { opacity: 0.9; }
            100% { top: 90%; opacity: 0.3; }
        }
        /* Bottom Control Bar */
        .scanner-bottom-bar {
            background: #111827;
            border-top: 1px solid #1E293B;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            color: white;
        }
        .btn-capture-auto {
            background: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 12px 26px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.25s ease;
            box-shadow: 0 4px 18px rgba(6, 182, 212, 0.4);
        }
        .btn-capture-auto:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(6, 182, 212, 0.6);
        }
        .btn-capture-auto.locked {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            box-shadow: 0 4px 20px rgba(16, 185, 129, 0.45);
        }
        .btn-capture-auto:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
        }
        .toggle-chip {
            background: #1E293B;
            border: 1px solid #334155;
            color: #E2E8F0;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            user-select: none;
        }
        .toggle-chip input {
            cursor: pointer;
        }
        /* Results View */
        #resultsSection {
            display: none;
            width: 100%;
        }
        .results-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .results-grid { grid-template-columns: 1fr; }
        }
        .rectified-canvas-wrap {
            background: #090D16;
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            text-align: center;
            border: 1px solid #1E293B;
            box-shadow: 0 20px 30px -10px rgba(0,0,0,0.5);
            position: relative;
        }
        .rectified-badge {
            position: absolute;
            top: 18px;
            left: 20px;
            background: rgba(16, 185, 129, 0.9);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
            z-index: 10;
        }
        #canvasResult {
            width: 100%;
            height: auto;
            border-radius: var(--radius-sm);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            background: #FFFFFF;
        }
        .score-hero {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            text-align: center;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-glow);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .stat-box {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.85rem;
            text-align: center;
        }
        .stat-box .num { font-size: 1.5rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
        .stat-box .lbl { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-top: 2px; }
        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        .breakdown-table th, .breakdown-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }
        .breakdown-table th { background: #F8FAFC; font-weight: 700; color: var(--text-muted); }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-correct { background: var(--success-light); color: #065F46; }
        .badge-wrong { background: var(--danger-light); color: #991B1B; }
        .badge-blank { background: #F1F5F9; color: #64748B; }
        .flash-screen {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: white;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.08s ease-out;
            z-index: 50;
        }
        .flash-screen.flash { opacity: 0.95; }
    </style>
</head>
<body>
    <div class="container scanner-container">
        <!-- Top Navigation -->
        <div class="scanner-topbar">
            <div>
                <h1 style="font-size: 1.5rem; margin: 0 0 4px 0;">Live AI Auto-Scanner & Rectifier</h1>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                    <%= paper.title %> &bull; <%= paper.numQuestions %> Questions
                </p>
            </div>
            <a href="/paper/<%= paper._id %>" class="btn btn-secondary btn-sm">&larr; Back to Paper</a>
        </div>

        <!-- Live Viewfinder Section -->
        <div id="viewfinderSection" class="viewfinder-card">
            <div class="video-wrapper" id="videoWrapper" onclick="handleTapToCapture()">
                <div id="flashScreen" class="flash-screen"></div>
                <div id="scanLaser" class="scan-laser"></div>

                <!-- Live HUD -->
                <div class="hud-top-bar">
                    <div id="hudChip" class="hud-chip">
                        <div id="statusDot" class="status-dot"></div>
                        <span id="hudStatus">AI SCANNER ACTIVE: POINT AT SHEET</span>
                    </div>
                    <div id="tiltBadge" class="hud-tilt-badge">
                        ðŸ“ TILT: 0.0Â° &bull; LEVEL
                    </div>
                </div>

                <video id="videoInput" autoplay playsinline></video>
                <canvas id="canvasPreview"></canvas>
            </div>

            <!-- Bottom Toolbar -->
            <div class="scanner-bottom-bar">
                <div style="display:flex; align-items:center; gap:12px;">
                    <label class="toggle-chip">
                        <input type="checkbox" id="autoSnapToggle" checked>
                        <span>Auto-Snap on Steady Lock</span>
                    </label>
                </div>
                <div>
                    <button type="button" class="btn-capture-auto" id="captureBtn" onclick="triggerManualCapture()">
                        âš¡ Snap & Level Sheet
                    </button>
                </div>
            </div>
        </div>

        <!-- High-Tech Cropped & Leveled Results Section -->
        <div id="resultsSection">
            <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 1rem 0;">
                <h2 style="margin: 0; font-size: 1.4rem;">Leveled Document & Evaluation</h2>
                <button class="btn btn-primary" onclick="restartScanner()">
                    ðŸ“· Scan Next Sheet
                </button>
            </div>

            <div class="results-grid">
                <!-- Cropped Leveled Sheet Display -->
                <div class="rectified-canvas-wrap">
                    <span class="rectified-badge">âœ“ Auto-Leveled & Cropped (A4)</span>
                    <canvas id="canvasResult"></canvas>
                </div>

                <!-- Scorecard & Breakdown -->
                <div>
                    <div class="score-hero">
                        <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">Score Achieved</div>
                        <div class="score-val" id="scoreValue" style="font-size: 3.25rem; font-weight: 800; margin: 0.25rem 0; font-family: 'Plus Jakarta Sans', sans-serif;">0 / 0</div>
                        <div id="scorePercentage" style="font-size: 1.15rem; font-weight: 600;">0% Accuracy</div>
                    </div>

                    <div class="card" style="padding: 1.25rem;">
                        <div class="stat-grid">
                            <div class="stat-box">
                                <div class="num" id="statCorrect" style="color: #10B981;">0</div>
                                <div class="lbl">Correct</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                                <div class="lbl">Wrong</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                                <div class="lbl">Attempted</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                                <div class="lbl">Unmarked</div>
                            </div>
                        </div>

                        <h4 style="margin: 1.25rem 0 0.5rem 0; font-size: 0.95rem;">Question Breakdown</h4>
                        <div style="max-height: 340px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                            <table class="breakdown-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Marked</th>
                                        <th>Key</th>
                                        <th>Verdict</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;

        const video = document.getElementById('videoInput');
        const previewCanvas = document.getElementById('canvasPreview');
        const previewCtx = previewCanvas.getContext('2d');
        const resultCanvas = document.getElementById('canvasResult');
        const resultCtx = resultCanvas.getContext('2d');

        const hudChip = document.getElementById('hudChip');
        const hudStatus = document.getElementById('hudStatus');
        const statusDot = document.getElementById('statusDot');
        const tiltBadge = document.getElementById('tiltBadge');
        const captureBtn = document.getElementById('captureBtn');
        const autoSnapToggle = document.getElementById('autoSnapToggle');
        const flashScreen = document.getElementById('flashScreen');
        const scanLaser = document.getElementById('scanLaser');

        let cameraStream = null;
        let animationFrameId = null;
        let isCaptured = false;

        // Auto-tracking state
        let smoothedCorners = null;
        let lockStreak = 0;
        const LOCK_REQUIRED_FRAMES = 12; // ~0.8s steady lock

        // Fast analysis downscale canvas
        const fastCanvas = document.createElement('canvas');
        const fastCtx = fastCanvas.getContext('2d');

        // Standardized A4 Leveled Canvas Dimensions
        const TARGET_W = 1000;
        const TARGET_H = 1414; // 1000 * 1.414 (exact A4 ratio)

        // Measured Standard Ratios
        const U_START = 141.0 / 2235.0;
        const V_START = 835.5 / 3261.0;
        const U_BUBBLE_STEP = 62.5 / 2235.0;
        const V_ROW_STEP = 59.4615 / 3261.0;
        const U_COL_STEP = 447.5 / 2235.0;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        async function initCamera() {
            isCaptured = false;
            smoothedCorners = null;
            lockStreak = 0;
            document.getElementById('viewfinderSection').style.display = 'block';
            document.getElementById('resultsSection').style.display = 'none';
            scanLaser.style.display = 'block';

            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'environment',
                        width: { ideal: 1920 },
                        height: { ideal: 1080 }
                    },
                    audio: false
                });
                video.srcObject = cameraStream;
                await video.play();

                previewCanvas.width = video.videoWidth || 1280;
                previewCanvas.height = video.videoHeight || 720;
                
                renderLoop();
            } catch (err) {
                console.error(err);
                hudStatus.textContent = 'CAMERA ERROR: ' + err.message;
            }
        }

        // 4-point Perspective Transform (Homography) solver: dst -> src
        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]]; [B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        // Live Frame Detection Loop
        function renderLoop() {
            if (isCaptured) return;

            if (video.readyState === video.HAVE_ENOUGH_DATA) {
                const W = previewCanvas.width;
                const H = previewCanvas.height;
                previewCtx.drawImage(video, 0, 0, W, H);

                // Run fast detector on downscaled canvas (360 width)
                const fastW = 360;
                const fastH = Math.round(H * (fastW / W));
                fastCanvas.width = fastW;
                fastCanvas.height = fastH;
                fastCtx.drawImage(video, 0, 0, fastW, fastH);

                const detectedRaw = detectLiveCorners(fastCtx, fastW, fastH);

                if (detectedRaw) {
                    // Scale back up to full preview coordinates
                    const scale = W / fastW;
                    const currentCorners = detectedRaw.map(pt => ({
                        x: pt.x * scale,
                        y: pt.y * scale
                    }));

                    // Smooth with Exponential Moving Average (EMA)
                    if (!smoothedCorners) {
                        smoothedCorners = currentCorners;
                    } else {
                        smoothedCorners = smoothedCorners.map((pt, i) => ({
                            x: pt.x * 0.75 + currentCorners[i].x * 0.25,
                            y: pt.y * 0.75 + currentCorners[i].y * 0.25
                        }));
                    }

                    // Compute Tilt Angle
                    const dX = smoothedCorners[1].x - smoothedCorners[0].x;
                    const dY = smoothedCorners[1].y - smoothedCorners[0].y;
                    const tilt = (Math.atan2(dY, dX) * (180 / Math.PI)).toFixed(1);

                    lockStreak++;
                    hudChip.classList.add('locked');
                    statusDot.className = 'status-dot active';
                    hudStatus.textContent = `TARGET LOCKED & LEVELED (${lockStreak >= LOCK_REQUIRED_FRAMES ? 'READY' : Math.round((lockStreak/LOCK_REQUIRED_FRAMES)*100) + '%'})`;
                    tiltBadge.className = 'hud-tilt-badge level';
                    tiltBadge.textContent = `ðŸ“ TILT: ${tilt > 0 ? '+' + tilt : tilt}Â° â€¢ AUTO-LEVELLING`;
                    captureBtn.classList.add('locked');

                    // Draw Glowing Cybernetic Polygonal Overlay
                    drawCyberOverlay(previewCtx, smoothedCorners, true);

                    // Auto-snap if held steady
                    if (autoSnapToggle.checked && lockStreak >= LOCK_REQUIRED_FRAMES) {
                        snapAndWarpSheet();
                        return;
                    }
                } else {
                    lockStreak = Math.max(0, lockStreak - 1);
                    hudChip.classList.remove('locked');
                    statusDot.className = 'status-dot';
                    hudStatus.textContent = 'AI SCANNER: POSITION SHEET IN VIEW';
                    tiltBadge.className = 'hud-tilt-badge';
                    tiltBadge.textContent = 'ðŸ“ SEARCHING CORNERS';
                    captureBtn.classList.remove('locked');

                    if (smoothedCorners) {
                        drawCyberOverlay(previewCtx, smoothedCorners, false);
                    }
                }
            }

            animationFrameId = requestAnimationFrame(renderLoop);
        }

        // Fast Corner Detector
        function detectLiveCorners(ctx, sw, sh) {
            const imgData = ctx.getImageData(0, 0, sw, sh);
            const data = imgData.data;

            const boxW = Math.round(sw * 0.32);
            const boxH = Math.round(sh * 0.32);
            const quads = [
                { x1: 0, y1: 0, x2: boxW, y2: boxH, cx: 0, cy: 0 },
                { x1: sw - boxW, y1: 0, x2: sw, y2: boxH, cx: sw, cy: 0 },
                { x1: sw - boxW, y1: sh - boxH, x2: sw, y2: sh, cx: sw, cy: sh },
                { x1: 0, y1: sh - boxH, x2: boxW, y2: sh, cx: 0, cy: sh }
            ];

            const found = [];
            for (let q of quads) {
                const pw = q.x2 - q.x1;
                const ph = q.y2 - q.y1;
                const gray = new Uint8Array(pw * ph);
                const hist = new Int32Array(256);
                let idx = 0;

                for (let y = q.y1; y < q.y2; y++) {
                    for (let x = q.x1; x < q.x2; x++) {
                        const pIdx = (y * sw + x) * 4;
                        const g = (data[pIdx] * 77 + data[pIdx+1] * 150 + data[pIdx+2] * 29) >> 8;
                        gray[idx++] = g;
                        hist[g]++;
                    }
                }

                // Quick threshold
                const total = pw * ph;
                let sum = 0;
                for (let i = 0; i < 256; i++) sum += i * hist[i];
                let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
                for (let i = 0; i < 256; i++) {
                    wB += hist[i];
                    if (wB === 0) continue;
                    const wF = total - wB;
                    if (wF === 0) break;
                    sumB += i * hist[i];
                    const v = wB * wF * (sumB/wB - (sum - sumB)/wF) * (sumB/wB - (sum - sumB)/wF);
                    if (v > maxVar) { maxVar = v; thresh = i; }
                }

                // Find solid square blob
                const visited = new Uint8Array(pw * ph);
                let best = null;
                let bestScore = -1;

                for (let py = 1; py < ph - 1; py += 2) {
                    for (let px = 1; px < pw - 1; px += 2) {
                        const p = py * pw + px;
                        if (visited[p] || gray[p] >= thresh) continue;

                        let count = 0, sumX = 0, sumY = 0;
                        let minX = px, maxX = px, minY = py, maxY = py;
                        const queue = [p];
                        visited[p] = 1;
                        let qHead = 0;

                        while (qHead < queue.length) {
                            const cur = queue[qHead++];
                            const cy = Math.floor(cur / pw);
                            const cx = cur % pw;
                            count++;
                            sumX += cx;
                            sumY += cy;
                            if (cx < minX) minX = cx;
                            if (cx > maxX) maxX = cx;
                            if (cy < minY) minY = cy;
                            if (cy > maxY) maxY = cy;

                            for (let nb of [cur - 1, cur + 1, cur - pw, cur + pw]) {
                                if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                    visited[nb] = 1;
                                    queue.push(nb);
                                }
                            }
                        }

                        const bw = maxX - minX + 1;
                        const bh = maxY - minY + 1;
                        const aspect = bw / bh;
                        const density = count / (bw * bh);

                        if (aspect > 0.65 && aspect < 1.45 && density > 0.60 && count > 12 && count < 1800) {
                            const score = density * count;
                            if (score > bestScore) {
                                bestScore = score;
                                best = { x: q.x1 + sumX / count, y: q.y1 + sumY / count };
                            }
                        }
                    }
                }

                if (best) {
                    found.push(best);
                } else {
                    return null; // Not all 4 corner markers visible yet
                }
            }

            return found.length === 4 ? found : null;
        }

        // Draw High-Tech Cyber Reticles & Bounding Quad
        function drawCyberOverlay(ctx, pts, isLocked) {
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.lineTo(pts[3].x, pts[3].y);
            ctx.closePath();

            ctx.fillStyle = isLocked ? 'rgba(16, 185, 129, 0.14)' : 'rgba(6, 182, 212, 0.08)';
            ctx.fill();

            ctx.lineWidth = 3;
            ctx.strokeStyle = isLocked ? '#10B981' : '#06B6D4';
            ctx.shadowColor = isLocked ? '#10B981' : '#06B6D4';
            ctx.shadowBlur = 10;
            ctx.stroke();

            // Cybernetic Corner Brackets
            pts.forEach((pt, i) => {
                const len = 22;
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 10, 0, 2 * Math.PI);
                ctx.fillStyle = isLocked ? '#10B981' : '#06B6D4';
                ctx.fill();

                ctx.lineWidth = 4;
                ctx.strokeStyle = '#FFFFFF';
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 18, 0, 2 * Math.PI);
                ctx.stroke();
            });
            ctx.restore();
        }

        function handleTapToCapture() {
            triggerManualCapture();
        }

        function triggerManualCapture() {
            if (isCaptured) return;
            snapAndWarpSheet();
        }

        function playShutter() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(140, audioCtx.currentTime + 0.09);
                gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.09);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch (e) {}
        }

        // Warps the perspective into a perfectly flat, upright, leveled A4 sheet
        function snapAndWarpSheet() {
            isCaptured = true;
            if (animationFrameId) cancelAnimationFrame(animationFrameId);

            playShutter();
            flashScreen.classList.add('flash');
            setTimeout(() => flashScreen.classList.remove('flash'), 120);

            const W = previewCanvas.width;
            const H = previewCanvas.height;

            const corners = smoothedCorners || [
                { x: W * 0.08, y: H * 0.06 },
                { x: W * 0.92, y: H * 0.06 },
                { x: W * 0.92, y: H * 0.94 },
                { x: W * 0.08, y: H * 0.94 }
            ];

            // Target Leveled Canvas: 1000 x 1414
            resultCanvas.width = TARGET_W;
            resultCanvas.height = TARGET_H;

            // Target canonical marker positions on the leveled A4 canvas
            const m_L = TARGET_W * 0.056;
            const m_R = TARGET_W * 0.944;
            const m_T = TARGET_H * 0.038;
            const m_B = TARGET_H * 0.962;

            const dstRectCorners = [
                { x: m_L, y: m_T },
                { x: m_R, y: m_T },
                { x: m_R, y: m_B },
                { x: m_L, y: m_B }
            ];

            // Perspective Transform Matrix H (dst -> src)
            const H_mat = getPerspectiveTransform(dstRectCorners, corners);

            // Read source frame pixels
            const srcImgData = previewCtx.getImageData(0, 0, W, H);
            const src32 = new Uint32Array(srcImgData.data.buffer);

            // Create target rectified image
            const dstImgData = resultCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF; // White border outside sheet
                    }
                    dstIdx++;
                }
            }

            resultCtx.putImageData(dstImgData, 0, 0);

            // Turn off camera stream
            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
            }

            // Evaluate sheet on the leveled, rectified canvas
            evaluateLeveledSheet(resultCtx, TARGET_W, TARGET_H, m_L, m_T, m_R - m_L, m_B - m_T);

            // Switch to Results View
            document.getElementById('viewfinderSection').style.display = 'none';
            document.getElementById('resultsSection').style.display = 'block';
        }

        // Evaluate bubbles on the flat, leveled A4 sheet
        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (y * W + x) * 4;
                return (data[idx] * 77 + data[idx+1] * 150 + data[idx+2] * 29) >> 8;
            }

            function sampleCircle(cx, cy, r) {
                let sum = 0, count = 0;
                for (let dy = -r; dy <= r; dy++) {
                    for (let dx = -r; dx <= r; dx++) {
                        if (dx*dx + dy*dy <= r*r) {
                            sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            const bubbleRadius = Math.max(7, Math.round(Math.min(W, H) * 0.007));
            let score = 0;
            let correctCount = 0;
            let wrongCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let evaluatedKeyCount = 0;
            let rowsHtml = '';

            for (let q = 1; q <= totalPaperQuestions; q++) {
                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                // Exact pixel coordinates on the leveled sheet!
                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                // Sample local paper baseline
                const paperVal = sampleCircle(colX - 18, rowY, 6);

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;

                    // Local peak search (locks onto the exact circle center)
                    let bestX = bubbleX, bestY = rowY, minVal = 999;
                    for (let dy of [-4, 0, 4]) {
                        for (let dx of [-4, 0, 4]) {
                            const val = sampleCircle(bubbleX + dx, rowY + dy, Math.round(bubbleRadius * 0.6));
                            if (val < minVal) {
                                minVal = val;
                                bestX = bubbleX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    const bubbleMean = sampleCircle(bestX, bestY, bubbleRadius);
                    const darkness = paperVal - bubbleMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -bubbleRadius; dy <= bubbleRadius; dy++) {
                        for (let dx = -bubbleRadius; dx <= bubbleRadius; dx++) {
                            if (dx*dx + dy*dy <= bubbleRadius*bubbleRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 25)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    bubbleStats.push({
                        opt: OPTIONS[b],
                        darkness: darkness,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                // Relative Contrast Sorting
                const sorted = [...bubbleStats].sort((a, b) => b.darkness - a.darkness);
                const top1 = sorted[0];
                const top2 = sorted[1];

                let isFilled = false;
                if (top1.darkness >= 16) {
                    if (top1.darkness - top2.darkness >= 9 || top1.darkRatio > 0.32 || top1.darkness > top2.darkness * 1.35) {
                        isFilled = true;
                    }
                }

                const detectedAnswer = isFilled ? top1.opt : '';
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';
                if (correctAns) evaluatedKeyCount++;

                if (detectedAnswer) {
                    attemptedCount++;
                    if (correctAns && detectedAnswer === correctAns) {
                        score++;
                        correctCount++;
                        verdict = 'correct';
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                    }
                } else {
                    blankCount++;
                }

                // Draw Overlay Rings on the Leveled Cropped Sheet
                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(3, Math.round(W * 0.002));

                    if (opt === detectedAnswer) {
                        if (correctAns && detectedAnswer === correctAns) {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.45)';
                        } else if (correctAns) {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.45)';
                        } else {
                            ctx.strokeStyle = '#3B82F6';
                            ctx.fillStyle = 'rgba(59, 130, 246, 0.35)';
                        }
                        ctx.fill();
                    } else if (opt === correctAns && detectedAnswer !== correctAns) {
                        ctx.strokeStyle = '#F59E0B';
                        ctx.fillStyle = 'rgba(245, 158, 11, 0.35)';
                        ctx.fill();
                    } else {
                        ctx.strokeStyle = 'rgba(59, 130, 246, 0.2)';
                    }
                    ctx.stroke();
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Unmarked';
                if (verdict === 'correct') { badgeClass = 'badge-correct'; verdictText = 'âœ“ Correct'; }
                else if (verdict === 'wrong') { badgeClass = 'badge-wrong'; verdictText = 'âœ— Wrong'; }
                else if (detectedAnswer) { badgeClass = 'badge-correct'; verdictText = 'Marked'; }

                rowsHtml += `<tr>
                    <td><strong>${q}</strong></td>
                    <td>${detectedAnswer ? '<span style="font-weight:700; font-size:1rem;">' + detectedAnswer + '</span>' : '<span style="color:#9CA3AF;">-</span>'}</td>
                    <td>${correctAns ? '<strong style="color:var(--primary);">' + correctAns + '</strong>' : '<span style="color:#9CA3AF;">-</span>'}</td>
                    <td><span class="badge ${badgeClass}">${verdictText}</span></td>
                </tr>`;
            }

            // Update UI Scoreboard
            const totalGraded = evaluatedKeyCount > 0 ? evaluatedKeyCount : totalPaperQuestions;
            document.getElementById('scoreValue').textContent = `${score} / ${totalGraded}`;
            const pct = totalGraded > 0 ? Math.round((score / totalGraded) * 100) : 0;
            document.getElementById('scorePercentage').textContent = `${pct}% Accuracy`;

            document.getElementById('statCorrect').textContent = correctCount;
            document.getElementById('statWrong').textContent = wrongCount;
            document.getElementById('statAttempted').textContent = attemptedCount;
            document.getElementById('statBlank').textContent = blankCount;
            document.getElementById('tableBody').innerHTML = rowsHtml;
        }

        function restartScanner() {
            initCamera();
        }

        window.addEventListener('DOMContentLoaded', initCamera);
    </script>
</body>
