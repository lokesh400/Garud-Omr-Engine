<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> AI CyberScan - <%= paper.title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --cyber-cyan: #06B6D4;
            --cyber-emerald: #10B981;
            --cyber-glow: rgba(6, 182, 212, 0.4);
            --cyber-emerald-glow: rgba(16, 185, 129, 0.4);
            --dark-card: #0F172A;
        }

        .scanner-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .scanner-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .viewfinder-card {
            background: #090D16;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            border: 1px solid #1E293B;
            position: relative;
        }

        .video-wrapper {
            position: relative;
            width: 100%;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 520px;
            user-select: none;
            touch-action: none;
            cursor: pointer;
        }

        #videoInput {
            display: none;
        }

        #canvasPreview {
            width: 100%;
            height: auto;
            display: block;
        }

        /* High-Tech HUD Overlays */
        .hud-top-bar {
            position: absolute;
            top: 14px;
            left: 14px;
            right: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            pointer-events: none;
            z-index: 25;
        }

        .hud-chip {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(10px);
            color: #FFFFFF;
            padding: 8px 16px;
            border-radius: var(--radius-full);
            font-size: 0.85rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid rgba(6, 182, 212, 0.3);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            letter-spacing: 0.5px;
        }

        .hud-chip.locked {
            border-color: var(--cyber-emerald);
            color: #6EE7B7;
            box-shadow: 0 0 20px var(--cyber-emerald-glow);
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #F59E0B;
            box-shadow: 0 0 10px #F59E0B;
            transition: all 0.2s ease;
        }

        .status-dot.active {
            background: var(--cyber-emerald);
            box-shadow: 0 0 12px var(--cyber-emerald);
            animation: pulse-dot 1.2s infinite;
        }

        @keyframes pulse-dot {

            0%,
            100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.3);
                opacity: 0.7;
            }
        }

        .hud-tilt-badge {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(10px);
            color: #94A3B8;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-family: 'JetBrains Mono', monospace;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .hud-tilt-badge.level {
            color: #34D399;
            border-color: rgba(52, 211, 153, 0.4);
        }

        /* Scanning Laser Beam */
        .scan-laser {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent 0%, var(--cyber-cyan) 50%, transparent 100%);
            box-shadow: 0 0 15px var(--cyber-cyan), 0 0 30px var(--cyber-cyan);
            pointer-events: none;
            z-index: 20;
            display: none;
            animation: laser-sweep 2s ease-in-out infinite alternate;
        }

        @keyframes laser-sweep {
            0% {
                top: 10%;
                opacity: 0.3;
            }

            50% {
                opacity: 0.9;
            }

            100% {
                top: 90%;
                opacity: 0.3;
            }
        }

        /* Bottom Control Bar */
        .scanner-bottom-bar {
            background: #111827;
            border-top: 1px solid #1E293B;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            color: white;
        }

        .btn-capture-auto {
            background: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 12px 26px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.25s ease;
            box-shadow: 0 4px 18px rgba(6, 182, 212, 0.4);
        }

        .btn-capture-auto:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(6, 182, 212, 0.6);
        }

        .btn-capture-auto.locked {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            box-shadow: 0 4px 20px rgba(16, 185, 129, 0.45);
        }

        .btn-capture-auto:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
        }

        .toggle-chip {
            background: #1E293B;
            border: 1px solid #334155;
            color: #E2E8F0;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            user-select: none;
        }

        .toggle-chip input {
            cursor: pointer;
        }

        /* Results View */
        #resultsSection {
            display: none;
            width: 100%;
        }

        .results-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @media (max-width: 960px) {
            .results-grid {
                grid-template-columns: 1fr;
            }
        }

        .rectified-canvas-wrap {
            background: #090D16;
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            text-align: center;
            border: 1px solid #1E293B;
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        .rectified-badge {
            position: absolute;
            top: 18px;
            left: 20px;
            background: rgba(16, 185, 129, 0.9);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
            z-index: 10;
        }

        #canvasResult {
            width: 100%;
            height: auto;
            border-radius: var(--radius-sm);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            background: #FFFFFF;
        }

        .score-hero {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            text-align: center;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-glow);
        }

        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .stat-box {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.85rem;
            text-align: center;
        }

        .stat-box .num {
            font-size: 1.5rem;
            font-weight: 800;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .stat-box .lbl {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            margin-top: 2px;
        }

        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }

        .breakdown-table th,
        .breakdown-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }

        .breakdown-table th {
            background: #F8FAFC;
            font-weight: 700;
            color: var(--text-muted);
        }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }

        .badge-correct {
            background: var(--success-light);
            color: #065F46;
        }

        .badge-wrong {
            background: var(--danger-light);
            color: #991B1B;
        }

        .badge-blank {
            background: #F1F5F9;
            color: #64748B;
        }

        .badge-multiple {
            background: #FEE2E2;
            color: #991B1B;
            border: 1px solid #FCA5A5;
        }

        /* Roll Number Card */
        .roll-number-card {
            background: #0F172A;
            border: 1px solid #1E293B;
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .roll-label-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.75rem;
        }

        .roll-title {
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: #94A3B8;
            text-transform: uppercase;
        }

        .roll-status-pill {
            margin-left: auto;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: var(--radius-full);
            background: rgba(16, 185, 129, 0.2);
            color: #34D399;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-family: 'JetBrains Mono', monospace;
        }

        .roll-boxes-display {
            display: flex;
            gap: 6px;
            justify-content: center;
        }

        .roll-digit-box {
            width: 36px;
            height: 44px;
            background: #1E293B;
            border: 1.5px solid #334155;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #38BDF8;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
            transition: all 0.2s ease;
        }

        .roll-digit-box.filled {
            border-color: #38BDF8;
            background: #0c2238;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.35), inset 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .roll-digit-box.unknown {
            color: #64748B;
            border-style: dashed;
        }

        .flash-screen {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.08s ease-out;
            z-index: 50;
        }

        .flash-screen.flash {
            opacity: 0.95;
        }
    </style>
</head>

<body>
    <div class="container scanner-container">
        <!-- Top Navigation -->
        <div class="scanner-topbar">
            <div>
                <h1 style="font-size: 1.5rem; margin: 0 0 4px 0;">Live AI Auto-Scanner & Rectifier</h1>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                    <%= paper.title %> &bull; <%= paper.numQuestions %> Questions
                </p>
            </div>
            <a href="/paper/<%= paper._id %>" class="btn btn-secondary btn-sm">&larr; Back to Paper</a>
        </div>

        <!-- Live Viewfinder Section -->
        <div id="viewfinderSection" class="viewfinder-card">
            <div class="video-wrapper" id="videoWrapper" onclick="handleTapToCapture()">
                <div id="flashScreen" class="flash-screen"></div>
                <div id="scanLaser" class="scan-laser"></div>

                <!-- Live HUD -->
                <div class="hud-top-bar">
                    <div id="hudChip" class="hud-chip">
                        <div id="statusDot" class="status-dot"></div>
                        <span id="hudStatus">AI SCANNER ACTIVE: POINT AT SHEET</span>
                    </div>
                    <div id="tiltBadge" class="hud-tilt-badge">
                        ðŸ“ TILT: 0.0Â° &bull; LEVEL
                    </div>
                </div>

                <video id="videoInput" autoplay playsinline></video>
                <canvas id="canvasPreview"></canvas>
            </div>

            <!-- Bottom Toolbar -->
            <div class="scanner-bottom-bar">
                <div style="display:flex; align-items:center; gap:12px;">
                    <label class="toggle-chip">
                        <input type="checkbox" id="autoSnapToggle" checked>
                        <span>Auto-Snap on Steady Lock</span>
                    </label>
                </div>
                <div>
                    <button type="button" class="btn-capture-auto" id="captureBtn" onclick="triggerManualCapture()">
                        âš¡ Snap & Level Sheet
                    </button>
                </div>
            </div>
        </div>

        <!-- High-Tech Cropped & Leveled Results Section -->
        <div id="resultsSection">
            <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 1rem 0;">
                <h2 style="margin: 0; font-size: 1.4rem;">Leveled Document & Evaluation</h2>
                <button class="btn btn-primary" onclick="restartScanner()">
                    ðŸ“· Scan Next Sheet
                </button>
            </div>

            <div class="results-grid">
                <!-- Cropped Leveled Sheet Display -->
                <div class="rectified-canvas-wrap">
                    <span class="rectified-badge">âœ“ Auto-Leveled & Cropped (A4)</span>
                    <canvas id="canvasResult"></canvas>
                </div>

                <!-- Scorecard & Breakdown -->
                <div>
                    <!-- Student Roll Number Card -->
                    <div class="roll-number-card">
                        <div class="roll-label-row">
                            <span style="font-size: 1.1rem;">🎓</span>
                            <span class="roll-title">Student Roll Number</span>
                            <span class="roll-status-pill" id="rollStatusPill">Detecting...</span>
                        </div>
                        <div class="roll-boxes-display" id="rollBoxesDisplay">
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                        </div>
                    </div>

                    <div class="score-hero">
                        <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9;">
                            Score Achieved</div>
                        <div class="score-val" id="scoreValue"
                            style="font-size: 3.25rem; font-weight: 800; margin: 0.25rem 0; font-family: 'Plus Jakarta Sans', sans-serif;">
                            0 / 0</div>
                        <div id="scorePercentage" style="font-size: 1.15rem; font-weight: 600;">0% Accuracy</div>
                    </div>

                    <div class="card" style="padding: 1.25rem;">
                        <div class="stat-grid"
                            style="grid-template-columns: repeat(auto-fit, minmax(75px, 1fr)); gap: 8px;">
                            <div class="stat-box">
                                <div class="num" id="statCorrect" style="color: #10B981;">0</div>
                                <div class="lbl">Correct</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statWrong" style="color: #EF4444;">0</div>
                                <div class="lbl">Wrong</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statMultiple" style="color: #DC2626;">0</div>
                                <div class="lbl">Multiple</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statAttempted" style="color: #4F46E5;">0</div>
                                <div class="lbl">Attempted</div>
                            </div>
                            <div class="stat-box">
                                <div class="num" id="statBlank" style="color: #6B7280;">0</div>
                                <div class="lbl">Unmarked</div>
                            </div>
                        </div>

                        <h4 style="margin: 1.25rem 0 0.5rem 0; font-size: 0.95rem;">Question Breakdown</h4>
                        <div
                            style="max-height: 340px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                            <table class="breakdown-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Marked</th>
                                        <th>Key</th>
                                        <th>Verdict</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;

        const video = document.getElementById('videoInput');
        const previewCanvas = document.getElementById('canvasPreview');
        const previewCtx = previewCanvas.getContext('2d');
        const resultCanvas = document.getElementById('canvasResult');
        const resultCtx = resultCanvas.getContext('2d');

        const hudChip = document.getElementById('hudChip');
        const hudStatus = document.getElementById('hudStatus');
        const statusDot = document.getElementById('statusDot');
        const tiltBadge = document.getElementById('tiltBadge');
        const captureBtn = document.getElementById('captureBtn');
        const autoSnapToggle = document.getElementById('autoSnapToggle');
        const flashScreen = document.getElementById('flashScreen');
        const scanLaser = document.getElementById('scanLaser');

        let cameraStream = null;
        let animationFrameId = null;
        let isCaptured = false;

        // Auto-tracking state
        let smoothedCorners = null;
        let lockStreak = 0;
        const LOCK_REQUIRED_FRAMES = 5; // ~160ms steady hold before auto-snap

        // Fast analysis downscale canvas
        const fastCanvas = document.createElement('canvas');
        const fastCtx = fastCanvas.getContext('2d');

        // Standardized A4 Leveled Canvas Dimensions
        const TARGET_W = 1000;
        const TARGET_H = 1414; // 1000 * 1.414 (exact A4 ratio)

        // Measured Standard Ratios
        const U_START = 141.0 / 2235.0;
        const V_START = 835.5 / 3261.0;
        const U_BUBBLE_STEP = 62.5 / 2235.0;
        const V_ROW_STEP = 59.4615 / 3261.0;
        const U_COL_STEP = 447.5 / 2235.0;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        async function initCamera() {
            isCaptured = false;
            smoothedCorners = null;
            lockStreak = 0;
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            document.getElementById('viewfinderSection').style.display = 'block';
            document.getElementById('resultsSection').style.display = 'none';
            scanLaser.style.display = 'block';

            // Reuse existing active stream if available
            if (cameraStream && cameraStream.active) {
                try {
                    video.srcObject = cameraStream;
                    video.muted = true;
                    await video.play();
                    previewCanvas.width = video.videoWidth || 1280;
                    previewCanvas.height = video.videoHeight || 720;
                    renderLoop();
                    return;
                } catch (e) {
                    console.warn('Reuse stream failed, reopening:', e);
                }
            }

            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }

            let stream = null;
            const constraintsList = [
                { video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false },
                { video: { facingMode: 'environment' }, audio: false },
                { video: { width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false },
                { video: true, audio: false }
            ];

            for (const c of constraintsList) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia(c);
                    if (stream) break;
                } catch (err) { }
            }

            if (!stream) {
                hudStatus.textContent = 'CAMERA ERROR: CAMERA NOT ACCESSIBLE';
                return;
            }

            try {
                cameraStream = stream;
                video.srcObject = cameraStream;
                video.muted = true;
                await video.play();

                previewCanvas.width = video.videoWidth || 1280;
                previewCanvas.height = video.videoHeight || 720;

                renderLoop();
            } catch (err) {
                console.error(err);
                hudStatus.textContent = 'CAMERA ERROR: ' + err.message;
            }
        }

        // 4-point Perspective Transform (Homography) solver: dst -> src
        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]];[B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        // Live Frame Detection Loop
        function renderLoop() {
            if (isCaptured) return;

            if (video.readyState >= 2) {
                const W = previewCanvas.width;
                const H = previewCanvas.height;
                previewCtx.drawImage(video, 0, 0, W, H);

                // Run fast detector on downscaled canvas (320px width for <1ms execution)
                const fastW = 320;
                const fastH = Math.max(1, Math.round(H * (fastW / W)));
                fastCanvas.width = fastW;
                fastCanvas.height = fastH;
                fastCtx.drawImage(video, 0, 0, fastW, fastH);

                const detectedRaw = detectLiveCorners(fastCtx, fastW, fastH);

                if (detectedRaw) {
                    // Scale back up to full preview coordinates
                    const scale = W / fastW;
                    const currentCorners = detectedRaw.map(pt => ({
                        x: pt.x * scale,
                        y: pt.y * scale
                    }));

                    // Smooth with Exponential Moving Average (EMA)
                    if (!smoothedCorners) {
                        smoothedCorners = currentCorners;
                    } else {
                        smoothedCorners = smoothedCorners.map((pt, i) => ({
                            x: pt.x * 0.70 + currentCorners[i].x * 0.30,
                            y: pt.y * 0.70 + currentCorners[i].y * 0.30
                        }));
                    }

                    // Compute Tilt Angle
                    const dX = smoothedCorners[1].x - smoothedCorners[0].x;
                    const dY = smoothedCorners[1].y - smoothedCorners[0].y;
                    const tilt = (Math.atan2(dY, dX) * (180 / Math.PI)).toFixed(1);

                    lockStreak++;
                    hudChip.classList.add('locked');
                    statusDot.className = 'status-dot active';
                    const pct = Math.min(100, Math.round((lockStreak / LOCK_REQUIRED_FRAMES) * 100));
                    hudStatus.textContent = lockStreak >= LOCK_REQUIRED_FRAMES ? 'TARGET LOCKED • AUTO-SNAPPING' : 'LOCKING SHEET (' + pct + '%)';
                    tiltBadge.className = 'hud-tilt-badge level';
                    tiltBadge.textContent = '📐 TILT: ' + (tilt > 0 ? '+' + tilt : tilt) + '° • LEVEL';
                    captureBtn.classList.add('locked');

                    // Draw Glowing Cybernetic Polygonal Overlay
                    drawCyberOverlay(previewCtx, smoothedCorners, lockStreak >= LOCK_REQUIRED_FRAMES);

                    // Auto-snap if held steady
                    if (autoSnapToggle.checked && lockStreak >= LOCK_REQUIRED_FRAMES) {
                        snapAndWarpSheet();
                        return;
                    }
                } else {
                    lockStreak = Math.max(0, lockStreak - 1);
                    if (lockStreak === 0) smoothedCorners = null;
                    hudChip.classList.remove('locked');
                    statusDot.className = 'status-dot';
                    hudStatus.textContent = 'AI SCANNER: ALIGN OMR SHEET IN FRAME';
                    tiltBadge.className = 'hud-tilt-badge';
                    tiltBadge.textContent = '📐 SEARCHING CORNERS';
                    captureBtn.classList.remove('locked');

                    if (smoothedCorners) {
                        drawCyberOverlay(previewCtx, smoothedCorners, false);
                    } else {
                        drawFramingGuide(previewCtx, W, H);
                    }
                }
            }

            animationFrameId = requestAnimationFrame(renderLoop);
        }

        // High-Precision Solid Corner Detector: Isolates 4 Solid Black Corner Markers
        // Strictly avoids question bubbles via 28% margin restriction, count >= 26, and inner margin check
        function detectLiveCorners(ctx, sw, sh) {
            const imgData = ctx.getImageData(0, 0, sw, sh);
            const data = imgData.data;

            // Search in outer 28% margin corners (strictly stays outside central question grid)
            const boxW = Math.round(sw * 0.28);
            const boxH = Math.round(sh * 0.28);
            const quads = [
                { x1: 0, y1: 0, x2: boxW, y2: boxH, cx: 0, cy: 0 },
                { x1: sw - boxW, y1: 0, x2: sw, y2: boxH, cx: sw, cy: 0 },
                { x1: sw - boxW, y1: sh - boxH, x2: sw, y2: sh, cx: sw, cy: sh },
                { x1: 0, y1: sh - boxH, x2: boxW, y2: sh, cx: 0, cy: sh }
            ];

            const diag = Math.hypot(sw, sh);
            const foundCorners = [];

            for (let q of quads) {
                const pw = q.x2 - q.x1;
                const ph = q.y2 - q.y1;
                const gray = new Uint8Array(pw * ph);
                const hist = new Int32Array(256);
                let idx = 0;

                for (let y = q.y1; y < q.y2; y++) {
                    for (let x = q.x1; x < q.x2; x++) {
                        const pIdx = (y * sw + x) * 4;
                        const g = (data[pIdx] * 77 + data[pIdx + 1] * 150 + data[pIdx + 2] * 29) >> 8;
                        gray[idx++] = g;
                        hist[g]++;
                    }
                }

                // Otsu threshold clamped to prevent noise skipping
                const total = pw * ph;
                let sum = 0;
                for (let i = 0; i < 256; i++) sum += i * hist[i];
                let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
                for (let i = 0; i < 256; i++) {
                    wB += hist[i];
                    if (wB === 0) continue;
                    const wF = total - wB;
                    if (wF === 0) break;
                    sumB += i * hist[i];
                    const v = wB * wF * (sumB / wB - (sum - sumB) / wF) * (sumB / wB - (sum - sumB) / wF);
                    if (v > maxVar) { maxVar = v; thresh = i + 1; }
                }

                thresh = Math.max(35, Math.min(thresh, 185));

                const visited = new Uint8Array(pw * ph);
                const candidates = [];

                for (let py = 1; py < ph - 1; py += 2) {
                    for (let px = 1; px < pw - 1; px += 2) {
                        const p = py * pw + px;
                        if (visited[p] || gray[p] >= thresh) continue;

                        let count = 0, sumX = 0, sumY = 0;
                        let minX = px, maxX = px, minY = py, maxY = py;
                        const queue = [p];
                        visited[p] = 1;
                        let qHead = 0;

                        while (qHead < queue.length) {
                            // Freeze protection: terminate large non-marker regions immediately
                            if (count > 2000) break;

                            const cur = queue[qHead++];
                            const cy = Math.floor(cur / pw);
                            const cx = cur % pw;
                            count++;
                            sumX += cx;
                            sumY += cy;
                            if (cx < minX) minX = cx;
                            if (cx > maxX) maxX = cx;
                            if (cy < minY) minY = cy;
                            if (cy > maxY) maxY = cy;

                            for (let nb of [cur - 1, cur + 1, cur - pw, cur + pw]) {
                                if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                    visited[nb] = 1;
                                    queue.push(nb);
                                }
                            }
                        }

                        const bw = maxX - minX + 1;
                        const bh = maxY - minY + 1;
                        const aspect = bw / bh;
                        const density = count / (bw * bh);

                        // Solid Square Corner Marker Criteria:
                        // bw, bh >= 7 (bubbles are 3-4px), count >= 26 (bubbles are <= 14px), density >= 0.55
                        if (bw >= 7 && bh >= 7 && bw <= 55 && bh <= 55 && aspect >= 0.60 && aspect <= 1.60 && density >= 0.55 && count >= 26 && count <= 2000) {
                            const bx = q.x1 + sumX / count;
                            const by = q.y1 + sumY / count;

                            // Inward paper margin check: genuine corner markers have white paper inward towards sheet center
                            const dirX = Math.sign((sw / 2) - bx);
                            const dirY = Math.sign((sh / 2) - by);
                            let whiteInward = 0;
                            const d1 = Math.round(Math.max(bw, bh) * 1.0);
                            const d2 = Math.round(Math.max(bw, bh) * 1.6);
                            for (let sd of [d1, d2]) {
                                const ix = Math.round(bx + dirX * sd);
                                const iy = Math.round(by + dirY * sd);
                                if (ix >= 0 && ix < sw && iy >= 0 && iy < sh) {
                                    const inIdx = (iy * sw + ix) * 4;
                                    const inGray = (data[inIdx] * 77 + data[inIdx + 1] * 150 + data[inIdx + 2] * 29) >> 8;
                                    if (inGray >= (thresh - 10)) whiteInward++;
                                }
                            }

                            // Isolation Ring Check: Corner markers sit in white margins (ringDarkRatio <= 0.18)
                            const rIn = Math.round(Math.max(bw, bh) * 0.75);
                            const rOut = Math.round(Math.max(bw, bh) * 1.55);
                            let darkRing = 0, totalRing = 0;

                            for (let rdy = -rOut; rdy <= rOut; rdy += 2) {
                                for (let rdx = -rOut; rdx <= rOut; rdx += 2) {
                                    const d2 = rdx * rdx + rdy * rdy;
                                    if (d2 >= rIn * rIn && d2 <= rOut * rOut) {
                                        const gx = Math.round(bx + rdx);
                                        const gy = Math.round(by + rdy);
                                        if (gx >= 0 && gx < sw && gy >= 0 && gy < sh) {
                                            totalRing++;
                                            const gIdx = (gy * sw + gx) * 4;
                                            const pixGray = (data[gIdx] * 77 + data[gIdx + 1] * 150 + data[gIdx + 2] * 29) >> 8;
                                            if (pixGray < thresh) darkRing++;
                                        }
                                    }
                                }
                            }

                            const ringDarkRatio = totalRing > 0 ? (darkRing / totalRing) : 0;
                            const distToCorner = Math.hypot(bx - q.cx, by - q.cy);
                            const normDist = distToCorner / diag;

                            // Accept only isolated solid square markers with clean inward margin
                            if (ringDarkRatio <= 0.18 && whiteInward >= 1) {
                                const score = (density * 2.5) - (normDist * 2.5) - (ringDarkRatio * 3.0);
                                candidates.push({
                                    x: bx,
                                    y: by,
                                    count: count,
                                    score: score,
                                    distToCorner: distToCorner
                                });
                            }
                        }
                    }
                }

                if (candidates.length === 0) {
                    return null; // A corner is missing or obstructed - do NOT lock onto bubbles
                }

                // Pick the candidate with best score (most isolated and closest to outer quadrant corner)
                candidates.sort((a, b) => b.score - a.score);
                foundCorners.push({ x: candidates[0].x, y: candidates[0].y, count: candidates[0].count });
            }

            if (foundCorners.length !== 4) return null;

            // Strict Quad Geometry Validation
            const p0 = foundCorners[0], p1 = foundCorners[1], p2 = foundCorners[2], p3 = foundCorners[3];

            // 1. Convexity check (clockwise cross-products > 0)
            const pts = [p0, p1, p2, p3];
            for (let i = 0; i < 4; i++) {
                const a = pts[i];
                const b = pts[(i + 1) % 4];
                const c = pts[(i + 2) % 4];
                const cross = (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
                if (cross <= 0) return null;
            }

            // 2. Parallelism and proportional opposite sides
            const wTop = Math.hypot(p1.x - p0.x, p1.y - p0.y);
            const wBot = Math.hypot(p2.x - p3.x, p2.y - p3.y);
            const hLeft = Math.hypot(p3.x - p0.x, p3.y - p0.y);
            const hRight = Math.hypot(p2.x - p1.x, p2.y - p1.y);

            if (Math.min(wTop, wBot) / Math.max(wTop, wBot) < 0.58) return null;
            if (Math.min(hLeft, hRight) / Math.max(hLeft, hRight) < 0.58) return null;

            // 3. Aspect ratio check (allows both portrait and landscape orientation)
            const avgW = (wTop + wBot) / 2;
            const avgH = (hLeft + hRight) / 2;
            const aspect = avgH / avgW;
            if (aspect < 0.50 || aspect > 2.05) return null;

            // 4. Area check (at least 8% of camera area)
            const quadArea = 0.5 * Math.abs(
                (p0.x * p1.y - p0.y * p1.x) +
                (p1.x * p2.y - p1.y * p2.x) +
                (p2.x * p3.y - p2.y * p3.x) +
                (p3.x * p0.y - p3.y * p0.x)
            );
            if (quadArea < (sw * sh * 0.08)) return null;

            return foundCorners;
        }

        // Draw Sleek Framing Guide when searching
        function drawFramingGuide(ctx, W, H) {
            ctx.save();
            const gw = Math.round(W * 0.65);
            const gh = Math.min(Math.round(H * 0.88), Math.round(gw * 1.414));
            const gx = Math.round((W - gw) / 2);
            const gy = Math.round((H - gh) / 2);

            ctx.strokeStyle = 'rgba(6, 182, 212, 0.35)';
            ctx.lineWidth = 2;
            ctx.setLineDash([8, 8]);
            ctx.strokeRect(gx, gy, gw, gh);
            ctx.setLineDash([]);

            // Framing Corner Brackets
            const cornerLen = Math.min(32, Math.round(gw * 0.08));
            ctx.strokeStyle = '#06B6D4';
            ctx.lineWidth = 3.5;

            // Top-Left
            ctx.beginPath();
            ctx.moveTo(gx, gy + cornerLen);
            ctx.lineTo(gx, gy);
            ctx.lineTo(gx + cornerLen, gy);
            ctx.stroke();

            // Top-Right
            ctx.beginPath();
            ctx.moveTo(gx + gw - cornerLen, gy);
            ctx.lineTo(gx + gw, gy);
            ctx.lineTo(gx + gw, gy + cornerLen);
            ctx.stroke();

            // Bottom-Right
            ctx.beginPath();
            ctx.moveTo(gx + gw, gy + gh - cornerLen);
            ctx.lineTo(gx + gw, gy + gh);
            ctx.lineTo(gx + gw - cornerLen, gy + gh);
            ctx.stroke();

            // Bottom-Left
            ctx.beginPath();
            ctx.moveTo(gx + cornerLen, gy + gh);
            ctx.lineTo(gx, gy + gh);
            ctx.lineTo(gx, gy + gh - cornerLen);
            ctx.stroke();

            ctx.restore();
        }

        // Draw High-Tech Cyber Reticles & Bounding Quad
        function drawCyberOverlay(ctx, pts, isLocked) {
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.lineTo(pts[3].x, pts[3].y);
            ctx.closePath();

            ctx.fillStyle = isLocked ? 'rgba(16, 185, 129, 0.16)' : 'rgba(6, 182, 212, 0.08)';
            ctx.fill();

            ctx.lineWidth = 3.5;
            ctx.strokeStyle = isLocked ? '#10B981' : '#06B6D4';
            ctx.shadowColor = isLocked ? '#10B981' : '#06B6D4';
            ctx.shadowBlur = 12;
            ctx.stroke();

            // Cybernetic Corner Brackets & Rings
            pts.forEach((pt, i) => {
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 8, 0, 2 * Math.PI);
                ctx.fillStyle = isLocked ? '#10B981' : '#06B6D4';
                ctx.fill();

                ctx.lineWidth = 3;
                ctx.strokeStyle = '#FFFFFF';
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 16, 0, 2 * Math.PI);
                ctx.stroke();
            });
            ctx.restore();
        }

        function handleTapToCapture() {
            triggerManualCapture();
        }

        function triggerManualCapture() {
            if (isCaptured) return;
            snapAndWarpSheet();
        }

        function playShutter() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(140, audioCtx.currentTime + 0.09);
                gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.09);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch (e) { }
        }

        // Warps the perspective into a perfectly flat, upright, leveled A4 sheet
        function snapAndWarpSheet() {
            isCaptured = true;
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }

            playShutter();
            flashScreen.classList.add('flash');
            setTimeout(() => flashScreen.classList.remove('flash'), 120);

            const W = previewCanvas.width;
            const H = previewCanvas.height;

            const corners = smoothedCorners || [
                { x: W * 0.12, y: H * 0.08 },
                { x: W * 0.88, y: H * 0.08 },
                { x: W * 0.88, y: H * 0.92 },
                { x: W * 0.12, y: H * 0.92 }
            ];

            // Target Leveled Canvas: 1000 x 1414
            resultCanvas.width = TARGET_W;
            resultCanvas.height = TARGET_H;

            // Target canonical marker positions on the leveled A4 canvas
            const m_L = TARGET_W * 0.056;
            const m_R = TARGET_W * 0.944;
            const m_T = TARGET_H * 0.038;
            const m_B = TARGET_H * 0.962;

            const dstRectCorners = [
                { x: m_L, y: m_T },
                { x: m_R, y: m_T },
                { x: m_R, y: m_B },
                { x: m_L, y: m_B }
            ];

            // Perspective Transform Matrix H (dst -> src)
            const H_mat = getPerspectiveTransform(dstRectCorners, corners);

            // Read source frame pixels
            const srcImgData = previewCtx.getImageData(0, 0, W, H);
            const src32 = new Uint32Array(srcImgData.data.buffer);

            // Create target rectified image
            const dstImgData = resultCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF; // White border outside sheet
                    }
                    dstIdx++;
                }
            }

            resultCtx.putImageData(dstImgData, 0, 0);

            // Pause video to conserve battery/CPU, keep stream alive
            video.pause();

            // Evaluate sheet on the leveled, rectified canvas
            evaluateLeveledSheet(resultCtx, TARGET_W, TARGET_H, m_L, m_T, m_R - m_L, m_B - m_T);

            // Switch to Results View
            document.getElementById('viewfinderSection').style.display = 'none';
            document.getElementById('resultsSection').style.display = 'block';
        }

        // Evaluate bubbles on the flat, leveled A4 sheet
        // High-Precision Core-Based Bubble & Roll Number Evaluator
        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (y * W + x) * 4;
                return (data[idx] * 77 + data[idx + 1] * 150 + data[idx + 2] * 29) >> 8;
            }

            function sampleCircle(cx, cy, r) {
                let sum = 0, count = 0;
                for (let dy = -r; dy <= r; dy++) {
                    for (let dx = -r; dx <= r; dx++) {
                        if (dx * dx + dy * dy <= r * r) {
                            sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            // 1. DETECT 8-DIGIT ROLL NUMBER FROM ROLL NUMBER GRID
            const U_ROLL_START = 1386.5 / 2235.0;
            const V_ROLL_START = 191.0 / 3261.0;
            const U_ROLL_COL_STEP = 59.5 / 2235.0;
            const V_ROLL_ROW_STEP = 59.5 / 3261.0;
            const rollRadius = Math.max(6, Math.round(Math.min(W, H) * 0.0065));
            const rollCoreRadius = Math.max(3, Math.round(rollRadius * 0.55));

            let detectedRollNumber = '';
            let rollDigitsArray = [];
            let detectedDigitsCount = 0;

            for (let c = 0; c < 8; c++) {
                const colX = markerL + (U_ROLL_START + c * U_ROLL_COL_STEP) * markerW;
                const paperVal = sampleCircle(colX - 12, markerT + V_ROLL_START * markerH, 4);

                let colStats = [];
                for (let d = 0; d < 10; d++) {
                    const rowY = markerT + (V_ROLL_START + d * V_ROLL_ROW_STEP) * markerH;

                    let bestX = colX, bestY = rowY, minVal = 999;
                    for (let dy of [-2, 0, 2]) {
                        for (let dx of [-2, 0, 2]) {
                            const val = sampleCircle(colX + dx, rowY + dy, Math.round(rollRadius * 0.5));
                            if (val < minVal) {
                                minVal = val;
                                bestX = colX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    const coreMean = sampleCircle(bestX, bestY, rollCoreRadius);
                    const coreDarkness = paperVal - coreMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -rollRadius; dy <= rollRadius; dy++) {
                        for (let dx = -rollRadius; dx <= rollRadius; dx++) {
                            if (dx * dx + dy * dy <= rollRadius * rollRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 25)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    colStats.push({
                        digit: d,
                        coreDarkness: coreDarkness,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                colStats.sort((a, b) => b.coreDarkness - a.coreDarkness);
                const top1 = colStats[0];
                const top2 = colStats[1];

                // Detect filled roll number digit via relative contrast & darkness
                let isColFilled = false;
                if ((top1.coreDarkness >= 22 && (top1.coreDarkness - top2.coreDarkness >= 12)) || top1.coreDarkness >= 48) {
                    isColFilled = true;
                }

                const detectedDigit = isColFilled ? top1.digit.toString() : '-';
                if (isColFilled) detectedDigitsCount++;
                detectedRollNumber += detectedDigit;
                rollDigitsArray.push({
                    digit: detectedDigit,
                    isFilled: isColFilled,
                    chosen: isColFilled ? top1 : null
                });

                // Draw roll number grid overlays on canvas
                for (let d = 0; d < 10; d++) {
                    const stat = colStats.find(s => s.digit === d);
                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, rollRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(2, Math.round(W * 0.0018));

                    if (isColFilled && d === top1.digit) {
                        ctx.strokeStyle = '#06B6D4';
                        ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        ctx.fill();
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                    }
                    ctx.stroke();
                }
            }

            // Update Roll Number UI Display
            const rollBoxesEl = document.getElementById('rollBoxesDisplay');
            if (rollBoxesEl) {
                let rollBoxesHtml = '';
                for (let c = 0; c < 8; c++) {
                    const item = rollDigitsArray[c];
                    if (item.isFilled) {
                        rollBoxesHtml += '<div class="roll-digit-box filled">' + item.digit + '</div>';
                    } else {
                        rollBoxesHtml += '<div class="roll-digit-box unknown">-</div>';
                    }
                }
                rollBoxesEl.innerHTML = rollBoxesHtml;
            }
            const rollStatusPill = document.getElementById('rollStatusPill');
            if (rollStatusPill) {
                if (detectedDigitsCount === 8) {
                    rollStatusPill.textContent = '✓ 8/8 DIGITS DETECTED';
                    rollStatusPill.style.background = 'rgba(16, 185, 129, 0.2)';
                    rollStatusPill.style.color = '#34D399';
                    rollStatusPill.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                } else if (detectedDigitsCount > 0) {
                    rollStatusPill.textContent = detectedDigitsCount + '/8 DIGITS DETECTED';
                    rollStatusPill.style.background = 'rgba(245, 158, 11, 0.2)';
                    rollStatusPill.style.color = '#FBBF24';
                    rollStatusPill.style.borderColor = 'rgba(245, 158, 11, 0.4)';
                } else {
                    rollStatusPill.textContent = 'NO ROLL NO DETECTED';
                    rollStatusPill.style.background = 'rgba(100, 116, 139, 0.2)';
                    rollStatusPill.style.color = '#94A3B8';
                    rollStatusPill.style.borderColor = 'rgba(100, 116, 139, 0.3)';
                }
            }

            // 2. DETECT QUESTIONS & MULTIPLE MARKINGS (ACCURATE RELATIVE CONTRAST DISCRIMINATION)
            const bubbleRadius = Math.max(7, Math.round(Math.min(W, H) * 0.007));
            const bubbleCoreRadius = Math.max(3, Math.round(bubbleRadius * 0.55));
            let score = 0;
            let correctCount = 0;
            let wrongCount = 0;
            let multipleCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let evaluatedKeyCount = 0;
            let rowsHtml = '';

            for (let q = 1; q <= totalPaperQuestions; q++) {
                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                // Exact pixel coordinates on the leveled sheet
                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                // Sample local paper baseline
                const paperVal = sampleCircle(colX - 18, rowY, 6);

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;

                    let bestX = bubbleX, bestY = rowY, minVal = 999;
                    for (let dy of [-3, -1, 0, 1, 3]) {
                        for (let dx of [-3, -1, 0, 1, 3]) {
                            const val = sampleCircle(bubbleX + dx, rowY + dy, 3);
                            if (val < minVal) {
                                minVal = val;
                                bestX = bubbleX + dx;
                                bestY = rowY + dy;
                            }
                        }
                    }

                    // Inner core brightness
                    const coreMean = sampleCircle(bestX, bestY, bubbleCoreRadius);
                    const coreDarkness = paperVal - coreMean;

                    let darkCount = 0, totalCount = 0;
                    for (let dy = -bubbleRadius; dy <= bubbleRadius; dy++) {
                        for (let dx = -bubbleRadius; dx <= bubbleRadius; dx++) {
                            if (dx * dx + dy * dy <= bubbleRadius * bubbleRadius) {
                                totalCount++;
                                if (getGray(Math.round(bestX + dx), Math.round(bestY + dy)) < (paperVal - 25)) {
                                    darkCount++;
                                }
                            }
                        }
                    }
                    const darkRatio = totalCount > 0 ? (darkCount / totalCount) : 0;

                    bubbleStats.push({
                        opt: OPTIONS[b],
                        coreDarkness: coreDarkness,
                        darkRatio: darkRatio,
                        x: bestX,
                        y: bestY
                    });
                }

                const sorted = [...bubbleStats].sort((a, b) => b.coreDarkness - a.coreDarkness);
                const top = sorted[0];
                const second = sorted[1];

                // Detect filled bubbles with relative contrast (accommodates pencil, gel, ballpoint)
                let filledBubbles = [];
                if (top.coreDarkness >= 22) {
                    if (second.coreDarkness >= 20 && (top.coreDarkness - second.coreDarkness < 15 || second.coreDarkness >= 35)) {
                        // Multiple markings detected
                        filledBubbles = [top, second];
                    } else if (top.coreDarkness - second.coreDarkness >= 12 || top.coreDarkness >= 45) {
                        filledBubbles = [top];
                    }
                }

                const isMultiple = filledBubbles.length > 1;
                const detectedAnswer = filledBubbles.map(b => b.opt).join(', ');
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';
                if (correctAns) evaluatedKeyCount++;

                if (isMultiple) {
                    attemptedCount++;
                    wrongCount++;
                    multipleCount++;
                    verdict = 'multiple';
                } else if (filledBubbles.length === 1) {
                    const singleAns = filledBubbles[0].opt;
                    attemptedCount++;
                    if (correctAns && singleAns === correctAns) {
                        score++;
                        correctCount++;
                        verdict = 'correct';
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                    } else {
                        verdict = 'marked';
                    }
                } else {
                    blankCount++;
                }

                // Draw Overlay Rings on the Leveled Cropped Sheet
                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];
                    const isThisBubbleFilled = filledBubbles.some(f => f.opt === opt);

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(3, Math.round(W * 0.002));

                    if (isMultiple && isThisBubbleFilled) {
                        ctx.strokeStyle = '#EF4444';
                        ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        ctx.fill();
                        ctx.stroke();

                        ctx.strokeStyle = '#FFFFFF';
                        ctx.lineWidth = 2;
                        const sz = Math.round(bubbleRadius * 0.5);
                        ctx.beginPath();
                        ctx.moveTo(stat.x - sz, stat.y - sz);
                        ctx.lineTo(stat.x + sz, stat.y + sz);
                        ctx.moveTo(stat.x + sz, stat.y - sz);
                        ctx.lineTo(stat.x - sz, stat.y + sz);
                        ctx.stroke();
                    } else if (isThisBubbleFilled) {
                        if (verdict === 'correct') {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.55)';
                        } else if (verdict === 'wrong') {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        } else {
                            ctx.strokeStyle = '#06B6D4';
                            ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        }
                        ctx.fill();
                        ctx.stroke();
                    } else if (correctAns && opt === correctAns && verdict === 'wrong') {
                        ctx.strokeStyle = '#10B981';
                        ctx.setLineDash([3, 3]);
                        ctx.stroke();
                        ctx.setLineDash([]);
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                        ctx.stroke();
                    }
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Blank';
                let markedCellHtml = '<span style="color:#9CA3AF;">-</span>';

                if (verdict === 'multiple') {
                    badgeClass = 'badge-multiple';
                    verdictText = '❌ Multiple (Invalid)';
                    markedCellHtml = '<strong style="color: #EF4444; font-size:1rem;">' + detectedAnswer + '</strong> <span style="font-size:0.75rem; color:#DC2626; font-weight:700;">(Multi)</span>';
                } else if (verdict === 'correct') {
                    badgeClass = 'badge-correct';
                    verdictText = '✓ Correct';
                    markedCellHtml = '<strong style="color: #10B981; font-size:1rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'wrong') {
                    badgeClass = 'badge-wrong';
                    verdictText = '✗ Wrong';
                    markedCellHtml = '<strong style="color: #EF4444; font-size:1rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'marked') {
                    badgeClass = 'badge-correct';
                    verdictText = 'Marked';
                    markedCellHtml = '<strong style="font-size:1rem;">' + detectedAnswer + '</strong>';
                }

                rowsHtml += '<tr>' +
                    '<td><strong>' + q + '</strong></td>' +
                    '<td>' + markedCellHtml + '</td>' +
                    '<td>' + (correctAns ? '<strong style="color:var(--primary);">' + correctAns + '</strong>' : '<span style="color:#9CA3AF;">-</span>') + '</td>' +
                    '<td><span class="badge ' + badgeClass + '">' + verdictText + '</span></td>' +
                '</tr>';
            }

            // Safe UI Scoreboard Updates
            const safeSetText = (id, text) => {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            const totalGraded = evaluatedKeyCount > 0 ? evaluatedKeyCount : totalPaperQuestions;
            safeSetText('scoreValue', `${score} / ${totalGraded}`);
            const pct = totalGraded > 0 ? Math.round((score / totalGraded) * 100) : 0;
            safeSetText('scorePercentage', `${pct}% Accuracy`);

            safeSetText('statCorrect', correctCount);
            safeSetText('statWrong', wrongCount);
            safeSetText('statMultiple', multipleCount);
            safeSetText('statAttempted', attemptedCount);
            safeSetText('statBlank', blankCount);

            const tbl = document.getElementById('tableBody');
            if (tbl) tbl.innerHTML = rowsHtml;
        }

        function restartScanner() {
            initCamera();
        }

        window.addEventListener('DOMContentLoaded', initCamera);
    </script>
</body>

</html>