<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My OMR Results • Garud OMR</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .student-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1.5rem 1.25rem 4rem 1.25rem;
        }

        /* Clean Light Theme Student Profile Banner */
        .student-profile-banner {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-xs);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .student-profile-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .student-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            color: #FFFFFF;
            font-size: 1.35rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
            flex-shrink: 0;
        }

        .student-name-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .student-name {
            font-size: 1.35rem;
            font-weight: 800;
            margin: 0;
            color: var(--text-main);
            letter-spacing: -0.01em;
        }

        .roll-pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            font-weight: 700;
            background: var(--primary-light);
            color: var(--primary-active);
            border: 1px solid var(--primary-border);
            padding: 3px 10px;
            border-radius: var(--radius-xs);
        }

        .role-pill {
            font-size: 0.68rem;
            font-weight: 700;
            background: #F1F5F9;
            color: #475569;
            padding: 2px 7px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .student-meta-sub {
            font-size: 0.825rem;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .student-stats-ribbon {
            display: flex;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }

        .student-stat-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 90px;
        }

        .student-stat-item .stat-number {
            font-size: 1.45rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            line-height: 1.15;
            color: var(--text-main);
        }

        .student-stat-item .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            font-weight: 600;
        }

        /* Modern Exam Cards */
        .exam-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }

        .exam-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.35rem;
            box-shadow: var(--shadow-xs);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1rem;
            transition: var(--transition-smooth);
        }

        .exam-card:hover {
            border-color: var(--border-hover);
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .exam-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .exam-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 4px 0;
            line-height: 1.3;
        }

        .exam-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .subject-badge {
            font-size: 0.72rem;
            font-weight: 700;
            color: #2563EB;
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            padding: 2px 7px;
            border-radius: 4px;
        }

        .agg-summary {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 0.85rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
        }

        .agg-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
            color: var(--text-muted);
        }

        .agg-score {
            font-size: 1.45rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #1E40AF;
            line-height: 1.15;
            margin-top: 2px;
        }

        .topper-pill {
            font-size: 0.74rem;
            font-weight: 700;
            color: #92400E;
            background: #FEF3C7;
            border: 1px solid #FDE68A;
            padding: 2px 8px;
            border-radius: 4px;
            font-family: 'JetBrains Mono', monospace;
            margin-top: 4px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .sec-stack-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .sec-stack-item {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: var(--radius-xs);
            padding: 7px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .sec-stack-item-total {
            background: #F0FDF4;
            border-color: #BBF7D0;
        }

        .sec-stack-name {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-body);
        }

        .sec-stack-marks {
            font-size: 0.88rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            color: #2563EB;
        }

        .sec-stack-max {
            font-size: 0.74rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .sec-stack-meta {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-variant-numeric: tabular-nums;
            line-height: 1.3;
        }

        .btn-view-omr {
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            color: #FFFFFF;
            border: none;
            border-radius: var(--radius-sm);
            padding: 0.65rem 1rem;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
            transition: all 0.15s ease;
            text-decoration: none;
            width: 100%;
        }

        .btn-view-omr:hover {
            background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
            transform: translateY(-1px);
        }

        /* Full-Page Immersive Modal Dialog (Whole Screen, Zero Space Left) */
        dialog.omr-modal-dialog {
            border: none;
            border-radius: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            max-width: 100vw;
            max-height: 100vh;
            background: #090D16;
            color: var(--text-body);
            box-shadow: none;
            margin: 0;
            inset: 0;
            position: fixed;
            overflow: hidden;
            z-index: 99999;
        }

        dialog.omr-modal-dialog:modal {
            overscroll-behavior: contain;
        }

        dialog.omr-modal-dialog::backdrop {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(8px);
        }

        dialog.omr-modal-dialog[open] {
            display: flex;
            flex-direction: column;
            width: 100vw;
            height: 100vh;
        }

        .omr-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            padding: 0 12px;
            height: 44px;
            min-height: 44px;
            max-height: 44px;
            background: #0F172A;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: #FFFFFF;
            flex-shrink: 0;
            z-index: 10;
        }

        .omr-modal-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            overflow: hidden;
        }

        .omr-modal-header-center {
            display: none;
            align-items: center;
            gap: 3px;
            background: rgba(255, 255, 255, 0.1);
            padding: 2px;
            border-radius: 6px;
        }

        .omr-modal-header-right {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .btn-omr-back {
            background: rgba(255, 255, 255, 0.08);
            color: #F8FAFC;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 4px 10px;
            height: 28px;
            border-radius: var(--radius-xs);
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-omr-back:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
        }

        .btn-omr-tool {
            background: rgba(255, 255, 255, 0.08);
            color: #E2E8F0;
            border: 1px solid rgba(255, 255, 255, 0.14);
            padding: 4px 9px;
            height: 28px;
            border-radius: var(--radius-xs);
            font-size: 0.76rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-omr-tool:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #FFFFFF;
        }

        .omr-tab-pill {
            padding: 3px 10px;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 4px;
            border: none;
            background: transparent;
            color: #94A3B8;
            cursor: pointer;
            transition: var(--transition);
            line-height: 1.4;
        }

        .omr-tab-pill.active {
            background: #2563EB;
            color: #FFFFFF;
            box-shadow: 0 1px 4px rgba(37, 99, 235, 0.4);
        }

        .omr-modal-body {
            padding: 0;
            display: grid;
            grid-template-columns: 50% 50%;
            height: calc(100vh - 44px);
            max-height: calc(100vh - 44px);
            overflow: hidden;
            background: #090D16;
        }

        .omr-stage-pane {
            height: 100%;
            display: flex;
            flex-direction: column;
            background: #070B13;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            position: relative;
            overflow: hidden;
        }

        .omr-stage-viewport {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: auto;
            padding: 14px;
            position: relative;
            touch-action: pan-x pan-y pinch-zoom;
        }

        .omr-preview-frame {
            position: relative;
            max-height: calc(100vh - 125px);
            aspect-ratio: 1000 / 1461;
            width: auto;
            height: 100%;
            background: #FFFFFF;
            border-radius: 6px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.15);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            transition: transform 0.2s ease;
        }

        .omr-preview-frame img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: fill;
            display: block;
            border: none;
            background: #FFFFFF;
        }

        .omr-preview-frame svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 2;
        }

        .omr-stage-footer {
            height: 44px;
            background: #0F172A;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            color: #94A3B8;
            font-size: 0.77rem;
            flex-shrink: 0;
        }

        .omr-zoom-bar {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .btn-zoom {
            background: rgba(255, 255, 255, 0.1);
            color: #CBD5E1;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.72rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-zoom:hover,
        .btn-zoom.active {
            background: #2563EB;
            color: #FFFFFF;
            border-color: #3B82F6;
        }

        .omr-details-pane {
            height: 100%;
            overflow-y: auto;
            background: #F8FAFC;
            color: #1E293B;
            padding: 1.25rem 1.5rem 3rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.15rem;
        }

        /* Scorecard Collapsible Toggle & Light Theme Cards */
        .scorecard-toggle-wrap {
            width: 100%;
        }

        .btn-scorecard-toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            color: var(--text-main);
            font-family: inherit;
            cursor: pointer;
            box-shadow: var(--shadow-xs);
            transition: var(--transition);
        }

        .btn-scorecard-toggle:hover {
            background: var(--surface-subtle);
            border-color: var(--border-hover);
        }

        .scorecard-toggle-badge {
            font-size: 0.8rem;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            background: var(--primary-light);
            color: var(--primary-active);
            padding: 3px 8px;
            border-radius: 4px;
            border: 1px solid var(--primary-border);
        }

        .scorecard-toggle-chevron {
            color: var(--text-muted);
            transition: transform 0.2s ease;
        }

        .omr-scorecard-collapsible {
            display: flex;
            flex-direction: column;
            gap: 1.15rem;
            animation: fadeInDown 0.2s ease;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .omr-hero-banner {
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            border-radius: var(--radius-md);
            padding: 1.15rem 1.35rem;
            color: #0F172A;
            box-shadow: var(--shadow-xs);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .hero-sublabel {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #1E40AF;
            font-weight: 700;
        }

        .aggregate-grand-val {
            font-size: 2rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #1E40AF;
            line-height: 1.15;
            margin-top: 2px;
        }

        .hero-accuracy-val {
            font-size: 1.85rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            color: #059669;
            margin-top: 2px;
        }

        .omr-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .omr-kpi-tile {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 9px 12px;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-sm);
        }

        .omr-kpi-tile .kpi-label {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .omr-kpi-tile .kpi-val {
            font-size: 1.25rem;
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            margin-top: 2px;
            line-height: 1.2;
        }

        .sec-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }

        .sec-card-total {
            background: #F0FDF4;
            border-color: #BBF7D0;
        }

        .sec-title {
            font-weight: 700;
            font-size: 0.88rem;
            color: var(--text-main);
        }

        .sec-range {
            font-size: 0.74rem;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
            font-weight: 500;
            margin-top: 2px;
        }

        .sec-marks {
            width: 100%;
            padding-top: 6px;
            border-top: 1px solid #F1F5F9;
        }

        .sec-marks-val {
            font-weight: 800;
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.05rem;
            color: var(--primary);
        }

        .breakdown-filter-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 4px;
        }

        .filter-pill {
            font-size: 0.74rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid var(--border-color);
            background: #FFFFFF;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-pill:hover,
        .filter-pill.active {
            background: var(--primary);
            color: #FFFFFF;
            border-color: var(--primary);
        }

        .btn-modal-close {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            width: 32px;
            height: 32px;
            border-radius: var(--radius-xs);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 500;
            color: #F8FAFC;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-modal-close:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #FFFFFF;
        }

        /* Responsive Media Queries */
        @media (max-width: 960px) {
            .omr-modal-header-center {
                display: flex !important;
            }

            .omr-modal-body {
                display: flex;
                flex-direction: column;
                grid-template-columns: none;
                height: calc(100vh - 44px);
                max-height: calc(100vh - 44px);
                overflow: hidden;
            }

            .omr-stage-pane {
                width: 100%;
                height: 100%;
                min-height: 0;
                flex: 1;
                border-right: none;
            }

            .omr-stage-viewport {
                padding: 8px 6px;
                overflow: auto;
                -webkit-overflow-scrolling: touch;
            }

            .omr-preview-frame {
                width: 100%;
                max-width: min(100%, 480px);
                height: auto;
                max-height: 100%;
                min-height: 380px;
                aspect-ratio: 1000 / 1461;
                margin: auto;
            }

            .omr-details-pane {
                width: 100%;
                height: 100%;
                padding: 1rem 0.85rem 3rem 0.85rem;
            }

            .omr-stage-pane.mobile-tab-hidden,
            .omr-details-pane.mobile-tab-hidden {
                display: none !important;
            }
        }

        @media (max-width: 640px) {
            .student-container {
                padding: 1rem 0.75rem 3rem 0.75rem;
            }

            .exam-grid {
                grid-template-columns: 1fr;
            }

            .student-profile-banner {
                padding: 1rem;
            }

            .student-stats-ribbon {
                gap: 12px;
                width: 100%;
                justify-content: space-between;
            }

            .student-stat-item {
                min-width: 0;
            }

            .omr-modal-header {
                padding: 0 8px;
                height: 42px;
                min-height: 42px;
                max-height: 42px;
                gap: 6px;
            }

            .btn-omr-back .back-text {
                display: none;
            }

            .omr-kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar_start', { activeNav: 'student' }) %>

    <%
        const totalExams = (results && Array.isArray(results)) ? results.length : 0;
        let sumAccuracy = 0;
        let bestScore = 0;
        let bestTotal = 0;
        let totalAttempted = 0;

        if (totalExams > 0) {
            results.forEach(item => {
                sumAccuracy += (Number(item.percentage) || 0);
                const sumSec = item.allSectionsSummary || {};
                const obMarks = sumSec.obtainedMarks !== undefined ? sumSec.obtainedMarks : ((item.aggregateMarks !== undefined) ? item.aggregateMarks : (item.score * 4));
                const totMarks = sumSec.totalMarks !== undefined ? sumSec.totalMarks : (item.maxMarks || ((item.totalQuestions || 50) * 4));
                if (obMarks > bestScore) {
                    bestScore = obMarks;
                    bestTotal = totMarks;
                }
                const att = sumSec.attemptedQuestions !== undefined ? sumSec.attemptedQuestions : Math.max(0, (item.totalQuestions || 0) - (item.blankCount || 0));
                totalAttempted += att;
            });
        }
        const avgAccuracy = totalExams > 0 ? (sumAccuracy / totalExams).toFixed(0) : 0;
    %>

    <div class="student-container">
        <!-- Student Overview Profile Ribbon -->
        <header class="student-profile-banner">
            <div class="student-profile-info">
                <div class="student-avatar" aria-hidden="true">
                    <%= (currentUser.fullName || currentUser.username || 'S')[0].toUpperCase() %>
                </div>
                <div>
                    <div class="student-name-row">
                        <h1 class="student-name"><%= currentUser.fullName || currentUser.username %></h1>
                        <% if (targetRoll) { %>
                            <span class="roll-pill">Roll: <%= targetRoll %></span>
                        <% } %>
                        <span class="role-pill"><%= (currentUser.role || 'student').toUpperCase() %></span>
                    </div>
                    <div class="student-meta-sub">
                        Student Performance & OMR Evaluation Portal
                    </div>
                </div>
            </div>

            <div class="student-stats-ribbon">
                <div class="student-stat-item">
                    <span class="stat-number"><%= totalExams %></span>
                    <span class="stat-label">Evaluated Tests</span>
                </div>
                <div class="student-stat-item">
                    <span class="stat-number" style="color: #059669;"><%= avgAccuracy %>%</span>
                    <span class="stat-label">Avg Accuracy</span>
                </div>
                <div class="student-stat-item">
                    <span class="stat-number" style="color: #2563EB;"><%= bestScore %> <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted);">/ <%= bestTotal || 300 %></span></span>
                    <span class="stat-label">Top Score</span>
                </div>
                <div class="student-stat-item">
                    <span class="stat-number" style="color: #7C3AED;"><%= totalAttempted %></span>
                    <span class="stat-label">Questions Attempted</span>
                </div>
            </div>
        </header>

        <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'teacher')) { %>
            <div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: #FFFFFF;">
                <search>
                    <form action="/student" method="GET" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <label for="lookupRoll" style="font-weight: 700; font-size: 0.875rem; color: var(--text-main);">
                            Lookup Student Roll Number:
                        </label>
                        <input type="text"
                               id="lookupRoll"
                               name="roll"
                               class="form-control"
                               value="<%= targetRoll || '' %>"
                               placeholder="e.g. 01234567"
                               autocorrect="off"
                               autocapitalize="none"
                               spellcheck="false"
                               style="max-width: 240px;">
                        <button type="submit" class="btn btn-primary btn-sm">Preview Student Results</button>
                    </form>
                </search>
            </div>
        <% } %>

        <% if (results && results.length > 0) { %>
            <div class="exam-grid">
                <% results.forEach(item => { %>
                    <%
                        const scannedDate = new Date(item.submitted_at || item.scannedAt || Date.now());
                        const agg = item.aggregateMarks !== undefined ? item.aggregateMarks : (item.score * 4);
                        const maxM = item.maxMarks || ((item.totalQuestions || 50) * 4);
                        const sumSec = item.allSectionsSummary || {
                            totalMarks: maxM,
                            obtainedMarks: agg,
                            totalQuestions: item.totalQuestions || 0,
                            attemptedQuestions: Math.max(0, (item.totalQuestions || 0) - (item.blankCount || 0)),
                            unattemptedQuestions: item.blankCount || 0,
                            correctCount: item.correctCount || 0,
                            wrongCount: item.wrongCount || 0
                        };
                        const pId = String(item.paper_id || item.paperId || '');
                        const pStats = (typeof paperTopperStats !== 'undefined' && paperTopperStats && paperTopperStats[pId]) ? paperTopperStats[pId] : null;
                    %>
                    <article class="exam-card">
                        <div>
                            <div class="exam-header">
                                <div>
                                    <h2 class="exam-title"><%= item.paperTitle %></h2>
                                    <div class="exam-meta">
                                        <span class="subject-badge"><%= item.paperSubject || 'General' %></span>
                                        <span>&middot;</span>
                                        <span><%= scannedDate.toLocaleDateString() %></span>
                                    </div>
                                </div>
                                <span class="pill <%= item.percentage >= 60 ? 'pill-success' : (item.percentage >= 35 ? 'pill-warning' : 'pill-danger') %>">
                                    <%= item.percentage %>% Accuracy
                                </span>
                            </div>

                            <div class="agg-summary" style="margin: 1rem 0; flex-wrap: wrap;">
                                <div>
                                    <div class="agg-label">Obtained Score</div>
                                    <div class="agg-score">
                                        <%= sumSec.obtainedMarks %> <span style="font-size: 0.88rem; font-weight: 500; color: var(--text-muted);">/ <%= sumSec.totalMarks %></span>
                                    </div>
                                    <% if (pStats && pStats.highestOverall !== undefined) { %>
                                        <div>
                                            <span class="topper-pill" title="Highest marks scored across all candidates for this exam">
                                                🏆 Paper Highest: <%= pStats.highestOverall %> / <%= sumSec.totalMarks %>
                                            </span>
                                        </div>
                                    <% } %>
                                </div>
                                <div style="text-align: right; font-size: 0.8rem;">
                                    <div style="font-weight: 700; font-family: 'JetBrains Mono', monospace; color: var(--text-main);">
                                        <%= sumSec.attemptedQuestions %> / <%= sumSec.totalQuestions %> Att
                                    </div>
                                    <div style="color: var(--text-muted); margin-top: 2px;">
                                        Unatt: <strong style="color: var(--text-body);"><%= sumSec.unattemptedQuestions %></strong> &middot;
                                        <span style="color: var(--success-hover); font-weight: 600;"><%= sumSec.correctCount %>C</span> &middot;
                                        <span style="color: var(--danger); font-weight: 600;"><%= sumSec.wrongCount %>W</span>
                                    </div>
                                </div>
                            </div>

                            <% if (item.sectionWise && item.sectionWise.length > 0) { %>
                                <div class="sec-stack-list">
                                    <% item.sectionWise.forEach(s => { %>
                                        <%
                                            const secUnatt = s.unattempted !== undefined ? s.unattempted : (s.blank || 0);
                                            const secTotalQ = s.totalQuestions !== undefined ? s.totalQuestions : ((s.correct || 0) + (s.wrong || 0) + secUnatt);
                                            const secAtt = s.attempted !== undefined ? s.attempted : Math.max(0, secTotalQ - secUnatt);
                                            const secHighestObj = (pStats && pStats.sectionHighest) ? pStats.sectionHighest[s.sectionName] : null;
                                            const secHighestVal = secHighestObj ? secHighestObj.highest : null;
                                        %>
                                        <div class="sec-stack-item">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                                <div class="sec-stack-name">
                                                    <%= s.sectionName %>
                                                    <% if (s.range && !s.range.includes('MCQ') && !s.range.includes('NVQ')) { %>
                                                        <span style="font-weight: 500; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;">(<%= s.range %>)</span>
                                                    <% } %>
                                                </div>
                                                <% if (secHighestVal !== null && secHighestVal !== undefined) { %>
                                                    <span style="font-size: 0.72rem; font-weight: 700; color: #065F46; background: #D1FAE5; border: 1px solid #A7F3D0; padding: 1px 6px; border-radius: 4px; font-family: 'JetBrains Mono', monospace;" title="Highest marks scored in <%= s.sectionName %> across all candidates">
                                                        Top: <%= secHighestVal %>/<%= s.maxMarks %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="sec-stack-marks"><%= s.marks %> <span class="sec-stack-max">/ <%= s.maxMarks %> marks</span></div>
                                            <div class="sec-stack-meta">
                                                Total: <strong><%= secTotalQ %></strong> &middot;
                                                Att: <strong><%= secAtt %></strong> &middot;
                                                Unatt: <strong><%= secUnatt %></strong>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>

                        <button type="button"
                                class="btn-view-omr"
                                onclick="openStudentOmrModal('<%= item._id %>')">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <span>View Evaluated OMR Sheet</span>
                        </button>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                </div>
                <h3 style="margin-bottom: 0.4rem;">No evaluated OMR sheets found</h3>
                <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto; font-size: 0.9rem;">
                    <% if (targetRoll) { %>
                        No OMR submissions have been uploaded yet for roll number <strong><%= targetRoll %></strong>.
                    <% } else { %>
                        No roll number is assigned to this account. Contact your exam administrator.
                    <% } %>
                </p>
            </div>
        <% } %>
    </div>

    <!-- Checked OMR Copy Full-Page Modal Dialog -->
    <dialog id="omrModal" class="omr-modal-dialog" closedby="any" aria-labelledby="modalRollNo">
        <header class="omr-modal-header">
            <div class="omr-modal-header-left">
                <button type="button" class="btn-omr-back" onclick="closeStudentOmrModal()" title="Close OMR view">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span class="back-text">Back</span>
                </button>
                <span class="roll-badge" id="modalRollNo" style="font-size: 0.8rem; padding: 2px 8px; background: #0284C7; color: #FFFFFF; border: none; font-weight: 700; border-radius: 4px; font-family: 'JetBrains Mono', monospace; white-space: nowrap;">ROLL</span>
                <span class="aggregate-badge" id="modalAggregateText" style="font-size: 0.82rem; padding: 2px 8px; background: #059669; color: #FFFFFF; border: 1px solid #10B981; font-weight: 700; border-radius: 999px; white-space: nowrap;">0 / 0</span>
            </div>

            <div class="omr-modal-header-center" id="omrMobileNav">
                <button type="button" class="omr-tab-pill active" id="tabMobileOmr" onclick="setMobileModalTab('omr')">Sheet</button>
                <button type="button" class="omr-tab-pill" id="tabMobileBreakdown" onclick="setMobileModalTab('breakdown')">Marks</button>
            </div>

            <div class="omr-modal-header-right">
                <button type="button" id="toggleOverlayBtn" class="btn-omr-tool" onclick="toggleCheckingOverlay()" title="Toggle live check marks overlay">
                    Marks: ON
                </button>
                <a id="modalOpenFullBtn" href="#" target="_blank" class="btn-omr-tool" title="Open full resolution photo in new tab">
                    Photo &#8599;
                </a>
                <button type="button" class="btn-modal-close" onclick="closeStudentOmrModal()" aria-label="Close modal">&times;</button>
            </div>
        </header>

        <div class="omr-modal-body">
            <!-- Left: Full-Height OMR Sheet Stage with Centered Canvas & Live Checking Overlay -->
            <div class="omr-stage-pane">
                <div class="omr-stage-viewport">
                    <div class="omr-preview-frame">
                        <img id="modalOmrImg" src="" alt="Evaluated OMR Sheet"
                            onerror="this.onerror=null; document.getElementById('modalCloudInfo').textContent='Image preview unavailable or blocked';">
                        <svg id="modalOmrOverlay" viewBox="0 0 1000 1461" preserveAspectRatio="none"></svg>
                    </div>
                </div>
                <div class="omr-stage-footer">
                    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font-size: 0.76rem; font-weight: 600;">
                        <span><span style="color: #10B981;">&#9679;</span> Correct (+4)</span>
                        <span><span style="color: #EF4444;">&#9679;</span> Wrong (-1)</span>
                        <span><span style="color: #10B981;">&#9676;</span> Key</span>
                        <span><span style="color: #06B6D4;">&#9679;</span> Roll</span>
                    </div>
                    <div class="omr-zoom-bar">
                        <span style="font-size: 0.72rem; color: #94A3B8; margin-right: 3px; font-weight: 600;">Zoom:</span>
                        <button type="button" class="btn-zoom active" id="btnZoom1" onclick="setOmrModalZoom(1, this)">1×</button>
                        <button type="button" class="btn-zoom" id="btnZoom15" onclick="setOmrModalZoom(1.5, this)">1.5×</button>
                        <button type="button" class="btn-zoom" id="btnZoom2" onclick="setOmrModalZoom(2, this)">2×</button>
                    </div>
                    <div id="modalCloudInfo" style="color: #64748B; font-size: 0.73rem;">
                        Stored on Cloudinary
                    </div>
                </div>
            </div>

            <!-- Right: Performance & Breakdown Dashboard -->
            <div class="omr-details-pane">
                <!-- Collapsible Score & Performance Toggle Bar (Hidden by Default) -->
                <div class="scorecard-toggle-wrap">
                    <button type="button" class="btn-scorecard-toggle" id="btnScorecardToggle" onclick="toggleStudentScorecardVisibility()">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: #2563EB;">
                                <path d="M18 20V10"></path>
                                <path d="M12 20V4"></path>
                                <path d="M6 20v-6"></path>
                            </svg>
                            <span id="scorecardToggleLabel" style="font-weight: 700; font-size: 0.88rem;">Show Score & Subject Performance</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="scorecard-toggle-badge" id="scorecardToggleSummaryBadge">0 / 0</span>
                            <svg class="scorecard-toggle-chevron" id="scorecardToggleChevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </button>
                </div>

                <!-- Collapsible Scorecard Breakdown Content (HIDDEN BY DEFAULT) -->
                <div id="modalScorecardCollapsible" class="omr-scorecard-collapsible" style="display: none;">
                    <!-- Hero Banner (Light Theme) -->
                    <div class="omr-hero-banner">
                        <div>
                            <div class="hero-sublabel">
                                Total Obtained Score
                            </div>
                            <div class="aggregate-grand-val" id="modalGrandAggregate">
                                0 / 0
                            </div>
                            <div style="font-size: 0.78rem; color: #475569; margin-top: 6px; font-variant-numeric: tabular-nums;" id="modalAllSectionsStats">
                                Total: 0 Qs &middot; Attempted: 0 &middot; Unattempted: 0
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div class="hero-sublabel">
                                Overall Accuracy
                            </div>
                            <div class="hero-accuracy-val" id="modalAccuracyText">
                                0%
                            </div>
                        </div>
                    </div>

                    <!-- KPI Tiles Grid -->
                    <div class="omr-kpi-grid">
                        <div class="omr-kpi-tile">
                            <span class="kpi-label">Attempted</span>
                            <span class="kpi-val" id="kpiAttempted" style="color: #2563EB;">0</span>
                        </div>
                        <div class="omr-kpi-tile">
                            <span class="kpi-label">Correct (+4)</span>
                            <span class="kpi-val" id="kpiCorrect" style="color: #059669;">0</span>
                        </div>
                        <div class="omr-kpi-tile">
                            <span class="kpi-label">Wrong (-1)</span>
                            <span class="kpi-val" id="kpiWrong" style="color: #DC2626;">0</span>
                        </div>
                        <div class="omr-kpi-tile">
                            <span class="kpi-label">Unattempted</span>
                            <span class="kpi-val" id="kpiBlank" style="color: #64748B;">0</span>
                        </div>
                    </div>

                    <!-- Subject/Section Breakdown Section -->
                    <div>
                        <h4 style="margin: 0 0 10px 0; font-size: 0.94rem; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: #2563EB;">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            Subject Performance
                        </h4>
                        <div id="modalSectionContainer" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;"></div>
                    </div>
                </div>

                <!-- Question Breakdown Table Section -->
                <div style="display: flex; flex-direction: column; gap: 8px; flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        <h4 style="margin: 0; font-size: 0.94rem; font-weight: 700; color: #0F172A;">
                            Question-by-Question Breakdown
                        </h4>
                        <div class="breakdown-filter-bar">
                            <button type="button" class="filter-pill active" data-filter="all" onclick="filterModalBreakdown('all')">
                                All (<span id="filterCountAll">0</span>)
                            </button>
                            <button type="button" class="filter-pill" data-filter="correct" onclick="filterModalBreakdown('correct')">
                                Correct (<span id="filterCountCorrect">0</span>)
                            </button>
                            <button type="button" class="filter-pill" data-filter="wrong" onclick="filterModalBreakdown('wrong')">
                                Wrong (<span id="filterCountWrong">0</span>)
                            </button>
                            <button type="button" class="filter-pill" data-filter="blank" onclick="filterModalBreakdown('blank')">
                                Blank (<span id="filterCountBlank">0</span>)
                            </button>
                        </div>
                    </div>

                    <div style="max-height: 420px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #FFFFFF; box-shadow: var(--shadow-sm);">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.825rem; text-align: center; font-variant-numeric: tabular-nums;">
                            <thead>
                                <tr style="background: #F1F5F9; border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 1; color: var(--text-muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em;">
                                    <th style="padding: 9px 8px; font-weight: 700;" id="thSubjectCol">Subject</th>
                                    <th style="padding: 9px 8px; font-weight: 700;">Q#</th>
                                    <th style="padding: 9px 8px; font-weight: 700;">Student Response</th>
                                    <th style="padding: 9px 8px; font-weight: 700;">Official Key</th>
                                    <th style="padding: 9px 8px; font-weight: 700;">Marks</th>
                                    <th style="padding: 9px 8px; font-weight: 700;">Verdict</th>
                                </tr>
                            </thead>
                            <tbody id="modalBreakdownBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </dialog>

    <script>
        const studentSubmissions = <%- JSON.stringify(results || []).replace(/</g, '\\u003c') %>;
        const paperTopperStats = <%- JSON.stringify(typeof paperTopperStats !== 'undefined' ? paperTopperStats : {}).replace(/</g, '\\u003c') %>;
        const submissionsById = {};
        studentSubmissions.forEach(s => {
            if (s && s._id) submissionsById[String(s._id)] = s;
        });

        function parseKeyOptionsClient(keyStr) {
            if (!keyStr || typeof keyStr !== 'string') return [];
            const trimmed = keyStr.trim().toUpperCase();
            if (trimmed === 'BONUS' || trimmed === '*' || trimmed === 'ALL' || trimmed.includes('BONUS')) {
                return ['BONUS'];
            }
            if (trimmed.includes(',') || trimmed.includes('/') || trimmed.includes(';') || trimmed.includes(' ')) {
                return trimmed.split(/[,/;\s]+/).map(s => s.trim().toUpperCase()).filter(Boolean);
            }
            if (trimmed.length > 1 && /^[ABCD]+$/.test(trimmed)) {
                return trimmed.split('');
            }
            return [trimmed];
        }

        function evaluateClientQuestionVerdict(marked, officialKey, isJee = false) {
            const key = (officialKey || '').trim().toUpperCase();
            const resp = (marked || '').trim().toUpperCase();
            const posMarks = isJee ? 4 : 1;
            const posMarksStr = isJee ? '+4' : '+1';
            const negMarks = isJee ? -1 : 0;
            const negMarksStr = isJee ? '-1' : '0';

            // 1. Bonus Question: Full positive marks to all students
            if (key === 'BONUS' || key === '*' || key === 'ALL' || key.includes('BONUS')) {
                return {
                    verdict: 'bonus',
                    marks: posMarksStr,
                    scoreDelta: posMarks,
                    isCorrect: true,
                    isWrong: false,
                    isBlank: (!resp || resp === '-' || resp === 'BLANK'),
                    isBonus: true
                };
            }

            // 2. Blank / Unmarked
            if (!resp || resp === '-' || resp === 'BLANK') {
                return {
                    verdict: 'blank',
                    marks: '0',
                    scoreDelta: 0,
                    isCorrect: false,
                    isWrong: false,
                    isBlank: true,
                    isBonus: false
                };
            }

            // 3. No Key Set yet
            if (!key || key === '-') {
                return {
                    verdict: 'marked',
                    marks: posMarksStr,
                    scoreDelta: posMarks,
                    isCorrect: true,
                    isWrong: false,
                    isBlank: false,
                    isBonus: false
                };
            }

            // 4. Multi-option or single-option key check
            const validKeys = parseKeyOptionsClient(key);
            const markedOpts = resp.split(/[,/;\s]+/).map(s => s.trim().toUpperCase()).filter(Boolean);

            const allMarkedValid = markedOpts.length > 0 && markedOpts.every(o => validKeys.includes(o));
            const singleMarkedValid = markedOpts.length === 1 && validKeys.includes(markedOpts[0]);

            if (allMarkedValid || singleMarkedValid) {
                return {
                    verdict: 'correct',
                    marks: posMarksStr,
                    scoreDelta: posMarks,
                    isCorrect: true,
                    isWrong: false,
                    isBlank: false,
                    isBonus: false
                };
            }

            // Student marked multiple bubbles, at least one is wrong
            if (markedOpts.length > 1) {
                return {
                    verdict: 'multiple',
                    marks: negMarksStr,
                    scoreDelta: negMarks,
                    isCorrect: false,
                    isWrong: true,
                    isBlank: false,
                    isBonus: false
                };
            }

            // Single wrong option marked
            return {
                verdict: 'wrong',
                marks: negMarksStr,
                scoreDelta: negMarks,
                isCorrect: false,
                isWrong: true,
                isBlank: false,
                isBonus: false
            };
        }

        let currentModalItem = null;
        let currentModalList = [];
        let showCheckingOverlay = true;
        let currentFilterVerdict = 'all';

        const omrModalDialog = document.getElementById('omrModal');
        if (omrModalDialog && !('closedBy' in HTMLDialogElement.prototype)) {
            const outside = (e, d) => {
                const r = d.getBoundingClientRect();
                return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
            };
            let downOutside = false;
            omrModalDialog.addEventListener('pointerdown', e => { downOutside = outside(e, omrModalDialog); });
            omrModalDialog.addEventListener('pointerup', e => { if (downOutside && outside(e, omrModalDialog)) omrModalDialog.close(); });
        }

        const OMR_GEOMETRY = {
            TARGET_W: 1000,
            TARGET_H: 1461,
            U_START: 0.061846,
            V_START: 0.256331,
            U_BUBBLE_STEP: 0.028042,
            V_ROW_STEP: 0.018233,
            U_COL_STEP: 0.201332,
            QUESTIONS_PER_COL: 40,
            OPTIONS: ['A', 'B', 'C', 'D'],
            BUBBLE_R: 9.0,
            U_ROLL_START: 0.619879,
            V_ROLL_START: 0.058644,
            U_ROLL_COL_STEP: 0.026640,
