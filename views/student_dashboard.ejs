                padding: 10px 14px;
                display: flex;
                flex-direction: column;
                gap: 4px;
                box-shadow: 0 1px 2px rgba(0,0,0,0.04);
            `;

                        const head = document.createElement('div');
                        head.style.cssText = 'display:flex; justify-content:space-between; align-items:center;';

                        const title = document.createElement('div');
                        title.style.cssText = `font-weight:700; font-size:0.86rem; color:${opts.isTotal ? '#15803D' : '#1E293B'};`;
                        title.textContent = opts.title;

                        const marks = document.createElement('div');
                        marks.style.cssText = `font-weight:800; font-family:"JetBrains Mono",monospace; font-size:1.05rem; color:${opts.isTotal ? '#15803D' : '#2563EB'};`;
                        marks.innerHTML = `${opts.obtainedMarks} <span style="font-size:0.72rem; font-weight:600; color:#64748B;">/ ${opts.totalMarks}</span>`;

                        head.appendChild(title);
                        head.appendChild(marks);

                        const meta = document.createElement('div');
                        meta.style.cssText = 'font-size:0.73rem; color:#64748B; line-height:1.35; font-variant-numeric:tabular-nums;';
                        meta.textContent = opts.metaText;

                        card.appendChild(head);
                        card.appendChild(meta);

                        if (opts.topScore !== undefined && opts.topScore !== null) {
                            const topBadge = document.createElement('div');
                            topBadge.style.cssText = 'font-size:0.72rem; font-weight:700; color:#065F46; background:#D1FAE5; border:1px solid #A7F3D0; padding:2px 7px; border-radius:4px; font-family:"JetBrains Mono",monospace; width:fit-content; margin-top:3px;';
                            topBadge.textContent = `🏆 Paper Top: ${opts.topScore}/${opts.totalMarks}`;
                            card.appendChild(topBadge);
                        }

                        container.appendChild(card);
                    }

                    function filterModalBreakdown(verdict) {
                        currentFilterVerdict = verdict;
                        document.querySelectorAll('.filter-pill').forEach(p => {
                            if (p.getAttribute('data-filter') === verdict) {
                                p.classList.add('active');
                            } else {
                                p.classList.remove('active');
                            }
                        });
                        renderModalBreakdownTable();
                    }

                    function renderModalBreakdownTable() {
                        const tbody = document.getElementById('modalBreakdownBody');
                        if (!tbody) return;
                        tbody.innerHTML = '';

                        const list = currentModalList || [];
                        const data = currentModalItem || {};
                        const isJee = (data.examType === 'jee') ||
                            (data.exam_type === 'jee') ||
                            (data.numericalScores && Object.keys(data.numericalScores).length > 0) ||
                            (data.mcqSubjectScores && Object.keys(data.mcqSubjectScores).length > 0) ||
                            /jee/i.test(data.paperTitle || '') ||
                            /jee/i.test(data.paperSubject || '');

                        const thSub = document.getElementById('thSubjectCol');
                        if (thSub) thSub.style.display = isJee ? '' : 'none';

                        let cAll = 0, cCor = 0, cWro = 0, cBla = 0;
                        list.forEach(q => {
                            cAll++;
                            if (q.verdict === 'correct' || q.verdict === 'bonus') cCor++;
                            else if (q.verdict === 'wrong' || q.verdict === 'multiple') cWro++;
                            else cBla++;
                        });

                        const cntAll = document.getElementById('filterCountAll');
                        if (cntAll) cntAll.textContent = cAll;
                        const cntCor = document.getElementById('filterCountCorrect');
                        if (cntCor) cntCor.textContent = cCor;
                        const cntWro = document.getElementById('filterCountWrong');
                        if (cntWro) cntWro.textContent = cWro;
                        const cntBla = document.getElementById('filterCountBlank');
                        if (cntBla) cntBla.textContent = cBla;

                        const filtered = list.filter(b => {
                            if (currentFilterVerdict === 'correct') return b.verdict === 'correct' || b.verdict === 'bonus';
                            if (currentFilterVerdict === 'wrong') return (b.verdict === 'wrong' || b.verdict === 'multiple');
                            if (currentFilterVerdict === 'blank') return (b.verdict === 'blank' || b.verdict === 'unmarked');
                            return true;
                        });

                        if (filtered.length > 0) {
                            filtered.forEach(b => {
                                const tr = document.createElement('tr');
                                tr.style.borderBottom = '1px solid #F1F5F9';
                                let vColor = '#64748B';
                                let vBg = '#F1F5F9';
                                let vText = 'Blank';
                                let qMarksText = (b.marks !== undefined) ? b.marks : '0';
                                let qMarksColor = '#64748B';

                                if (b.verdict === 'bonus') {
                                    vColor = '#92400E'; vBg = '#FEF3C7'; vText = '★ BONUS'; if (b.marks === undefined) qMarksText = isJee ? '+4' : '+1'; qMarksColor = '#D97706';
                                } else if (b.verdict === 'correct') {
                                    vColor = '#15803D'; vBg = '#DCFCE7'; vText = 'Correct'; if (b.marks === undefined) qMarksText = isJee ? '+4' : '+1'; qMarksColor = '#15803D';
                                } else if (b.verdict === 'wrong') {
                                    vColor = '#DC2626'; vBg = '#FEE2E2'; vText = 'Wrong'; if (b.marks === undefined) qMarksText = isJee ? '-1' : '0'; qMarksColor = '#DC2626';
                                } else if (b.verdict === 'multiple') {
                                    vColor = '#B91C1C'; vBg = '#FEE2E2'; vText = 'Multiple'; if (b.marks === undefined) qMarksText = isJee ? '-1' : '0'; qMarksColor = '#B91C1C';
                                } else if (b.verdict === 'marked') {
                                    vColor = '#1D4ED8'; vBg = '#DBEAFE'; vText = 'Recorded';
                                }

                                if (isJee) {
                                    const tdSub = document.createElement('td');
                                    tdSub.style.cssText = 'padding:8px 6px; font-weight:700; font-size:0.75rem; color:#475569;';
                                    tdSub.textContent = b.subject || '-';
                                    tr.appendChild(tdSub);
                                }

                                const tdQ = document.createElement('td');
                                tdQ.style.cssText = 'padding:8px 6px; font-weight:700; font-family:"JetBrains Mono",monospace; color:#475569;';
                                tdQ.textContent = 'Q' + (b.displayQ || b.q);

                                const tdMarked = document.createElement('td');
                                tdMarked.style.cssText = 'padding:8px 6px; font-weight:700; font-family:"JetBrains Mono",monospace; color:var(--text-main);';
                                tdMarked.textContent = b.marked || '—';

                                const tdKey = document.createElement('td');
                                tdKey.style.cssText = 'padding:8px 6px; font-weight:700; color:#1D4ED8; font-family:"JetBrains Mono",monospace;';
                                const cKeyStr = String(b.correctKey || '-').trim();
                                if (cKeyStr.toUpperCase() === 'BONUS') {
                                    tdKey.innerHTML = '<span style="color:#D97706; font-weight:800;">★ BONUS</span>';
                                } else {
                                    tdKey.textContent = cKeyStr;
                                }

                                const tdMarks = document.createElement('td');
                                tdMarks.style.cssText = `padding:8px 6px; font-weight:700; font-family:"JetBrains Mono",monospace; color:${qMarksColor};`;
                                tdMarks.textContent = qMarksText;

                                const tdVerdict = document.createElement('td');
                                tdVerdict.style.cssText = 'padding:8px 6px;';
                                const vPill = document.createElement('span');
                                vPill.style.cssText = `display:inline-block; padding:2px 8px; border-radius:999px; font-size:0.72rem; font-weight:700; color:${vColor}; background:${vBg};`;
                                vPill.textContent = vText;
                                tdVerdict.appendChild(vPill);

                                tr.appendChild(tdQ);
                                tr.appendChild(tdMarked);
                                tr.appendChild(tdKey);
                                tr.appendChild(tdMarks);
                                tr.appendChild(tdVerdict);
                                tbody.appendChild(tr);
                            });
                        } else {
                            tbody.innerHTML = '<tr><td colspan="6" style="padding:24px; text-align:center; color:var(--text-muted);">No questions match the selected filter.</td></tr>';
                        }
                    }

                    function openStudentOmrModal(id) {
                        const data = submissionsById[String(id)];
                        if (!data) return;

                        currentModalItem = data;
                        const roll = data.rollnumber || data.rollNumber || 'UNKNOWN';
                        const imgUrl = data.cloudinary_image_url || data.omrImageUrl || '';
                        const sumSec = getSubmissionTotals(data);
                        const pct = data.percentage !== undefined ? data.percentage : (data.totalQuestions > 0 ? Math.round((data.score / data.totalQuestions) * 100) : 0);
                        const pId = String(data.paper_id || data.paperId || '');
                        const pStats = (typeof paperTopperStats !== 'undefined' && paperTopperStats) ? paperTopperStats[pId] : null;

                        document.getElementById('modalRollNo').textContent = roll;
                        const titleEl = document.getElementById('modalPaperTitle');
                        if (titleEl) titleEl.textContent = data.paperTitle || 'Exam Sheet';
                        const aggEl = document.getElementById('modalAggregateText');
                        if (aggEl) aggEl.textContent = `${sumSec.obtainedMarks} / ${sumSec.totalMarks}`;
                        const scoreTextEl = document.getElementById('modalScoreText');
                        if (scoreTextEl) scoreTextEl.textContent = `${sumSec.attemptedQuestions} / ${sumSec.totalQuestions} Att · ${sumSec.unattemptedQuestions} Unatt`;

                        // Reset Scorecard Collapsible by default (Hidden)
                        const coll = document.getElementById('modalScorecardCollapsible');
                        if (coll) coll.style.display = 'none';
                        const lbl = document.getElementById('scorecardToggleLabel');
                        if (lbl) lbl.textContent = 'Show Score & Subject Performance';
                        const chev = document.getElementById('scorecardToggleChevron');
                        if (chev) chev.style.transform = 'rotate(0deg)';

                        const badge = document.getElementById('scorecardToggleSummaryBadge');
                        if (badge) {
                            badge.textContent = `${sumSec.obtainedMarks} / ${sumSec.totalMarks} (${pct}%)`;
                        }

                        // Populate KPI elements
                        const elAtt = document.getElementById('kpiAttempted');
                        if (elAtt) elAtt.textContent = sumSec.attemptedQuestions;
                        const elCor = document.getElementById('kpiCorrect');
                        if (elCor) elCor.textContent = sumSec.correctCount;
                        const elWro = document.getElementById('kpiWrong');
                        if (elWro) elWro.textContent = sumSec.wrongCount;
                        const elBla = document.getElementById('kpiBlank');
                        if (elBla) elBla.textContent = sumSec.unattemptedQuestions;

                        // Populate Rank elements
                        const rankVal = data.rank;
                        const totalCand = data.totalCandidates;
                        const rankBadgeEl = document.getElementById('modalRankBadge');
                        const heroRankEl = document.getElementById('modalHeroRankBadge');
                        const heroRankValEl = document.getElementById('modalHeroRankVal');
                        const tileRankWrap = document.getElementById('tileRankWrap');
                        const kpiRankEl = document.getElementById('kpiRank');

                        if (rankVal) {
                            const rankText = totalCand ? `Rank #${rankVal} / ${totalCand}` : `Rank #${rankVal}`;
                            if (rankBadgeEl) {
                                rankBadgeEl.style.display = 'inline-flex';
                                rankBadgeEl.textContent = rankText;
                                if (rankVal === 1) {
                                    rankBadgeEl.className = 'rank-badge rank-badge-top1';
                                } else if (rankVal <= 3) {
                                    rankBadgeEl.className = 'rank-badge rank-badge-top3';
                                } else {
                                    rankBadgeEl.className = 'rank-badge';
                                }
                            }
                            if (heroRankEl && heroRankValEl) {
                                heroRankEl.style.display = 'inline-flex';
                                heroRankValEl.textContent = rankText;
                            }
                            if (tileRankWrap && kpiRankEl) {
                                tileRankWrap.style.display = 'flex';
                                kpiRankEl.textContent = totalCand ? `#${rankVal} / ${totalCand}` : `#${rankVal}`;
                            }
                        } else {
                            if (rankBadgeEl) rankBadgeEl.style.display = 'none';
                            if (heroRankEl) heroRankEl.style.display = 'none';
                            if (tileRankWrap) tileRankWrap.style.display = 'none';
                        }

                        const grandAggEl = document.getElementById('modalGrandAggregate');
                        if (grandAggEl) {
                            if (pStats && pStats.highestOverall !== undefined) {
                                grandAggEl.innerHTML = `${sumSec.obtainedMarks} / ${sumSec.totalMarks} <span style="display:inline-block; font-size:0.75rem; background:#FEF3C7; color:#92400E; border:1px solid #FDE68A; padding:2px 8px; border-radius:4px; font-weight:700; margin-left:8px;">🏆 Top: ${pStats.highestOverall}</span>`;
                            } else {
                                grandAggEl.textContent = `${sumSec.obtainedMarks} / ${sumSec.totalMarks}`;
                            }
                        }

                        const allStatsEl = document.getElementById('modalAllSectionsStats');
                        if (allStatsEl) {
                            allStatsEl.textContent = `Total: ${sumSec.totalQuestions} Qs · Attempted: ${sumSec.attemptedQuestions} · Unattempted: ${sumSec.unattemptedQuestions} · ${sumSec.correctCount}C · ${sumSec.wrongCount}W`;
                        }
                        document.getElementById('modalAccuracyText').textContent = `${pct}%`;

                        document.getElementById('modalOmrImg').src = imgUrl;
                        document.getElementById('modalOpenFullBtn').href = imgUrl || '#';

                        const accName = data.cloudinary_account || data.cloudinaryAccount;
                        document.getElementById('modalCloudInfo').textContent = accName
                            ? `Stored on Cloudinary (${accName})`
                            : 'Stored on Cloudinary';

                        const secContainer = document.getElementById('modalSectionContainer');
                        secContainer.innerHTML = '';
                        if (data.sectionWise && data.sectionWise.length > 0) {
                            data.sectionWise.forEach(s => {
                                const secUnatt = s.unattempted !== undefined ? (Number(s.unattempted) || 0) : (Number(s.blank) || 0);
                                const secTotalQ = s.totalQuestions !== undefined ? (Number(s.totalQuestions) || 0) : ((Number(s.correct) || 0) + (Number(s.wrong) || 0) + secUnatt);
                                const secAtt = s.attempted !== undefined ? (Number(s.attempted) || 0) : Math.max(0, secTotalQ - secUnatt);
                                const secTopObj = (pStats && pStats.sectionHighest) ? pStats.sectionHighest[s.sectionName] : null;
                                const secTopVal = secTopObj ? secTopObj.highest : null;
                                let secTitle = s.sectionName || '';
                                if (s.range && !s.range.includes('MCQ') && !s.range.includes('NVQ')) {
                                    secTitle += ` (${s.range})`;
                                }
                                appendSectionSummaryCard(secContainer, {
                                    isTotal: false,
                                    title: secTitle,
                                    metaText: `Total: ${secTotalQ} · Att: ${secAtt} · Unatt: ${secUnatt} · ${s.correct || 0}C · ${s.wrong || 0}W`,
                                    obtainedMarks: s.marks || 0,
                                    totalMarks: s.maxMarks || (secTotalQ * 4),
                                    topScore: secTopVal
                                });
                            });
                            appendSectionSummaryCard(secContainer, {
                                isTotal: true,
                                title: 'All Sections (Sum)',
                                metaText: `Total: ${sumSec.totalQuestions} · Att: ${sumSec.attemptedQuestions} · Unatt: ${sumSec.unattemptedQuestions} · ${sumSec.correctCount}C · ${sumSec.wrongCount}W`,
                                obtainedMarks: sumSec.obtainedMarks,
                                totalMarks: sumSec.totalMarks,
                                topScore: (pStats && pStats.highestOverall !== undefined) ? pStats.highestOverall : null
                            });
                        } else {
                            secContainer.innerHTML = '<span style="color:var(--text-muted); font-size:0.84rem;">No sections configured</span>';
                        }

                        const keyObj = data.answerKeyLookup || {};
                        const resps = Array.isArray(data.responses) ? data.responses : [];
                        const isJee = (data.examType === 'jee') ||
                            (data.exam_type === 'jee') ||
                            (data.numericalScores && Object.keys(data.numericalScores).length > 0) ||
                            (data.mcqSubjectScores && Object.keys(data.mcqSubjectScores).length > 0) ||
                            /jee/i.test(data.paperTitle || '') ||
                            /jee/i.test(data.paperSubject || '');

                        let list = [];
                        if (data.breakdown && Array.isArray(data.breakdown) && data.breakdown.length > 0) {
                            // Map stored breakdown with live answerKey to evaluate bonus and multi-correct options dynamically
                            list = data.breakdown.map(item => {
                                if (!item || item.isNumerical) return item;
                                const omrQ = Number(item.omrQ);
                                const dispQ = Number(item.displayQ || item.q);
                                const activeKey = keyObj[omrQ] || keyObj[String(omrQ)] || keyObj[dispQ] || keyObj[String(dispQ)] || item.correctKey;
                                const ev = evaluateClientQuestionVerdict(item.marked, activeKey, isJee);
                                return {
                                    ...item,
                                    correctKey: activeKey || item.correctKey || '-',
                                    verdict: ev.verdict,
                                    marks: ev.marks
                                };
                            });
                        } else if (isJee) {
                            // Section 1: Physics Q1-20
                            for (let qNum = 1; qNum <= 20; qNum++) {
                                const resp = resps[qNum - 1] || '';
                                const correctKey = keyObj[qNum] || keyObj[String(qNum)] || '-';
                                const ev = evaluateClientQuestionVerdict(resp, correctKey, true);
                                list.push({
                                    q: qNum,
                                    displayQ: qNum,
                                    omrQ: qNum,
                                    subject: '⚛️ Phy',
                                    marked: resp || '',
                                    correctKey: correctKey,
                                    marks: ev.marks,
                                    verdict: ev.verdict,
                                    isNumerical: false
                                });
                            }

                            // Section 1: Physics Q21-25 (NVQ)
                            const phyNvq = (data.numericalScores && data.numericalScores.phy) || [];
                            for (let i = 1; i <= 5; i++) {
                                const qNum = 20 + i;
                                const val = Number(phyNvq[i - 1] || 0);
                                let verdict = 'blank';
                                let marks = '0';
                                let markedText = 'Blank';
                                if (val === 4) { verdict = 'correct'; marks = '+4'; markedText = '+4 (Correct)'; }
                                else if (val === -1) { verdict = 'wrong'; marks = '-1'; markedText = '-1 (Wrong)'; }
                                list.push({
                                    q: qNum,
                                    displayQ: qNum,
                                    omrQ: null,
                                    subject: '⚛️ Phy',
                                    marked: markedText,
                                    correctKey: 'NVQ',
                                    marks: marks,
                                    verdict: verdict,
                                    isNumerical: true
                                });
                            }

                            // Section 2: Chemistry Q26-45
                            for (let omrQ = 41; omrQ <= 60; omrQ++) {
                                const displayQ = 26 + (omrQ - 41);
                                const resp = resps[omrQ - 1] || '';
                                const correctKey = keyObj[omrQ] || keyObj[String(omrQ)] || keyObj[displayQ] || keyObj[String(displayQ)] || '-';
                                const ev = evaluateClientQuestionVerdict(resp, correctKey, true);
                                list.push({
                                    q: displayQ,
                                    displayQ: displayQ,
                                    omrQ: omrQ,
                                    subject: '🧪 Chem',
                                    marked: resp || '',
                                    correctKey: correctKey,
                                    marks: ev.marks,
                                    verdict: ev.verdict,
                                    isNumerical: false
                                });
                            }

                            // Section 2: Chemistry Q46-50 (NVQ)
                            const chemNvq = (data.numericalScores && data.numericalScores.chem) || [];
                            for (let i = 1; i <= 5; i++) {
                                const qNum = 45 + i;
                                const val = Number(chemNvq[i - 1] || 0);
                                let verdict = 'blank';
                                let marks = '0';
                                let markedText = 'Blank';
                                if (val === 4) { verdict = 'correct'; marks = '+4'; markedText = '+4 (Correct)'; }
                                else if (val === -1) { verdict = 'wrong'; marks = '-1'; markedText = '-1 (Wrong)'; }
                                list.push({
                                    q: qNum,
                                    displayQ: qNum,
                                    omrQ: null,
                                    subject: '🧪 Chem',
                                    marked: markedText,
                                    correctKey: 'NVQ',
                                    marks: marks,
                                    verdict: verdict,
                                    isNumerical: true
                                });
                            }

                            // Section 3: Mathematics Q51-70
                            for (let omrQ = 81; omrQ <= 100; omrQ++) {
                                const displayQ = 51 + (omrQ - 81);
                                const resp = resps[omrQ - 1] || '';
                                const correctKey = keyObj[omrQ] || keyObj[String(omrQ)] || keyObj[displayQ] || keyObj[String(displayQ)] || '-';
                                const ev = evaluateClientQuestionVerdict(resp, correctKey, true);
                                list.push({
                                    q: displayQ,
                                    displayQ: displayQ,
                                    omrQ: omrQ,
                                    subject: '📐 Math',
                                    marked: resp || '',
                                    correctKey: correctKey,
                                    marks: ev.marks,
                                    verdict: ev.verdict,
                                    isNumerical: false
                                });
                            }

                            // Section 3: Mathematics Q71-75 (NVQ)
                            const mathNvq = (data.numericalScores && data.numericalScores.math) || [];
                            for (let i = 1; i <= 5; i++) {
                                const qNum = 70 + i;
                                const val = Number(mathNvq[i - 1] || 0);
                                let verdict = 'blank';
                                let marks = '0';
                                let markedText = 'Blank';
                                if (val === 4) { verdict = 'correct'; marks = '+4'; markedText = '+4 (Correct)'; }
                                else if (val === -1) { verdict = 'wrong'; marks = '-1'; markedText = '-1 (Wrong)'; }
                                list.push({
                                    q: qNum,
                                    displayQ: qNum,
                                    omrQ: null,
                                    subject: '📐 Math',
                                    marked: markedText,
                                    correctKey: 'NVQ',
                                    marks: marks,
                                    verdict: verdict,
                                    isNumerical: true
                                });
                            }
                        } else {
                            const qTotal = Math.max(resps.length, data.totalQuestions || 0);
                            for (let i = 0; i < qTotal; i++) {
                                const qNum = i + 1;
                                const resp = resps[i];
                                const correctKey = keyObj[qNum] || keyObj[String(qNum)] || '-';
                                const ev = evaluateClientQuestionVerdict(resp, correctKey, false);
                                list.push({
                                    q: qNum,
                                    displayQ: qNum,
                                    marked: resp || '',
                                    correctKey,
                                    marks: ev.marks,
                                    verdict: ev.verdict,
                                    isNumerical: false
                                });
                            }
                        }

                        currentModalList = list;
                        renderOmrOverlay(data, list);

                        currentFilterVerdict = 'all';
                        document.querySelectorAll('.filter-pill').forEach(p => {
                            if (p.getAttribute('data-filter') === 'all') p.classList.add('active');
                            else p.classList.remove('active');
                        });
                        renderModalBreakdownTable();

                        setMobileModalTab('omr');
                        setOmrModalZoom(1);

                        if (omrModalDialog) {
                            if (typeof omrModalDialog.showModal === 'function') {
                                try {
                                    omrModalDialog.showModal();
                                } catch (e) {
                                    omrModalDialog.setAttribute('open', '');
                                }
                            } else {
                                omrModalDialog.setAttribute('open', '');
                            }
                        }
                    }

                    function closeStudentOmrModal() {
                        if (omrModalDialog) {
                            if (typeof omrModalDialog.close === 'function') {
                                try {
                                    omrModalDialog.close();
                                } catch (e) {
                                    omrModalDialog.removeAttribute('open');
                                }
                            } else {
                                omrModalDialog.removeAttribute('open');
                            }
                        }
                        setOmrModalZoom(1);
                        currentModalItem = null;
                    }
                </script>
                <%- include('partials/sidebar_end') %>
</body>

</html>