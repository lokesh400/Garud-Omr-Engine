<%
    const _navActive = (typeof activeNav !== 'undefined' && activeNav) ? activeNav : '';
    const _user = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    const _isAdmin = _user && _user.role === 'admin';
    const _homeUrl = _isAdmin ? '/' : '/student';
    const _displayName = _user ? (_user.fullName || _user.username || 'User') : 'Account';
    const _initials = _displayName
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map(w => w[0])
        .join('')
        .toUpperCase() || 'U';
    const _paperCtx = (typeof paper !== 'undefined' && paper && paper._id) ? paper : null;
    const _paperEncodedId = _paperCtx ? encodeURIComponent(_paperCtx._id) : '';
%>
<div class="app-shell">
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

    <aside class="app-sidebar" id="appSidebar" aria-label="Sidebar Navigation">
        <div class="sidebar-header">
            <a href="<%= _homeUrl %>" class="sidebar-brand">
                <span class="sidebar-brand-icon" aria-hidden="true">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                        <line x1="8" y1="8" x2="16" y2="8"></line>
                        <circle cx="9" cy="13" r="1"></circle>
                        <circle cx="15" cy="13" r="1"></circle>
                        <circle cx="9" cy="17" r="1"></circle>
                        <circle cx="15" cy="17" r="1"></circle>
                    </svg>
                </span>
                <span>
                    <span class="sidebar-brand-title" style="display: block;">Garud OMR</span>
                    <span class="sidebar-brand-sub" style="display: block;"><%= _isAdmin ? 'Admin Portal' : 'Student Portal' %></span>
                </span>
            </a>

            <button type="button"
                    class="sidebar-close-btn"
                    id="sidebarCloseBtn"
                    aria-label="Close navigation menu">
                &times;
            </button>
        </div>

        <nav class="sidebar-nav" aria-label="Primary navigation">
            <div>
                <div class="sidebar-group-label"><%= _isAdmin ? 'Workspace' : 'Navigation' %></div>
                <ul class="sidebar-link-list">
                    <% if (_isAdmin) { %>
                        <li>
                            <a href="/" class="sidebar-link" <%- _navActive === 'dashboard' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                                </svg>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a href="/paper/new" class="sidebar-link" <%- _navActive === 'new_paper' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                                <span>Create Paper</span>
                            </a>
                        </li>
                        <li>
                            <a href="/users" class="sidebar-link" <%- _navActive === 'users' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                <span>User Management</span>
                            </a>
                        </li>
                        <li>
                            <a href="/student" class="sidebar-link" <%- _navActive === 'student' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                                </svg>
                                <span>Student Portal</span>
                            </a>
                        </li>
                    <% } else { %>
                        <li>
                            <a href="/student" class="sidebar-link" <%- _navActive === 'student' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                <span>My OMR Results</span>
                            </a>
                        </li>
                    <% } %>

                    <li>
                        <a href="/account" class="sidebar-link" <%- _navActive === 'account' ? 'aria-current="page"' : '' %>>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M20 21a8 8 0 1 0-16 0"></path>
                            </svg>
                            <span>Account Settings</span>
                        </a>
                    </li>
                </ul>
            </div>

            <% if (_isAdmin && _paperCtx) { %>
                <div>
                    <div class="sidebar-group-label" title="<%= _paperCtx.title %>">Paper: <%= _paperCtx.title %></div>
                    <ul class="sidebar-link-list">
                        <li>
                            <a href="/paper/<%= _paperEncodedId %>" class="sidebar-link" <%- _navActive === 'paper_key' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                                </svg>
                                <span>Answer Key</span>
                            </a>
                        </li>
                        <li>
                            <a href="/paper/<%= _paperEncodedId %>/results" class="sidebar-link" <%- _navActive === 'paper_results' ? 'aria-current="page"' : '' %>>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                <span>Results &amp; Copies</span>
                            </a>
                        </li>
                        <li>
                            <a href="/paper/<%= _paperEncodedId %>/omr" target="_blank" rel="noopener" class="sidebar-link">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                    <rect x="6" y="14" width="12" height="8"></rect>
                                </svg>
                                <span>Print OMR</span>
                            </a>
                        </li>
                        <li>
                            <a href="/paper/<%= _paperEncodedId %>/scan" class="sidebar-link">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                                <span>Live Scanner</span>
                            </a>
                        </li>
                    </ul>
                </div>
            <% } %>
        </nav>

        <% if (_user) { %>
            <div class="sidebar-footer">
                <div class="sidebar-user-row">
                    <div class="sidebar-avatar" aria-hidden="true"><%= _initials %></div>
                    <div class="sidebar-user-meta">
                        <div class="sidebar-user-name" title="<%= _displayName %>"><%= _displayName %></div>
                        <div class="sidebar-user-sub">
                            <%= _isAdmin ? ('Admin · @' + _user.username) : ('Roll: ' + (_user.rollnumber || _user.username)) %>
                        </div>
                    </div>
                </div>
                <form action="/logout" method="POST" style="margin: 0;">
                    <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Sign Out
                    </button>
                </form>
            </div>
        <% } %>
    </aside>

    <div class="app-main-col" id="appMainCol">
        <header class="mobile-topbar">
            <div class="mobile-topbar-left">
                <button type="button"
                        class="hamburger-btn"
                        id="mobileMenuBtn"
                        aria-label="Open navigation menu"
                        aria-controls="appSidebar"
                        aria-expanded="false">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <a href="<%= _homeUrl %>" class="mobile-brand-link">
                    <span class="mobile-brand-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                            <line x1="8" y1="8" x2="16" y2="8"></line>
                            <circle cx="9" cy="13" r="1"></circle>
                            <circle cx="15" cy="13" r="1"></circle>
                            <circle cx="9" cy="17" r="1"></circle>
                            <circle cx="15" cy="17" r="1"></circle>
                        </svg>
                    </span>
                    <span class="mobile-brand-text">Garud OMR</span>
                </a>
            </div>
            <div class="mobile-topbar-right">
                <% if (_user) { %>
                    <span class="pill <%= _isAdmin ? 'pill-primary' : 'pill-success' %>">
                        <%= _isAdmin ? 'Admin' : ('Roll: ' + (_user.rollnumber || _user.username)) %>
                    </span>
                <% } %>
            </div>
        </header>

        <div class="app-main-body">

