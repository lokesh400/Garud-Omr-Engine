<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title><%= paper.title %> • JEE Mains Answer Key</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: var(--bg-page);
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .full-screen-container {
            width: 100%;
            max-width: 1360px;
            margin: 0 auto;
            padding: 12px 14px 104px 14px;
            box-sizing: border-box;
        }

        /* Slim Sticky Top Bar */
        .slim-top-bar {
            position: sticky;
            top: 10px;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 10px 16px;
            margin-bottom: 14px;
            box-shadow: var(--shadow-sm);
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            background: #FFFFFF;
            color: var(--text-main);
            text-decoration: none;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 600;
            border: 1px solid var(--border-hover);
            transition: var(--transition);
            flex-shrink: 0;
        }

        .btn-back:hover {
            background: var(--surface-subtle);
            border-color: #94A3B8;
        }

        .page-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .subject-chip {
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.74rem;
            font-weight: 600;
        }

        .code-chip {
            background: var(--surface-subtle);
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
            font-size: 0.74rem;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
        }

        .header-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            color: #1D4ED8;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            font-size: 0.8rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
        }

        /* Section Navigation */
        .section-quick-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
            align-items: center;
        }

        .section-quick-tab {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            text-decoration: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .section-quick-tab:hover {
            border-color: #2563EB;
            color: #1D4ED8;
            background: #EFF6FF;
        }

        .section-divider-banner {
            grid-column: 1 / -1;
            background: #FFFFFF;
            color: var(--text-main);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 14px 0 4px 0;
            border: 1px solid var(--border-color);
            border-left: 5px solid #2563EB;
            scroll-margin-top: 80px;
            box-shadow: var(--shadow-xs);
        }

        .section-divider-banner.chem-banner {
            border-left-color: #059669;
        }

        .section-divider-banner.math-banner {
            border-left-color: #7C3AED;
        }

        .omr-grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
            gap: 10px;
            width: 100%;
            box-sizing: border-box;
        }

        .omr-key-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 9px 12px;
            transition: border-color 150ms ease, background-color 150ms ease;
            user-select: none;
        }

        .omr-key-row:hover {
            border-color: var(--border-hover);
        }

        .omr-key-row.has-val {
            border-color: #BFDBFE;
            background: #F8FAFF;
        }

        .omr-q-badge {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .omr-q-num {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-body);
            min-width: 34px;
            font-variant-numeric: tabular-nums;
        }

        .omr-key-row.has-val .omr-q-num {
            color: #1D4ED8;
        }

        .omr-selected-val {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: var(--radius-xs);
            background: var(--surface-subtle);
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
        }

        .omr-key-row.has-val .omr-selected-val {
            background: #2563EB;
            color: #FFFFFF;
        }

        .omr-bubbles-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .omr-bubble {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1.5px solid var(--border-hover);
            background: #FFFFFF;
            color: var(--text-main);
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 120ms ease;
            user-select: none;
            font-family: 'Inter', sans-serif;
            padding: 0;
        }

        .omr-bubble:hover {
            border-color: #2563EB;
            background: #EFF6FF;
            color: #1D4ED8;
            scale: 1.05;
        }

        .omr-bubble.selected {
            background: #2563EB !important;
            border-color: #1D4ED8 !important;
            color: #FFFFFF !important;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
        }

        /* Floating bottom action bar */
        .floating-action-bar {
            position: fixed;
            bottom: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            background: rgba(15, 23, 42, 0.94);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: var(--radius-full);
            padding: 8px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);
            max-width: calc(100% - 32px);
            box-sizing: border-box;
        }

        .floating-counter {
            color: #E2E8F0;
            font-size: 0.86rem;
            font-weight: 600;
            padding: 0 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
        }

        .floating-counter strong {
            color: #60A5FA;
            font-size: 1rem;
        }

        .btn-floating-clear {
            background: rgba(255, 255, 255, 0.12);
            color: #E2E8F0;
            border: 1px solid rgba(255, 255, 255, 0.20);
            border-radius: var(--radius-full);
            padding: 8px 16px;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'Inter', sans-serif;
        }

        .btn-floating-clear:hover {
            background: rgba(239, 68, 68, 0.25);
            border-color: #EF4444;
            color: #FECACA;
        }

        .btn-floating-save {
            background: #2563EB;
            color: #FFFFFF;
            border: 1px solid #3B82F6;
            border-radius: var(--radius-full);
            padding: 9px 22px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition), scale 100ms ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.40);
        }

        .btn-floating-save:hover {
            background: #1D4ED8;
            scale: 1.02;
        }

        .btn-floating-save:active {
            scale: 0.98;
        }

        .saved-toast {
            background: #F0FDF4;
            border: 1px solid #BBF7D0;
            color: #15803D;
            padding: 10px 16px;
            border-radius: var(--radius-md);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.88rem;
            font-weight: 600;
        }

        @media (max-width: 640px) {
            .omr-grid-container {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .omr-key-row {
                padding: 8px 10px;
            }

            .floating-action-bar {
                bottom: 12px;
                padding: 8px 10px;
                gap: 8px;
                width: calc(100% - 16px);
                justify-content: space-between;
            }

            .floating-counter {
                display: none;
            }

            .btn-floating-clear {
                padding: 9px 12px;
                font-size: 0.82rem;
                flex: 1;
                justify-content: center;
            }

            .btn-floating-save {
                padding: 9px 14px;
                font-size: 0.86rem;
                flex: 1.4;
                justify-content: center;
            }
        }

        @media (min-width: 641px) {
            .omr-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
                gap: 12px;
            }
        }

        @media (min-width: 960px) {
            .floating-action-bar {
                left: calc(50% + (var(--sidebar-width) / 2));
                max-width: calc(100% - var(--sidebar-width) - 32px);
            }
        }
    </style>
</head>
<body>
    <%- include('partials/sidebar_start', { activeNav: 'paper_key', paper: paper }) %>
    <%
        const encodedId = encodeURIComponent(paper._id);
        const JEE_SECTIONS = [
            {
                name: 'Section 1: ⚛️ Physics',
                range: 'Q1 – Q25',
                from: 1,
                to: 20,
                displayFrom: 1,
                displayTo: 20,
                nvqRange: 'Q21 – Q25',
                bannerClass: '',
                badge: '20 MCQs (Q1–Q20) • 80 Max Marks',
                color: '#2563EB'
            },
            {
                name: 'Section 2: 🧪 Chemistry',
                range: 'Q26 – Q50',
                from: 41,
                to: 60,
                displayFrom: 26,
                displayTo: 45,
                nvqRange: 'Q46 – Q50',
                bannerClass: 'chem-banner',
                badge: '20 MCQs (Q26–Q45) • 80 Max Marks',
                color: '#059669'
            },
            {
                name: 'Section 3: 📐 Mathematics',
                range: 'Q51 – Q75',
                from: 81,
                to: 100,
                displayFrom: 51,
                displayTo: 70,
                nvqRange: 'Q71 – Q75',
                bannerClass: 'math-banner',
                badge: '20 MCQs (Q51–Q70) • 80 Max Marks',
                color: '#7C3AED'
            }
        ];

        let jeeKeyedCount = 0;
        const jeeQuestionSet = [];
        JEE_SECTIONS.forEach(s => {
            for (let q = s.from; q <= s.to; q++) {
                jeeQuestionSet.push(q);
                let currentVal = "";
                if (Array.isArray(paper.answer_key) && paper.answer_key.length >= q) {
                    currentVal = paper.answer_key[q - 1] || "";
                } else if (paper.answerKey) {
                    if (typeof paper.answerKey.get === 'function') {
                        currentVal = paper.answerKey.get(String(q)) || "";
                    } else {
                        currentVal = paper.answerKey[String(q)] || "";
                    }
                }
                if (currentVal && currentVal.trim()) jeeKeyedCount++;
            }
        });
    %>

    <div class="full-screen-container">
        <!-- Top Sticky Header -->
        <header class="slim-top-bar">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: wrap;">
                <h1 class="page-title"><%= paper.title %></h1>
                <span class="subject-chip">⚛️ JEE Mains Key</span>
                <% if (paper._id) { %>
                    <span class="code-chip"><%= paper._id %></span>
                <% } %>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <a href="/paper/<%= encodedId %>" class="btn btn-secondary btn-sm" title="View standard answer key with all questions">
                    All Questions View
                </a>
                <a href="/paper/<%= encodedId %>/jee-scan" class="btn btn-secondary btn-sm" style="background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE;" title="Launch Camera Scanner for JEE Mains">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    JEE Scanner
                </a>
                <a href="/paper/<%= encodedId %>/results" class="btn btn-secondary btn-sm" title="View Results & Checked OMR Copies">
                    Results
                </a>
                <div class="header-pill">
                    <span id="headerCounter"><%= jeeKeyedCount %>/60</span>
                </div>
            </div>
        </header>

        <% if (typeof saved !== 'undefined' && saved) { %>
            <div class="saved-toast">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>JEE Mains Answer Key saved successfully! All checked OMR sheets have been regraded.</span>
            </div>
        <% } %>

        <!-- Jump to Section Tabs -->
        <nav class="section-quick-tabs" aria-label="Jump to JEE section">
            <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); margin-right: 4px;">Jump To:</span>
            <a href="#sec_1" class="section-quick-tab">
                <span>⚛️ Physics</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:#2563EB;">Q1–Q25 (MCQ 1–20)</span>
            </a>
            <a href="#sec_41" class="section-quick-tab">
                <span>🧪 Chemistry</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:#059669;">Q26–Q50 (MCQ 26–45)</span>
            </a>
            <a href="#sec_81" class="section-quick-tab">
                <span>📐 Mathematics</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:#7C3AED;">Q51–Q75 (MCQ 51–70)</span>
            </a>
        </nav>

        <!-- Answer Key Form -->
        <form action="/paper/<%= encodedId %>/jee-answerkey" method="POST" id="jeeAnswerKeyForm">
            <div class="omr-grid-container" id="answerGrid">
                <% JEE_SECTIONS.forEach(sec => { %>
                    <!-- Section Divider Banner -->
                    <div class="section-divider-banner <%= sec.bannerClass %>" id="sec_<%= sec.from %>">
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                            <strong style="font-size:0.95rem; color: var(--text-main);"><%= sec.name %></strong>
                            <span style="color: var(--text-muted); font-size:0.8rem; font-family:'JetBrains Mono',monospace;">(<%= sec.range %>)</span>
                        </div>
                        <div style="font-size:0.78rem; font-family:'JetBrains Mono',monospace; font-weight: 700; color: <%= sec.color %>;">
                            <%= sec.badge %>
                        </div>
                    </div>

                    <!-- 20 Question Rows for this section -->
                    <% for(let i = sec.from; i <= sec.to; i++) { %>
                        <%
                            const displayQ = sec.displayFrom + (i - sec.from);
                            let currentVal = "";
                            if (Array.isArray(paper.answer_key) && paper.answer_key.length >= i) {
                                currentVal = paper.answer_key[i - 1] || "";
                            } else if (paper.answerKey) {
                                if (typeof paper.answerKey.get === 'function') {
                                    currentVal = paper.answerKey.get(String(i)) || "";
                                } else {
                                    currentVal = paper.answerKey[String(i)] || "";
                                }
                            }
                        %>
                        <div class="omr-key-row <%= currentVal ? 'has-val' : '' %>" id="row_q<%= i %>">
                            <div class="omr-q-badge">
                                <div style="display:flex; flex-direction:column; line-height:1.15;">
                                    <span class="omr-q-num">Q<%= displayQ %></span>
                                    <% if (sec.from !== sec.displayFrom) { %>
                                        <span style="font-size:0.67rem; color:var(--text-muted); font-family:'JetBrains Mono',monospace;">(OMR Q<%= i %>)</span>
                                    <% } %>
                                </div>
                                <span class="omr-selected-val" id="badge_val_q<%= i %>"><%= currentVal || '-' %></span>
                            </div>
                            <div class="omr-bubbles-wrap" role="group" aria-label="Question <%= displayQ %> options">
                                <% ['A','B','C','D'].forEach(opt => { %>
                                    <button type="button"
                                            class="omr-bubble <%= currentVal === opt ? 'selected' : '' %>"
                                            id="btn_q<%= i %>_<%= opt %>"
                                            data-q="<%= i %>"
                                            data-opt="<%= opt %>"
                                            onclick="selectAnswer('<%= i %>', '<%= opt %>')"
                                            title="Select <%= opt %> for Question <%= displayQ %> (OMR Q<%= i %>)">
                                        <%= opt %>
                                    </button>
                                <% }) %>
                            </div>
                            <input type="hidden" name="q<%= i %>" id="input_q<%= i %>" value="<%= currentVal %>">
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </form>

        <!-- Informational Banner About Section B Numerical Questions -->
        <div style="margin-top: 1.5rem; background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px 18px; display: flex; align-items: flex-start; gap: 12px;">
            <div style="font-size: 1.25rem; line-height: 1;">💡</div>
            <div style="font-size: 0.85rem; color: var(--text-body); line-height: 1.45;">
                <strong>Looking for Section B Numerical Questions?</strong><br>
                Questions <strong>Q21–Q25 (Physics)</strong>, <strong>Q46–Q50 (Chemistry)</strong>, and <strong>Q71–Q75 (Mathematics)</strong> are handwritten numerical value answers on the student's OMR sheet. They are graded directly using the single-tap <code>+4 Correct</code>, <code>-1 Wrong</code>, or <code>0 Blank</code> buttons inside the <a href="/paper/<%= encodedId %>/jee-scan" style="color: #2563EB; font-weight: 700; text-decoration: underline;">JEE Live Scanner</a> or <a href="/paper/<%= encodedId %>/jee-evaluator" style="color: #2563EB; font-weight: 700; text-decoration: underline;">JEE Evaluator</a>.
            </div>
        </div>

        <!-- Floating Bottom Action Bar -->
        <div class="floating-action-bar">
            <div class="floating-counter">
                <span id="floatingCounter"><strong><%= jeeKeyedCount %></strong></span> / 60 Keyed
            </div>
            <button type="button" class="btn-floating-clear" onclick="confirmAndClearAll()" title="Clear all answers on this page">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Clear All
            </button>
            <button type="button" class="btn-floating-save" onclick="confirmAndSaveKey()" title="Save JEE Mains answer key">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                Save JEE Answer Key
            </button>
        </div>
    </div>

    <script>
        const totalJeeQuestions = 60;

        function selectAnswer(qNum, opt) {
            const input = document.getElementById('input_q' + qNum);
            const row = document.getElementById('row_q' + qNum);
            const badge = document.getElementById('badge_val_q' + qNum);
            if (!input) return;

            if (input.value === opt) {
                input.value = '';
                if (badge) badge.textContent = '-';
                if (row) row.classList.remove('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) btn.classList.remove('selected');
                });
            } else {
                input.value = opt;
                if (badge) badge.textContent = opt;
                if (row) row.classList.add('has-val');
                ['A', 'B', 'C', 'D'].forEach(o => {
                    const btn = document.getElementById('btn_q' + qNum + '_' + o);
                    if (btn) {
                        if (o === opt) btn.classList.add('selected');
                        else btn.classList.remove('selected');
                    }
                });
            }

            updateKeyProgress();
        }

        function updateKeyProgress() {
            let count = 0;
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            inputs.forEach(inp => {
                if (inp.value && inp.value.trim() !== '') count++;
            });
            const headerCounter = document.getElementById('headerCounter');
            const floatingCounter = document.getElementById('floatingCounter');
            if (headerCounter) headerCounter.textContent = count + '/60';
            if (floatingCounter) floatingCounter.innerHTML = '<strong>' + count + '</strong>';
        }

        function confirmAndClearAll() {
            if (confirm("Are you sure you want to clear all marked answers for these 60 questions?")) {
                const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
                inputs.forEach(inp => { inp.value = ""; });
                const rows = document.querySelectorAll('.omr-key-row');
                rows.forEach(r => r.classList.remove('has-val'));
                const badges = document.querySelectorAll('.omr-selected-val');
                badges.forEach(b => b.textContent = '-');
                const bubbles = document.querySelectorAll('.omr-bubble');
                bubbles.forEach(b => b.classList.remove('selected'));
                updateKeyProgress();
            }
        }

        function confirmAndSaveKey() {
            const inputs = document.querySelectorAll('#answerGrid input[type="hidden"]');
            let filled = 0;
            inputs.forEach(inp => { if (inp.value && inp.value.trim() !== '') filled++; });

            const msg = filled === 0
                ? "No questions have been marked. Do you want to save an empty JEE answer key?"
                : `Save JEE answer key with ${filled} of 60 questions configured?`;

            if (confirm(msg)) {
                document.getElementById('jeeAnswerKeyForm').submit();
            }
        }
    </script>
    <%- include('partials/sidebar_end') %>
</body>
</html>

