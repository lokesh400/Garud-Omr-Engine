    <script>
        const answerKey = <%- answerKey || '{}' %>;
        const totalPaperQuestions = <%= paper.numQuestions || 50 %>;

        // JEE MAINS SPECIFIC: Only check Q1-20 (Physics), Q41-60 (Chemistry), Q81-100 (Math)
        const JEE_QUESTIONS = [];
        for (let q = 1; q <= 20; q++) JEE_QUESTIONS.push({ q, subject: 'Physics', subKey: 'phy' });
        for (let q = 41; q <= 60; q++) JEE_QUESTIONS.push({ q, subject: 'Chemistry', subKey: 'chem' });
        for (let q = 81; q <= 100; q++) JEE_QUESTIONS.push({ q, subject: 'Mathematics', subKey: 'math' });

        // State for Section B Numerical Questions (5 each for Physics, Chemistry, Math)
        const numericalScores = {
            phy: [0, 0, 0, 0, 0],
            chem: [0, 0, 0, 0, 0],
            math: [0, 0, 0, 0, 0]
        };

        let mcqScores = {
            phy: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
            chem: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
            math: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 }
        };

        function setNvq(subKey, index, marks, btn) {
            numericalScores[subKey][index] = marks;
            const parent = btn.parentElement;
            parent.querySelectorAll('.jee-nvq-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            updateJeeTotals();
        }

        function resetNvqButtons() {
            numericalScores.phy = [0, 0, 0, 0, 0];
            numericalScores.chem = [0, 0, 0, 0, 0];
            numericalScores.math = [0, 0, 0, 0, 0];

            for (let i = 1; i <= 5; i++) {
                ['phy', 'chem', 'math'].forEach(sub => {
                    const group = document.getElementById('nvq_' + sub + '_' + i);
                    if (group) {
                        group.querySelectorAll('.jee-nvq-btn').forEach(b => b.classList.remove('active'));
                        const blankBtn = group.querySelector('.btn-b');
                        if (blankBtn) blankBtn.classList.add('active');
                    }
                });
            }
        }

        function updateJeeTotals() {
            const sumArr = (arr) => arr.reduce((acc, v) => acc + v, 0);
            const phyNvq = sumArr(numericalScores.phy);
            const chemNvq = sumArr(numericalScores.chem);
            const mathNvq = sumArr(numericalScores.math);

            const phyMcqMarks = (mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple;
            const chemMcqMarks = (mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple;
            const mathMcqMarks = (mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple;

            const phyTotal = phyMcqMarks + phyNvq;
            const chemTotal = chemMcqMarks + chemNvq;
            const mathTotal = mathMcqMarks + mathNvq;
            const grandTotal = phyTotal + chemTotal + mathTotal;

            const elPhyMcq = document.getElementById('phyMcqMarks');
            if (elPhyMcq) elPhyMcq.textContent = (phyMcqMarks >= 0 ? '+' : '') + phyMcqMarks;
            const elPhyNvq = document.getElementById('phyNvqMarks');
            if (elPhyNvq) elPhyNvq.textContent = (phyNvq >= 0 ? '+' : '') + phyNvq;
            const elPhyTotal = document.getElementById('phyTotalMarks');
            if (elPhyTotal) elPhyTotal.textContent = phyTotal + '/100';

            const elChemMcq = document.getElementById('chemMcqMarks');
            if (elChemMcq) elChemMcq.textContent = (chemMcqMarks >= 0 ? '+' : '') + chemMcqMarks;
            const elChemNvq = document.getElementById('chemNvqMarks');
            if (elChemNvq) elChemNvq.textContent = (chemNvq >= 0 ? '+' : '') + chemNvq;
            const elChemTotal = document.getElementById('chemTotalMarks');
            if (elChemTotal) elChemTotal.textContent = chemTotal + '/100';

            const elMathMcq = document.getElementById('mathMcqMarks');
            if (elMathMcq) elMathMcq.textContent = (mathMcqMarks >= 0 ? '+' : '') + mathMcqMarks;
            const elMathNvq = document.getElementById('mathNvqMarks');
            if (elMathNvq) elMathNvq.textContent = (mathNvq >= 0 ? '+' : '') + mathNvq;
            const elMathTotal = document.getElementById('mathTotalMarks');
            if (elMathTotal) elMathTotal.textContent = mathTotal + '/100';

            const elPhySum = document.getElementById('phyNvqSummary');
            if (elPhySum) elPhySum.textContent = (phyNvq >= 0 ? '+' : '') + phyNvq + ' Marks';
            const elChemSum = document.getElementById('chemNvqSummary');
            if (elChemSum) elChemSum.textContent = (chemNvq >= 0 ? '+' : '') + chemNvq + ' Marks';
            const elMathSum = document.getElementById('mathNvqSummary');
            if (elMathSum) elMathSum.textContent = (mathNvq >= 0 ? '+' : '') + mathNvq + ' Marks';

            const scoreValEl = document.getElementById('scoreValue');
            if (scoreValEl) scoreValEl.textContent = grandTotal + ' / 300';
            const pct = Math.max(0, Math.round((grandTotal / 300) * 100));
            const pctEl = document.getElementById('scorePercentage');
            if (pctEl) pctEl.textContent = pct + '% Marks (' + grandTotal + '/300)';

            if (window.lastEvaluationData) {
                window.lastEvaluationData.score = grandTotal;
                window.lastEvaluationData.numericalScores = numericalScores;
                window.lastEvaluationData.mcqSubjectScores = {
                    phy: { score: phyMcqMarks, correct: mcqScores.phy.correct, wrong: mcqScores.phy.wrong + mcqScores.phy.multiple, blank: mcqScores.phy.blank },
                    chem: { score: chemMcqMarks, correct: mcqScores.chem.correct, wrong: mcqScores.chem.wrong + mcqScores.chem.multiple, blank: mcqScores.chem.blank },
                    math: { score: mathMcqMarks, correct: mcqScores.math.correct, wrong: mcqScores.math.wrong + mcqScores.math.multiple, blank: mcqScores.math.blank }
                };
            }
        }

        const video = document.getElementById('videoInput');
        const previewCanvas = document.getElementById('canvasPreview');
        const previewCtx = previewCanvas.getContext('2d');
        const resultCanvas = document.getElementById('canvasResult');
        const resultCtx = resultCanvas.getContext('2d');

        const hudChip = document.getElementById('hudChip');
        const hudStatus = document.getElementById('hudStatus');
        const statusDot = document.getElementById('statusDot');
        const captureBtn = document.getElementById('captureBtn');
        const flashScreen = document.getElementById('flashScreen');
        const scanLaser = document.getElementById('scanLaser');

        let cameraStream = null;
        let animationFrameId = null;
        let isCaptured = false;

        // Auto-tracking state
        let smoothedCorners = null;
        let lastRawCorners = null;
        let lockStreak = 0;
        const LOCK_REQUIRED_FRAMES = 6; // ~0.2s steady hold to auto-capture
        let isFrozen = false;
        let frozenCorners = null;

        const lockMeter = document.getElementById('lockMeter');
        const lockMeterFill = document.getElementById('lockMeterFill');
        const freezeBanner = document.getElementById('freezeBanner');

        // Fast analysis downscale canvas
        const fastCanvas = document.createElement('canvas');
        const fastCtx = fastCanvas.getContext('2d');

        // Standardized A4 Leveled Canvas Dimensions
        const TARGET_W = 1000;
        const TARGET_H = 1461; // Exact aspect ratio between corner markers (1042.05 / 713.22)

        // Measured Standard Ratios from Rendered A4 Sheet
        const U_START = 0.061846;
        const V_START = 0.256331;
        const U_BUBBLE_STEP = 0.028042;
        const V_ROW_STEP = 0.018233;
        const U_COL_STEP = 0.201332;
        const QUESTIONS_PER_COL = 40;
        const OPTIONS = ['A', 'B', 'C', 'D'];

        // Roll Number Exact Ratios
        const U_ROLL_START = 0.619879;
        const V_ROLL_START = 0.058644;
        const U_ROLL_COL_STEP = 0.026640;
        const V_ROLL_ROW_STEP = 0.018233;

        async function initCamera() {
            isCaptured = false;
            isFrozen = false;
            frozenCorners = null;
            smoothedCorners = null;
            lastRawCorners = null;
            lockStreak = 0;
            resetNvqButtons();
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            document.getElementById('viewfinderSection').style.display = 'block';
            document.getElementById('resultsSection').style.display = 'none';
            if (freezeBanner) freezeBanner.style.display = 'none';
            scanLaser.style.display = 'block';
            hudStatus.textContent = 'Align paper in view';
            captureBtn.classList.remove('locked');
            captureBtn.innerHTML = 'Capture &amp; Evaluate';

            // Reuse existing active stream if available
            if (cameraStream && cameraStream.active) {
                try {
                    video.srcObject = cameraStream;
                    video.muted = true;
                    await video.play();
                    previewCanvas.width = video.videoWidth || 1280;
                    previewCanvas.height = video.videoHeight || 720;
                    renderLoop();
                    return;
                } catch (e) {
                    console.warn('Reuse stream failed, reopening:', e);
                }
            }

            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }

            let stream = null;
            const constraintsList = [
                { video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false },
                { video: { facingMode: 'environment' }, audio: false },
                { video: { width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false },
                { video: true, audio: false }
            ];

            for (const c of constraintsList) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia(c);
                    if (stream) break;
                } catch (err) { }
            }

            if (!stream) {
                hudStatus.textContent = 'CAMERA ERROR: CAMERA NOT ACCESSIBLE';
                return;
            }

            try {
                cameraStream = stream;
                video.srcObject = cameraStream;
                video.muted = true;
                await video.play();

                previewCanvas.width = video.videoWidth || 1280;
                previewCanvas.height = video.videoHeight || 720;

                renderLoop();
            } catch (err) {
                console.error(err);
                hudStatus.textContent = 'CAMERA ERROR: ' + err.message;
            }
        }

        // Robust 4-corner ordering [TL, TR, BR, BL]
        function orderCorners(pts) {
            if (!pts || pts.length !== 4) return pts;
            let tl = pts[0], br = pts[0], tr = pts[0], bl = pts[0];
            let minSum = pts[0].x + pts[0].y, maxSum = minSum;
            let maxDiff = pts[0].x - pts[0].y, minDiff = maxDiff;

            for (let i = 1; i < pts.length; i++) {
                const p = pts[i];
                const sum = p.x + p.y;
                const diff = p.x - p.y;
                if (sum < minSum) { minSum = sum; tl = p; }
                if (sum > maxSum) { maxSum = sum; br = p; }
                if (diff > maxDiff) { maxDiff = diff; tr = p; }
                if (diff < minDiff) { minDiff = diff; bl = p; }
            }

            const unique = new Set([tl, tr, br, bl]);
            if (unique.size === 4) {
                return [tl, tr, br, bl];
            }

            const cx = (pts[0].x + pts[1].x + pts[2].x + pts[3].x) / 4;
            const cy = (pts[0].y + pts[1].y + pts[2].y + pts[3].y) / 4;
            const sorted = [...pts].map(p => ({
                x: p.x,
                y: p.y,
                angle: Math.atan2(p.y - cy, p.x - cx)
            })).sort((a, b) => a.angle - b.angle);

            let minAngleDiff = Infinity;
            let tlIdx = 0;
            const targetAngle = -2.35619; // -135 deg
            sorted.forEach((p, idx) => {
                let diff = Math.abs(p.angle - targetAngle);
                if (diff > Math.PI) diff = 2 * Math.PI - diff;
                if (diff < minAngleDiff) {
                    minAngleDiff = diff;
                    tlIdx = idx;
                }
            });

            return [
                sorted[tlIdx],
                sorted[(tlIdx + 1) % 4],
                sorted[(tlIdx + 2) % 4],
                sorted[(tlIdx + 3) % 4]
            ].map(p => ({ x: p.x, y: p.y }));
        }

        function getPerspectiveTransform(src, dst) {
            const A = [], B = [];
            for (let i = 0; i < 4; i++) {
                const sx = src[i].x, sy = src[i].y, dx = dst[i].x, dy = dst[i].y;
                A.push([sx, sy, 1, 0, 0, 0, -dx * sx, -dx * sy]); B.push(dx);
                A.push([0, 0, 0, sx, sy, 1, -dy * sx, -dy * sy]); B.push(dy);
            }
            const n = 8;
            for (let i = 0; i < n; i++) {
                let maxRow = i;
                for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[maxRow][i])) maxRow = k;
                [A[i], A[maxRow]] = [A[maxRow], A[i]];[B[i], B[maxRow]] = [B[maxRow], B[i]];
                const pivot = A[i][i];
                if (Math.abs(pivot) < 1e-10) return null;
                for (let j = i; j < n; j++) A[i][j] /= pivot;
                B[i] /= pivot;
                for (let k = 0; k < n; k++) {
                    if (k !== i) {
                        const factor = A[k][i];
                        for (let j = i; j < n; j++) A[k][j] -= factor * A[i][j];
                        B[k] -= factor * B[i];
                    }
                }
            }
            return [B[0], B[1], B[2], B[3], B[4], B[5], B[6], B[7], 1];
        }

        // Live Frame Detection Loop
        function renderLoop() {
            if (isCaptured || isFrozen) return;

            if (video.readyState >= 2) {
                const W = previewCanvas.width;
                const H = previewCanvas.height;
                previewCtx.drawImage(video, 0, 0, W, H);

                // Run fast detector on downscaled canvas (400px width from 59e4b1e)
                const fastW = 400;
                const fastH = Math.max(1, Math.round(H * (fastW / W)));
                fastCanvas.width = fastW;
                fastCanvas.height = fastH;
                fastCtx.drawImage(video, 0, 0, fastW, fastH);

                const detectedRaw = detectLiveCorners(fastCtx, fastW, fastH);

                if (detectedRaw) {
                    const scale = W / fastW;
                    const currentCorners = detectedRaw.map(pt => ({
                        x: pt.x * scale,
                        y: pt.y * scale
                    }));

                    let isSteady = false;
                    if (lastRawCorners) {
                        const maxDelta = Math.max(...currentCorners.map((pt, i) =>
                            Math.hypot(pt.x - lastRawCorners[i].x, pt.y - lastRawCorners[i].y)
                        ));
                        if (maxDelta < 20.0) {
                            isSteady = true;
                        }
                    } else {
                        isSteady = true;
                    }
                    lastRawCorners = currentCorners;

                    if (isSteady) {
                        lockStreak++;
                    } else {
                        lockStreak = Math.max(0, lockStreak - 1);
                    }

                    if (!smoothedCorners) {
                        smoothedCorners = currentCorners;
                    } else {
                        smoothedCorners = smoothedCorners.map((pt, i) => ({
                            x: pt.x * 0.70 + currentCorners[i].x * 0.30,
                            y: pt.y * 0.70 + currentCorners[i].y * 0.30
                        }));
                    }

                    const pct = Math.min(100, Math.round((lockStreak / LOCK_REQUIRED_FRAMES) * 100));

                    hudChip.classList.add('locked');
                    statusDot.className = 'status-dot';
                    statusDot.style.background = '#22C55E';
                    statusDot.style.boxShadow = 'none';
                    hudStatus.textContent = `Corners detected • Auto-capturing (${pct}%)`;

                    if (lockMeter) {
                        lockMeter.classList.add('active');
                        if (lockMeterFill) lockMeterFill.style.width = pct + '%';
                    }

                    captureBtn.classList.add('locked');
                    captureBtn.innerHTML = 'Auto-Capturing...';

                    drawCyberOverlay(previewCtx, smoothedCorners, lockStreak >= LOCK_REQUIRED_FRAMES, pct);

                    // AUTOMATIC CAPTURE WITHOUT TAPPING
                    if (lockStreak >= LOCK_REQUIRED_FRAMES) {
                        snapAndWarpSheet(smoothedCorners);
                        return;
                    }
                } else {
                    lockStreak = Math.max(0, lockStreak - 1);
                    if (lockStreak === 0) {
                        lastRawCorners = null;
                        smoothedCorners = null;
                    }

                    hudChip.classList.remove('locked');
                    statusDot.className = 'status-dot';
                    statusDot.style.background = '#F59E0B';
                    statusDot.style.boxShadow = 'none';
                    hudStatus.textContent = 'Align paper in view';
                    captureBtn.classList.remove('locked');
                    captureBtn.innerHTML = 'Capture &amp; Evaluate';

                    if (lockMeter) {
                        lockMeter.classList.remove('active');
                        if (lockMeterFill) lockMeterFill.style.width = '0%';
                    }

                    if (smoothedCorners) {
                        drawCyberOverlay(previewCtx, smoothedCorners, false, 0);
                    } else {
                        drawFramingGuide(previewCtx, W, H);
                    }
                }
            }

            animationFrameId = requestAnimationFrame(renderLoop);
        }

        // Freeze the scene when corners are recognized
        function freezeScene() {
            if (isFrozen || isCaptured || !smoothedCorners) return;
            isFrozen = true;
            frozenCorners = smoothedCorners.map(p => ({ x: p.x, y: p.y }));

            try { video.pause(); } catch (e) { }
            scanLaser.style.display = 'none';
            drawCyberOverlay(previewCtx, frozenCorners, true, 100);

            hudChip.classList.add('locked');
            statusDot.className = 'status-dot active';
            statusDot.style.background = '#22C55E';
            statusDot.style.boxShadow = 'none';
            hudStatus.textContent = 'Corners locked • Tap screen to compute';

            if (lockMeter) lockMeter.classList.add('active');
            if (lockMeterFill) lockMeterFill.style.width = '100%';

            const freezeBanner = document.getElementById('freezeBanner');
            if (freezeBanner) freezeBanner.style.display = 'block';

            captureBtn.classList.add('locked');
            captureBtn.innerHTML = 'Tap Screen to Compute';
        }

        function unfreezeScene() {
            if (isCaptured) return;
            isFrozen = false;
            frozenCorners = null;
            smoothedCorners = null;
            lastRawCorners = null;
            lockStreak = 0;

            const freezeBanner = document.getElementById('freezeBanner');
            if (freezeBanner) freezeBanner.style.display = 'none';

            scanLaser.style.display = 'block';
            hudChip.classList.remove('locked');
            statusDot.className = 'status-dot';
            statusDot.style.background = '#F59E0B';
            statusDot.style.boxShadow = 'none';
            hudStatus.textContent = 'Align paper in view';
            captureBtn.classList.remove('locked');
            captureBtn.innerHTML = 'Capture &amp; Evaluate';

            if (lockMeter) {
                lockMeter.classList.remove('active');
                if (lockMeterFill) lockMeterFill.style.width = '0%';
            }

            try { video.play(); } catch (e) { }
            if (!animationFrameId) {
                animationFrameId = requestAnimationFrame(renderLoop);
            }
        }

        // High-Precision Solid Corner Detector
        function detectLiveCorners(ctx, sw, sh) {
            const imgData = ctx.getImageData(0, 0, sw, sh);
            const data = imgData.data;
            const total = sw * sh;

            // 1. Grayscale & Histogram
            const gray = new Uint8Array(total);
            const hist = new Int32Array(256);
            let pIdx = 0;
            for (let i = 0; i < data.length; i += 4) {
                const g = (data[i] * 77 + data[i + 1] * 150 + data[i + 2] * 29) >> 8;
                gray[pIdx++] = g;
                hist[g]++;
            }

            // 2. Global Otsu Threshold
            let sum = 0;
            for (let i = 0; i < 256; i++) sum += i * hist[i];
            let sumB = 0, wB = 0, maxVar = 0, thresh = 110;
            for (let i = 0; i < 256; i++) {
                wB += hist[i];
                if (wB === 0) continue;
                const wF = total - wB;
                if (wF === 0) break;
                sumB += i * hist[i];
                const diff = (sumB / wB) - ((sum - sumB) / wF);
                const v = wB * wF * diff * diff;
                if (v > maxVar) { maxVar = v; thresh = i + 1; }
            }
            thresh = Math.max(40, Math.min(thresh, 175));

            // 3. Connected Component Analysis across the frame
            const visited = new Uint8Array(total);
            const candidates = [];
            const queue = new Int32Array(total);

            for (let py = 4; py < sh - 4; py += 2) {
                for (let px = 4; px < sw - 4; px += 2) {
                    const startP = py * sw + px;
                    if (visited[startP] || gray[startP] >= thresh) continue;

                    let count = 0, sumX = 0, sumY = 0;
                    let minX = px, maxX = px, minY = py, maxY = py;
                    let qHead = 0, qTail = 0;
                    queue[qTail++] = startP;
                    visited[startP] = 1;

                    while (qHead < qTail) {
                        if (count > 2500) break;
                        const cur = queue[qHead++];
                        const cy = Math.floor(cur / sw);
                        const cx = cur % sw;
                        count++;
                        sumX += cx;
                        sumY += cy;
                        if (cx < minX) minX = cx;
                        if (cx > maxX) maxX = cx;
                        if (cy < minY) minY = cy;
                        if (cy > maxY) maxY = cy;

                        const neighbors = [cur - 1, cur + 1, cur - sw, cur + sw];
                        for (let k = 0; k < 4; k++) {
                            const nb = neighbors[k];
                            if (nb >= 0 && nb < total && !visited[nb] && gray[nb] < thresh) {
                                visited[nb] = 1;
                                queue[qTail++] = nb;
                            }
                        }
                    }

                    const bw = maxX - minX + 1;
                    const bh = maxY - minY + 1;
                    const aspect = bw / bh;
                    const density = count / (bw * bh);

                    // Solid Square Corner Marker Criteria
                    if (bw >= 5 && bh >= 5 && bw <= 45 && bh <= 45 && aspect >= 0.55 && aspect <= 1.80 && density >= 0.45 && count >= 14 && count <= 900) {
                        const bx = sumX / count;
                        const by = sumY / count;
                        const blobR = Math.max(bw, bh) / 2;

                        // INWARD ISOLATION CHECK
                        const dirX = Math.sign((sw / 2) - bx);
                        const dirY = Math.sign((sh / 2) - by);
                        const rIn = Math.round(blobR * 1.3);
                        const rOut = Math.max(rIn + 3, Math.round(blobR * 2.5));
                        let darkPixels = 0, totalRing = 0;

                        for (let dy = -rOut; dy <= rOut; dy += 2) {
                            for (let dx = -rOut; dx <= rOut; dx += 2) {
                                const d2 = dx * dx + dy * dy;
                                if (d2 >= rIn * rIn && d2 <= rOut * rOut) {
                                    if ((dx * dirX + dy * dirY) >= -0.2 * blobR) {
                                        const gx = Math.round(bx + dx);
                                        const gy = Math.round(by + dy);
                                        if (gx >= 0 && gx < sw && gy >= 0 && gy < sh) {
                                            totalRing++;
                                            if (gray[gy * sw + gx] < thresh) darkPixels++;
                                        }
                                    }
                                }
                            }
                        }

                        const ringDarkRatio = totalRing > 0 ? (darkPixels / totalRing) : 0;
                        if (ringDarkRatio > 0.20) {
                            continue;
                        }

                        // Inward white paper margin check
                        let whiteInwardCount = 0;
                        const testDists = [Math.round(blobR * 1.3), Math.round(blobR * 1.9), Math.round(blobR * 2.5)];
                        for (let d of testDists) {
                            const ix = Math.round(bx + dirX * d);
                            const iy = Math.round(by + dirY * d);
                            if (ix >= 0 && ix < sw && iy >= 0 && iy < sh) {
                                if (gray[iy * sw + ix] >= (thresh - 15)) whiteInwardCount++;
                            }
                        }

                        if (whiteInwardCount < 2) {
                            continue;
                        }

                        const distFromCenter = Math.hypot(bx - sw / 2, by - sh / 2);
                        const score = (density * 3.0) + (distFromCenter / (sw * 0.5) * 2.0) - (ringDarkRatio * 8.0);

                        candidates.push({
                            x: bx,
                            y: by,
                            bw,
                            bh,
                            count,
                            score,
                            density,
                            distFromCenter
                        });
                    }
                }
            }

            if (candidates.length < 4) return null;

            candidates.sort((a, b) => b.score - a.score);
            const topCandidates = candidates.slice(0, 10);
            const n = topCandidates.length;

            let bestQuad = null;

            function evaluateQuadCandidate(ordered) {
                const [pTL, pTR, pBR, pBL] = ordered;

                const pts = [pTL, pTR, pBR, pBL];
                for (let i = 0; i < 4; i++) {
                    const a = pts[i];
                    const b = pts[(i + 1) % 4];
                    const c = pts[(i + 2) % 4];
                    const cross = (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
                    if (cross <= 0) return null;
                }

                const wTop = Math.hypot(pTR.x - pTL.x, pTR.y - pTL.y);
                const wBot = Math.hypot(pBR.x - pBL.x, pBR.y - pBL.y);
                const hLeft = Math.hypot(pBL.x - pTL.x, pBL.y - pTL.y);
                const hRight = Math.hypot(pBR.x - pTR.x, pBR.y - pTR.y);

                const wRatio = Math.min(wTop, wBot) / Math.max(wTop, wBot);
                const hRatio = Math.min(hLeft, hRight) / Math.max(hLeft, hRight);
                if (wRatio < 0.50 || hRatio < 0.50) return null;

                const avgW = (wTop + wBot) / 2;
                const avgH = (hLeft + hRight) / 2;
                const aspect = avgH / avgW;
                if (aspect < 1.00 || aspect > 2.10) return null;

                const d1 = Math.hypot(pBR.x - pTL.x, pBR.y - pTL.y);
                const d2 = Math.hypot(pBL.x - pTR.x, pBL.y - pTR.y);
                if (Math.min(d1, d2) / Math.max(d1, d2) < 0.55) return null;

                const quadArea = 0.5 * Math.abs(
                    (pTL.x * pTR.y - pTL.y * pTR.x) +
                    (pTR.x * pBR.y - pTR.y * pBR.x) +
                    (pBR.x * pBL.y - pBR.y * pBL.x) +
                    (pBL.x * pTL.y - pBL.y * pTL.x)
                );
                if (quadArea < sw * sh * 0.08) return null;

                const counts = [pTL.count, pTR.count, pBR.count, pBL.count];
                const minC = Math.min(...counts);
                const maxC = Math.max(...counts);
                if (minC / maxC < 0.12) return null;

                const aspectDev = Math.abs(aspect - 1.461);
                const score = quadArea * (1.0 - aspectDev * 0.4) * wRatio * hRatio;

                return { ordered, score };
            }

            for (let i = 0; i < n; i++) {
                for (let j = i + 1; j < n; j++) {
                    for (let k = j + 1; k < n; k++) {
                        for (let l = k + 1; l < n; l++) {
                            const quad4 = [topCandidates[i], topCandidates[j], topCandidates[k], topCandidates[l]];
                            const ordered = orderCorners(quad4);
                            if (!ordered) continue;
                            const res = evaluateQuadCandidate(ordered);
                            if (res && (!bestQuad || res.score > bestQuad.score)) {
                                bestQuad = res;
                            }
                        }
                    }
                }
            }

            if (!bestQuad) return null;
            return bestQuad.ordered;
        }

        function drawFramingGuide(ctx, W, H) {
            ctx.save();
            const gw = Math.round(W * 0.65);
            const gh = Math.min(Math.round(H * 0.88), Math.round(gw * 1.414));
            const gx = Math.round((W - gw) / 2);
            const gy = Math.round((H - gh) / 2);

            ctx.strokeStyle = 'rgba(6, 182, 212, 0.35)';
            ctx.lineWidth = 2;
            ctx.setLineDash([8, 8]);
            ctx.strokeRect(gx, gy, gw, gh);
            ctx.setLineDash([]);

            // Framing Corner Brackets
            const cornerLen = Math.min(32, Math.round(gw * 0.08));
            ctx.strokeStyle = '#06B6D4';
            ctx.lineWidth = 3.5;

            // Top-Left
            ctx.beginPath();
            ctx.moveTo(gx, gy + cornerLen);
            ctx.lineTo(gx, gy);
            ctx.lineTo(gx + cornerLen, gy);
            ctx.stroke();

            // Top-Right
            ctx.beginPath();
            ctx.moveTo(gx + gw - cornerLen, gy);
            ctx.lineTo(gx + gw, gy);
            ctx.lineTo(gx + gw, gy + cornerLen);
            ctx.stroke();

            // Bottom-Right
            ctx.beginPath();
            ctx.moveTo(gx + gw, gy + gh - cornerLen);
            ctx.lineTo(gx + gw, gy + gh);
            ctx.lineTo(gx + gw - cornerLen, gy + gh);
            ctx.stroke();

            // Bottom-Left
            ctx.beginPath();
            ctx.moveTo(gx + cornerLen, gy + gh);
            ctx.lineTo(gx, gy + gh);
            ctx.lineTo(gx, gy + gh - cornerLen);
            ctx.stroke();

            // Center Helper Text
            ctx.font = 'bold 13px "Plus Jakarta Sans", sans-serif';
            ctx.fillStyle = 'rgba(6, 182, 212, 0.7)';
            ctx.textAlign = 'center';
            ctx.fillText('ALIGN JEE SHEET IN FRAME', W / 2, gy + gh / 2);

            ctx.restore();
        }

        function drawCyberOverlay(ctx, pts, isLocked, pct) {
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.lineTo(pts[3].x, pts[3].y);
            ctx.closePath();

            const primaryColor = isLocked ? '#10B981' : '#06B6D4';
            const shadowColor = isLocked ? '#10B981' : '#06B6D4';
            const fillColor = isLocked ? 'rgba(16, 185, 129, 0.18)' : 'rgba(6, 182, 212, 0.10)';

            ctx.fillStyle = fillColor;
            ctx.fill();

            ctx.lineWidth = 3.5;
            ctx.strokeStyle = primaryColor;
            ctx.shadowColor = shadowColor;
            ctx.shadowBlur = 14;
            ctx.stroke();

            const cornerLabels = ['TL', 'TR', 'BR', 'BL'];

            pts.forEach((pt, i) => {
                ctx.lineWidth = 2.5;
                ctx.strokeStyle = '#FFFFFF';
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 16, 0, 2 * Math.PI);
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 6, 0, 2 * Math.PI);
                ctx.fillStyle = primaryColor;
                ctx.fill();

                ctx.lineWidth = 2;
                ctx.strokeStyle = primaryColor;
                ctx.beginPath();
                ctx.moveTo(pt.x - 22, pt.y);
                ctx.lineTo(pt.x - 10, pt.y);
                ctx.moveTo(pt.x + 10, pt.y);
                ctx.lineTo(pt.x + 22, pt.y);
                ctx.moveTo(pt.x, pt.y - 22);
                ctx.lineTo(pt.x - 10, pt.y);
                ctx.moveTo(pt.x, pt.y + 10);
                ctx.lineTo(pt.x + 22, pt.y);
                ctx.stroke();

                ctx.font = 'bold 11px "JetBrains Mono", monospace';
                const tag = cornerLabels[i];
                const tagW = ctx.measureText(tag).width + 8;
                const tagH = 16;
                const tagX = i === 0 || i === 3 ? pt.x - tagW - 14 : pt.x + 14;
                const tagY = i === 0 || i === 1 ? pt.y - 12 : pt.y + 16;

                ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
                ctx.fillRect(tagX, tagY - 12, tagW, tagH);
                ctx.strokeStyle = primaryColor;
                ctx.lineWidth = 1;
                ctx.strokeRect(tagX, tagY - 12, tagW, tagH);

                ctx.fillStyle = '#FFFFFF';
                ctx.fillText(tag, tagX + 4, tagY);
            });

            ctx.restore();
        }

        function handleTapToCapture() {
            triggerManualCapture();
        }

        function triggerManualCapture() {
            if (isCaptured) return;

            if (isFrozen && frozenCorners) {
                snapAndWarpSheet(frozenCorners);
                return;
            }

            if (smoothedCorners) {
                snapAndWarpSheet(smoothedCorners);
                return;
            }

            hudStatus.textContent = 'Please align 4 corner dots first';
            setTimeout(() => {
                if (!isFrozen && !isCaptured) hudStatus.textContent = 'Align paper in view';
            }, 1500);
        }

        function playShutter() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(140, audioCtx.currentTime + 0.09);
                gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.09);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch (e) { }
        }

        function snapAndWarpSheet(passedCorners) {
            isCaptured = true;
            isFrozen = false;
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }

            playShutter();
            flashScreen.classList.add('flash');
            setTimeout(() => flashScreen.classList.remove('flash'), 120);

            const W = previewCanvas.width;
            const H = previewCanvas.height;

            const corners = orderCorners(passedCorners || frozenCorners || smoothedCorners || [
                { x: W * 0.10, y: H * 0.06 },
                { x: W * 0.90, y: H * 0.06 },
                { x: W * 0.90, y: H * 0.94 },
                { x: W * 0.10, y: H * 0.94 }
            ]);

            resultCanvas.width = TARGET_W;
            resultCanvas.height = TARGET_H;

            const dstRectCorners = [
                { x: 0, y: 0 },
                { x: TARGET_W, y: 0 },
                { x: TARGET_W, y: TARGET_H },
                { x: 0, y: TARGET_H }
            ];

            const cleanCanvas = document.createElement('canvas');
            cleanCanvas.width = W;
            cleanCanvas.height = H;
            const cleanCtx = cleanCanvas.getContext('2d');
            cleanCtx.drawImage(video, 0, 0, W, H);
            const srcImgData = cleanCtx.getImageData(0, 0, W, H);
            const srcData = srcImgData.data;
            const src32 = new Uint32Array(srcImgData.data.buffer);

            function refineCornerSubpixel(pt) {
                const searchR = Math.max(12, Math.min(22, Math.round(Math.min(W, H) * 0.018)));
                const minX = Math.max(0, Math.round(pt.x - searchR));
                const maxX = Math.min(W - 1, Math.round(pt.x + searchR));
                const minY = Math.max(0, Math.round(pt.y - searchR));
                const maxY = Math.min(H - 1, Math.round(pt.y + searchR));

                let minLum = 255, seedX = Math.round(pt.x), seedY = Math.round(pt.y);
                for (let y = minY; y <= maxY; y++) {
                    const rowIdx = y * W;
                    for (let x = minX; x <= maxX; x++) {
                        const idx = (rowIdx + x) * 4;
                        const lum = (srcData[idx] * 77 + srcData[idx + 1] * 150 + srcData[idx + 2] * 29) >> 8;
                        if (lum < minLum) {
                            minLum = lum;
                            seedX = x;
                            seedY = y;
                        }
                    }
                }

                if (minLum > 140) return pt;

                const markerThresh = minLum + 45;
                const maxR = Math.max(18, searchR * 1.6);
                const maxR2 = maxR * maxR;
                const winDim = Math.round(maxR * 2) + 3;
                const visited = new Uint8Array(winDim * winDim);
                const ox = seedX - Math.round(maxR) - 1;
                const oy = seedY - Math.round(maxR) - 1;

                const qX = new Int32Array(4096);
                const qY = new Int32Array(4096);
                let qHead = 0, qTail = 0;

                const startLx = seedX - ox;
                const startLy = seedY - oy;
                visited[startLy * winDim + startLx] = 1;
                qX[qTail] = seedX;
                qY[qTail] = seedY;
                qTail++;

                let sumX = 0, sumY = 0, count = 0;

                while (qHead < qTail && count < 3500) {
                    const cx = qX[qHead];
                    const cy = qY[qHead];
                    qHead++;

                    sumX += cx;
                    sumY += cy;
                    count++;

                    const neighbors = [
                        [cx - 1, cy], [cx + 1, cy], [cx, cy - 1], [cx, cy + 1]
                    ];
                    for (let k = 0; k < 4; k++) {
                        const nx = neighbors[k][0];
                        const ny = neighbors[k][1];
                        if (nx < 0 || nx >= W || ny < 0 || ny >= H) continue;

                        const dx = nx - seedX;
                        const dy = ny - seedY;
                        if (dx * dx + dy * dy > maxR2) continue;

                        const lx = nx - ox;
                        const ly = ny - oy;
                        if (lx < 0 || lx >= winDim || ly < 0 || ly >= winDim) continue;
                        const vIdx = ly * winDim + lx;
                        if (visited[vIdx]) continue;
                        visited[vIdx] = 1;

                        const pIdx = (ny * W + nx) * 4;
                        const lum = (srcData[pIdx] * 77 + srcData[pIdx + 1] * 150 + srcData[pIdx + 2] * 29) >> 8;
                        if (lum < markerThresh) {
                            if (qTail < 4090) {
                                qX[qTail] = nx;
                                qY[qTail] = ny;
                                qTail++;
                            }
                        }
                    }
                }

                if (count >= 16) {
                    return { x: sumX / count, y: sumY / count };
                }
                return pt;
            }

            const refinedCorners = corners.map(p => refineCornerSubpixel(p));
            const H_mat = getPerspectiveTransform(dstRectCorners, refinedCorners);

            const dstImgData = resultCtx.createImageData(TARGET_W, TARGET_H);
            const dst32 = new Uint32Array(dstImgData.data.buffer);

            const h0 = H_mat[0], h1 = H_mat[1], h2 = H_mat[2];
            const h3 = H_mat[3], h4 = H_mat[4], h5 = H_mat[5];
            const h6 = H_mat[6], h7 = H_mat[7];

            let dstIdx = 0;
            for (let y = 0; y < TARGET_H; y++) {
                const wx = h1 * y + h2;
                const wy = h4 * y + h5;
                const wz = h7 * y + 1;
                for (let x = 0; x < TARGET_W; x++) {
                    const z = 1 / (h6 * x + wz);
                    const sx = Math.round((h0 * x + wx) * z);
                    const sy = Math.round((h3 * x + wy) * z);
                    if (sx >= 0 && sx < W && sy >= 0 && sy < H) {
                        dst32[dstIdx] = src32[sy * W + sx];
                    } else {
                        dst32[dstIdx] = 0xFFFFFFFF;
                    }
                    dstIdx++;
                }
            }

            resultCtx.putImageData(dstImgData, 0, 0);

            try {
                window.cleanLeveledImageData = resultCanvas.toDataURL('image/jpeg', 0.78);
            } catch (e) {
                window.cleanLeveledImageData = resultCanvas.toDataURL();
            }

            video.pause();

            evaluateLeveledSheet(resultCtx, TARGET_W, TARGET_H, 0, 0, TARGET_W, TARGET_H);

            document.getElementById('viewfinderSection').style.display = 'none';
            document.getElementById('resultsSection').style.display = 'block';
        }

        // High-Precision Annular Moat & Interior OMR Evaluator FOR JEE MAINS
        function evaluateLeveledSheet(ctx, W, H, markerL, markerT, markerW, markerH) {
            const imgData = ctx.getImageData(0, 0, W, H);
            const data = imgData.data;

            function getGray(x, y) {
                if (x < 0 || x >= W || y < 0 || y >= H) return 255;
                const idx = (y * W + x) * 4;
                return (data[idx] * 77 + data[idx + 1] * 150 + data[idx + 2] * 29) >> 8;
            }

            function sampleDisk(cx, cy, r) {
                let sum = 0, count = 0;
                const r2 = r * r;
                const ir = Math.ceil(r);
                for (let dy = -ir; dy <= ir; dy++) {
                    for (let dx = -ir; dx <= ir; dx++) {
                        if (dx * dx + dy * dy <= r2) {
                            sum += getGray(Math.round(cx + dx), Math.round(cy + dy));
                            count++;
                        }
                    }
                }
                return count > 0 ? (sum / count) : 255;
            }

            function sampleBubbleFeatures(nominalX, nominalY, paperVal) {
                const offsets = [
                    [0, 0], [-1.0, 0], [1.0, 0], [0, -1.0], [0, 1.0]
                ];
                let bestStat = null;

                for (let k = 0; k < offsets.length; k++) {
                    const cx = nominalX + offsets[k][0];
                    const cy = nominalY + offsets[k][1];
                    let midSum = 0, midCount = 0, darkMidCount = 0;
                    let fullSum = 0, fullCount = 0;

                    for (let dy = -6; dy <= 6; dy++) {
                        for (let dx = -6; dx <= 6; dx++) {
                            const d2 = dx * dx + dy * dy;
                            const d = Math.sqrt(d2);
                            if (d > 5.8) continue;

                            const g = getGray(Math.round(cx + dx), Math.round(cy + dy));
                            fullSum += g;
                            fullCount++;

                            if (d >= 2.5 && d <= 5.8) {
                                midSum += g;
                                midCount++;
                                if (g < (paperVal - 22)) darkMidCount++;
                            }
                        }
                    }

                    if (midCount === 0 || fullCount === 0) continue;

                    const midMean = midSum / midCount;
                    const fullMean = fullSum / fullCount;
                    const midDarkness = Math.max(0, paperVal - midMean);
                    const fullDarkness = Math.max(0, paperVal - fullMean);
                    const midDarkRatio = darkMidCount / midCount;

                    const fillScore = midDarkness * 0.70 + fullDarkness * 0.30;

                    if (!bestStat || fillScore > bestStat.fillScore) {
                        bestStat = {
                            midDarkness,
                            fullDarkness,
                            midDarkRatio,
                            fillScore
                        };
                    }
                }

                return bestStat || {
                    midDarkness: 0,
                    fullDarkness: 0,
                    midDarkRatio: 0,
                    fillScore: 0
                };
            }

            // 1. DETECT 8-DIGIT ROLL NUMBER FROM ROLL NUMBER GRID
            const rollRadius = 8.5;
            let detectedRollNumber = '';
            let rollDigitsArray = [];

            for (let c = 0; c < 8; c++) {
                const colX = markerL + (U_ROLL_START + c * U_ROLL_COL_STEP) * markerW;
                const paperVal = sampleDisk(colX, markerT + (V_ROLL_START - 0.015) * markerH, 4.0);

                let digitScores = [];
                for (let d = 0; d <= 9; d++) {
                    const rowY = markerT + (V_ROLL_START + d * V_ROLL_ROW_STEP) * markerH;
                    const sample = sampleBubbleFeatures(colX, rowY, paperVal);
                    digitScores.push({ digit: d, ...sample, x: colX, y: rowY });
                }

                const sortedAsc = [...digitScores].sort((a, b) => a.fillScore - b.fillScore);
                const colBase = (sortedAsc[0].fillScore + sortedAsc[1].fillScore) / 2;

                const filledDigits = digitScores.filter(d => {
                    const contrast = d.fillScore - colBase;
                    return (d.midDarkness >= 26 && contrast >= 14) ||
                           (d.fillScore >= 42 && contrast >= 16);
                });

                if (filledDigits.length === 1) {
                    const chosen = filledDigits[0];
                    detectedRollNumber += chosen.digit;
                    rollDigitsArray.push(chosen.digit);

                    ctx.beginPath();
                    ctx.arc(chosen.x, chosen.y, rollRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = 2.5;
                    ctx.strokeStyle = '#2563EB';
                    ctx.fillStyle = 'rgba(37, 99, 235, 0.40)';
                    ctx.fill();
                    ctx.stroke();
                } else if (filledDigits.length > 1) {
                    const best = [...filledDigits].sort((a, b) => b.fillScore - a.fillScore)[0];
                    detectedRollNumber += best.digit;
                    rollDigitsArray.push(best.digit);

                    ctx.beginPath();
                    ctx.arc(best.x, best.y, rollRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = 2.5;
                    ctx.strokeStyle = '#F59E0B';
                    ctx.fillStyle = 'rgba(245, 158, 11, 0.40)';
                    ctx.fill();
                    ctx.stroke();
                } else {
                    detectedRollNumber += '-';
                    rollDigitsArray.push(null);
                }
            }

            // Update Roll Number UI Display
            const rollBoxes = document.getElementById('rollBoxesDisplay');
            if (rollBoxes) {
                rollBoxes.innerHTML = '';
                for (let i = 0; i < 8; i++) {
                    const box = document.createElement('div');
                    const val = rollDigitsArray[i];
                    if (val !== null && val !== undefined) {
                        box.className = 'roll-digit-box filled';
                        box.textContent = val;
                    } else {
                        box.className = 'roll-digit-box unknown';
                        box.textContent = '-';
                    }
                    rollBoxes.appendChild(box);
                }
            }

            const pill = document.getElementById('rollStatusPill');
            const cleanRoll = detectedRollNumber.replace(/-/g, '');
            if (pill) {
                if (cleanRoll.length === 8) {
                    pill.textContent = 'Detected (' + cleanRoll + ')';
                    pill.style.background = '#F0FDF4';
                    pill.style.color = '#15803D';
                    pill.style.borderColor = '#BBF7D0';
                } else if (cleanRoll.length > 0) {
                    pill.textContent = 'Partial (' + cleanRoll + ')';
                    pill.style.background = '#FEF3C7';
                    pill.style.color = '#D97706';
                    pill.style.borderColor = '#FDE68A';
                } else {
                    pill.textContent = 'Not Found';
                    pill.style.background = '#FEF2F2';
                    pill.style.color = '#B91C1C';
                    pill.style.borderColor = '#FECACA';
                }
            }

            // 2. DETECT JEE MAINS MCQS (STRICTLY Q1-20, Q41-60, Q81-100 ONLY)
            const bubbleRadius = 9.0;
            let correctCount = 0;
            let wrongCount = 0;
            let multipleCount = 0;
            let attemptedCount = 0;
            let blankCount = 0;
            let rowsHtml = '';
            const scannerBreakdown = [];

            mcqScores = {
                phy: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                chem: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 },
                math: { correct: 0, wrong: 0, multiple: 0, blank: 0, score: 0 }
            };

            for (let idx = 0; idx < JEE_QUESTIONS.length; idx++) {
                const item = JEE_QUESTIONS[idx];
                const q = item.q;
                const subject = item.subject;
                const subKey = item.subKey;

                const col = Math.floor((q - 1) / QUESTIONS_PER_COL);
                const row = (q - 1) % QUESTIONS_PER_COL;

                const rowY = markerT + (V_START + row * V_ROW_STEP) * markerH;
                const colX = markerL + (U_START + col * U_COL_STEP) * markerW;

                const optD_X = colX + 3 * U_BUBBLE_STEP * markerW;
                const gutterSampleX = Math.min(W - 14, optD_X + 16);
                const paperVal1 = sampleDisk(gutterSampleX, rowY, 3.5);
                const paperVal2 = sampleDisk(Math.max(14, colX - 16), rowY, 3.5);
                const paperVal = Math.max(paperVal1, paperVal2);

                let bubbleStats = [];
                for (let b = 0; b < 4; b++) {
                    const bubbleX = colX + (b * U_BUBBLE_STEP) * markerW;
                    const sample = sampleBubbleFeatures(bubbleX, rowY, paperVal);
                    bubbleStats.push({
                        opt: OPTIONS[b],
                        ...sample,
                        x: bubbleX,
                        y: rowY
                    });
                }

                const sortedAsc = [...bubbleStats].sort((a, b) => a.fillScore - b.fillScore);
                const rowBase = (sortedAsc[0].fillScore + sortedAsc[1].fillScore) / 2;

                function isOptionFilled(s) {
                    const contrast = s.fillScore - rowBase;
                    if (s.midDarkness >= 36 && contrast >= 16) return true;
                    if (s.midDarkness >= 26 && contrast >= 14 && s.midDarkRatio >= 0.28) return true;
                    if (s.fillScore >= 48 && contrast >= 16) return true;
                    if (s.midDarkness >= 55 && s.midDarkRatio >= 0.50 && s.fullDarkness >= 45) return true;
                    return false;
                }

                const filledCandidates = bubbleStats.filter(b => isOptionFilled(b));
                let filledBubbles = [];

                if (filledCandidates.length === 0) {
                    filledBubbles = [];
                } else if (filledCandidates.length === 1) {
                    filledBubbles = filledCandidates;
                } else {
                    const sortedCandidates = [...filledCandidates].sort((a, b) => b.fillScore - a.fillScore);
                    const top1 = sortedCandidates[0];
                    const top2 = sortedCandidates[1];

                    if (top1.fillScore - top2.fillScore >= 35 && top1.fillScore >= 55) {
                        filledBubbles = [top1];
                    } else {
                        filledBubbles = filledCandidates;
                    }
                }

                const isMultiple = filledBubbles.length > 1;
                const detectedAnswer = filledBubbles.map(b => b.opt).join(', ');
                const correctAns = answerKey[q.toString()] || '';

                let verdict = 'unmarked';

                if (isMultiple) {
                    attemptedCount++;
                    wrongCount++;
                    multipleCount++;
                    verdict = 'multiple';
                    mcqScores[subKey].multiple++;
                } else if (filledBubbles.length === 1) {
                    const singleAns = filledBubbles[0].opt;
                    attemptedCount++;
                    if (correctAns && singleAns === correctAns) {
                        correctCount++;
                        verdict = 'correct';
                        mcqScores[subKey].correct++;
                    } else if (correctAns) {
                        wrongCount++;
                        verdict = 'wrong';
                        mcqScores[subKey].wrong++;
                    } else {
                        verdict = 'marked';
                        mcqScores[subKey].correct++;
                    }
                } else {
                    blankCount++;
                    mcqScores[subKey].blank++;
                }

                scannerBreakdown.push({
                    q: q,
                    subject: subject,
                    subKey: subKey,
                    marked: detectedAnswer || '',
                    correctKey: correctAns || '',
                    verdict: verdict
                });

                // Draw Overlay Rings strictly on these checked questions
                for (let b = 0; b < 4; b++) {
                    const opt = OPTIONS[b];
                    const stat = bubbleStats[b];
                    const isThisBubbleFilled = filledBubbles.some(f => f.opt === opt);

                    ctx.beginPath();
                    ctx.arc(stat.x, stat.y, bubbleRadius, 0, 2 * Math.PI);
                    ctx.lineWidth = Math.max(2, Math.round(W * 0.002));

                    if (isMultiple && isThisBubbleFilled) {
                        ctx.strokeStyle = '#EF4444';
                        ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        ctx.fill();
                        ctx.stroke();

                        ctx.strokeStyle = '#FFFFFF';
                        ctx.lineWidth = 2;
                        const sz = Math.round(bubbleRadius * 0.5);
                        ctx.beginPath();
                        ctx.moveTo(stat.x - sz, stat.y - sz);
                        ctx.lineTo(stat.x + sz, stat.y + sz);
                        ctx.moveTo(stat.x + sz, stat.y - sz);
                        ctx.lineTo(stat.x - sz, stat.y + sz);
                        ctx.stroke();
                    } else if (isThisBubbleFilled) {
                        if (verdict === 'correct') {
                            ctx.strokeStyle = '#10B981';
                            ctx.fillStyle = 'rgba(16, 185, 129, 0.55)';
                        } else if (verdict === 'wrong') {
                            ctx.strokeStyle = '#EF4444';
                            ctx.fillStyle = 'rgba(239, 68, 68, 0.55)';
                        } else {
                            ctx.strokeStyle = '#06B6D4';
                            ctx.fillStyle = 'rgba(6, 182, 212, 0.55)';
                        }
                        ctx.fill();
                        ctx.stroke();
                    } else if (correctAns && opt === correctAns && verdict === 'wrong') {
                        ctx.strokeStyle = '#10B981';
                        ctx.setLineDash([3, 3]);
                        ctx.stroke();
                        ctx.setLineDash([]);
                    } else {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                        ctx.stroke();
                    }
                }

                let badgeClass = 'badge-blank';
                let verdictText = 'Blank';
                let markedCellHtml = '<span style="color:#94A3B8;">-</span>';

                if (verdict === 'multiple') {
                    badgeClass = 'badge-multiple';
                    verdictText = 'Multiple';
                    markedCellHtml = '<strong style="color: #DC2626; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'correct') {
                    badgeClass = 'badge-correct';
                    verdictText = 'Correct (+4)';
                    markedCellHtml = '<strong style="color: #15803D; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'wrong') {
                    badgeClass = 'badge-wrong';
                    verdictText = 'Wrong (-1)';
                    markedCellHtml = '<strong style="color: #DC2626; font-size:0.95rem;">' + detectedAnswer + '</strong>';
                } else if (verdict === 'marked') {
                    badgeClass = 'badge-marked';
                    verdictText = 'Marked';
                    markedCellHtml = '<strong style="color: var(--primary); font-size:0.95rem;">' + detectedAnswer + '</strong>';
                }

                const subIcon = subKey === 'phy' ? '⚛️ Phy' : (subKey === 'chem' ? '🧪 Chem' : '📐 Math');

                rowsHtml += '<tr>' +
                    '<td style="font-size:0.75rem; font-weight:700; color:var(--text-muted);">' + subIcon + '</td>' +
                    '<td style="font-weight:700; font-family:\'JetBrains Mono\',monospace;">Q' + q + '</td>' +
                    '<td>' + markedCellHtml + '</td>' +
                    '<td style="font-family:\'JetBrains Mono\',monospace; font-weight:700; color:var(--text-muted);">' + (correctAns || '-') + '</td>' +
                    '<td><span class="badge ' + badgeClass + '">' + verdictText + '</span></td>' +
                    '</tr>';
            }

            document.getElementById('tableBody').innerHTML = rowsHtml;
            document.getElementById('statCorrect').textContent = correctCount;
            document.getElementById('statWrong').textContent = wrongCount;
            document.getElementById('statMultiple').textContent = multipleCount;
            document.getElementById('statAttempted').textContent = attemptedCount;
            document.getElementById('statBlank').textContent = blankCount;

            // Recalculate JEE totals (MCQ + NVQ)
            updateJeeTotals();

            // Prepare Payload for Database / Cloudinary Save
            try {
                const finalRoll = cleanRoll.length > 0 ? cleanRoll : 'STUDENT-' + Date.now().toString().slice(-4);
                const sumArr = (arr) => arr.reduce((acc, v) => acc + v, 0);
                const phyTotal = ((mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple) + sumArr(numericalScores.phy);
                const chemTotal = ((mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple) + sumArr(numericalScores.chem);
                const mathTotal = ((mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple) + sumArr(numericalScores.math);
                const grandTotal = phyTotal + chemTotal + mathTotal;

                window.lastEvaluationData = {
                    rollNumber: finalRoll,
                    score: grandTotal,
                    totalQuestions: 75,
                    maxMarks: 300,
                    numericalScores: numericalScores,
                    mcqSubjectScores: {
                        phy: { score: (mcqScores.phy.correct * 4) - mcqScores.phy.wrong - mcqScores.phy.multiple, correct: mcqScores.phy.correct, wrong: mcqScores.phy.wrong + mcqScores.phy.multiple, blank: mcqScores.phy.blank },
                        chem: { score: (mcqScores.chem.correct * 4) - mcqScores.chem.wrong - mcqScores.chem.multiple, correct: mcqScores.chem.correct, wrong: mcqScores.chem.wrong + mcqScores.chem.multiple, blank: mcqScores.chem.blank },
                        math: { score: (mcqScores.math.correct * 4) - mcqScores.math.wrong - mcqScores.math.multiple, correct: mcqScores.math.correct, wrong: mcqScores.math.wrong + mcqScores.math.multiple, blank: mcqScores.math.blank }
                    },
                    breakdown: scannerBreakdown,
                    imageData: window.cleanLeveledImageData
                };

                updateSaveButtonsState(false, 'Save &amp; Scan Next');
            } catch (err) {
                console.warn('Evaluation payload prep error:', err);
            }
        }

        let isSavingSubmission = false;

        function updateSaveButtonsState(disabled, text) {
            const btns = [document.getElementById('btnSaveNext'), document.getElementById('topSaveBtn')];
            btns.forEach(btn => {
                if (btn) {
                    btn.disabled = disabled;
                    btn.innerHTML = text;
                }
            });
        }

        // Save result, upload to Cloudinary, then scan next sheet
        async function saveAndScanNext() {
            if (isSavingSubmission) return;
            if (!window.lastEvaluationData) {
                alert('No evaluated sheet available to save.');
                return;
            }

            isSavingSubmission = true;
            updateSaveButtonsState(true, 'Uploading...');

            const pill = document.getElementById('rollStatusPill');
            if (pill) {
                pill.textContent = 'Uploading...';
                pill.style.background = '#EFF6FF';
                pill.style.color = '#1D4ED8';
                pill.style.borderColor = '#BFDBFE';
            }

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 22000);

            try {
                const paperId = encodeURIComponent('<%= paper._id %>');
                const res = await fetch('/api/paper/' + paperId + '/jee-save-result', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(window.lastEvaluationData),
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                const data = await res.json();

                if (data.success) {
                    if (pill) {
                        pill.textContent = 'Saved (' + (data.cloudinaryAccount || 'Cloud') + ')';
                        pill.style.background = '#F0FDF4';
                        pill.style.color = '#15803D';
                        pill.style.borderColor = '#BBF7D0';
                    }
                    updateSaveButtonsState(true, 'Saved! Scanning Next...');

                    window.lastEvaluationData = null;
                    window.cleanLeveledImageData = null;
                    isSavingSubmission = false;

                    // Immediately resume live camera and scan next sheet
                    setTimeout(() => {
                        restartScanner();
                        updateSaveButtonsState(false, 'Save &amp; Scan Next');
                    }, 500);
                } else {
                    alert('Error saving evaluation: ' + (data.error || 'Failed to save'));
                    isSavingSubmission = false;
                    updateSaveButtonsState(false, 'Save &amp; Scan Next');
                    if (pill) {
                        pill.textContent = 'Save Failed';
                        pill.style.background = '#FEF2F2';
                        pill.style.color = '#B91C1C';
                        pill.style.borderColor = '#FECACA';
                    }
                }
            } catch (err) {
                clearTimeout(timeoutId);
                console.error('Save error:', err);
                alert('Save status: ' + (err.name === 'AbortError' ? 'Upload took too long. Please retry.' : err.message));
                isSavingSubmission = false;
                updateSaveButtonsState(false, 'Save &amp; Scan Next');
                if (pill) {
                    pill.textContent = 'Upload Error';
                    pill.style.background = '#FEF2F2';
                    pill.style.color = '#B91C1C';
                    pill.style.borderColor = '#FECACA';
                }
            }
        }

        function rescanSheet() {
            window.lastEvaluationData = null;
            window.cleanLeveledImageData = null;
            isSavingSubmission = false;
            restartScanner();
        }

        function restartScanner() {
            initCamera();
        }

        window.addEventListener('DOMContentLoaded', initCamera);
    </script>
</body>

</html>
