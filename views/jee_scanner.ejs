<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEE Mains Scanner • <%= paper.title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .scanner-container {
            max-width: 1140px;
            margin: 0 auto;
        }

        .viewfinder-card {
            background: #FFFFFF;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
            position: relative;
        }

        .video-wrapper {
            position: relative;
            width: 100%;
            background: #0F172A;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 500px;
            user-select: none;
            touch-action: none;
            cursor: pointer;
        }

        #videoInput {
            display: none;
        }

        #canvasPreview {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Clean Viewfinder HUD Overlays */
        .hud-top-bar {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            pointer-events: none;
            z-index: 25;
        }

        .hud-chip {
            background: rgba(15, 23, 42, 0.82);
            color: #FFFFFF;
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255, 255, 255, 0.16);
        }

        .lock-meter {
            width: 68px;
            height: 6px;
            background: rgba(255, 255, 255, 0.22);
            border-radius: 3px;
            overflow: hidden;
            display: none;
            margin-left: 4px;
        }

        .lock-meter.active {
            display: block;
        }

        .lock-meter-fill {
            height: 100%;
            width: 0%;
            background: #22C55E;
            border-radius: 3px;
            transition: width 0.08s ease-out;
        }

        .hud-chip.locked {
            border-color: #22C55E;
            color: #DCFCE7;
        }

        .status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #F59E0B;
        }

        .status-dot.active {
            background: #22C55E;
        }

        .scan-laser {
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(37, 99, 235, 0.65);
            pointer-events: none;
            z-index: 20;
            display: none;
            animation: laser-sweep 2.2s ease-in-out infinite alternate;
        }

        @keyframes laser-sweep {
            0% { top: 12%; opacity: 0.25; }
            50% { opacity: 0.85; }
            100% { top: 88%; opacity: 0.25; }
        }

        /* Clean Light Bottom Control Bar */
        .scanner-bottom-bar {
            background: #FFFFFF;
            border-top: 1px solid var(--border-color);
            padding: 0.9rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--text-body);
        }

        .btn-capture-auto {
            background: var(--primary);
            color: #FFFFFF;
            border: 1px solid var(--primary);
            border-radius: var(--radius-sm);
            padding: 10px 20px;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition), scale 120ms ease-out;
        }

        .btn-capture-auto:hover:not(:disabled) {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
        }

        .btn-capture-auto.locked {
            background: var(--success);
            border-color: var(--success);
        }

        .btn-capture-auto:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Results View */
        #resultsSection {
            display: none;
            width: 100%;
        }

        .results-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        @media (max-width: 960px) {
            .results-grid {
                grid-template-columns: 1fr;
            }
        }

        .rectified-canvas-wrap {
            background: var(--surface-subtle);
            border-radius: var(--radius-lg);
            padding: 1rem;
            text-align: center;
            border: 1px solid var(--border-color);
            position: relative;
        }

        .rectified-badge {
            position: absolute;
            top: 16px;
            left: 16px;
            background: var(--success);
            color: #FFFFFF;
            font-size: 0.74rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: var(--radius-full);
            z-index: 10;
        }

        #canvasResult {
            width: 100%;
            height: auto;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            background: #FFFFFF;
        }

        .score-hero {
            background: var(--primary-light);
            color: var(--text-main);
            border: 1px solid var(--primary-border);
            border-radius: var(--radius-lg);
            padding: 1.4rem;
            text-align: center;
            margin-bottom: 1.25rem;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 1.25rem;
        }

        @media (max-width: 640px) {
            .stat-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .stat-box {
            background: var(--surface-subtle);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.8rem 0.5rem;
            text-align: center;
        }

        .stat-box .num {
            font-size: 1.45rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            line-height: 1.1;
        }

        .stat-box .lbl {
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            margin-top: 4px;
            letter-spacing: 0.04em;
        }

        .breakdown-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
            font-variant-numeric: tabular-nums;
        }

        .breakdown-table th,
        .breakdown-table td {
            padding: 9px 12px;
            border-bottom: 1px solid #F1F5F9;
            text-align: center;
        }

        .breakdown-table th {
            background: var(--surface-subtle);
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .breakdown-table tr:hover td {
            background: var(--surface-subtle);
        }

        .badge {
            display: inline-block;
            padding: 2px 9px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-correct {
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
        }

        .badge-wrong {
            background: var(--danger-light);
            color: var(--danger);
            border: 1px solid var(--danger-border);
        }

        .badge-blank {
            background: var(--surface-subtle);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }

        .badge-marked {
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid var(--primary-border);
        }

        .badge-multiple {
            background: var(--danger-light);
            color: var(--danger-hover);
            border: 1px solid var(--danger-border);
        }

        /* Clean Light Roll Number Card */
        .roll-number-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .roll-label-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.75rem;
        }

        .roll-title {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .roll-status-pill {
            margin-left: auto;
            font-size: 0.74rem;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: var(--radius-full);
            background: var(--success-light);
            color: var(--success-hover);
            border: 1px solid var(--success-border);
            font-family: 'JetBrains Mono', monospace;
        }

        .roll-boxes-display {
            display: flex;
            gap: 6px;
            justify-content: center;
        }

        .roll-digit-box {
            width: 35px;
            height: 43px;
            background: var(--surface-subtle);
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-muted);
        }

        .roll-digit-box.filled {
            border-color: var(--primary-border);
            background: var(--primary-light);
            color: var(--primary-active);
        }

        .roll-digit-box.unknown {
            color: var(--text-subtle);
            border-style: dashed;
        }

        .freeze-banner {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 30;
            pointer-events: auto;
        }

        .freeze-banner-content {
            background: rgba(15, 23, 42, 0.92);
            border: 1px solid #22C55E;
            border-radius: var(--radius-full);
            padding: 8px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #FFFFFF;
        }

        .freeze-text {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

        .freeze-text strong {
            font-size: 0.84rem;
            color: #86EFAC;
        }

        .freeze-text span {
            font-size: 0.76rem;
            color: #E2E8F0;
        }

        .btn-retake {
            background: #FFFFFF;
            border: 1px solid var(--border-hover);
            color: var(--text-main);
            padding: 5px 12px;
            border-radius: var(--radius-full);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-retake:hover {
            background: var(--surface-subtle);
        }

        .flash-screen {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.08s ease-out;
            z-index: 50;
        }

        .flash-screen.flash {
            opacity: 0.9;
        }

        /* Results Action Buttons */
        .results-actions-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 0 0 1.25rem 0;
            flex-wrap: wrap;
            gap: 12px;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 12px 18px;
            box-shadow: var(--shadow-xs);
        }

        .action-buttons-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-save-next {
            background: var(--primary);
            color: #FFFFFF;
            border: 1px solid var(--primary);
            font-weight: 600;
            padding: 9px 18px;
            font-size: 0.9rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition), scale 120ms ease-out;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-family: 'Inter', sans-serif;
        }

        .btn-save-next:hover:not(:disabled) {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
        }

        .btn-save-next:active:not(:disabled) {
            scale: 0.98;
        }

        .btn-save-next:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .btn-rescan {
            background: #FFFFFF;
            color: var(--text-main);
            border: 1px solid var(--border-hover);
            font-weight: 600;
            padding: 9px 16px;
            font-size: 0.9rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'Inter', sans-serif;
        }

        .btn-rescan:hover {
            background: var(--surface-subtle);
            border-color: #94A3B8;
        }

        .scanner-sticky-dock {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 1.25rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border-color);
        }

        /* JEE Specific Styles */
        .jee-nvq-btn {
            border: 1px solid var(--border-hover);
            background: #FFFFFF;
            color: var(--text-main);
            border-radius: var(--radius-xs);
            padding: 4px 0;
            font-size: 0.74rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            transition: all 0.12s ease;
        }

        .jee-nvq-btn:hover {
            filter: brightness(0.95);
        }

        .jee-nvq-btn.btn-c.active {
            background: #10B981 !important;
            color: #FFFFFF !important;
            border-color: #059669 !important;
        }

        .jee-nvq-btn.btn-w.active {
            background: #EF4444 !important;
            color: #FFFFFF !important;
            border-color: #DC2626 !important;
        }

        .jee-nvq-btn.btn-b.active {
            background: #64748B !important;
            color: #FFFFFF !important;
            border-color: #475569 !important;
        }

        @media (max-width: 640px) {
            .results-actions-topbar {
                flex-direction: column;
                align-items: stretch;
                padding: 12px;
            }
            .action-buttons-group, .scanner-sticky-dock {
                width: 100%;
                display: grid;
                grid-template-columns: 1fr 1.5fr;
                gap: 8px;
            }
            .btn-save-next, .btn-rescan {
                justify-content: center;
                padding: 10px 12px;
                font-size: 0.86rem;
            }
        }
    </style>
</head>

<body>
    <div class="container scanner-container">
        <!-- Live Viewfinder Section -->
        <div id="viewfinderSection" class="viewfinder-card">
            <div class="video-wrapper" id="videoWrapper" onclick="handleTapToCapture()">
                <div id="flashScreen" class="flash-screen"></div>
                <div id="scanLaser" class="scan-laser"></div>

                <div class="hud-top-bar">
                    <div id="hudChip" class="hud-chip">
                        <div id="statusDot" class="status-dot"></div>
                        <span id="hudStatus">Align paper in view</span>
                        <div class="lock-meter" id="lockMeter">
                            <div class="lock-meter-fill" id="lockMeterFill"></div>
                        </div>
                    </div>
                </div>

                <!-- Frozen State Banner -->
                <div id="freezeBanner" class="freeze-banner" style="display: none;">
                    <div class="freeze-banner-content">
                        <div class="freeze-text">
                            <strong>Corners Locked</strong>
                            <span>Tap screen to compute score</span>
                        </div>
                        <button type="button" class="btn-retake" onclick="event.stopPropagation(); unfreezeScene();">Retake</button>
                    </div>
                </div>

                <video id="videoInput" autoplay playsinline></video>
                <canvas id="canvasPreview"></canvas>
            </div>

            <!-- Bottom Toolbar -->
            <div class="scanner-bottom-bar">
                <div style="display:flex; align-items:center; gap:8px;">
                    <a href="/paper/<%= encodeURIComponent(paper._id) %>/jee-answerkey" class="btn btn-secondary btn-sm" style="background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE; text-decoration:none; font-weight:600;" title="Edit JEE Answer Key (Q1-20, Q41-60, Q81-100)">
                        ⚛️ JEE Key
                    </a>
                    <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">
                        Auto-captures when 4 corners align, or tap the viewfinder
                    </span>
                </div>
                <div>
                    <button type="button" class="btn-capture-auto" id="captureBtn" onclick="triggerManualCapture()">
                        Capture &amp; Evaluate
                    </button>
                </div>
            </div>
        </div>

        <!-- Leveled Results Section -->
        <div id="resultsSection">
            <div class="results-actions-topbar">
                <div>
                    <h2 style="margin: 0 0 2px 0; font-size: 1.2rem; font-weight: 700;">JEE Mains Evaluation Results</h2>
                    <span style="font-size: 0.825rem; color: var(--text-muted);"><%= paper.title %> &bull; Checked: <strong>Q1-20 (Phy)</strong>, <strong>Q41-60 (Chem)</strong>, <strong>Q81-100 (Math)</strong> + Numerical</span>
                </div>
                <div class="action-buttons-group">
                    <a href="/paper/<%= encodeURIComponent(paper._id) %>/jee-answerkey" class="btn btn-secondary btn-sm" style="text-decoration:none; font-weight:600;" title="Edit JEE Answer Key (Q1-20, Q41-60, Q81-100)">
                        ⚛️ JEE Key
                    </a>
                    <button type="button" class="btn-rescan" id="topRescanBtn" onclick="rescanSheet()" title="Discard this scan and rescan immediately">
                        Rescan
                    </button>
                    <button type="button" class="btn-save-next" id="topSaveBtn" onclick="saveAndScanNext()" title="Save result to database and upload OMR copy to Cloudinary, then scan next">
                        Save &amp; Scan Next
                    </button>
                </div>
            </div>

            <div class="results-grid">
                <div class="rectified-canvas-wrap">
                    <span class="rectified-badge">Auto-Leveled &amp; Cropped</span>
                    <canvas id="canvasResult"></canvas>
                </div>

                <div>
                    <div class="roll-number-card">
                        <div class="roll-label-row">
                            <span class="roll-title">Student Roll Number</span>
                            <span class="roll-status-pill" id="rollStatusPill">Detecting...</span>
                        </div>
                        <div class="roll-boxes-display" id="rollBoxesDisplay">
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                            <div class="roll-digit-box unknown">-</div>
                        </div>
                    </div>

                    <!-- Score Hero: 300 Max Marks -->
                    <div class="score-hero">
                        <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600;">
                            JEE Mains Total Score (300 Max)
                        </div>
                        <div class="score-val" id="scoreValue"
                            style="font-size: 3rem; font-weight: 700; margin: 0.2rem 0; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; color: var(--primary);">
                            0 / 300
                        </div>
                        <div id="scorePercentage" style="font-size: 1rem; font-weight: 600; color: var(--text-body);">0% Marks (0/300)</div>
                    </div>

                    <!-- 3 Subject Mini Cards -->
                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; margin-bottom:1.25rem;">
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">⚛️ Physics</div>
                            <div id="phyTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="phyMcqMarks">0</span> &bull; NVQ: <span id="phyNvqMarks">0</span></div>
                        </div>
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">🧪 Chemistry</div>
                            <div id="chemTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="chemMcqMarks">0</span> &bull; NVQ: <span id="chemNvqMarks">0</span></div>
                        </div>
                        <div style="background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px; text-align:center;">
                            <div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">📐 Mathematics</div>
                            <div id="mathTotalMarks" style="font-size:1.25rem; font-weight:700; font-family:'JetBrains Mono',monospace; color:var(--text-main);">0/100</div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">MCQ: <span id="mathMcqMarks">0</span> &bull; NVQ: <span id="mathNvqMarks">0</span></div>
                        </div>
                    </div>

                    <!-- Section B: Numerical Value Questions (NVQ) Panel -->
                    <div class="card" style="padding: 1.15rem; margin-bottom: 1.25rem; border: 1px solid var(--border-color); background: #FFFFFF;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:6px;">
                            <div>
                                <h4 style="margin:0; font-size:0.95rem; font-weight:700; color:var(--text-main);">Section B: Numerical Value Questions</h4>
                                <span style="font-size:0.75rem; color:var(--text-muted);">Single-tap (+4 Correct, -1 Wrong, 0 Blank)</span>
                            </div>
                            <span style="font-size:0.72rem; font-weight:600; padding:2px 8px; border-radius:var(--radius-full); background:#EFF6FF; color:#1D4ED8;">15 Qs &bull; Max 60 M</span>
                        </div>

                        <!-- Physics NVQ (Q21-25) -->
                        <div style="margin-bottom:10px; padding:8px 10px; background:var(--surface-subtle); border:1px solid var(--border-color); border-radius:var(--radius-sm);">
                            <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.78rem; font-weight:700;">
                                <span>⚛️ Physics Numerical (Q21–Q25)</span>
                                <span id="phyNvqSummary" style="font-family:'JetBrains Mono',monospace; color:var(--primary);">+0 Marks</span>
                            </div>
                            <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:6px;">
                                <% for(let i=1; i<=5; i++) { %>
                                    <div style="border:1px solid var(--border-color); border-radius:var(--radius-xs); padding:5px 3px; text-align:center; background:#FFFFFF;">
