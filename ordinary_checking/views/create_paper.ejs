<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Paper • Ordinary OMR Checker</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container {
            max-width: 960px;
            margin: 24px auto 60px auto;
            padding: 0 16px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #64748B;
            margin-bottom: 16px;
        }

        .breadcrumb a {
            color: #2563EB;
            text-decoration: none;
            font-weight: 600;
        }

        .form-card {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            margin-bottom: 24px;
        }

        .form-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid #E2E8F0;
        }

        .form-header h1 {
            font-size: 22px;
            margin: 0 0 4px 0;
            color: #0F172A;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        @media (max-width: 768px) {
            .form-grid-2 {
                grid-template-columns: 1fr;
            }
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #CBD5E1;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .preset-badge {
            display: inline-block;
            background: #F1F5F9;
            border: 1px solid #CBD5E1;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            cursor: pointer;
            margin-right: 6px;
            margin-bottom: 6px;
            transition: all 0.15s ease;
        }

        .preset-badge:hover, .preset-badge.active {
            background: #2563EB;
            color: #fff;
            border-color: #2563EB;
        }

        /* Section Builder */
        .section-box {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
        }

        .sec-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 40px;
            gap: 10px;
            align-items: center;
            background: #fff;
            border: 1px solid #E2E8F0;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 8px;
        }

        @media (max-width: 640px) {
            .sec-row {
                grid-template-columns: 1fr;
            }
        }

        .btn-del {
            background: #FEE2E2;
            color: #DC2626;
            border: none;
            border-radius: 6px;
            height: 34px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
        }

        /* Answer Key Bubble Grid */
        .key-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 10px;
            max-height: 480px;
            overflow-y: auto;
            padding: 10px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 8px;
        }

        .q-card {
            background: #fff;
            border: 1px solid #CBD5E1;
            border-radius: 6px;
            padding: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .q-num {
            font-size: 13px;
            font-weight: 700;
            color: #1E293B;
            width: 32px;
        }

        .bubble-group {
            display: flex;
            gap: 4px;
        }

        .bubble-opt {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1.5px solid #94A3B8;
            background: #fff;
            font-size: 11px;
            font-weight: 700;
            color: #334155;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.1s ease;
        }

        .bubble-opt:hover {
            border-color: #2563EB;
            color: #2563EB;
        }

        .bubble-opt.selected {
            background: #2563EB;
            color: #fff;
            border-color: #2563EB;
        }

        .bubble-opt.bonus-selected {
            background: #10B981;
            color: #fff;
            border-color: #10B981;
        }

        .btn-primary {
            background: #2563EB;
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .btn-primary:hover {
            background: #1D4ED8;
        }
    </style>
</head>

<%
    const _paper = (typeof paper !== 'undefined' && paper) ? paper : ((typeof config !== 'undefined' && config) ? config : null);
    const _isEditing = Boolean(_paper && _paper.id);
    const _titleVal = _paper ? (_paper.title || '') : '';
    const _subjectVal = _paper ? (_paper.subject || 'Physics, Chemistry, Biology') : 'Physics, Chemistry, Biology';
    const _totalQVal = _paper ? (Number(_paper.totalQuestions) || 180) : 180;
    const _paperIdVal = _paper ? (_paper.id || '') : '';
%>
<body>
    <div class="container">
        <div class="breadcrumb">
            <a href="/ordinary">&larr; Ordinary OMR Portal</a>
            <span>/</span>
            <span><%= _isEditing ? 'Edit Assessment Paper' : 'Create Assessment Paper' %></span>
        </div>

        <form action="/ordinary/paper/new" method="POST" id="paperForm">
            <!-- Hidden inputs -->
            <input type="hidden" name="paperId" id="paperId" value="<%= _paperIdVal %>">
            <input type="hidden" name="sectionsJson" id="sectionsJson">
            <input type="hidden" name="answerKeyJson" id="answerKeyJson">

            <div class="form-card">
                <div class="form-header">
                    <div>
                        <h1><%= _isEditing ? 'Edit Assessment Paper' : 'Create Assessment Paper' %></h1>
                        <span style="font-size: 13px; color: #64748B;">This paper &amp; answer key will be synced to dedicated tabs in your Google Sheet</span>
                    </div>
                    <span style="background: #D1FAE5; color: #065F46; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                        Google Sheet Mode
                    </span>
                </div>

                <!-- Title & Subject -->
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label" for="paperTitle">Paper Title *</label>
                        <input type="text" id="paperTitle" name="title" class="form-input" placeholder="e.g. NEET Full Test 01" value="<%= _titleVal %>" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="paperSubject">Subject / Category</label>
                        <input type="text" id="paperSubject" name="subject" class="form-input" placeholder="e.g. Physics, Chemistry, Biology" value="<%= _subjectVal %>">
                    </div>
                </div>

                <!-- Total Questions & Presets -->
                <div class="form-group">
                    <label class="form-label">Total Questions</label>
                    <div style="margin-bottom: 8px;">
                        <span class="preset-badge" onclick="setTotalQ(30);">30 Qs</span>
                        <span class="preset-badge" onclick="setTotalQ(45);">45 Qs</span>
                        <span class="preset-badge" onclick="setTotalQ(50);">50 Qs</span>
                        <span class="preset-badge" onclick="setTotalQ(90);">90 Qs</span>
                        <span class="preset-badge" onclick="setTotalQ(100);">100 Qs</span>
                        <span class="preset-badge active" onclick="setTotalQ(180);">180 Qs (NEET)</span>
                        <span class="preset-badge" onclick="setTotalQ(200);">200 Qs</span>
                    </div>
                    <div style="display: flex; gap: 12px; align-items: center; max-width: 320px;">
                        <input type="number" id="totalQuestions" name="totalQuestions" class="form-input" value="<%= _totalQVal %>" min="1" max="200" onchange="rebuildQuestionGrid();">
                        <span style="font-size: 13px; color: #64748B;">Max: <strong id="maxMarksLabel"><%= _totalQVal * 4 %></strong> Marks</span>
                    </div>
                </div>

                <!-- Section Configuration -->
                <div class="section-box">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <strong style="font-size: 14px; color: #1E293B;">Paper Sections</strong>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="preset-badge" onclick="applyNeetSections();">Apply NEET 4 Sections</button>
                            <button type="button" class="preset-badge" onclick="addSectionRow();">+ Add Section</button>
                        </div>
                    </div>
                    <div id="sectionRowsContainer">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Answer Key Header & Quick Tools -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin: 24px 0 12px 0;">
                    <div>
                        <h2 style="font-size: 16px; margin: 0 0 2px 0; color: #0F172A;">Official Answer Key</h2>
                        <span style="font-size: 12px; color: #64748B;">Click bubbles (A, B, C, D) or Bonus (*) for each question</span>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="preset-badge" onclick="openPasteModal();">📋 Quick Paste</button>
                        <button type="button" class="preset-badge" onclick="clearAllAnswers();">✕ Clear All</button>
                    </div>
                </div>

                <!-- OMR Bubble Grid -->
                <div class="key-grid" id="keyGrid">
                    <!-- Dynamic Q1 to QN cards -->
                </div>

                <!-- Save Action -->
                <div style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px;">
                    <a href="/ordinary" class="btn-del" style="height: auto; padding: 12px 18px; text-decoration: none; display: inline-flex; align-items: center;">Cancel</a>
                    <button type="submit" class="btn-primary" onclick="prepareSubmit(event);">
                        💾 Save Paper &amp; Sync to Google Sheet
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Quick Paste Modal -->
    <div id="pasteModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background: #fff; max-width: 500px; margin: 60px auto; border-radius: 12px; padding: 20px;">
            <h3 style="margin: 0 0 8px 0; font-size: 16px;">Quick Paste Answer Key</h3>
            <p style="font-size: 12px; color: #64748B; margin: 0 0 12px 0;">
                Paste answers in format: <code>ABCDABCD...</code> or <code>1:A, 2:B...</code> or space-separated.
            </p>
            <textarea id="pasteInput" rows="6" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 6px; padding: 10px; font-family: monospace; font-size: 13px; box-sizing: border-box;" placeholder="e.g. A B C D A B C D ..."></textarea>
            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
                <button type="button" class="preset-badge" onclick="document.getElementById('pasteModal').style.display = 'none';">Cancel</button>
                <button type="button" class="btn-primary" style="padding: 8px 16px; font-size: 13px;" onclick="applyQuickPaste();">Apply</button>
            </div>
        </div>
    </div>

    <script>
        const initialConfig = <%- JSON.stringify((typeof paper !== 'undefined' && paper) ? paper : ((typeof config !== 'undefined' && config) ? config : {})) %>;
        let totalQ = Number(initialConfig.totalQuestions) || 180;
        let answerKey = { ...(initialConfig.answerKey || {}) };

        let sections = (initialConfig.sections && initialConfig.sections.length > 0)
            ? initialConfig.sections
            : [
                { name: 'Physics', from: 1, to: 45, maxMarks: 180 },
                { name: 'Chemistry', from: 46, to: 90, maxMarks: 180 },
                { name: 'Botany', from: 91, to: 135, maxMarks: 180 },
                { name: 'Zoology', from: 136, to: 180, maxMarks: 180 }
            ];

        function setTotalQ(q) {
            totalQ = q;
            document.getElementById('totalQuestions').value = q;
            document.querySelectorAll('.preset-badge').forEach(b => {
                if (b.textContent.includes(q + ' Qs')) b.classList.add('active');
                else b.classList.remove('active');
            });
            rebuildQuestionGrid();
        }

        function renderSections() {
            const container = document.getElementById('sectionRowsContainer');
            container.innerHTML = '';
            sections.forEach((sec, idx) => {
                const row = document.createElement('div');
                row.className = 'sec-row';
                row.innerHTML = `
                    <div>
                        <label style="font-size: 11px; color: #64748B; display: block;">Section Name</label>
                        <input type="text" class="form-input" style="padding: 6px 8px;" value="${sec.name}" onchange="sections[${idx}].name = this.value;">
                    </div>
                    <div>
                        <label style="font-size: 11px; color: #64748B; display: block;">From Q#</label>
                        <input type="number" class="form-input" style="padding: 6px 8px;" value="${sec.from}" min="1" max="${totalQ}" onchange="sections[${idx}].from = Number(this.value);">
                    </div>
                    <div>
                        <label style="font-size: 11px; color: #64748B; display: block;">To Q#</label>
                        <input type="number" class="form-input" style="padding: 6px 8px;" value="${sec.to}" min="1" max="${totalQ}" onchange="sections[${idx}].to = Number(this.value);">
                    </div>
                    <div>
                        <label style="font-size: 11px; color: #64748B; display: block;">Max Marks</label>
                        <input type="number" class="form-input" style="padding: 6px 8px;" value="${sec.maxMarks || ((sec.to - sec.from + 1) * 4)}" onchange="sections[${idx}].maxMarks = Number(this.value);">
                    </div>
                    <div>
                        <button type="button" class="btn-del" onclick="deleteSection(${idx});" style="width: 100%; margin-top: 16px;">&times;</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function addSectionRow() {
            const lastTo = sections.length > 0 ? sections[sections.length - 1].to : 0;
            const newFrom = lastTo + 1;
            const newTo = Math.min(totalQ, newFrom + 44);
            sections.push({
                name: 'Section ' + (sections.length + 1),
                from: newFrom,
                to: newTo,
                maxMarks: (newTo - newFrom + 1) * 4
            });
            renderSections();
        }

        function deleteSection(idx) {
            sections.splice(idx, 1);
            renderSections();
        }

        function applyNeetSections() {
            setTotalQ(180);
            sections = [
                { name: 'Physics', from: 1, to: 45, maxMarks: 180 },
                { name: 'Chemistry', from: 46, to: 90, maxMarks: 180 },
                { name: 'Botany', from: 91, to: 135, maxMarks: 180 },
                { name: 'Zoology', from: 136, to: 180, maxMarks: 180 }
            ];
            renderSections();
        }

        function rebuildQuestionGrid() {
            totalQ = Number(document.getElementById('totalQuestions').value) || 180;
            document.getElementById('maxMarksLabel').textContent = totalQ * 4;

            const grid = document.getElementById('keyGrid');
            grid.innerHTML = '';

            for (let q = 1; q <= totalQ; q++) {
                const currentAns = String(answerKey[String(q)] || '').toUpperCase();
                const card = document.createElement('div');
                card.className = 'q-card';
                card.id = 'qcard_' + q;

                const qNum = document.createElement('span');
                qNum.className = 'q-num';
                qNum.textContent = `Q${q}`;

                const group = document.createElement('div');
                group.className = 'bubble-group';

                ['A', 'B', 'C', 'D'].forEach(opt => {
                    const b = document.createElement('span');
                    b.className = 'bubble-opt' + (currentAns === opt ? ' selected' : '');
                    b.textContent = opt;
                    b.onclick = () => selectAnswer(q, opt);
                    group.appendChild(b);
                });

                // Bonus button
                const bonus = document.createElement('span');
                bonus.className = 'bubble-opt' + ((currentAns === '*' || currentAns === 'BONUS') ? ' bonus-selected' : '');
                bonus.textContent = '*';
                bonus.title = 'Bonus Question';
                bonus.onclick = () => selectAnswer(q, '*');
                group.appendChild(bonus);

                card.appendChild(qNum);
                card.appendChild(group);
                grid.appendChild(card);
            }
        }

        function selectAnswer(q, opt) {
            const current = answerKey[String(q)];
            if (current === opt) {
                delete answerKey[String(q)];
            } else {
                answerKey[String(q)] = opt;
            }
            updateQCard(q);
        }

        function updateQCard(q) {
            const card = document.getElementById('qcard_' + q);
            if (!card) return;
            const currentAns = String(answerKey[String(q)] || '').toUpperCase();
            const bubbles = card.querySelectorAll('.bubble-opt');
            bubbles.forEach(b => {
                const txt = b.textContent;
                if (txt === '*') {
                    if (currentAns === '*' || currentAns === 'BONUS') b.classList.add('bonus-selected');
                    else b.classList.remove('bonus-selected');
                } else {
                    if (currentAns === txt) b.classList.add('selected');
                    else b.classList.remove('selected');
                }
            });
        }

        function clearAllAnswers() {
            if (confirm('Clear all answer key selections?')) {
                answerKey = {};
                rebuildQuestionGrid();
            }
        }

        function openPasteModal() {
            document.getElementById('pasteModal').style.display = 'flex';
            document.getElementById('pasteInput').focus();
        }

        function applyQuickPaste() {
            const text = document.getElementById('pasteInput').value.trim();
            if (!text) return;

            // Pattern 1: Raw letters e.g. ABCDABCD...
            if (/^[ABCD*]{5,}$/i.test(text.replace(/\s+/g, ''))) {
                const letters = text.replace(/\s+/g, '').toUpperCase().split('');
                letters.forEach((l, idx) => {
                    if (idx < totalQ) answerKey[String(idx + 1)] = l;
                });
            } else {
                // Pattern 2: Space or comma separated answers
                const tokens = text.split(/[\s,;]+/);
                tokens.forEach((tok, idx) => {
                    const match = tok.match(/^(?:(\d+)[:.-])?([ABCD*])$/i);
                    if (match) {
                        const qNum = match[1] ? parseInt(match[1]) : (idx + 1);
                        const ans = match[2].toUpperCase();
                        if (qNum <= totalQ) answerKey[String(qNum)] = ans;
                    }
                });
            }

            document.getElementById('pasteModal').style.display = 'none';
            rebuildQuestionGrid();
        }

        function prepareSubmit(e) {
            document.getElementById('sectionsJson').value = JSON.stringify(sections);
            document.getElementById('answerKeyJson').value = JSON.stringify(answerKey);
        }

        // Initialize on load
        renderSections();
        rebuildQuestionGrid();
    </script>
</body>

</html>
