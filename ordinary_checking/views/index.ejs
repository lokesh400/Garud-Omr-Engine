<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ordinary OMR Checker - Google Sheets Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container {
            max-width: 1040px;
            margin: 28px auto 60px auto;
            padding: 0 16px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .header-box {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            color: #fff;
            padding: 24px 28px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .badge-env {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid #10B981;
            color: #34D399;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .card {
            background: #ffffff;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .btn-primary {
            background: #2563EB;
            color: #fff;
        }

        .btn-primary:hover {
            background: #1D4ED8;
        }

        .btn-success {
            background: #059669;
            color: #fff;
        }

        .btn-success:hover {
            background: #047857;
        }

        .btn-outline {
            background: #FFFFFF;
            color: #334155;
            border: 1px solid #CBD5E1;
        }

        .btn-outline:hover {
            background: #F8FAFC;
            border-color: #94A3B8;
        }

        .btn-danger {
            background: #FEE2E2;
            color: #B91C1C;
            border: 1px solid #FECACA;
        }

        .btn-danger:hover {
            background: #FCA5A5;
            color: #991B1B;
        }

        .paper-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 18px;
            margin-top: 16px;
        }

        .paper-card {
            background: #FFFFFF;
            border: 1.5px solid #E2E8F0;
            border-radius: 12px;
            padding: 20px;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }

        .paper-card:hover {
            border-color: #94A3B8;
            box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.08);
            transform: translateY(-2px);
        }

        .paper-card.is-active {
            border-color: #2563EB;
            background: #F8FAFC;
            box-shadow: 0 0 0 1px #2563EB;
        }

        .active-tag {
            position: absolute;
            top: 14px;
            right: 14px;
            background: #EFF6FF;
            color: #1D4ED8;
            border: 1px solid #BFDBFE;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #F1F5F9;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            color: #475569;
            margin-right: 6px;
            margin-bottom: 6px;
        }

        .alert-banner {
            background: #D1FAE5;
            border: 1px solid #6EE7B7;
            color: #065F46;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #FEE2E2;
            border: 1px solid #FCA5A5;
            color: #991B1B;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Alerts -->
        <% if (message) { %>
            <div class="alert-banner">
                ✓ <%= message %>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert-error">
                ✕ <%= error %>
            </div>
        <% } %>

        <!-- Header -->
        <div class="header-box">
            <div>
                <span class="badge-env">
                    ● GOOGLE SHEET CONNECTED VIA .ENV
                </span>
                <h1 style="margin: 0 0 6px 0; font-size: 24px;">Ordinary OMR Assessment Portal</h1>
                <p style="margin: 0; color: #94A3B8; font-size: 13px;">
                    Each paper maintains its own <strong>Key</strong> and <strong>Results</strong> tab in Google Sheets &bull; Zero MongoDB / Zero Cloudinary
                </p>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <a href="/ordinary/paper/new" class="btn btn-primary" style="background: #10B981; font-weight: 700;">
                    ➕ Create New Paper
                </a>
                <a href="/" class="btn btn-outline" style="background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2);">
                    Main Portal
                </a>
            </div>
        </div>

        <!-- Papers List / Folder Overview -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                <div>
                    <h2 style="margin: 0 0 4px 0; font-size: 20px; color: #0F172A;">
                        Assessment Papers (<%= (papers || []).length %>)
                    </h2>
                    <span style="font-size: 13px; color: #64748B;">
                        Select any paper to launch its live camera scanner, file evaluator, or edit its answer key.
                    </span>
                </div>
                <a href="/ordinary/paper/new" class="btn btn-outline" style="font-size: 13px; padding: 6px 12px;">
                    ➕ Add Another Paper
                </a>
            </div>

            <!-- Paper Cards Grid -->
            <div class="paper-grid">
                <% (papers || []).forEach(function(p) { %>
                    <div class="paper-card <%= p.isActive ? 'is-active' : '' %>">
                        <div>
                            <% if (p.isActive) { %>
                                <span class="active-tag">Active Paper</span>
                            <% } %>

                            <h3 style="margin: 0 0 4px 0; font-size: 17px; color: #0F172A; padding-right: 70px;">
                                <%= p.title %>
                            </h3>
                            <div style="color: #64748B; font-size: 13px; margin-bottom: 12px;">
                                <%= p.subject || 'General' %>
                            </div>

                            <!-- Stats -->
                            <div style="margin-bottom: 12px;">
                                <span class="info-pill">
                                    <strong><%= p.totalQuestions %></strong> Questions
                                </span>
                                <span class="info-pill">
                                    <strong><%= p.maxMarks || (p.totalQuestions * 4) %></strong> Marks
                                </span>
                                <span class="info-pill" style="background: <%= Object.keys(p.answerKey || {}).length > 0 ? '#DCFCE7' : '#FEF3C7' %>; color: <%= Object.keys(p.answerKey || {}).length > 0 ? '#166534' : '#92400E' %>;">
                                    <strong><%= Object.keys(p.answerKey || {}).length %></strong> Keyed
                                </span>
                            </div>

                            <!-- Google Sheet Tabs Info -->
                            <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 6px; padding: 8px 10px; margin-bottom: 14px; font-size: 11.5px; color: #475569;">
                                <div>📋 Key Tab: <strong>Key - <%= p.title %></strong></div>
                                <div>📊 Results Tab: <strong>Results - <%= p.title %></strong></div>
                            </div>
                        </div>

                        <!-- Actions for this Paper -->
                        <div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                                <a href="/ordinary/paper/<%= p.id %>/scanner" class="btn btn-success" style="font-size: 12.5px; padding: 8px;" title="Scan OMR sheets for this paper">
                                    📷 Scanner
                                </a>
                                <a href="/ordinary/paper/<%= p.id %>/evaluator" class="btn btn-primary" style="font-size: 12.5px; padding: 8px;" title="Upload/evaluate images for this paper">
                                    📁 Evaluator
                                </a>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px; border-top: 1px solid #F1F5F9; padding-top: 10px;">
                                <div style="display: flex; gap: 6px;">
                                    <a href="/ordinary/paper/<%= p.id %>/edit" class="btn btn-outline" style="font-size: 12px; padding: 4px 8px;" title="Edit Answer Key">
                                        ✏️ Edit Key
                                    </a>
                                    <% if (!p.isActive) { %>
                                        <form action="/ordinary/paper/<%= p.id %>/set-active" method="POST" style="display: inline; margin: 0;">
                                            <button type="submit" class="btn btn-outline" style="font-size: 12px; padding: 4px 8px;" title="Make this the default active paper">
                                                ★ Set Active
                                            </button>
                                        </form>
                                    <% } %>
                                </div>

                                <% if ((papers || []).length > 1) { %>
                                    <form action="/ordinary/paper/<%= p.id %>/delete" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('Delete paper \'<%= p.title %>\'? (Google Sheet tabs will be preserved)');">
                                        <button type="submit" class="btn btn-danger" style="font-size: 12px; padding: 4px 8px;" title="Remove paper from local portal">
                                            🗑️
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>

                <!-- Add New Paper Action Card -->
                <a href="/ordinary/paper/new" class="paper-card" style="border-style: dashed; align-items: center; justify-content: center; text-decoration: none; min-height: 230px; text-align: center; background: #FAFAFA;">
                    <div style="font-size: 36px; margin-bottom: 8px;">➕</div>
                    <div style="font-size: 16px; font-weight: 700; color: #1E293B; margin-bottom: 4px;">Create Another Paper</div>
                    <div style="font-size: 12px; color: #64748B; max-width: 220px;">
                        Sets up a new dedicated Answer Key &amp; Results sheet tab in Google Sheets.
                    </div>
                </a>
            </div>
        </div>

        <!-- Google Sheet Connection Details (Auto configured from .env) -->
        <div class="card" style="background: #F8FAFC;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h3 style="margin: 0 0 4px 0; font-size: 14px; color: #1E293B;">Google Apps Script Web App</h3>
                    <div style="font-family: monospace; font-size: 12px; color: #64748B; word-break: break-all;">
                        <%= envUrl || config.url %>
                    </div>
                </div>
                <div>
                    <button class="btn btn-outline" style="font-size: 12px; padding: 6px 12px;" onclick="document.getElementById('scriptModal').style.display = 'block';">
                        📋 View Apps Script Code
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Apps Script Code Modal -->
    <div id="scriptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; overflow-y: auto; padding: 20px;">
        <div style="background: #fff; max-width: 800px; margin: 30px auto; border-radius: 12px; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h3 style="margin: 0; font-size: 18px;">Google Apps Script Web App Code (Multi-Paper Ready)</h3>
                <button type="button" class="btn btn-outline" style="font-size: 12px; padding: 4px 10px;" onclick="document.getElementById('scriptModal').style.display = 'none';">✕ Close</button>
            </div>
            <p style="font-size: 13px; color: #64748B; margin-bottom: 12px;">
                In your Google Spreadsheet, click <strong>Extensions &gt; Apps Script</strong>, paste this code, and deploy as a Web App (Access: Anyone).
            </p>
            <textarea id="appsScriptTextarea" readonly rows="16" style="width: 100%; font-family: monospace; font-size: 12px; padding: 12px; border: 1px solid #CBD5E1; border-radius: 8px; box-sizing: border-box; background: #0F172A; color: #F8FAFC;"><%= appsScriptCode %></textarea>
            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
                <button type="button" class="btn btn-primary" onclick="navigator.clipboard.writeText(document.getElementById('appsScriptTextarea').value); alert('Copied Apps Script code to clipboard!');">
                    📋 Copy Code
                </button>
                <button type="button" class="btn btn-outline" onclick="document.getElementById('scriptModal').style.display = 'none';">
                    Close
                </button>
            </div>
        </div>
    </div>
</body>

</html>
