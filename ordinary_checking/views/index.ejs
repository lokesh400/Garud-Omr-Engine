<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ordinary OMR Checker - Google Sheets Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container {
            max-width: 960px;
            margin: 28px auto 60px auto;
            padding: 0 16px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .header-box {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            color: #fff;
            padding: 24px 28px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .badge-env {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid #10B981;
            color: #34D399;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .card {
            background: #ffffff;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .btn-primary {
            background: #2563EB;
            color: #fff;
        }

        .btn-primary:hover {
            background: #1D4ED8;
        }

        .btn-success {
            background: #059669;
            color: #fff;
        }

        .btn-success:hover {
            background: #047857;
        }

        .btn-outline {
            background: #FFFFFF;
            color: #334155;
            border: 1px solid #CBD5E1;
        }

        .btn-outline:hover {
            background: #F8FAFC;
            border-color: #94A3B8;
        }

        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .action-card {
            background: #F8FAFC;
            border: 1.5px solid #E2E8F0;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .action-card:hover {
            border-color: #2563EB;
            background: #EFF6FF;
            transform: translateY(-2px);
        }

        .action-card h3 {
            margin: 0 0 6px 0;
            color: #1E293B;
            font-size: 18px;
        }

        .action-card p {
            color: #64748B;
            font-size: 13px;
            margin: 0 0 16px 0;
            line-height: 1.4;
        }

        .info-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #F1F5F9;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            color: #475569;
            margin-right: 8px;
            margin-bottom: 8px;
        }

        .alert-banner {
            background: #D1FAE5;
            border: 1px solid #6EE7B7;
            color: #065F46;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Success / Info Message -->
        <% if (message) { %>
            <div class="alert-banner">
                ✓ <%= message %>
            </div>
        <% } %>

        <!-- Header -->
        <div class="header-box">
            <div>
                <span class="badge-env">
                    ● GOOGLE SHEET CONNECTED VIA .ENV
                </span>
                <h1 style="margin: 0 0 6px 0; font-size: 24px;">Ordinary OMR Checker</h1>
                <p style="margin: 0; color: #94A3B8; font-size: 13px;">
                    Google Sheets integration active &bull; Zero MongoDB / Zero Cloudinary footprint
                </p>
            </div>
            <div style="display: flex; gap: 8px;">
                <a href="/ordinary/paper/new" class="btn btn-primary" style="background: #10B981;">
                    ➕ Create New Paper
                </a>
                <a href="/" class="btn btn-outline" style="background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2);">
                    Main Portal
                </a>
            </div>
        </div>

        <!-- Active Assessment Paper Card -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <div>
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.5px;">Active Assessment Paper</span>
                    <h2 style="margin: 4px 0 0 0; font-size: 20px; color: #0F172A;"><%= config.title %></h2>
                    <span style="color: #64748B; font-size: 13px;"><%= config.subject || 'General' %></span>
                </div>
                <div style="display: flex; gap: 8px;">
                    <a href="/ordinary/paper/new" class="btn btn-outline" style="font-size: 13px; padding: 6px 12px;">
                        ✏️ Edit Paper / Key
                    </a>
                    <form action="/ordinary/sync-sheet" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-outline" style="font-size: 13px; padding: 6px 12px;" title="Fetch latest answer key from Google Sheet">
                            🔄 Sync from Sheet
                        </button>
                    </form>
                </div>
            </div>

            <!-- Paper Stats -->
            <div style="margin-bottom: 16px;">
                <span class="info-pill"><strong>Total Questions:</strong> <%= config.totalQuestions %></span>
                <span class="info-pill"><strong>Max Marks:</strong> <%= config.maxMarks || (config.totalQuestions * 4) %></span>
                <span class="info-pill" style="background: <%= Object.keys(config.answerKey || {}).length > 0 ? '#DCFCE7' : '#FEF3C7' %>; color: <%= Object.keys(config.answerKey || {}).length > 0 ? '#166534' : '#92400E' %>;">
                    <strong>Answer Key:</strong> <%= Object.keys(config.answerKey || {}).length %> / <%= config.totalQuestions %> Keyed
                </span>
            </div>

            <!-- Sections summary -->
            <div>
                <strong style="font-size: 12px; color: #475569; display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Sections Defined:
                </strong>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    <% (config.sections || []).forEach(function(sec) { %>
                        <span class="info-pill" style="background: #EFF6FF; border: 1px solid #BFDBFE; color: #1D4ED8;">
                            <strong><%= sec.name %>:</strong> Q<%= sec.from %>-Q<%= sec.to %> (<%= sec.maxMarks || ((sec.to - sec.from + 1) * 4) %>M)
                        </span>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Start Checking Actions -->
        <div class="card">
            <h2 style="margin: 0 0 4px 0; font-size: 18px; color: #0F172A;">Start Evaluation</h2>
            <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748B;">
                Scanned marks will be appended directly into your Google Sheet under the <strong>Results</strong> tab.
            </p>

            <div class="action-grid">
                <div class="action-card">
                    <div>
                        <div style="font-size: 32px; margin-bottom: 8px;">📷</div>
                        <h3>Live Camera Scanner</h3>
                        <p>Continuous webcam / mobile scanning. Enter student name, hit Enter, and results save directly to Google Sheets.</p>
                    </div>
                    <a href="/ordinary/scanner" class="btn btn-success" style="width: 100%; box-sizing: border-box; padding: 12px;">
                        Launch Camera Scanner
                    </a>
                </div>

                <div class="action-card">
                    <div>
                        <div style="font-size: 32px; margin-bottom: 8px;">📁</div>
                        <h3>File Upload Evaluator</h3>
                        <p>Upload or drag &amp; drop OMR sheet photos. Enter student name and record marks instantly.</p>
                    </div>
                    <a href="/ordinary/evaluator" class="btn btn-primary" style="width: 100%; box-sizing: border-box; padding: 12px;">
                        Launch File Evaluator
                    </a>
                </div>
            </div>
        </div>

        <!-- Google Sheet Connection Details (Auto configured from .env) -->
        <div class="card" style="background: #F8FAFC;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h3 style="margin: 0 0 4px 0; font-size: 14px; color: #1E293B;">Google Apps Script Web App</h3>
                    <div style="font-family: monospace; font-size: 12px; color: #64748B; word-break: break-all;">
                        <%= envUrl || config.url %>
                    </div>
                </div>
                <div>
                    <button class="btn btn-outline" style="font-size: 12px; padding: 6px 12px;" onclick="document.getElementById('scriptModal').style.display = 'block';">
                        📋 View Apps Script Code
                    </button>
                </div>
            </div>
        </div>

        <!-- Script Modal -->
        <div id="scriptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
            <div style="background: #fff; max-width: 750px; margin: 40px auto; border-radius: 12px; padding: 24px; max-height: 85vh; overflow-y: auto;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 18px; color: #0F172A;">Google Apps Script Code</h3>
                    <button onclick="document.getElementById('scriptModal').style.display = 'none';" style="border: none; background: transparent; font-size: 20px; cursor: pointer;">&times;</button>
                </div>
                <p style="font-size: 13px; color: #475569; margin-bottom: 12px;">
                    This script powers the two-way sync: writing the AnswerKey tab when a paper is created, and appending rows to the Results tab when students are checked.
                </p>
                <div style="background: #0F172A; color: #E2E8F0; padding: 16px; border-radius: 8px; font-family: monospace; font-size: 12px; max-height: 250px; overflow-y: auto; position: relative;">
                    <button style="position: absolute; top: 10px; right: 10px; background: #334155; color: #fff; padding: 4px 10px; border-radius: 4px; border: none; font-size: 11px; cursor: pointer;" onclick="navigator.clipboard.writeText(document.getElementById('rawScript').textContent); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 2000);">Copy</button>
                    <pre id="rawScript" style="margin: 0; white-space: pre-wrap;"><%= appsScriptCode %></pre>
                </div>
                <div style="text-align: right; margin-top: 16px;">
                    <button class="btn btn-primary" onclick="document.getElementById('scriptModal').style.display = 'none';">Close</button>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
